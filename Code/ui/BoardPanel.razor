@using System
@using Sandbox
@using Sandbox.UI
@inherits PanelComponent

<root class="board-panel-root" style="@RootStyle">
	@if ( ShouldShowBoard )
	{
		<div class="board-center" style="@CenterStyle"></div>
		<div class="board-track-bg side-bottom" style="@GetTrackBackgroundStyle( "side-bottom" )"></div>
		<div class="board-track-bg side-left" style="@GetTrackBackgroundStyle( "side-left" )"></div>
		<div class="board-track-bg side-top" style="@GetTrackBackgroundStyle( "side-top" )"></div>
		<div class="board-track-bg side-right" style="@GetTrackBackgroundStyle( "side-right" )"></div>

		@foreach ( var space in SpaceDefs )
		{
			<div class="@GetSpaceClasses( space )" style="@GetSpaceStyle( space.Index )">
				<div class="space-inner" style="@SpaceInnerStyle">

					@if ( HasColorBar( space ) )
					{
						<div class="@GetColorBarClasses( space )" style="@GetColorBarStyle( space )"></div>
					}

					<div class="space-content" style="@ContentStyle">
						@if ( IsCorner( space ) )
						{
							<div class="corner-icon">@GetCornerIcon( space )</div>
							<div class="corner-title">@GetCornerTitle( space )</div>
							@if ( space.Type == SpaceType.Go )
							{
								<div class="go-arrow" style="@GoArrowStyle">&lt;-</div>
							}
						}
						else
						{
							@if ( ShouldOverlayTitleOnIcon( space ) )
							{
								<div class="space-icon-stack">
									<div class="space-title space-title-overlay" style="@SpaceTitleStyle">
										@foreach ( var line in GetSpaceNameLines( space ) )
										{
											<div>@line</div>
										}
									</div>

									@if ( space.Type == SpaceType.CommunityChest )
									{
										@RenderChestArt()
									}
									else if ( GetIconType(space) == IconType.Text )
									{
										<div class="space-icon" style="@GetSpaceIconStyle( space )">@GetSpaceIconText( space )</div>
									}
									else
									{
										<img class="space-icon space-icon-image" src="@GetSpaceIconImagePath( space )" />
									}
								</div>
							}
							else
							{
								@if ( HasIcon( space ) )
								{
									@if ( space.Type == SpaceType.CommunityChest )
									{
										@RenderChestArt()
									}
									else if ( GetIconType(space) == IconType.Text )
									{
										<div class="space-icon" style="@GetSpaceIconStyle( space )">@GetSpaceIconText( space )</div>
									}
									else
									{
										<img class="space-icon space-icon-image" src="@GetSpaceIconImagePath( space )" />
									}
								}

								<div class="space-title" style="@SpaceTitleStyle">
									@foreach ( var line in GetSpaceNameLines( space ) )
									{
										<div>@line</div>
									}
								</div>
							}
						}
					</div>
					@if ( ShouldShowFreeParkingBank( space ) )
					{
						<div class="corner-free-parking-bank">$@GetFreeParkingBank()</div>
					}
				</div>
			</div>
		}
	}
</root>

@code
{
	private const int MaxLineLength = 10;
	private static readonly IReadOnlyList<SpaceDef> FallbackSpaceDefs =
		BoardData.CreateSpaceDefs()
			.OrderBy( space => space.Index )
			.ToList();

	[Property] public float CornerSizePercent { get; set; } = 15f;
	[Property] public float TrackDepthPercent { get; set; } = 15f;
	[Property] public List<float> SpaceLengthWeights { get; set; } = CreateDefaultSpaceLengthWeights();
	[Property] public string BoardEdgeColor { get; set; } = "#1399d6";
	[Property] public string CenterColor { get; set; } = "#9d9d9d";
	[Property] public string SpaceColor { get; set; } = "#b9cfca";
	[Property] public string BorderColor { get; set; } = "#050505";
	[Property] public string TextColor { get; set; } = "#050505";
	[Property] public string BrownLabelColor { get; set; } = "#8b3a00";
	[Property] public string LightBlueLabelColor { get; set; } = "#7fa1d0";
	[Property] public string PinkLabelColor { get; set; } = "#ed1978";
	[Property] public string OrangeLabelColor { get; set; } = "#ff7f0e";
	[Property] public string RedLabelColor { get; set; } = "#f22520";
	[Property] public string YellowLabelColor { get; set; } = "#ffe21a";
	[Property] public string GreenLabelColor { get; set; } = "#07a64f";
	[Property] public string DarkBlueLabelColor { get; set; } = "#06469a";
	[Property] public Material BrownLabelMaterial { get; set; }
	[Property] public Material LightBlueLabelMaterial { get; set; }
	[Property] public Material PinkLabelMaterial { get; set; }
	[Property] public Material OrangeLabelMaterial { get; set; }
	[Property] public Material RedLabelMaterial { get; set; }
	[Property] public Material YellowLabelMaterial { get; set; }
	[Property] public Material GreenLabelMaterial { get; set; }
	[Property] public Material DarkBlueLabelMaterial { get; set; }
	[Property] public string ChestIconColor { get; set; } = "#296c9e";
	[Property] public string GoColor { get; set; } = "#c51e24";
	[Property] public string FreeParkingColor { get; set; } = "#e8df6a";
	[Property] public string GoToJailColor { get; set; } = "#1f4f8f";
	[Property] public float OuterBorderThicknessPx { get; set; } = 8f;
	[Property] public float SpaceBorderThicknessPx { get; set; } = 3f;
	[Property] public float CenterBorderThicknessPx { get; set; } = 6f;
	[Property] public float ColorBarThicknessPercent { get; set; } = 18f;
	[Property] public float ContentPaddingPx { get; set; } = 6f;
	[Property] public float SpaceTextFontSizePx { get; set; } = 17f;
	[Property] public float SpaceTextLineHeightPx { get; set; } = 17f;
	[Property] public float SpaceIconFontSizePx { get; set; } = 40f;
	[Property] public float ChanceIconFontSizePx { get; set; } = 58f;
	[Property] public float CommunityChestIconFontSizePx { get; set; } = 32f;
	[Property] public float UtilityIconFontSizePx { get; set; } = 28f;
	[Property] public float CornerIconFontSizePx { get; set; } = 32f;
	[Property] public float GoIconFontSizePx { get; set; } = 44f;
	[Property] public float GoToJailIconFontSizePx { get; set; } = 42f;
	[Property] public float CornerTitleFontSizePx { get; set; } = 13f;
	[Property] public float FreeParkingIconSizePx { get; set; } = 58f;
	[Property] public bool CreateMaterialColorLabels { get; set; } = true;
	[Property] public float MaterialColorLabelZOffset { get; set; } = 0.08f;
	[Property] public float MaterialColorLabelBorderInsetPercent { get; set; } = 0.35f;

	private bool ShouldShowBoard => Board.Instance is null || Board.Instance.UseProceduralBoardPanel;
	private readonly List<GameObject> materialColorLabels = new();
	private int materialColorLabelsHash;
	private GameController ActiveGame => GameController.Instance;

	protected override void OnUpdate()
	{
		UpdateMaterialColorLabels();
	}

	protected override void OnDisabled()
	{
		ClearMaterialColorLabels();
	}

	private string RootStyle =>
		$"background: {BoardEdgeColor}; border: {OuterBorderThicknessPx}px solid {BoardEdgeColor}; color: {TextColor};";

	private string CenterStyle =>
		$"left: {TrackDepth}%; top: {TrackDepth}%; width: {100f - (TrackDepth * 2f)}%; height: {100f - (TrackDepth * 2f)}%; background: {CenterColor}; border: {CenterBorderThicknessPx}px solid {BorderColor};";

	private string GetTrackBackgroundStyle( string side )
	{
		var bleed = Math.Max( 0f, SpaceBorderThicknessPx ) * 0.05f;
		var style = side switch
		{
			"side-bottom" => RectStyle( -bleed, 100f - TrackDepth - bleed, 100f + bleed * 2f, TrackDepth + bleed * 2f ),
			"side-left" => RectStyle( -bleed, -bleed, TrackDepth + bleed * 2f, 100f + bleed * 2f ),
			"side-top" => RectStyle( -bleed, -bleed, 100f + bleed * 2f, TrackDepth + bleed * 2f ),
			"side-right" => RectStyle( 100f - TrackDepth - bleed, -bleed, TrackDepth + bleed * 2f, 100f + bleed * 2f ),
			_ => ""
		};

		return $"{style} background: {BorderColor};";
	}

	private string SpaceInnerStyle =>
		$"left: {SpaceInnerInsetPx}px; top: {SpaceInnerInsetPx}px; right: {SpaceInnerInsetPx}px; bottom: {SpaceInnerInsetPx}px; background-color: {SpaceColor};";

	private float SpaceInnerInsetPx => Math.Max( 0f, SpaceBorderThicknessPx * 0.5f );

	private string ContentStyle =>
		$"padding: {ContentPaddingPx}px;";

	private string SpaceTitleStyle =>
		$"font-size: {SpaceTextFontSizePx}px; line-height: {SpaceTextLineHeightPx}px; color: {TextColor};";

	private string CornerTitleStyle =>
		$"font-size: {CornerTitleFontSizePx}px; line-height: {CornerTitleFontSizePx}px; color: {TextColor};";

	private string GoArrowStyle =>
		$"font-size: {GoIconFontSizePx * 0.64f}px; color: {GoColor};";

	private IEnumerable<SpaceDef> SpaceDefs =>
		Board.Instance?.SpaceDefs?.Count > 0
			? Board.Instance.SpaceDefs.OrderBy( space => space.Index )
			: FallbackSpaceDefs;

	public float CornerSize => Math.Clamp( CornerSizePercent, 5f, 35f );
	public float TrackDepth => Math.Clamp( TrackDepthPercent, 5f, CornerSize );
	public float SideRegularLength => Math.Max( 0f, 100f - (CornerSize * 2f) );

	private static string GetSpaceClasses( SpaceDef space )
	{
		var side = GetSideClass( space.Index );
		var corner = IsCorner( space ) ? "corner" : "standard";
		return $"board-space {side} {corner} type-{space.Type.ToString().ToLowerInvariant()} color-{space.ColorGroupClass} space-{space.Index} key-{space.Key}";
	}

	private static string GetSpaceContentClasses( SpaceDef space )
	{
		var str = $"space-content";
		if (IsCorner( space ))
		{
			str += " corner";
		}
		return str;
	}

	private static string GetColorBarClasses( SpaceDef space )
	{
		return $"space-color-bar color-bar-{space.ColorGroupClass}";
	}

	private string GetColorBarStyle( SpaceDef space )
	{
		var thickness = Math.Clamp( ColorBarThicknessPercent, 2f, 80f );
		var color = GetLabelColor( space.ColorGroup );
		var border = $"{SpaceBorderThicknessPx}px solid {BorderColor}";

		if ( GetSideClass( space.Index ) is "side-left" or "side-right" )
		{
			var sideBorder = GetSideClass( space.Index ) == "side-left" ? "border-left" : "border-right";
			return $"width: {thickness}%; height: 100%; background-color: {color}; border-color: {BorderColor}; {sideBorder}: {border};";
		}

		var edgeBorder = GetSideClass( space.Index ) == "side-top" ? "border-top" : "border-bottom";
		return $"height: {thickness}%; background-color: {color}; border-color: {BorderColor}; {edgeBorder}: {border};";
	}

	private string GetLabelColor( ColorGroup colorGroup )
	{
		return colorGroup switch
		{
			ColorGroup.Brown => BrownLabelColor,
			ColorGroup.LightBlue => LightBlueLabelColor,
			ColorGroup.Pink => PinkLabelColor,
			ColorGroup.Orange => OrangeLabelColor,
			ColorGroup.Red => RedLabelColor,
			ColorGroup.Yellow => YellowLabelColor,
			ColorGroup.Green => GreenLabelColor,
			ColorGroup.DarkBlue => DarkBlueLabelColor,
			_ => SpaceColor
		};
	}

	private Material GetLabelMaterial( ColorGroup colorGroup )
	{
		return colorGroup switch
		{
			ColorGroup.Brown => BrownLabelMaterial,
			ColorGroup.LightBlue => LightBlueLabelMaterial,
			ColorGroup.Pink => PinkLabelMaterial,
			ColorGroup.Orange => OrangeLabelMaterial,
			ColorGroup.Red => RedLabelMaterial,
			ColorGroup.Yellow => YellowLabelMaterial,
			ColorGroup.Green => GreenLabelMaterial,
			ColorGroup.DarkBlue => DarkBlueLabelMaterial,
			_ => null
		};
	}

	private static string GetSideClass( int spaceIndex )
	{
		if ( spaceIndex <= 10 )
			return "side-bottom";

		if ( spaceIndex <= 20 )
			return "side-left";

		if ( spaceIndex <= 30 )
			return "side-top";

		return "side-right";
	}

	private string GetSpaceStyle( int spaceIndex )
	{
		Rect rect = BoardMath.GetSpaceRect( spaceIndex, this );
		return $"left: {rect.Left}%; top: {rect.Top}%; width: {rect.Width}%; height: {rect.Height}%;";
	}

	private static string RectStyle( float left, float top, float width, float height )
	{
		return $"left: {left}%; top: {top}%; width: {width}%; height: {height}%;";
	}

	public float GetSideWeightTotal( int firstIndex, int lastIndex )
	{
		var total = 0f;

		for ( var index = firstIndex; index <= lastIndex; index++ )
			total += GetSpaceLengthWeight( index );

		return Math.Max( 0.001f, total );
	}

	public float GetSpaceLengthWeight( int spaceIndex )
	{
		if ( SpaceLengthWeights is null ||
			spaceIndex < 0 ||
			spaceIndex >= SpaceLengthWeights.Count ||
			SpaceLengthWeights[spaceIndex] <= 0f )
		{
			return 1f;
		}

		return SpaceLengthWeights[spaceIndex];
	}

	private static List<float> CreateDefaultSpaceLengthWeights()
	{
		return Enumerable.Repeat( 1f, 40 ).ToList();
	}

	private static bool IsCorner( SpaceDef space )
	{
		return space.Type == SpaceType.Go ||
			space.Type == SpaceType.Jail ||
			space.Type == SpaceType.FreeParking ||
			space.Type == SpaceType.GoToJail;
	}

	private static bool HasColorBar( SpaceDef space )
	{
		return space.Type == SpaceType.Property && space.ColorGroup != ColorGroup.None;
	}

	private static bool HasIcon( SpaceDef space )
	{
		return space.Type != SpaceType.Property;
	}

	private static bool ShouldOverlayTitleOnIcon( SpaceDef space )
	{
		return space.Type is SpaceType.Chance or SpaceType.CommunityChest;
	}

	private RenderFragment RenderChestArt() => builder =>
	{
		builder.AddMarkupContent(
			0,
			"<div class=\"monopoly-chest-art board-chest-art\">" +
			"<div class=\"monopoly-chest-lid\"></div>" +
			"<div class=\"monopoly-chest-body\"></div>" +
			"<div class=\"monopoly-chest-lock\"></div>" +
			"</div>" );
	};

	private enum IconType
	{
		Image,
		Text
	}

	private static IconType GetIconType( SpaceDef space )
	{
		return space.Type switch
		{
			SpaceType.Railroad => IconType.Text,
			SpaceType.Utility => IconType.Text,
			SpaceType.Chance => IconType.Image,
			SpaceType.CommunityChest => IconType.Text,
			SpaceType.Tax => IconType.Text,
			_ => IconType.Text
		};
	}

	private static string GetSpaceIconText( SpaceDef space )
	{
		return space.Type switch
		{
			SpaceType.Railroad => "RR",
			SpaceType.Utility => "UTIL",
			SpaceType.Chance => "?",
			SpaceType.CommunityChest => "CHEST",
			SpaceType.Tax => "$",
			_ => ""
		};
	}

	private static Texture GetSpaceIconImage( SpaceDef space )
	{
		return GameAssets.Images.Chance.Texture;
	}

	private static string GetSpaceIconImagePath( SpaceDef space )
	{
		return GameAssets.Images.Chance.Path;
	}

	private string GetSpaceIconStyle( SpaceDef space )
	{
		var fontSize = space.Type switch
		{
			SpaceType.Chance => ChanceIconFontSizePx,
			SpaceType.CommunityChest => CommunityChestIconFontSizePx,
			SpaceType.Utility => UtilityIconFontSizePx,
			_ => SpaceIconFontSizePx
		};

		var color = space.Type == SpaceType.CommunityChest ? ChestIconColor : TextColor;
		return $"font-size: {fontSize}px; line-height: {fontSize + 2f}px; color: {color};";
	}

	private static string GetCornerIcon( SpaceDef space )
	{
		return space.Type switch
		{
			SpaceType.Go => "GO",
			SpaceType.Jail => "JAIL",
			SpaceType.FreeParking => "P",
			SpaceType.GoToJail => "JAIL",
			_ => ""
		};
	}

	private string GetCornerIconStyle( SpaceDef space )
	{
		var fontSize = space.Type switch
		{
			SpaceType.Go => GoIconFontSizePx,
			SpaceType.GoToJail => GoToJailIconFontSizePx,
			_ => CornerIconFontSizePx
		};

		var color = space.Type switch
		{
			SpaceType.Go => GoColor,
			SpaceType.GoToJail => GoToJailColor,
			_ => TextColor
		};

		var style = $"font-size: {fontSize}px; line-height: {fontSize + 2f}px; color: {color};";

		if ( space.Type == SpaceType.FreeParking )
		{
			style += $" width: {FreeParkingIconSizePx}px; height: {FreeParkingIconSizePx}px; border-radius: {FreeParkingIconSizePx * 0.5f}px; background-color: {FreeParkingColor}; border-color: {BorderColor};";
		}

		return style;
	}

	private static string GetCornerTitle( SpaceDef space )
	{
		return space.Type switch
		{
			SpaceType.Go => "Collect salary as you pass",
			SpaceType.Jail => "Just visiting",
			SpaceType.FreeParking => "Free parking",
			SpaceType.GoToJail => "Go to jail",
			_ => space.DisplayName
		};
	}

	private bool ShouldShowFreeParkingBank( SpaceDef space )
	{
		return space.Type == SpaceType.FreeParking &&
			ActiveGame?.Config?.VacationCash == true;
	}

	private int GetFreeParkingBank()
	{
		return ActiveGame?.FreeParkingBank ?? 0;
	}

	private static IEnumerable<string> GetSpaceNameLines( SpaceDef space )
	{
		return space.DisplayName
			.Split( '\n' )
			.SelectMany( WrapLine );
	}

	private static IEnumerable<string> WrapLine( string line )
	{
		var words = line.Split( ' ', StringSplitOptions.RemoveEmptyEntries );
		var currentLine = "";

		foreach ( var word in words )
		{
			if ( currentLine.Length == 0 )
			{
				currentLine = word;
				continue;
			}

			if ( currentLine.Length + 1 + word.Length > MaxLineLength )
			{
				yield return currentLine;
				currentLine = word;
				continue;
			}

			currentLine += $" {word}";
		}

		if ( currentLine.Length > 0 )
			yield return currentLine;
	}

	protected override int BuildHash()
	{
		var board = Board.Instance;
		return HashCode.Combine(
			board?.UseProceduralBoardPanel ?? true,
			board?.SpaceDefs?.Count ?? 0,
			CornerSizePercent,
			TrackDepthPercent,
			GetWeightsHash(),
			GetStyleHash(),
			GetGameplayHash()
		);
	}

	private int GetGameplayHash()
	{
		var game = ActiveGame;
		var hash = new HashCode();
		hash.Add( game?.Config?.VacationCash ?? false );
		hash.Add( game?.FreeParkingBank ?? 0 );
		return hash.ToHashCode();
	}

	private int GetWeightsHash()
	{
		var hash = new HashCode();
		hash.Add( SpaceLengthWeights?.Count ?? 0 );

		if ( SpaceLengthWeights is not null )
		{
			foreach ( var weight in SpaceLengthWeights )
				hash.Add( weight );
		}

		return hash.ToHashCode();
	}

	private int GetStyleHash()
	{
		var hash = new HashCode();
		hash.Add( BoardEdgeColor );
		hash.Add( CenterColor );
		hash.Add( SpaceColor );
		hash.Add( BorderColor );
		hash.Add( TextColor );
		hash.Add( BrownLabelColor );
		hash.Add( LightBlueLabelColor );
		hash.Add( PinkLabelColor );
		hash.Add( OrangeLabelColor );
		hash.Add( RedLabelColor );
		hash.Add( YellowLabelColor );
		hash.Add( GreenLabelColor );
		hash.Add( DarkBlueLabelColor );
		hash.Add( ChestIconColor );
		hash.Add( GoColor );
		hash.Add( FreeParkingColor );
		hash.Add( GoToJailColor );
		hash.Add( OuterBorderThicknessPx );
		hash.Add( SpaceBorderThicknessPx );
		hash.Add( CenterBorderThicknessPx );
		hash.Add( ColorBarThicknessPercent );
		hash.Add( ContentPaddingPx );
		hash.Add( SpaceTextFontSizePx );
		hash.Add( SpaceTextLineHeightPx );
		hash.Add( SpaceIconFontSizePx );
		hash.Add( ChanceIconFontSizePx );
		hash.Add( CommunityChestIconFontSizePx );
		hash.Add( UtilityIconFontSizePx );
		hash.Add( CornerIconFontSizePx );
		hash.Add( GoIconFontSizePx );
		hash.Add( GoToJailIconFontSizePx );
		hash.Add( CornerTitleFontSizePx );
		hash.Add( FreeParkingIconSizePx );
		return hash.ToHashCode();
	}

	private void UpdateMaterialColorLabels()
	{
		var hash = GetMaterialColorLabelsHash();
		if ( hash == materialColorLabelsHash )
			return;

		materialColorLabelsHash = hash;
		RebuildMaterialColorLabels();
	}

	private int GetMaterialColorLabelsHash()
	{
		var board = Board.Instance;
		var hash = new HashCode();
		hash.Add( ShouldShowBoard );
		hash.Add( CreateMaterialColorLabels );
		hash.Add( board?.ProceduralBoardWorldScale ?? 1f );
		hash.Add( board?.ProceduralReferencePanelSize ?? 2000f );
		hash.Add( board?.BoardWorldPanel?.PanelSize.x ?? 0f );
		hash.Add( GetMaterialColorLabelParent() );
		hash.Add( CornerSizePercent );
		hash.Add( TrackDepthPercent );
		hash.Add( GetWeightsHash() );
		hash.Add( ColorBarThicknessPercent );
		hash.Add( MaterialColorLabelZOffset );
		hash.Add( MaterialColorLabelBorderInsetPercent );
		hash.Add( BrownLabelMaterial );
		hash.Add( LightBlueLabelMaterial );
		hash.Add( PinkLabelMaterial );
		hash.Add( OrangeLabelMaterial );
		hash.Add( RedLabelMaterial );
		hash.Add( YellowLabelMaterial );
		hash.Add( GreenLabelMaterial );
		hash.Add( DarkBlueLabelMaterial );
		return hash.ToHashCode();
	}

	private void RebuildMaterialColorLabels()
	{
		ClearMaterialColorLabels();

		if ( !ShouldShowBoard || !CreateMaterialColorLabels )
			return;

		var boardWorldSize = GetBoardWorldSize();
		if ( boardWorldSize <= 0f )
			return;

		foreach ( var space in SpaceDefs )
		{
			if ( !HasColorBar( space ) )
				continue;

			var material = GetLabelMaterial( space.ColorGroup );
			if ( material is null )
				continue;

			CreateMaterialColorLabel( space, material, boardWorldSize );
		}
	}

	private void ClearMaterialColorLabels()
	{
		foreach ( var label in materialColorLabels )
			label.Destroy();

		materialColorLabels.Clear();
	}

	private void CreateMaterialColorLabel( SpaceDef space, Material material, float boardWorldSize )
	{
		var rect = GetColorBarRect( space );
		var center = BoardMath.RectPercentToLocal( rect, boardWorldSize, MaterialColorLabelZOffset );
		var size = BoardMath.RectPercentToColliderSize( rect, boardWorldSize, 0f );
		var color = Color.Parse( GetLabelColor( space.ColorGroup ) ) ?? Color.White;

		var labelObject = new GameObject( true, $"MaterialColorLabel_{space.Index:00}_{space.ColorGroup}" );
		labelObject.SetParent( GetMaterialColorLabelParent() );
		labelObject.LocalPosition = center;
		labelObject.LocalRotation = Rotation.Identity;
		labelObject.LocalScale = Vector3.One;
		materialColorLabels.Add( labelObject );

		var mesh = new PolygonMesh();
		AddMaterialColorLabelFace( mesh, material, color, size );
		mesh.Rebuild();

		var meshComponent = labelObject.Components.Create<MeshComponent>( false );
		meshComponent.Mesh = mesh;
		meshComponent.SmoothingAngle = 0f;
		meshComponent.Color = color;
		meshComponent.RebuildMesh();
		meshComponent.Enabled = true;
	}

	private Rect GetColorBarRect( SpaceDef space )
	{
		var rect = BoardMath.GetSpaceRect( space.Index, this );
		var thickness = Math.Clamp( ColorBarThicknessPercent, 2f, 80f ) * 0.01f;
		var inset = Math.Clamp( MaterialColorLabelBorderInsetPercent, 0f, 10f );

		if ( GetSideClass( space.Index ) == "side-bottom" )
		{
			var height = rect.Height * thickness;
			return RectFromEdges( rect.Left + inset, rect.Top + inset, rect.Right - inset, rect.Top + height - inset );
		}

		if ( GetSideClass( space.Index ) == "side-top" )
		{
			var height = rect.Height * thickness;
			return RectFromEdges( rect.Left + inset, rect.Bottom - height + inset, rect.Right - inset, rect.Bottom - inset );
		}

		if ( GetSideClass( space.Index ) == "side-left" )
		{
			var width = rect.Width * thickness;
			return RectFromEdges( rect.Right - width + inset, rect.Top + inset, rect.Right - inset, rect.Bottom - inset );
		}

		{
			var width = rect.Width * thickness;
			return RectFromEdges( rect.Left + inset, rect.Top + inset, rect.Left + width - inset, rect.Bottom - inset );
		}
	}

	private static Rect RectFromEdges( float left, float top, float right, float bottom )
	{
		return new Rect( left, top, Math.Max( 0.001f, right - left ), Math.Max( 0.001f, bottom - top ) );
	}

	private static void AddMaterialColorLabelFace( PolygonMesh mesh, Material material, Color color, Vector3 size )
	{
		var halfX = size.x * 0.5f;
		var halfY = size.y * 0.5f;
		var vertices = mesh.AddVertices(
			new Vector3( -halfX, -halfY, 0f ),
			new Vector3( halfX, -halfY, 0f ),
			new Vector3( halfX, halfY, 0f ),
			new Vector3( -halfX, halfY, 0f )
		);
		var face = mesh.AddFace( vertices );
		mesh.SetFaceMaterial( face, material );

		foreach ( var halfEdge in mesh.GetFaceEdges( face ) )
			mesh.SetVertexColor( halfEdge, color );
	}

	private float GetBoardWorldSize()
	{
		var board = Board.Instance;
		var baseBoardSize = (board?.ProceduralBoardHalfSize ?? 43f) * 2f;
		var boardWorldPanel = board?.BoardWorldPanel;
		var referencePanelSize = board?.ProceduralReferencePanelSize ?? 2000f;

		if ( boardWorldPanel is not null && boardWorldPanel.PanelSize.x > 0f && referencePanelSize > 0f )
			baseBoardSize *= boardWorldPanel.PanelSize.x / referencePanelSize;

		return baseBoardSize * (board?.ProceduralBoardWorldScale ?? 1f);
	}

	private GameObject GetMaterialColorLabelParent()
	{
		return Board.Instance?.GameObject ?? GameObject;
	}
}
