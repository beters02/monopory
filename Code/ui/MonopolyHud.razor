@using Sandbox;
@using Sandbox.UI;
@using Sandbox.ui.components.HudPanel;
@using System;
@using Sandbox.ui.components.buttons
@inherits PanelComponent

<root class="monopoly-hud">
	@if ( GameRef is not null )
	{
		@if ( Popups.Count > 0 )
		{
			<div class="popup-stack">
				@foreach ( var popup in Popups )
				{
					<div class="@GetPopupClasses( popup )">
						<div class="popup-content">
							@if ( !string.IsNullOrWhiteSpace( popup.Title ) )
							{
								<div class="popup-title">@popup.Title</div>
							}
							<div class="popup-message">@popup.Message</div>
						</div>

						@if ( popup.CanDismiss )
						{
							<MonopolyCloseButton OnClick="@(() => DismissPopup( popup.Id ))"></MonopolyCloseButton>
						}
					</div>
				}
			</div>
		}

		@if ( GameRef.MatchState == MonopolyMatchState.GameOver )
		{
			<div class="session-screen game-over-screen">
				<div class="session-panel">
					<div class="session-kicker">Game Over</div>
					<div class="session-title">@WinnerName Wins</div>
					<div class="session-copy">Return to the lobby to change players or start another round with the same table.</div>
					<div class="session-actions">
						<MonopolyButton Variant="session-primary-button" OnClick="@ReturnToLobby">Back To Lobby</MonopolyButton>
					</div>
				</div>
			</div>
		}
		else
		{
		<HudPanel Variant="hud-card">
			<ChildContent>
				<HudPanelTitle>Grand Casinopoly</HudPanelTitle>
				<HudPanelSubtitle>Local</HudPanelSubtitle>
				<HudPanelBody>Money: $@LocalPlayerMoney</HudPanelBody>
				<HudPanelEmptyLine></HudPanelEmptyLine>
				<HudPanelEmptyLine></HudPanelEmptyLine>
				<HudPanelSubtitle>Game</HudPanelSubtitle>
				<HudPanelBody>Time Left: @CurrentTurnTimeText</HudPanelBody>
				<HudPanelBody>Current Player: @CurrentPlayerName</HudPanelBody>
				<HudPanelBody>Last Roll: @GameRef.LastDieA + @GameRef.LastDieB</HudPanelBody>
				<HudPanelBody>Phase: @GameRef.Phase</HudPanelBody>

				@if ( GameRef.MatchState == MonopolyMatchState.InGame && GameRef.Phase == MonopolyGamePhase.WaitingToRoll && CurrentPlayer == LocalPlayer )
				{
					<MonopolyButton OnClick="@RollDice">Roll Dice</MonopolyButton>
				}
				@if ( GameRef.MatchState == MonopolyMatchState.InGame && CurrentPlayer == LocalPlayer )
				{
					<MonopolyButton Variant="@EndTurnButtonClasses" CanClick="@CanEndTurn" OnClick="@EndTurn" OnBlocked="@ShowEndTurnBlocked">End Turn</MonopolyButton>
				}
				@if ( GameRef.MatchState == MonopolyMatchState.InGame )
				{
					<MonopolyButton Variant="pause-button" OnClick="@PauseGame">Pause</MonopolyButton>
				}
			</ChildContent>
		</HudPanel>

		@if ( IsEscapeMenuOpen )
		{
			<div class="session-screen escape-menu-screen">
				<div class="session-panel escape-menu-panel">
					<div class="session-kicker">Menu</div>
					<div class="session-title">Game Menu</div>
					<div class="session-actions escape-menu-actions">
						<MonopolyButton Variant="session-secondary-button" OnClick="@LeaveLobby">Leave Lobby</MonopolyButton>
						<MonopolyButton Variant="session-danger-button" OnClick="@ExitGame">Exit Game</MonopolyButton>
					</div>
				</div>
			</div>
		}

		@if ( GameRef.MatchState == MonopolyMatchState.Paused )
		{
			<div class="session-screen pause-screen">
				<div class="session-panel">
					<div class="session-kicker">Paused</div>
					<div class="session-title">Game Paused</div>
					<div class="session-copy">The table is frozen until the host resumes or returns everyone to the lobby.</div>
					<div class="session-actions">
						<MonopolyButton Variant="session-primary-button" OnClick="@ResumeGame">Resume</MonopolyButton>
						<MonopolyButton Variant="session-secondary-button" OnClick="@ReturnToLobby">Back To Lobby</MonopolyButton>
					</div>
				</div>
			</div>
		}



		@if ( PropertyHudPlayers.Count > 0 )
		{
			
			<HudPanel Variant="property-hud-card">
				<ChildContent>
					@foreach ( var player in PropertyHudPlayers )
					{
						var playerIndex = GameRef.GetPlayerIndex( player );
						var isExpanded = IsPropertyPanelExpanded( playerIndex );

						<HudPanel Variant="@GetPropertyPanelClasses( playerIndex, isExpanded )">
							<ChildContent>
								<MonopolyButton Variant="property-player-button" OnClick="@(() => TogglePropertyPanel( playerIndex ))" Sound = "@(GetPropertyPanelSound( playerIndex ))">
									<ChildContent>
										<div class="property-player-name">@player.PlayerName</div>
										<div class="property-player-money">$@player.Money</div>
									</ChildContent>
								</MonopolyButton>

								<div class="property-grid">
									@foreach ( var property in PropertySpaces )
									{
										<MonopolyButton
											Variant="@GetPropertySquareClasses( property, playerIndex )"
											Title="@property.DisplayName"
											OnClick="@(() => SelectPropertySpace( property.Index ))">
											<ChildContent>
												@if ( GameRef.IsMortgaged( property.Index ) )
												{
													<div class="property-mortgage-marker">M</div>
												}
											</ChildContent>
										</MonopolyButton>
									}
								</div>

								@if ( isExpanded )
								{
									
								}
							</ChildContent>
						</HudPanel>
					}
				</ChildContent>
			</HudPanel>
		}

		<div class="trade-panel">
			<div class="trade-panel-header">
				<div class="trade-panel-title">Trades</div>
				<MonopolyButton Variant="trade-create-button" OnClick="@OpenTradeComposer">+ Create</MonopolyButton>
			</div>

			@if ( Trades.Count == 0 )
			{
				<div class="trade-empty">No pending trades</div>
			}
			else
			{
				<div class="trade-list">
					@foreach ( var trade in Trades )
					{
						var sender = GetPlayerName( trade.SenderPlayerIndex );
						var receiver = GetPlayerName( trade.ReceiverPlayerIndex );
						var isReceiver = trade.ReceiverPlayerIndex == GameRef.LocalPlayerIndex;
						var isSender = trade.SenderPlayerIndex == GameRef.LocalPlayerIndex;

						<div class="@GetTradeRowClasses( trade )">
							<MonopolyButton Variant="trade-row-main" OnClick="@(() => OpenTradeViewer( trade.Id ))">
								<ChildContent>
									<span class="trade-mini-box">@GetTradeSideLabel( trade, true )</span>
									<span class="trade-mini-box">@GetTradeSideLabel( trade, false )</span>
									<span>@sender</span>
									<span class="trade-arrow">-&gt;</span>
									<span>@receiver</span>
									@if ( isReceiver )
									{
										<span class="trade-looking">looking</span>
									}
								</ChildContent>
							</MonopolyButton>

							@if ( isReceiver )
							{
								<MonopolyButton Variant="trade-icon-button accept" OnClick="@(() => AcceptTrade( trade.Id ))">OK</MonopolyButton>
								<MonopolyButton Variant="trade-icon-button deny" OnClick="@(() => DenyTrade( trade.Id ))">X</MonopolyButton>
							}
							else if ( isSender )
							{
								<MonopolyButton Variant="trade-icon-button deny" OnClick="@(() => DenyTrade( trade.Id ))">X</MonopolyButton>
							}
						</div>
					}
				</div>
			}
		</div>

		@if ( IsTradeComposerOpen )
		{
			<div class="trade-modal-backdrop">
				<div class="trade-modal">
					<MonopolyCloseButton Variant="trade-modal-close" OnClick="@CloseTradeComposer"></MonopolyCloseButton>
					<div class="trade-modal-title">Create a trade</div>

					<div class="trade-editor">
						<div class="trade-side">
							<div class="trade-player-name">@GetPlayerName( GameRef.LocalPlayerIndex )</div>
							<div class="trade-money-row">
								<MonopolyButton OnClick="@(() => AdjustSenderMoney( -50 ))">-</MonopolyButton>
								<div class="trade-money-pill">$@ComposerSenderMoney</div>
								<MonopolyButton OnClick="@(() => AdjustSenderMoney( 50 ))">+</MonopolyButton>
							</div>
							<div class="trade-property-picker">
								@foreach ( var propertyIndex in LocalOwnedPropertyIndexes )
								{
									var property = GameRef.Board.GetSpaceDef( propertyIndex );
									<MonopolyButton Variant="@GetComposerPropertyClasses( propertyIndex, true )" OnClick="@(() => ToggleSenderProperty( propertyIndex ))">
										@property?.DisplayName
									</MonopolyButton>
								}
							</div>
						</div>

						<div class="trade-swap-column">&lt;-&gt;</div>

						<div class="trade-side">
							<div class="trade-player-select">
								@foreach ( var player in TradeTargets )
								{
									var index = GameRef.GetPlayerIndex( player );
									<MonopolyButton Variant="@GetTradeTargetClasses( index )" OnClick="@(() => SelectTradeTarget( index ))">@player.PlayerName</MonopolyButton>
								}
							</div>
							<div class="trade-money-row">
								<MonopolyButton OnClick="@(() => AdjustReceiverMoney( -50 ))">-</MonopolyButton>
								<div class="trade-money-pill">$@ComposerReceiverMoney</div>
								<MonopolyButton OnClick="@(() => AdjustReceiverMoney( 50 ))">+</MonopolyButton>
							</div>
							<div class="trade-property-picker">
								@foreach ( var propertyIndex in ReceiverOwnedPropertyIndexes )
								{
									var property = GameRef.Board.GetSpaceDef( propertyIndex );
									<MonopolyButton Variant="@GetComposerPropertyClasses( propertyIndex, false )" OnClick="@(() => ToggleReceiverProperty( propertyIndex ))">
										@property?.DisplayName
									</MonopolyButton>
								}
							</div>
						</div>
					</div>

					<MonopolyButton Variant="trade-send-button" OnClick="@SendTrade">Send trade</MonopolyButton>
				</div>
			</div>
		}

		@if ( ViewedTrade is not null )
		{
			<div class="trade-modal-backdrop">
				<div class="trade-modal trade-view-modal">
					<MonopolyCloseButton Variant="trade-modal-close" OnClick="@CloseTradeViewer"></MonopolyCloseButton>
					<div class="trade-modal-title">@GetPlayerName( ViewedTrade.SenderPlayerIndex ) -&gt; @GetPlayerName( ViewedTrade.ReceiverPlayerIndex )</div>

					<div class="trade-summary-grid">
						<div class="trade-summary-side">
							<div class="trade-player-name">@GetPlayerName( ViewedTrade.SenderPlayerIndex ) gives</div>
							<div class="trade-money-pill">$@ViewedTrade.SenderMoney</div>
							@foreach ( var propertyIndex in ViewedTrade.SenderPropertyIndexes )
							{
								<div class="trade-summary-property">@GetPropertyName( propertyIndex )</div>
							}
						</div>
						<div class="trade-summary-side">
							<div class="trade-player-name">@GetPlayerName( ViewedTrade.ReceiverPlayerIndex ) gives</div>
							<div class="trade-money-pill">$@ViewedTrade.ReceiverMoney</div>
							@foreach ( var propertyIndex in ViewedTrade.ReceiverPropertyIndexes )
							{
								<div class="trade-summary-property">@GetPropertyName( propertyIndex )</div>
							}
						</div>
					</div>

					@if ( ViewedTrade.ReceiverPlayerIndex == GameRef.LocalPlayerIndex )
					{
						<div class="trade-modal-actions">
							<MonopolyButton Variant="trade-send-button" OnClick="@(() => AcceptTrade( ViewedTrade.Id ))">Accept</MonopolyButton>
							<MonopolyButton Variant="trade-deny-button" OnClick="@(() => DenyTrade( ViewedTrade.Id ))">Deny</MonopolyButton>
						</div>
					}
				</div>
			</div>
		}

		@if ( IsAuctionActive )
		{
			<div class="auction-backdrop">
				<div class="auction-modal">
					<div class="auction-kicker">Auction</div>
					<div class="auction-title-row">
						<div class="@AuctionTitleDotClasses"></div>
						<div class="auction-title">@AuctionSpace.DisplayName</div>
					</div>

					<div class="auction-content">
						<div class="auction-bid-panel">
							<div class="auction-label">Current bid</div>
							<div class="auction-current-bid">$@GameRef.AuctionCurrentBid</div>
							<div class="auction-status-row">
								<div>@AuctionLeaderLabel</div>
								<div>@AuctionRemainingLabel</div>
							</div>
							<div class="auction-progress-track">
								<div class="auction-progress-fill" style="@AuctionProgressStyle"></div>
							</div>

							<div class="auction-label bid-label">I'm bidding...</div>
							<div class="auction-actions">
								@foreach ( var increment in AuctionBidIncrements )
								{
									var bid = GameRef.AuctionCurrentBid + increment;
									<MonopolyButton Variant="@GetAuctionBidButtonClasses( bid )" OnClick="@(() => BidAuction( bid ))">
										<ChildContent>
											<span>$@bid</span>
											<span>+$@increment</span>
										</ChildContent>
									</MonopolyButton>
								}
							</div>
						</div>

						<div class="@AuctionCardClasses">
							<div class="auction-card-header">
								<div class="auction-card-type">@AuctionSpace.Type</div>
								<div class="auction-card-name">@AuctionSpace.DisplayName</div>
							</div>

							@if ( AuctionSpace.Type == SpaceType.Property )
							{
								<div class="auction-card-rents">
									<div><span>with rent</span><span>$@AuctionSpace.BaseRent</span></div>
									<div><span>with one house</span><span>$@AuctionSpace.OneHouseRent</span></div>
									<div><span>with two houses</span><span>$@AuctionSpace.TwoHouseRent</span></div>
									<div><span>with three houses</span><span>$@AuctionSpace.ThreeHouseRent</span></div>
									<div><span>with four houses</span><span>$@AuctionSpace.FourHouseRent</span></div>
									<div><span>with a hotel</span><span>$@AuctionSpace.HotelRent</span></div>
								</div>
							}
							else
							{
								<div class="auction-card-rents">
									<div><span>listed price</span><span>$@AuctionSpace.Price</span></div>
									<div><span>space type</span><span>@AuctionSpace.Type</span></div>
								</div>
							}

							<div class="auction-card-footer">
								<div>
									<span>Price</span>
									<strong>$@AuctionSpace.Price</strong>
								</div>
								<div>
									<span>Bid</span>
									<strong>$@GameRef.AuctionCurrentBid</strong>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		}

		@if ( SelectedSpace is not null )
		{
			<div class="@SpaceCardClasses">
				<MonopolyCloseButton Variant="@SpaceCardCloseButtonClasses" CanClick="@CanCloseSelectedSpace" OnClick="@CloseSelectedSpace" OnBlocked="@ShowSelectedSpaceCloseBlocked"></MonopolyCloseButton>

				<div class="space-card-header">
					<div class="space-color-band"></div>
					<div class="space-type">@SelectedSpace.Type</div>
					<div class="space-title">@SelectedSpace.DisplayName</div>
				</div>

				@if ( IsSelectedSpaceMortgaged )
				{
					<div class="space-mortgage-status">
						<div class="space-mortgage-label">Mortgaged</div>
						<div class="space-mortgage-detail">Rent is suspended until unmortgaged.</div>
					</div>
				}

				@if ( ShowFreeParkingMoney )
				{
					<div class="free-parking-bank">
						<div class="free-parking-bank-label">Free Parking Bank</div>
						<div class="free-parking-bank-amount">$@GameRef.FreeParkingBank</div>
					</div>
				}

				@if ( IsProperty )
				{
					<div class="rent-list">
						<div>Rent: $@SelectedSpace.BaseRent</div>
						<div>1 House: $@SelectedSpace.OneHouseRent</div>
						<div>2 Houses: $@SelectedSpace.TwoHouseRent</div>
						<div>3 Houses: $@SelectedSpace.ThreeHouseRent</div>
						<div>4 Houses: $@SelectedSpace.FourHouseRent</div>
						<div>Hotel: $@SelectedSpace.HotelRent</div>
					</div>

					<div class="property-house-count">
						<img class="property-house-icon" src="ui/house-placeholder.svg" />
						<span>Current houses: @SelectedImprovementAmountLabel</span>
					</div>
				}

				@if ( CanBuySelectedSpace )
				{
					<div class="space-buttons">
						<MonopolyButton OnClick="@BuyProperty">Buy</MonopolyButton>
						<MonopolyButton OnClick="@AuctionProperty">Auction</MonopolyButton>
					</div>
				}

				@if ( CanManageSelectedSpace )
				{
					<div class="space-management">
						@if ( IsProperty )
						{
							<div class="space-buttons improvement-buttons">
								<MonopolyButton Variant="@BuildImprovementButtonClasses" OnClick="@BuildImprovement">@BuildImprovementActionLabel</MonopolyButton>
								<MonopolyButton Variant="@SellImprovementButtonClasses" OnClick="@SellImprovement">@SellImprovementActionLabel</MonopolyButton>
							</div>
						}
						<div class="space-buttons mortgage-buttons">
							<MonopolyButton Variant="@MortgageButtonClasses" OnClick="@Mortgage">@MortgageActionLabel</MonopolyButton>
						</div>
					</div>
				}
			</div>
		}
		}
	}
</root>

@code
{
	[Property] public MonopolyGame GameRef { get; set; }
	[Property] public string PendingDecisionBlockedSound { get; set; } = "";

	private const string SpaceCardThemeClass = "space-card-board";

	private MonopolyPlayerState CurrentPlayer => GameRef?.CurrentPlayer;
	private MonopolyPlayerState LocalPlayer => GameRef?.LocalPlayer;

	private string CurrentPlayerName => CurrentPlayer?.PlayerName ?? "None";
	private int LocalPlayerMoney => LocalPlayer?.Money ?? 0;
	private int CurrentTurnRemainingSeconds =>
		GameRef is null || GameRef.CurrentTurnEndsAt <= 0f
			? -1
			: Math.Max( 0, (int)MathF.Ceiling( GameRef.CurrentTurnEndsAt - Time.Now ) );

	private string CurrentTurnTimeText =>
		CurrentTurnRemainingSeconds < 0
			? "Off"
			: $"{CurrentTurnRemainingSeconds / 60:00}:{CurrentTurnRemainingSeconds % 60:00}";

	private string WinnerName =>
		GameRef?.Winner?.PlayerName ?? "No One";

	private bool IsEscapeMenuOpen;

	protected override void OnUpdate()
	{
		base.OnUpdate();

		if ( GameRef is null || GameRef.MatchState == MonopolyMatchState.GameOver )
		{
			IsEscapeMenuOpen = false;
			return;
		}

		HandleMenuOpen();
	}

	private void HandleMenuOpen()
	{
		#if STANDALONE
		if ( Input.EscapePressed )
		{
			Log.Info("yayayaya");
			IsEscapeMenuOpen = !IsEscapeMenuOpen;
			return;
		}
		#endif
		
		if (Input.Pressed("EditorMenu"))
		{
			Log.Info("YAYAYA");
			IsEscapeMenuOpen = !IsEscapeMenuOpen;
		}
	}

	private void PauseGame()
	{
		if ( GameRef is null )
			return;

		if ( Networking.IsHost )
			GameRef.TryPauseGame();
		else
			GameRef.RequestPauseGame();
	}

	private void ResumeGame()
	{
		if ( GameRef is null )
			return;

		if ( Networking.IsHost )
			GameRef.TryResumeGame();
		else
			GameRef.RequestResumeGame();
	}

	private void ReturnToLobby()
	{
		if ( GameRef is null )
			return;

		if ( Networking.IsHost )
		{
			GameRef.TryReturnToLobby();
			MonopolySceneFlow.LoadLobby( Scene );
		}
		else
			GameRef.RequestReturnToLobby();
	}

	private void LeaveLobby()
	{
		IsEscapeMenuOpen = false;
		ReturnToLobby();
	}

	private void ExitGame()
	{
		IsEscapeMenuOpen = false;
		Game.Close();
	}

	private readonly HashSet<int> ExpandedPropertyPanels = new();
	private readonly HashSet<int> ComposerSenderPropertyIndexes = new();
	private readonly HashSet<int> ComposerReceiverPropertyIndexes = new();
	private bool IsTradeComposerOpen;
	private int ComposerReceiverPlayerIndex = -1;
	private int ComposerSenderMoney;
	private int ComposerReceiverMoney;
	private int ViewedTradeId = -1;

	private void log(string msg) => Log.Info(msg);

	private List<MonopolyPopup> Popups =>
		GameRef?.Popups?.ToList() ?? new();

	private MonopolySpaceDef PendingDef =>
		GameRef?.Board?.GetSpaceDef( GameRef.PendingPurchaseSpaceIndex );

	private string PendingPropertyName => PendingDef?.DisplayName ?? "Unknown Property";
	private int PendingPropertyPrice => PendingDef?.Price ?? 0;

	private void RollDice()
	{
		Log.Info("Roll dice button clicked.");
		GameRef?.RequestRollDice();
	}

	private void EndTurn()
	{
		GameRef?.RequestEndTurn();
	}

	private void ShowEndTurnBlocked()
	{
		PlayBlockedActionSound();
		GameRef?.ShowLocalPopup(
			"Cannot end turn yet",
			GetEndTurnBlockedMessage(),
			MonopolyPopupKind.Warning,
			true,
			3f
		);
	}

	private string EndTurnButtonClasses =>
		CanEndTurn ? "" : "blocked-action-button";

	private bool CanEndTurn =>
		GameRef?.Phase == MonopolyGamePhase.TurnEnded &&
		GameRef.HasPendingForcedPayment != true;

	private void BuyProperty()
	{
		GameRef?.RequestBuyPendingProperty();
	}

	private void SkipProperty()
	{
		GameRef?.RequestSkipPendingProperty();
	}

	private void AuctionProperty()
	{
		GameRef?.RequestStartPendingAuction();
	}

	protected override int BuildHash()
	{
		return System.HashCode.Combine(
			System.HashCode.Combine(
				GameRef?.LocalSelectedSpaceIndex ?? -1,
				GameRef?.MatchState ?? 0,
				GameRef?.Phase ?? 0,
				GameRef?.CurrentPlayerIndex ?? -1,
				GetPropertyOwnersHash(),
				GetPlayersHash(),
				SelectedImprovementCount
			),
			System.HashCode.Combine(
				GameRef?.LastDieA ?? 0,
				GameRef?.LastDieB ?? 0,
				GameRef?.PendingPurchaseSpaceIndex ?? -1,
				GetAuctionHash(),
				GetMortgagedPropertiesHash(),
				LocalPlayerMoney
			),
			System.HashCode.Combine(
				GetSelectedOwnerIndex(),
				GetExpandedPanelsHash(),
				GetTradesHash(),
				GetComposerHash(),
				GetPopupsHash()
			),
			IsEscapeMenuOpen,
			GameRef?.Config?.VacationCash ?? false,
				GameRef?.FreeParkingBank ?? 0,
			CurrentTurnRemainingSeconds,
			GameRef?.WinnerPlayerIndex ?? -1
		);
	}

	private int GetPopupsHash()
	{
		var hash = new HashCode();

		foreach ( var popup in Popups )
		{
			hash.Add( popup.Id );
			hash.Add( popup.Title );
			hash.Add( popup.Message );
			hash.Add( popup.Kind );
			hash.Add( popup.CanDismiss );
		}

		return hash.ToHashCode();
	}

	private int GetMortgagedPropertiesHash()
	{
		if ( GameRef?.MortgagedProperties is null )
			return 0;

		var hash = new HashCode();

		foreach ( var entry in GameRef.MortgagedProperties.OrderBy( entry => entry.Key ) )
		{
			hash.Add( entry.Key );
			hash.Add( entry.Value );
		}

		return hash.ToHashCode();
	}

	private int GetAuctionHash()
	{
		return System.HashCode.Combine(
			GameRef?.AuctionSpaceIndex ?? -1,
			GameRef?.AuctionCurrentBid ?? 0,
			GameRef?.AuctionHighBidderIndex ?? -1,
			AuctionRemainingSeconds
		);
	}

	private List<MonopolyPlayerState> PropertyHudPlayers
	{
		get
		{
			if ( GameRef is null )
				return new();

			var assignedPlayers = GameRef.Players
				.Where( player => player is not null && player.IsAssigned )
				.ToList();

			var localIndex = GameRef.LocalPlayerIndex;
			if ( localIndex < 0 )
				return assignedPlayers;

			return assignedPlayers
				.OrderBy( player =>
				{
					var index = GameRef.GetPlayerIndex( player );
					return index == localIndex ? -1 : index;
				} )
				.ToList();
		}
	}

	private List<MonopolySpaceDef> PropertySpaces =>
		GameRef?.Board?.SpaceDefs?
			.Where( IsPurchasableSpace )
			.ToList() ?? new();

	private List<MonopolyTradeRequest> Trades =>
		GameRef?.GetTrades() ?? new();

	private MonopolyTradeRequest ViewedTrade =>
		ViewedTradeId < 0 || GameRef is null || !GameRef.TryGetTrade( ViewedTradeId, out var trade )
			? null
			: trade;

	private List<MonopolyPlayerState> TradeTargets =>
		GameRef?.Players?
			.Where( player => player is not null && player.IsAssigned && GameRef.GetPlayerIndex( player ) != GameRef.LocalPlayerIndex )
			.ToList() ?? new();

	private List<int> LocalOwnedPropertyIndexes =>
		GameRef is null ? new() : GameRef.GetOwnedPropertyIndexes( GameRef.LocalPlayerIndex );

	private List<int> ReceiverOwnedPropertyIndexes =>
		GameRef is null || ComposerReceiverPlayerIndex < 0 ? new() : GameRef.GetOwnedPropertyIndexes( ComposerReceiverPlayerIndex );

	private static bool IsPurchasableSpace( MonopolySpaceDef def )
	{
		return def is not null &&
			def.Price > 0 &&
			(def.Type == SpaceType.Property || def.Type == SpaceType.Railroad || def.Type == SpaceType.Utility);
	}

