	private string GetTradeRowClasses( MonopolyTradeRequest trade )
	{
		var classes = "trade-row";

		if ( trade.ReceiverPlayerIndex == GameRef?.LocalPlayerIndex )
			classes += " incoming";

		if ( trade.SenderPlayerIndex == GameRef?.LocalPlayerIndex )
			classes += " outgoing";

		return classes;
	}

	private static string GetTradeSideLabel( MonopolyTradeRequest trade, bool senderSide )
	{
		var money = senderSide ? trade.SenderMoney : trade.ReceiverMoney;
		var properties = senderSide ? trade.SenderPropertyIndexes.Count : trade.ReceiverPropertyIndexes.Count;
		var total = properties + (money > 0 ? 1 : 0);

		return total.ToString();
	}

	private string GetComposerPropertyClasses( int propertyIndex, bool senderSide )
	{
		var selected = senderSide
			? ComposerSenderPropertyIndexes.Contains( propertyIndex )
			: ComposerReceiverPropertyIndexes.Contains( propertyIndex );

		var def = GameRef?.Board?.GetSpaceDef( propertyIndex );
		var colorGroup = GetPropertyColorClass( def );
		var classes = $"trade-property-chip color-{colorGroup}";

		if ( selected )
			classes += " selected";

		return classes;
	}

	private string GetTradeTargetClasses( int playerIndex )
	{
		return playerIndex == ComposerReceiverPlayerIndex ? "trade-target selected" : "trade-target";
	}

