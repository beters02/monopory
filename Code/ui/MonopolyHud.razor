	private string GetPropertyPanelClasses( int playerIndex, bool isExpanded )
	{
		var classes = $"property-player-panel player-{playerIndex}";

		if ( isExpanded )
			classes += " expanded";

		if ( GameRef?.LocalPlayerIndex == playerIndex )
			classes += " local-player";

		if ( GameRef?.CurrentPlayerIndex == playerIndex )
			classes += " current-player";

		return classes;
	}

	private string GetPropertySquareClasses( MonopolySpaceDef property, int playerIndex )
	{
		var ownerIndex = GameRef?.GetOwnerIndexForSpace( property.Index ) ?? -1;
		var colorGroup = GetPropertyColorClass( property );
		var classes = $"property-square color-{colorGroup} space-{property.Index}";

		if ( ownerIndex == playerIndex )
			classes += " owned-by-panel-player";
		else if ( ownerIndex >= 0 )
			classes += " owned-by-other-player";
		else
			classes += " unowned";

		if ( GameRef?.PendingPurchaseSpaceIndex == property.Index )
			classes += " pending-purchase";

		if ( GameRef?.IsMortgaged( property.Index ) == true )
			classes += " mortgaged";

		if ( SelectedSpaceIndex == property.Index )
			classes += " selected";

		return classes;
	}

	private static string GetPropertyColorClass( MonopolySpaceDef def )
	{
		if ( def is null )
			return "none";

		if ( def.ColorGroup != MonopolyColorGroup.None )
			return def.ColorGroupClass;

		return GetSpecialPropertyColorGroup( def.Type );
	}

	private static string GetSpecialPropertyColorGroup( SpaceType type )
	{
		return type switch
		{
			SpaceType.Railroad => "railroad",
			SpaceType.Utility => "utility",
			_ => "none"
		};
	}

	private int GetPropertyOwnersHash()
	{
		if ( GameRef is null )
			return 0;

		var hash = new HashCode();

		for ( var spaceIndex = 0; spaceIndex < 40; spaceIndex++ )
		{
			hash.Add( spaceIndex );
			hash.Add( GameRef.GetOwnerIndexForSpace( spaceIndex ) );
		}

		return hash.ToHashCode();
	}

	private int GetPlayersHash()
	{
		if ( GameRef?.Players is null )
			return 0;

		var hash = new HashCode();

		foreach ( var player in GameRef.Players )
		{
			hash.Add( player?.OwnerId ?? 0 );
			hash.Add( player?.PlayerName ?? "" );
			hash.Add( player?.Money ?? 0 );
			hash.Add( player?.SpaceIndex ?? 0 );
			hash.Add( player?.IsAssigned ?? false );
		}

		return hash.ToHashCode();
	}

	private int GetExpandedPanelsHash()
	{
		var hash = new HashCode();

		foreach ( var playerIndex in ExpandedPropertyPanels.OrderBy( x => x ) )
		{
			hash.Add( playerIndex );
		}

		return hash.ToHashCode();
	}

	private int GetTradesHash()
	{
		if ( GameRef?.PendingTrades is null )
			return 0;

		var hash = new HashCode();

		foreach ( var trade in Trades )
		{
			hash.Add( trade.Id );
			hash.Add( trade.Serialize() );
			hash.Add( GameRef.IsTradeValid( trade ) );
		}

		return hash.ToHashCode();
	}

	private int GetComposerHash()
	{
		var hash = new HashCode();
		hash.Add( IsTradeComposerOpen );
		hash.Add( ComposerReceiverPlayerIndex );
		hash.Add( ComposerSenderMoney );
		hash.Add( ComposerReceiverMoney );
		hash.Add( ViewedTradeId );

		foreach ( var index in ComposerSenderPropertyIndexes.OrderBy( x => x ) )
			hash.Add( index );

		foreach ( var index in ComposerReceiverPropertyIndexes.OrderBy( x => x ) )
			hash.Add( index );

		return hash.ToHashCode();
	}

