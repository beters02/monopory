		GameRef.LocalPlayerIndex >= 0 &&
		GameRef.CanMortgageProperty( GameRef.LocalPlayerIndex, SelectedSpaceIndex );

	private bool CanUnmortgageSelectedSpace =>
		GameRef is not null &&
		GameRef.LocalPlayerIndex >= 0 &&
		GameRef.CanUnmortgageProperty( GameRef.LocalPlayerIndex, SelectedSpaceIndex );

	private string MortgageActionLabel =>
		IsSelectedSpaceMortgaged
			? $"Unmortgage -${SelectedUnmortgageCost}"
