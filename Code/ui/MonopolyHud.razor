	private void Mortgage()
	{
		if ( SelectedSpaceIndex < 0 )
			return;

		if ( IsSelectedSpaceMortgaged )
		{
			if ( CanUnmortgageSelectedSpace )
				GameRef?.RequestUnmortgageProperty( SelectedSpaceIndex );

			return;
		}

		if ( CanMortgageSelectedSpace )
			GameRef?.RequestMortgageProperty( SelectedSpaceIndex );
	}

	private string GetEndTurnBlockedMessage()
	{
		if ( GameRef?.HasPendingForcedPayment == true )
			return $"Raise ${GameRef.PendingForcedPaymentAmount} before ending your turn.";

		return GameRef?.Phase switch
		{
			MonopolyGamePhase.WaitingToRoll => "Roll the dice before ending your turn.",
			MonopolyGamePhase.ResolvingSpace => "Wait for your move to finish resolving.",
			MonopolyGamePhase.WaitingForBuyDecision => $"Buy or auction {PendingPropertyName} before ending your turn.",
			MonopolyGamePhase.Auctioning => "Wait for the auction to finish before ending your turn.",
			_ => "Finish the current action before ending your turn."
		};
	}

	private void PlayBlockedActionSound()
	{
		if ( string.IsNullOrWhiteSpace( PendingDecisionBlockedSound ) )
			return;

		Sound.Play( PendingDecisionBlockedSound );
	}

