@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent

<root class="monopoly-hud">
	@if ( GameRef is not null )
	{
		<div class="hud-card">
			<div class="title">Grand Casinopoly</div>

			<div>Current Player: @CurrentPlayerName</div>
			<div>Money: $@CurrentPlayerMoney</div>
			<div>Last Roll: @GameRef.LastDieA + @GameRef.LastDieB</div>
			<div>Phase: @GameRef.Phase</div>

			@if ( GameRef.Phase == MonopolyGamePhase.WaitingToRoll )
			{
				<button onclick="@RollDice">Roll Dice</button>
			}

			@if ( GameRef.Phase == MonopolyGamePhase.WaitingForBuyDecision )
			{
				<div class="buy-box">
					<div>@PendingPropertyName</div>
					<div>Price: $@PendingPropertyPrice</div>

					<button onclick="@BuyProperty">Buy</button>
					<button onclick="@SkipProperty">Skip</button>
				</div>
			}
		</div>

		@if ( SelectedSpace is not null )
		{
			<div class="space-card">
				<div class="space-title">@SelectedSpace.DisplayName</div>
				<div class="space-type">@SelectedSpace.Type</div>

				@if ( IsPurchasable )
				{
					<div class="space-price">Price: $@SelectedSpace.Price</div>
				}

				@if ( IsProperty )
				{
					<div class="rent-list">
						<div>Rent: $@SelectedSpace.BaseRent</div>
						<div>1 House: $@SelectedSpace.OneHouseRent</div>
						<div>2 Houses: $@SelectedSpace.TwoHouseRent</div>
						<div>3 Houses: $@SelectedSpace.ThreeHouseRent</div>
						<div>4 Houses: $@SelectedSpace.FourHouseRent</div>
						<div>Hotel: $@SelectedSpace.HotelRent</div>
					</div>
				}

				@if ( IsPurchasable )
				{
					//<div class="space-buttons">
					//	<button onclick="@Trade">Trade</button>
					//	<button onclick="@Sell">Sell</button>
					//	<button onclick="@Mortgage">Mortgage</button>
					//</div>
				}
			</div>
		}
	}
</root>

@code
{
	[Property] public MonopolyGame GameRef { get; set; }

	private MonopolyPlayerState CurrentPlayer => GameRef?.CurrentPlayer;

	private string CurrentPlayerName => CurrentPlayer?.PlayerName ?? "None";
	private int CurrentPlayerMoney => CurrentPlayer?.Money ?? 0;

	private MonopolySpaceDef PendingDef =>
		GameRef?.Board?.GetSpaceDef( GameRef.PendingPurchaseSpaceIndex );

	private string PendingPropertyName => PendingDef?.DisplayName ?? "Unknown Property";
	private int PendingPropertyPrice => PendingDef?.Price ?? 0;

	private void RollDice()
	{
		Log.Info("Roll dice button clicked.");
		GameRef?.RequestRollDice();
	}

	private void BuyProperty()
	{
		GameRef?.RequestBuyPendingProperty();
	}

	private void SkipProperty()
	{
		GameRef?.RequestSkipPendingProperty();
	}

	protected override int BuildHash()
	{
		return System.HashCode.Combine(
			System.HashCode.Combine(
				GameRef?.LocalSelectedSpaceIndex ?? -1,
				GameRef?.Phase ?? 0,
				GameRef?.CurrentPlayerIndex ?? -1
			),
			GameRef?.LastDieA ?? 0,
			GameRef?.LastDieB ?? 0,
			GameRef?.PendingPurchaseSpaceIndex ?? -1,
			CurrentPlayerMoney
		);
	}


	private MonopolySpaceDef SelectedSpace =>
		GameRef?.SelectedSpace;

	private int SelectedSpaceIndex =>
		GameRef?.LocalSelectedSpaceIndex ?? -1;

	private bool IsPurchasable =>
		SelectedSpace is not null && SelectedSpace.Price > 0;

	private bool IsProperty =>
		SelectedSpace is not null &&
		SelectedSpace.HotelRent > 0;

	private void Trade()
	{
		if ( SelectedSpaceIndex < 0 )
			return;

        //TODO: Implement trade UI and logic.
		//GameRef?.RequestTrade( SelectedSpaceIndex );
	}

	private void Sell()
