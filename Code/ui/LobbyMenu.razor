	private IEnumerable<MatchConfigOption> GetConfigOptionsForGroup( string group )
	{
		return MatchConfigSchema.Options.Where( option => option.IsVisible && string.Equals( option.Group, group, StringComparison.Ordinal ) );
	}

	private static string GetConfigOptionTitle( MatchConfigOption option )
	{
		return option?.Label ?? "";
	}

	private string GetConfigFormattedValue( MatchConfigOption option )
	{
		return MatchConfigSchema.FormatValue( option, MatchConfigSchema.GetOptionValue( option, EditableConfig ) );
	}

	private void EnsureEditableConfigCurrent( bool forceReload = false )
	{
		if ( Lobby is null )
			return;

		var latestSnapshot = Lobby.HostedConfigSnapshot ?? "";
		if ( !forceReload && EditableConfig is not null && string.Equals( latestSnapshot, LoadedConfigSnapshot, StringComparison.Ordinal ) )
			return;

		EditableConfig = Lobby.GetEditableConfig();
		LoadedConfigSnapshot = latestSnapshot;
		ConfigIntDrafts.Clear();
		configRevision++;
	}

	private bool GetConfigBoolValue( MatchConfigOption option )
	{
		return (bool)(MatchConfigSchema.GetOptionValue( option, EditableConfig ) ?? false);
	}

	private void ToggleConfigBoolValue( MatchConfigOption option )
	{
		if ( !CanEditConfig )
			return;

		MatchConfigSchema.SetOptionValue( option, EditableConfig, !GetConfigBoolValue( option ) );
		configRevision++;
	}

	private int GetConfigIntValue( MatchConfigOption option )
	{
		return (int)(MatchConfigSchema.GetOptionValue( option, EditableConfig ) ?? 0);
	}

	private string GetConfigIntTextValue( MatchConfigOption option )
	{
		if ( option is not null && ConfigIntDrafts.TryGetValue( option.Key, out var draft ) )
			return draft;

		return GetConfigIntValue( option ).ToString();
	}

	private void ChangeConfigIntValue( MatchConfigOption option, int delta )
	{
		if ( !CanEditConfig )
			return;

		CommitConfigIntDraftValue( option );
		var nextValue = GetConfigIntValue( option ) + delta;
		nextValue = Math.Clamp( nextValue, option.Min, option.Max );
		MatchConfigSchema.SetOptionValue( option, EditableConfig, nextValue );
		NormalizeEditableConfig();
		configRevision++;
	}

	private void SetConfigIntDraftValue( MatchConfigOption option, string rawValue )
	{
		if ( !CanEditConfig || option is null )
			return;

		ConfigIntDrafts[option.Key] = rawValue ?? "";
		configRevision++;
	}

	private void CommitConfigIntDraftValue( MatchConfigOption option )
	{
		if ( !CanEditConfig || option is null )
			return;

		if ( !ConfigIntDrafts.TryGetValue( option.Key, out var rawValue ) )
			return;

		if ( int.TryParse( rawValue, out var value ) )
		{
			value = Math.Clamp( value, option.Min, option.Max );
			MatchConfigSchema.SetOptionValue( option, EditableConfig, value );
			NormalizeEditableConfig();
		}

		ConfigIntDrafts.Remove( option.Key );
		configRevision++;
	}

	private void CommitConfigIntDraftValues()
	{
		foreach ( var option in MatchConfigSchema.Options.Where( option => option.Kind == MatchConfigOptionKind.Int ).ToList() )
			CommitConfigIntDraftValue( option );
	}

	private string GetConfigEnumValue( MatchConfigOption option )
	{
		return MatchConfigSchema.GetOptionValue( option, EditableConfig )?.ToString() ?? "";
	}

	private void SetConfigEnumValue( MatchConfigOption option, string rawValue )
	{
		if ( !CanEditConfig )
			return;

		if ( !MatchConfigSchema.TryParseValue( option, rawValue, out var parsedValue ) )
			return;

		MatchConfigSchema.SetOptionValue( option, EditableConfig, parsedValue );
		configRevision++;
	}

	private void NormalizeEditableConfig()
	{
		EditableConfig = MatchConfigSchema.Normalize( EditableConfig, Lobby?.Players?.Count ?? 0 );
	}

	private void ResetConfigMenu()
	{
		if ( Lobby is null || !CanEditConfig )
			return;

		DropdownButton.CloseOpenDropdown();

		if ( PopupGame is null )
		{
			ResetConfigMenuWithoutConfirmation();
			return;
		}

		PopupGame.ShowLocalConfirmation(
			"Reset match settings?",
			"This will replace your current match settings draft with the default values. You will still need to press Save.",
			ResetConfigMenuWithoutConfirmation,
			null,
			"Reset",
			"Cancel",
			false );
	}

	private void ResetConfigMenuWithoutConfirmation()
	{
		if ( Lobby is null || !CanEditConfig )
			return;

		EditableConfig = MatchConfigSchema.Normalize( MatchConfigSchema.CreateDefault(), Lobby.Players?.Count ?? 0 );
		ConfigIntDrafts.Clear();
		configRevision++;
	}

	private void SaveConfigMenu()
	{
		if ( Lobby is null || EditableConfig is null || !CanEditConfig )
			return;

		CommitConfigIntDraftValues();
		NormalizeEditableConfig();

		if ( !Lobby.TrySaveConfig( EditableConfig, out var errorMessage ) )
		{
			ShowLocalPopup( "Could not save", errorMessage, PopupKind.Warning, true, 3f, false );
			return;
		}

		LoadedConfigSnapshot = Lobby.HostedConfigSnapshot ?? "";
		EditableConfig = Lobby.GetEditableConfig();
		ShowLocalPopup( "Configuration saved", "Lobby game settings have been updated.", PopupKind.Success, true, 2.5f, false );
		configRevision++;
	}

