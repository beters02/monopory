@using Sandbox;
@using Sandbox.UI;
@using Sandbox.ui.components;
@using Sandbox.ui.components.buttons;
@using System;
@inherits PanelComponent

<root class="monopoly-flow-ui">
	<ButtonPopLayer></ButtonPopLayer>
	<PopupStack Popups="@PopupList" OnDismiss="@DismissPopup"></PopupStack>
	<div class="flow-screen lobby-screen">
		<OptionsMenu IsOpen="@IsOptionsMenuOpen" OnClose="@CloseOptionsMenu"></OptionsMenu>
		@if ( IsConfigMenuOpen && EditableConfig is not null )
		{
			<div class="match-config-root open">
				<div class="match-config-screen">
					<div class="match-config-panel">
						<div class="match-config-header">
							<div class="match-config-header-text">
								<div class="match-config-kicker">Lobby</div>
								<div class="match-config-title">Game Configuration</div>
							</div>
							<CloseButton Variant="match-config-close-button" Title="Close" OnClick="@CloseConfigMenu"></CloseButton>
						</div>

						<div class="match-config-scroll-shell">
							<div class="match-config-scroll monopory-scroll-y" @ref="MatchConfigScrollPanel">
								<div class="match-config-copy">@ConfigMenuCopy</div>

							@foreach ( var group in ConfigGroups )
							{
								<div class="match-config-section">
									<div class="match-config-section-title">@group</div>
									<div class="match-config-section-options">

									@foreach ( var option in GetConfigOptionsForGroup( group ) )
									{
										<div class="match-config-row">
											<div class="match-config-text">
												<div class="match-config-name">@GetConfigOptionTitle( option )</div>
												<div class="match-config-value">@option.Description</div>
											</div>
											<div class="match-config-control">
												@if ( option.Kind == MatchConfigOptionKind.Bool )
												{
													<GameButton Variant="@GetConfigToggleButtonClasses( GetConfigBoolValue( option ) )"
														CanClick="@CanEditConfig"
														BlockedPopupTitle="Host only"
														BlockedPopupMessage="Only the host can change lobby game settings."
														OnClick="@(() => ToggleConfigBoolValue( option ))">
														@(GetConfigBoolValue( option ) ? "On" : "Off")
													</GameButton>
												}
												else if ( option.Kind == MatchConfigOptionKind.Enum )
												{
													@if ( CanEditConfig )
													{
														<DropdownButton Value="@GetConfigEnumValue( option )" Items="@option.EnumNames" ScrollTarget="@MatchConfigScrollPanel" OnSelected="@((string value) => SetConfigEnumValue( option, value ))"></DropdownButton>
													}
													else
													{
														<div class="match-config-readonly-value">@GetConfigFormattedValue( option )</div>
													}
												}
												else if ( option.Kind == MatchConfigOptionKind.Int )
												{
													<div class="match-config-stepper">
														<GameButton Variant="match-config-step-button"
															CanClick="@CanEditConfig"
															BlockedPopupTitle="Host only"
															BlockedPopupMessage="Only the host can change lobby game settings."
															OnClick="@(() => ChangeConfigIntValue( option, -option.Step ))">-</GameButton>
														<div class="match-config-stepper-value">@GetConfigIntValue( option )</div>
														<GameButton Variant="match-config-step-button"
															CanClick="@CanEditConfig"
															BlockedPopupTitle="Host only"
															BlockedPopupMessage="Only the host can change lobby game settings."
															OnClick="@(() => ChangeConfigIntValue( option, option.Step ))">+</GameButton>
													</div>
												}
											</div>
										</div>
									}
									</div>
								</div>
							}
							</div>
							<MonoScrollbar Target="@MatchConfigScrollPanel"></MonoScrollbar>
						</div>

						<div class="match-config-footer">
							@if ( CanEditConfig )
							{
								<GameButton Variant="match-config-save-button" OnClick="@SaveConfigMenu">Save</GameButton>
							}
						</div>
					</div>
				</div>
			</div>
		}
		@if ( IsCustomizeMenuOpen )
		{
			<div class="piece-customize-root open">
				<div class="piece-customize-screen">
					<div class="piece-customize-panel">
						<div class="piece-customize-header">
							<div class="piece-customize-header-text">
								<div class="match-config-kicker">Lobby</div>
								<div class="piece-customize-title">Customize</div>
							</div>
							<CloseButton Variant="match-config-close-button" Title="Close" OnClick="@CloseCustomizeMenu"></CloseButton>
						</div>
						<div class="piece-customize-scroll-shell">
							<div class="piece-customize-grid monopory-scroll-y" @ref="PieceCustomizeScrollPanel">
								<div class="piece-customize-section-title">Pieces</div>
								@foreach ( var piece in AvailablePieces )
								{
									<div class="@GetPieceCardClasses( piece )">
										<div class="piece-customize-card-title">@piece.Label</div>
										<div class="piece-customize-card-copy">@piece.Description</div>
										@if ( !CanUsePiece( piece ) )
										{
											<div class="piece-customize-card-lock">@GetUnlockRequirement( piece.RequiredAchievementId )</div>
										}
										<GameButton Variant="@GetPieceSelectButtonClasses( piece )"
											CanClick="@CanUsePiece( piece )"
											BlockedPopupTitle="Locked"
											BlockedPopupMessage="@GetUnlockRequirement( piece.RequiredAchievementId )"
											OnClick="@(() => SelectPiece( piece.Id ))">
											@(IsSelectedPiece( piece ) ? "Selected" : CanUsePiece( piece ) ? "Select" : "Locked")
										</GameButton>
									</div>
								}
								<div class="piece-customize-section-title">Dice</div>
								@foreach ( var diceSkin in AvailableDiceSkins )
								{
									<div class="@GetDiceSkinCardClasses( diceSkin )">
										<div class="piece-customize-card-title">@diceSkin.Label</div>
										<div class="piece-customize-card-copy">@diceSkin.Description</div>
										@if ( !CanUseDiceSkin( diceSkin ) )
										{
											<div class="piece-customize-card-lock">@GetUnlockRequirement( diceSkin.RequiredAchievementId )</div>
										}
										<GameButton Variant="@GetDiceSkinSelectButtonClasses( diceSkin )"
											CanClick="@CanUseDiceSkin( diceSkin )"
											BlockedPopupTitle="Locked"
											BlockedPopupMessage="@GetUnlockRequirement( diceSkin.RequiredAchievementId )"
											OnClick="@(() => SelectDiceSkin( diceSkin.Id ))">
											@(IsSelectedDiceSkin( diceSkin ) ? "Selected" : CanUseDiceSkin( diceSkin ) ? "Select" : "Locked")
										</GameButton>
									</div>
								}
							</div>
							<MonoScrollbar Target="@PieceCustomizeScrollPanel"></MonoScrollbar>
						</div>
						<div class="piece-customize-footer">
							<GameButton Variant="match-config-secondary-button" OnClick="@CloseCustomizeMenu">Done</GameButton>
						</div>
					</div>
				</div>
			</div>
		}
		@if ( IsAchievementsMenuOpen )
		{
			<div class="piece-customize-root open">
				<div class="piece-customize-screen">
					<div class="piece-customize-panel">
						<div class="piece-customize-header">
							<div class="piece-customize-header-text">
								<div class="match-config-kicker">Profile</div>
								<div class="piece-customize-title">Achievements</div>
							</div>
							<CloseButton Variant="match-config-close-button" Title="Close" OnClick="@CloseAchievementsMenu"></CloseButton>
						</div>
						<div class="piece-customize-scroll-shell">
							<div class="achievements-list monopory-scroll-y" @ref="AchievementsScrollPanel">
								@foreach ( var achievement in AchievementCatalog.All )
								{
									<div class="@GetAchievementCardClasses( achievement )">
										<div class="achievement-card-main">
											<div class="piece-customize-card-title">@achievement.Title</div>
											<div class="piece-customize-card-copy">@achievement.Description</div>
										</div>
										<div class="achievement-progress">
											@GetAchievementProgressText( achievement )
										</div>
									</div>
								}
							</div>
							<MonoScrollbar Target="@AchievementsScrollPanel"></MonoScrollbar>
						</div>
						<div class="piece-customize-footer">
							<GameButton Variant="match-config-secondary-button" OnClick="@CloseAchievementsMenu">Done</GameButton>
						</div>
					</div>
				</div>
			</div>
		}
		<GameButton Variant="flow-settings-button" Title="Options" OnClick="@OpenOptionsMenu">
			<ChildContent>
				<div class="flow-settings-icon"></div>
			</ChildContent>
		</GameButton>
		<div class="flow-panel lobby-panel">
			<div class="flow-kicker">Lobby</div>
			<div class="flow-title">Players</div>

			@if ( Lobby is null )
			{
				<div class="flow-copy">Lobby controller missing.</div>
			}
			else
			{
				<div class="lobby-list">
					@foreach ( var player in Players )
					{
						<div class="@GetPlayerClasses( player )">
							<div>
								<div class="lobby-player-name">@player.Name</div>
								<div class="lobby-player-detail">@GetPlayerDetail( player )</div>
							</div>
							<div class="lobby-ready-pill">@GetReadyLabel( player )</div>
						</div>
					}
				</div>

				<div class="flow-copy">@LobbyStatusText</div>
				<div class="flow-actions">
					<div class="lobby-action-row lobby-action-row-top">
						<GameButton Variant="@ReadyButtonClasses" OnClick="@ToggleReady">@ReadyButtonLabel</GameButton>
						<GameButton Variant="@StartButtonClasses" CanClick="@CanClickStartGame" OnClick="@StartGame" BlockedPopupTitle="Cannot start game" BlockedPopupMessage="@StartBlockedMessage">Start Game</GameButton>
						<GameButton Variant="flow-secondary-button flow-utility-button" OnClick="@CustomizePiece">Customize</GameButton>
					</div>
					<div class="lobby-action-row lobby-action-row-bottom">
						<GameButton Variant="flow-secondary-button flow-back-button" OnClick="@BackToMenu">Back</GameButton>
						<GameButton Variant="flow-secondary-button flow-utility-button" OnClick="@InviteFriends">Invite</GameButton>
						<GameButton Variant="flow-secondary-button flow-utility-button" OnClick="@OpenAchievementsMenu">Achievements</GameButton>
						<GameButton Variant="@ConfigButtonClasses" CanClick="@CanOpenConfig" OnClick="@OpenConfigMenu" BlockedPopupTitle="Host only" BlockedPopupMessage="Only the host can change lobby game settings.">Match Settings</GameButton>
					</div>
				</div>
			}
		</div>
	</div>
</root>

@code
{
	[Property] public LobbyController LobbyRef { get; set; }

	private LobbyController Lobby => LobbyRef;
	private GameController PopupGame => GameController.Instance;
	private List<LobbyPlayer> Players => Lobby?.Players ?? new();
	private List<GamePopup> PopupList => PopupGame?.Popups.ToList() ?? new();
	private LobbyPlayer LocalPlayer => Lobby?.LocalPlayer;
	private bool CanClickStartGame => Lobby?.CanLocalPlayerStartGame == true;
	private bool IsOptionsMenuOpen;
	private bool IsConfigMenuOpen;
	private bool IsCustomizeMenuOpen;
	private bool IsAchievementsMenuOpen;
	private Panel MatchConfigScrollPanel = null!;
	private Panel PieceCustomizeScrollPanel = null!;
	private Panel AchievementsScrollPanel = null!;
	private bool CanOpenConfig => Lobby is not null;
	private bool CanEditConfig => Lobby?.IsLocalEffectiveHost == true;
	private IReadOnlyList<PieceDefinition> AvailablePieces => PieceCatalog.All;
	private IReadOnlyList<DiceSkinDefinition> AvailableDiceSkins => DiceSkinCatalog.All;
	private MatchConfig EditableConfig;
	private string LoadedConfigSnapshot = "";
	private int configRevision;
	private int achievementRevision;
	private bool achievementRefreshInFlight;
	private IReadOnlyList<string> ConfigGroups => MatchConfigSchema.Options.Select( option => option.Group ).Distinct().ToList();

	protected override void OnUpdate()
	{
		base.OnUpdate();
		Mouse.Visibility = MouseVisibility.Visible;

		if ( IsConfigMenuOpen )
			EnsureEditableConfigCurrent();
	}

	private string LobbyStatusText
	{
		get
		{
			if ( Lobby is null )
				return "Lobby controller missing.";

			if ( Players.Count < Lobby.MinPlayers )
				return $"Waiting for {Lobby.MinPlayers - Players.Count} more player(s).";

			if ( HasUnreadyPlayers )
				return "Waiting for everyone to ready up.";

			if ( Lobby.OnlyHostStartsGame && !Networking.IsHost )
				return "Waiting for the host to start.";

			return "Ready to start.";
		}
	}

	private string ReadyButtonLabel => LocalPlayer?.IsReady == true ? "Unready" : "Ready";
	private string ReadyButtonClasses => LocalPlayer?.IsReady == true ? "flow-secondary-button ready" : "flow-primary-button";
	private string StartButtonClasses => CanClickStartGame ? "flow-primary-button" : "flow-primary-button blocked-action-button";
	private string ConfigButtonClasses => "flow-secondary-button flow-utility-button flow-config-button";
	private string ConfigMenuCopy => CanEditConfig
		? "Changes stay local to the host until you press Save."
		: "Viewing current host settings. Only the host can change or save configuration.";
	private string StartBlockedMessage => Lobby?.OnlyHostStartsGame == true && Lobby?.IsLocalEffectiveHost != true
		? "Only the host can start this game."
		: LobbyStatusText;

	private bool HasUnreadyPlayers
	{
		get
		{
			for ( var i = 0; i < Players.Count; i++ )
			{
				if ( !Players[i].IsReady )
					return true;
			}

			return false;
		}
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( Lobby is not null );
		hash.Add( CanClickStartGame );
		hash.Add( LobbyStatusText );
		hash.Add( Lobby?.OnlyHostStartsGame ?? false );
		hash.Add( Lobby?.IsLocalEffectiveHost ?? false );
		hash.Add( IsOptionsMenuOpen );
		hash.Add( IsConfigMenuOpen );
		hash.Add( IsCustomizeMenuOpen );
		hash.Add( IsAchievementsMenuOpen );
		hash.Add( Lobby?.HostedConfigSnapshot ?? "" );
		hash.Add( configRevision );
		hash.Add( achievementRevision );
		hash.Add( AppSettings.SettingsAvailable );
		hash.Add( AppSettings.GetFullscreenMode() );
		hash.Add( AppSettings.GetVSyncEnabled() );
		hash.Add( AppSettings.GetMotionBlurEnabled() );
		hash.Add( AppSettings.GetUpscaler() );
		hash.Add( AppSettings.GetFsr3Quality() );
		hash.Add( GetPopupsHash() );

		foreach ( var player in Players )
		{
			hash.Add( player.OwnerId );
			hash.Add( player.Name );
			hash.Add( player.IsReady );
			hash.Add( player.IsConnected );
			hash.Add( player.IsHost );
			hash.Add( player.AbandonEndsAt );
			hash.Add( player.SelectedPieceId ?? "" );
			hash.Add( player.SelectedDiceSkinId ?? "" );
		}

		var localState = GetLocalAchievementState();
		foreach ( var progress in localState.Achievements )
		{
			hash.Add( progress.AchievementId );
			hash.Add( progress.Current );
			hash.Add( progress.Target );
			hash.Add( progress.UnlockedAt.HasValue );
		}

		if ( EditableConfig is not null )
		{
			foreach ( var option in MatchConfigSchema.Options )
				hash.Add( MatchConfigSchema.FormatValue( option, MatchConfigSchema.GetOptionValue( option, EditableConfig ) ) );
		}

		return hash.ToHashCode();
	}

	private void ToggleReady()
	{
		if ( Lobby is null || LocalPlayer is null )
			return;

		if ( Networking.IsHost )
			Lobby.TrySetReady( LocalPlayer.OwnerId, !LocalPlayer.IsReady );
		else
			Lobby.RequestSetReady( !LocalPlayer.IsReady );
	}

	private void StartGame()
	{
		if ( Lobby is null )
			return;

		if ( !CanClickStartGame )
		{
			ShowLocalPopup( "Cannot start game", StartBlockedMessage, PopupKind.Warning, true, 3f, false );
			return;
		}

		if ( Networking.IsHost )
			Lobby.TryStartGame();
		else
			Lobby.RequestStartGame();
	}

	private void BackToMenu()
	{
		if ( Lobby is null )
			return;

		Lobby.RequestBackToMenu();
	}

	private void InviteFriends()
	{
		Lobby?.TryOpenInviteOverlay();
	}

	private void CustomizePiece()
	{
		IsCustomizeMenuOpen = true;
		IsConfigMenuOpen = false;
		IsOptionsMenuOpen = false;
		IsAchievementsMenuOpen = false;
		_ = RefreshAchievementStateAsync();
	}

	private void CloseCustomizeMenu()
	{
		IsCustomizeMenuOpen = false;
	}

	private bool IsSelectedPiece( PieceDefinition piece )
	{
		if ( piece is null )
			return false;

		var selectedPieceId = LocalPlayer?.SelectedPieceId ?? PieceCatalog.DefaultPieceId;
		return string.Equals( selectedPieceId, piece.Id, StringComparison.OrdinalIgnoreCase );
	}

	private string GetPieceCardClasses( PieceDefinition piece )
	{
		var classes = IsSelectedPiece( piece ) ? "piece-customize-card selected" : "piece-customize-card";
		if ( !CanUsePiece( piece ) )
			classes += " locked";
		return classes;
	}

	private string GetPieceSelectButtonClasses( PieceDefinition piece )
	{
		if ( !CanUsePiece( piece ) )
			return "match-config-secondary-button blocked-action-button";

		return IsSelectedPiece( piece ) ? "match-config-save-button" : "match-config-secondary-button";
	}

	private void SelectPiece( string pieceId )
	{
		if ( Lobby is null || LocalPlayer is null )
			return;

		if ( Networking.IsHost )
			Lobby.TrySetSelectedPiece( LocalPlayer.OwnerId, pieceId );
		else
			Lobby.RequestSetSelectedPiece( pieceId );
	}

	private bool IsSelectedDiceSkin( DiceSkinDefinition diceSkin )
	{
		if ( diceSkin is null )
			return false;

		var selectedDiceSkinId = LocalPlayer?.SelectedDiceSkinId ?? DiceSkinCatalog.DefaultDiceSkinId;
		return string.Equals( selectedDiceSkinId, diceSkin.Id, StringComparison.OrdinalIgnoreCase );
	}

	private string GetDiceSkinCardClasses( DiceSkinDefinition diceSkin )
	{
		var classes = IsSelectedDiceSkin( diceSkin ) ? "piece-customize-card selected" : "piece-customize-card";
		if ( !CanUseDiceSkin( diceSkin ) )
			classes += " locked";
		return classes;
	}

	private string GetDiceSkinSelectButtonClasses( DiceSkinDefinition diceSkin )
	{
		if ( !CanUseDiceSkin( diceSkin ) )
			return "match-config-secondary-button blocked-action-button";

		return IsSelectedDiceSkin( diceSkin ) ? "match-config-save-button" : "match-config-secondary-button";
	}

	private void SelectDiceSkin( string diceSkinId )
	{
		if ( Lobby is null || LocalPlayer is null )
			return;

		if ( Networking.IsHost )
			Lobby.TrySetSelectedDiceSkin( LocalPlayer.OwnerId, diceSkinId );
		else
			Lobby.RequestSetSelectedDiceSkin( diceSkinId );
	}

	private bool CanUsePiece( PieceDefinition piece )
	{
		return piece is not null && AchievementServices.Cosmetics.CanUseCosmetic( LocalPlayer?.OwnerId ?? 0, CosmeticCatalog.NormalizePieceCosmeticId( piece.Id ) );
	}

	private bool CanUseDiceSkin( DiceSkinDefinition diceSkin )
	{
		return diceSkin is not null && AchievementServices.Cosmetics.CanUseCosmetic( LocalPlayer?.OwnerId ?? 0, CosmeticCatalog.NormalizeDiceSkinCosmeticId( diceSkin.Id ) );
	}

	private string GetUnlockRequirement( string achievementId )
	{
		var achievement = AchievementCatalog.GetById( achievementId );
		return achievement is null ? "Locked" : $"Unlock: {achievement.Title}";
	}

	private void OpenAchievementsMenu()
	{
		IsAchievementsMenuOpen = true;
		IsConfigMenuOpen = false;
		IsCustomizeMenuOpen = false;
		IsOptionsMenuOpen = false;
		_ = RefreshAchievementStateAsync();
	}

	private void CloseAchievementsMenu()
	{
		IsAchievementsMenuOpen = false;
	}

	private void OpenOptionsMenu()
	{
		IsOptionsMenuOpen = true;
		IsConfigMenuOpen = false;
		IsCustomizeMenuOpen = false;
		IsAchievementsMenuOpen = false;
	}

	private void CloseOptionsMenu()
	{
		IsOptionsMenuOpen = false;
	}

	private void OpenConfigMenu()
	{
		if ( !CanOpenConfig )
			return;

		IsConfigMenuOpen = true;
		IsOptionsMenuOpen = false;
		IsCustomizeMenuOpen = false;
		IsAchievementsMenuOpen = false;
		EnsureEditableConfigCurrent( true );
	}

	private PlayerAchievementState GetLocalAchievementState()
	{
		return AchievementServices.Achievements.GetCachedState( LocalPlayer?.OwnerId ?? 0 );
	}

	private async Task RefreshAchievementStateAsync()
	{
		if ( achievementRefreshInFlight )
			return;

		try
		{
			achievementRefreshInFlight = true;
			await AchievementServices.Achievements.GetMyStateAsync();
			achievementRevision++;
		}
		catch ( Exception exception )
		{
			Log.Warning( $"Failed to refresh achievement state: {exception.Message}" );
		}
		finally
		{
			achievementRefreshInFlight = false;
		}
	}

	private string GetAchievementCardClasses( AchievementDefinition achievement )
	{
		return IsAchievementUnlocked( achievement ) ? "achievement-card unlocked" : "achievement-card";
	}

	private bool IsAchievementUnlocked( AchievementDefinition achievement )
	{
		return GetAchievementProgress( achievement )?.IsUnlocked == true;
	}

	private AchievementProgress GetAchievementProgress( AchievementDefinition achievement )
	{
		if ( achievement is null )
			return null;

		return GetLocalAchievementState().Achievements.FirstOrDefault( progress => string.Equals( progress.AchievementId, achievement.Id, StringComparison.OrdinalIgnoreCase ) );
	}

	private string GetAchievementProgressText( AchievementDefinition achievement )
	{
		var progress = GetAchievementProgress( achievement );
		if ( progress is null )
			return "0 / 1";

		if ( progress.IsUnlocked )
			return "Unlocked";

		return $"{Math.Clamp( progress.Current, 0, progress.Target )} / {progress.Target}";
	}

	private void CloseConfigMenu()
	{
		DropdownButton.CloseOpenDropdown();
		IsConfigMenuOpen = false;
		EditableConfig = null;
		LoadedConfigSnapshot = "";
		configRevision++;
	}

	private IEnumerable<MatchConfigOption> GetConfigOptionsForGroup( string group )
	{
		return MatchConfigSchema.Options.Where( option => string.Equals( option.Group, group, StringComparison.Ordinal ) );
	}

	private static string GetConfigOptionTitle( MatchConfigOption option )
	{
		return option?.Label ?? "";
	}

	private string GetConfigFormattedValue( MatchConfigOption option )
	{
		return MatchConfigSchema.FormatValue( option, MatchConfigSchema.GetOptionValue( option, EditableConfig ) );
	}

	private void EnsureEditableConfigCurrent( bool forceReload = false )
	{
		if ( Lobby is null )
			return;

		var latestSnapshot = Lobby.HostedConfigSnapshot ?? "";
		if ( !forceReload && EditableConfig is not null && string.Equals( latestSnapshot, LoadedConfigSnapshot, StringComparison.Ordinal ) )
			return;

		EditableConfig = Lobby.GetEditableConfig();
		LoadedConfigSnapshot = latestSnapshot;
		configRevision++;
	}

	private bool GetConfigBoolValue( MatchConfigOption option )
	{
		return (bool)(MatchConfigSchema.GetOptionValue( option, EditableConfig ) ?? false);
	}

	private void ToggleConfigBoolValue( MatchConfigOption option )
	{
		if ( !CanEditConfig )
			return;

		MatchConfigSchema.SetOptionValue( option, EditableConfig, !GetConfigBoolValue( option ) );
		configRevision++;
	}

	private int GetConfigIntValue( MatchConfigOption option )
	{
		return (int)(MatchConfigSchema.GetOptionValue( option, EditableConfig ) ?? 0);
	}

	private void ChangeConfigIntValue( MatchConfigOption option, int delta )
	{
		if ( !CanEditConfig )
			return;

		var nextValue = GetConfigIntValue( option ) + delta;
		nextValue = Math.Clamp( nextValue, option.Min, option.Max );
		MatchConfigSchema.SetOptionValue( option, EditableConfig, nextValue );
		NormalizeEditableConfig();
		configRevision++;
	}

	private string GetConfigEnumValue( MatchConfigOption option )
	{
		return MatchConfigSchema.GetOptionValue( option, EditableConfig )?.ToString() ?? "";
	}

	private void SetConfigEnumValue( MatchConfigOption option, string rawValue )
	{
		if ( !CanEditConfig )
			return;

		if ( !MatchConfigSchema.TryParseValue( option, rawValue, out var parsedValue ) )
			return;

		MatchConfigSchema.SetOptionValue( option, EditableConfig, parsedValue );
		configRevision++;
	}

	private void NormalizeEditableConfig()
	{
		EditableConfig = MatchConfigSchema.Normalize( EditableConfig, Lobby?.Players?.Count ?? 0 );
	}

	private void SaveConfigMenu()
	{
		if ( Lobby is null || EditableConfig is null || !CanEditConfig )
			return;

		NormalizeEditableConfig();

		if ( !Lobby.TrySaveConfig( EditableConfig, out var errorMessage ) )
		{
			ShowLocalPopup( "Could not save", errorMessage, PopupKind.Warning, true, 3f, false );
			return;
		}

		LoadedConfigSnapshot = Lobby.HostedConfigSnapshot ?? "";
		EditableConfig = Lobby.GetEditableConfig();
		ShowLocalPopup( "Configuration saved", "Lobby game settings have been updated.", PopupKind.Success, true, 2.5f, false );
		configRevision++;
	}

	private static string GetConfigToggleButtonClasses( bool enabled )
	{
		return enabled ? "match-config-toggle-button selected" : "match-config-toggle-button";
	}

	private void DismissPopup( int popupId )
	{
		PopupGame?.DismissPopup( popupId );
	}

	private void ShowLocalPopup( string title, string message, PopupKind kind = PopupKind.Info, bool canDismiss = true, float lifetime = 5f, bool soundEnabled = true )
	{
		PopupGame?.ShowLocalPopup( title, message, kind, canDismiss, lifetime, soundEnabled );
	}

	private int GetPopupsHash()
	{
		var hash = new HashCode();
		foreach ( var popup in PopupList )
		{
			hash.Add( popup.Id );
			hash.Add( popup.Title );
			hash.Add( popup.Message );
			hash.Add( popup.Kind );
			hash.Add( popup.CanDismiss );
		}

		return hash.ToHashCode();
	}

	private static string GetPlayerClasses( LobbyPlayer player )
	{
		var classes = "lobby-player-row";

		if ( player.IsLocal )
			classes += " local";

		if ( player.IsReady )
			classes += " ready";
		if ( !player.IsConnected )
			classes += " disconnected";
		if ( player.IsHost )
			classes += " host";

		return classes;
	}

	private static string GetPlayerDetail( LobbyPlayer player )
	{
		if ( !player.IsConnected )
		{
			var remaining = Math.Max( 0, (int)MathF.Ceiling( player.AbandonEndsAt - Time.Now ) );
			return $"Disconnected - {remaining}s to rejoin";
		}

		if ( player.IsHost && player.IsLocal )
			return "You - Host";

		if ( player.IsHost )
			return "Host";

		return player.IsLocal ? "You" : "Connected";
	}

	private static string GetReadyLabel( LobbyPlayer player )
	{
		return player.IsReady ? "Ready" : "Not Ready";
	}
}
