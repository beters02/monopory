	private void SelectMatchingPresetsFromEditableConfig()
	{
		SelectedGameRulePresetId = GetFirstMatchingGameRulesPresetId() ?? CustomPresetId;
		SelectedBoardConfigPresetId = GetFirstMatchingBoardConfigPresetId() ?? CustomPresetId;
		IsGameRulesExplicitlyCustom = IsGameRulesCustomSelected;
		IsBoardConfigExplicitlyCustom = IsBoardConfigCustomSelected;
	}

	private string GetFirstMatchingGameRulesPresetId()
	{
		if ( EditableConfig is null )
			return null;

		var currentSnapshot = GetGameRulesPresetComparableSnapshot( EditableConfig );
		return GameRulePresets.FirstOrDefault( preset => string.Equals(
			currentSnapshot,
			GetGameRulesPresetComparableSnapshot( MatchConfigSchema.Deserialize( preset.Snapshot ) ),
			StringComparison.Ordinal ) )?.Id;
	}

	private string GetFirstMatchingBoardConfigPresetId()
	{
		if ( EditableConfig is null )
			return null;

		var currentSnapshot = NormalizeBoardPresetSnapshot( EditableConfig.BoardSpaceNamesSnapshot );
		return BoardConfigPresets.FirstOrDefault( preset => string.Equals(
			currentSnapshot,
			NormalizeBoardPresetSnapshot( preset.Snapshot ),
			StringComparison.Ordinal ) )?.Id;
	}

	private static string GetGameRulesPresetComparableSnapshot( MatchConfig config )
	{
		var clone = MatchConfigSchema.Clone( config );
		clone.BoardSpaceNamesSnapshot = "";
		return MatchConfigSchema.Serialize( clone );
	}

	private static string NormalizeBoardPresetSnapshot( string snapshot )
	{
		return BoardSpaceNameConfig.SerializeNames( BoardSpaceNameConfig.DeserializeNames( snapshot ) );
	}

	private void MarkCustomPreset()
	{
		if ( IsGameRulesConfigPage )
		{
			SelectedGameRulePresetId = CustomPresetId;
			IsGameRulesExplicitlyCustom = true;
		}
		else
		{
			SelectedBoardConfigPresetId = CustomPresetId;
			IsBoardConfigExplicitlyCustom = true;
		}

		configRevision++;
	}

	private void EnsureEditableConfigCurrent( bool forceReload = false )
	{
		if ( Lobby is null )
			return;

		var latestSnapshot = Lobby.HostedConfigSnapshot ?? "";
		if ( !forceReload && EditableConfig is not null && string.Equals( latestSnapshot, LoadedConfigSnapshot, StringComparison.Ordinal ) )
			return;

		EditableConfig = Lobby.GetEditableConfig();
		LoadedConfigSnapshot = latestSnapshot;
		ConfigIntDrafts.Clear();
		configRevision++;
	}

	private bool GetConfigBoolValue( MatchConfigOption option )
	{
		return (bool)(MatchConfigSchema.GetOptionValue( option, EditableConfig ) ?? false);
	}

	private void ToggleConfigBoolValue( MatchConfigOption option )
	{
		if ( !CanEditCurrentConfigPage )
			return;

		MatchConfigSchema.SetOptionValue( option, EditableConfig, !GetConfigBoolValue( option ) );
		configRevision++;
	}

	private int GetConfigIntValue( MatchConfigOption option )
	{
		return (int)(MatchConfigSchema.GetOptionValue( option, EditableConfig ) ?? 0);
	}

	private string GetConfigIntTextValue( MatchConfigOption option )
	{
		if ( option is not null && ConfigIntDrafts.TryGetValue( option.Key, out var draft ) )
			return draft;

		return GetConfigIntValue( option ).ToString();
	}

	private void ChangeConfigIntValue( MatchConfigOption option, int delta )
	{
		if ( !CanEditCurrentConfigPage )
			return;

		CommitConfigIntDraftValue( option );
		var nextValue = GetConfigIntValue( option ) + delta;
		nextValue = Math.Clamp( nextValue, option.Min, option.Max );
		MatchConfigSchema.SetOptionValue( option, EditableConfig, nextValue );
		NormalizeEditableConfig();
		configRevision++;
	}

	private void SetConfigIntDraftValue( MatchConfigOption option, string rawValue )
	{
		if ( !CanEditCurrentConfigPage || option is null )
			return;

		ConfigIntDrafts[option.Key] = rawValue ?? "";
		configRevision++;
	}

	private void CommitConfigIntDraftValue( MatchConfigOption option )
	{
		if ( !CanEditCurrentConfigPage || option is null )
			return;

		if ( !ConfigIntDrafts.TryGetValue( option.Key, out var rawValue ) )
			return;

		if ( int.TryParse( rawValue, out var value ) )
		{
			value = Math.Clamp( value, option.Min, option.Max );
			MatchConfigSchema.SetOptionValue( option, EditableConfig, value );
			NormalizeEditableConfig();
		}

		ConfigIntDrafts.Remove( option.Key );
		configRevision++;
	}

	private void CommitConfigIntDraftValues()
	{
		foreach ( var option in MatchConfigSchema.Options.Where( option => option.Kind == MatchConfigOptionKind.Int ).ToList() )
			CommitConfigIntDraftValue( option );
	}

	private void SetConfigEnumValue( MatchConfigOption option, string rawValue )
	{
		if ( !CanEditCurrentConfigPage )
			return;

		if ( !MatchConfigSchema.TryParseValue( option, rawValue, out var parsedValue ) )
			return;

		MatchConfigSchema.SetOptionValue( option, EditableConfig, parsedValue );
		configRevision++;
	}

	private void NormalizeEditableConfig()
	{
		EditableConfig = MatchConfigSchema.Normalize( EditableConfig, Lobby?.Players?.Count ?? 0 );
	}

	private void ApplyGameRulesPreset( MatchSettingsPreset preset )
	{
		if ( preset is null || EditableConfig is null || !CanEditConfig )
			return;

		var presetConfig = MatchConfigSchema.Deserialize( preset.Snapshot );
		foreach ( var option in MatchConfigSchema.Options.Where( option => option.Key != nameof( MatchConfig.BoardSpaceNamesSnapshot ) ) )
		{
			MatchConfigSchema.SetOptionValue( option, EditableConfig, MatchConfigSchema.GetOptionValue( option, presetConfig ) );
		}

		NormalizeEditableConfig();
		ConfigIntDrafts.Clear();
		IsGameRulesExplicitlyCustom = false;
		SelectedGameRulePresetId = preset.Id ?? CustomPresetId;
		configRevision++;
	}

	private void ApplyBoardConfigPreset( MatchSettingsPreset preset )
	{
		if ( preset is null || EditableConfig is null || !CanEditConfig )
			return;

		EditableConfig.BoardSpaceNamesSnapshot = preset.Snapshot ?? "";
		IsBoardConfigExplicitlyCustom = false;
		SelectedBoardConfigPresetId = preset.Id ?? CustomPresetId;
		configRevision++;
	}

	private void SaveGameRulesPreset()
	{
		if ( EditableConfig is null || !CanEditConfig || !IsGameRulesCustomSelected )
			return;

		CommitConfigIntDraftValues();
		var presetName = string.IsNullOrWhiteSpace( GameRulePresetNameDraft )
			? $"Custom Rules {CustomGameRulePresets.Count + 1}"
			: GameRulePresetNameDraft.Trim();

		var preset = new MatchSettingsPreset
		{
			Id = $"rules_custom_{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}",
			Name = presetName,
			Snapshot = MatchConfigSchema.Serialize( EditableConfig ),
			IsPredefined = false
		};

		CustomGameRulePresets.Add( preset );

		GameRulePresetNameDraft = "";
		SelectedGameRulePresetId = preset.Id;
		IsGameRulesExplicitlyCustom = false;
		SaveCustomPresets( GameRulePresetFileName, CustomGameRulePresets );
		configRevision++;
	}

	private void SaveBoardConfigPreset()
	{
		if ( EditableConfig is null || !CanEditConfig || !IsBoardConfigCustomSelected )
			return;

		var presetName = string.IsNullOrWhiteSpace( BoardConfigPresetNameDraft )
			? $"Custom Board {CustomBoardConfigPresets.Count + 1}"
			: BoardConfigPresetNameDraft.Trim();

		var preset = new MatchSettingsPreset
		{
			Id = $"board_custom_{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}",
			Name = presetName,
			Snapshot = EditableConfig.BoardSpaceNamesSnapshot ?? "",
			IsPredefined = false
		};

		CustomBoardConfigPresets.Add( preset );

		BoardConfigPresetNameDraft = "";
		SelectedBoardConfigPresetId = preset.Id;
		IsBoardConfigExplicitlyCustom = false;
		SaveCustomPresets( BoardConfigPresetFileName, CustomBoardConfigPresets );
		configRevision++;
	}

	private void DeleteGameRulesPreset( MatchSettingsPreset preset )
	{
		if ( preset is null || preset.IsPredefined )
			return;

		CustomGameRulePresets.RemoveAll( item => string.Equals( item.Id, preset.Id, StringComparison.Ordinal ) );
		if ( string.Equals( SelectedGameRulePresetId, preset.Id, StringComparison.Ordinal ) )
			SelectedGameRulePresetId = CustomPresetId;

		SaveCustomPresets( GameRulePresetFileName, CustomGameRulePresets );
		configRevision++;
	}

	private void DeleteBoardConfigPreset( MatchSettingsPreset preset )
	{
		if ( preset is null || preset.IsPredefined )
			return;

		CustomBoardConfigPresets.RemoveAll( item => string.Equals( item.Id, preset.Id, StringComparison.Ordinal ) );
		if ( string.Equals( SelectedBoardConfigPresetId, preset.Id, StringComparison.Ordinal ) )
			SelectedBoardConfigPresetId = CustomPresetId;

		SaveCustomPresets( BoardConfigPresetFileName, CustomBoardConfigPresets );
		configRevision++;
	}

	private void SetGameRulePresetNameDraft( string value )
	{
		GameRulePresetNameDraft = value ?? "";
		configRevision++;
	}

	private void SetBoardConfigPresetNameDraft( string value )
	{
		BoardConfigPresetNameDraft = value ?? "";
		configRevision++;
	}

	private void SetBoardSpaceName( int index, string value )
	{
		if ( EditableConfig is null || !CanEditCurrentConfigPage )
			return;

		var names = BoardSpaceNameConfig.DeserializeNames( EditableConfig.BoardSpaceNamesSnapshot );
		if ( index < 0 || index >= names.Count )
			return;

		names[index] = value ?? "";
		EditableConfig.BoardSpaceNamesSnapshot = BoardSpaceNameConfig.SerializeNames( names );
		configRevision++;
	}

	private void ResetConfigMenu()
	{
		if ( Lobby is null || !CanEditCurrentConfigPage )
			return;

		DropdownButton.CloseOpenDropdown();

		if ( PopupGame is null )
		{
			ResetConfigMenuWithoutConfirmation();
			return;
		}

		PopupGame.ShowLocalConfirmation(
			"Reset match settings?",
			$"This will replace the current {ActiveConfigPage.ToLower()} draft with the default values. You will still need to press Save.",
			ResetConfigMenuWithoutConfirmation,
			null,
			"Reset",
			"Cancel",
			false );
	}

	private void ResetConfigMenuWithoutConfirmation()
	{
		if ( Lobby is null || !CanEditCurrentConfigPage )
			return;

		if ( IsGameRulesConfigPage )
		{
			var boardNamesSnapshot = EditableConfig?.BoardSpaceNamesSnapshot ?? "";
			EditableConfig = MatchConfigSchema.Normalize( MatchConfigSchema.CreateDefault(), Lobby.Players?.Count ?? 0 );
			EditableConfig.BoardSpaceNamesSnapshot = boardNamesSnapshot;
		}
		else if ( EditableConfig is not null )
		{
			EditableConfig.BoardSpaceNamesSnapshot = BoardSpaceNameConfig.CreateDefaultSnapshot();
		}

		ConfigIntDrafts.Clear();
		configRevision++;
	}

	private async void SaveConfigMenu()
	{
		if ( Lobby is null || EditableConfig is null || !CanEditConfig )
			return;

		LoadingState.Show( "Applying settings", "Updating the match rules." );
		await LoadingState.WaitUntilPresentedAsync();

		CommitConfigIntDraftValues();
		NormalizeEditableConfig();

		if ( !Lobby.TrySaveConfig( EditableConfig, out var errorMessage ) )
		{
			LoadingState.Hide();
			ShowLocalPopup( "Could not save", errorMessage, PopupKind.Warning, true, 3f, false );
			return;
		}

		LoadedConfigSnapshot = Lobby.HostedConfigSnapshot ?? "";
		EditableConfig = Lobby.GetEditableConfig();
		ShowLocalPopup( "Configuration saved", "Lobby game settings have been updated.", PopupKind.Success, true, 2.5f, false );
		configRevision++;
		LoadingState.HideAfterSceneReady( 4, 0.16f );
	}

	private void DismissPopup( int popupId )
	{
		PopupGame?.DismissPopup( popupId );
	}

	private void HandleConfirmationDecision( int popupId, bool confirmed )
	{
		PopupGame?.ResolveConfirmationPopup( popupId, confirmed );
	}

	private void ShowLocalPopup( string title, string message, PopupKind kind = PopupKind.Info, bool canDismiss = true, float lifetime = 5f, bool soundEnabled = true )
	{
		PopupGame?.ShowLocalPopup( title, message, kind, canDismiss, lifetime, soundEnabled );
	}

	private int GetPopupsHash()
	{
		var hash = new HashCode();
		foreach ( var popup in PopupList )
		{
			hash.Add( popup.Id );
			hash.Add( popup.Title );
			hash.Add( popup.Message );
			hash.Add( popup.Kind );
			hash.Add( popup.CanDismiss );
		}

		return hash.ToHashCode();
	}

	private static string GetPlayerClasses( LobbyPlayer player )
	{
		var classes = "lobby-player-row";

		if ( player.IsLocal )
			classes += " local";

		if ( player.IsReady )
			classes += " ready";
		if ( !player.IsConnected )
			classes += " disconnected";
		if ( player.IsHost )
			classes += " host";

		return classes;
	}

	private static string GetPlayerDetail( LobbyPlayer player )
	{
		if ( !player.IsConnected )
		{
			var remaining = Math.Max( 0, (int)MathF.Ceiling( player.AbandonEndsAt - Time.Now ) );
			return $"Disconnected - {remaining}s to rejoin";
		}

		if ( player.IsHost && player.IsLocal )
			return "You - Host";

		if ( player.IsHost )
			return "Host";

		return player.IsLocal ? "You" : "Connected";
	}

	private static string GetReadyLabel( LobbyPlayer player )
	{
		return player.IsReady ? "Ready" : "Not Ready";
	}

