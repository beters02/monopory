	private string GetSeatAssignmentDetail( GameSavePlayerState savedPlayer )
	{
		var assignment = GetSeatAssignment( savedPlayer.SeatIndex );
		if ( assignment is null )
			return "No assignment";

		if ( assignment.KeepDisconnected )
			return "Missing player will start disconnected.";

		var assignedName = string.IsNullOrWhiteSpace( assignment.AssignedPlayerName ) ? savedPlayer.PlayerName : assignment.AssignedPlayerName;
		if ( assignment.AssignedOwnerId == savedPlayer.OwnerId )
			return $"Matched to {assignedName}.";

		return $"Substituted with {assignedName}.";
	}

	private IEnumerable<LobbyPlayer> GetAssignablePlayersForSeat( int seatIndex )
	{
		var usedOwnerIds = LoadSeatAssignments
			.Where( assignment => assignment.SeatIndex != seatIndex && !assignment.KeepDisconnected )
			.Select( assignment => assignment.AssignedOwnerId )
			.ToHashSet();

		return Players
			.Where( player => player.IsConnected )
			.Where( player => !usedOwnerIds.Contains( player.OwnerId ) )
			.OrderByDescending( player => IsSeatAssignedToPlayer( seatIndex, player.OwnerId ) )
			.ThenBy( player => player.Name );
	}

	private string GetKeepDisconnectedButtonClasses( GameSavePlayerState savedPlayer )
	{
		return GetSeatAssignment( savedPlayer.SeatIndex )?.KeepDisconnected == true
			? "options-panel-primary-button"
			: "options-panel-secondary-button";
	}

	private string GetAssignPlayerButtonClasses( int seatIndex, long ownerId )
	{
		return IsSeatAssignedToPlayer( seatIndex, ownerId )
			? "options-panel-primary-button"
			: "options-panel-secondary-button";
	}

	private bool IsSeatAssignedToPlayer( int seatIndex, long ownerId )
	{
		var assignment = GetSeatAssignment( seatIndex );
		return assignment is not null && !assignment.KeepDisconnected && assignment.AssignedOwnerId == ownerId;
	}

	private LoadedSeatAssignment GetSeatAssignment( int seatIndex )
	{
		return LoadSeatAssignments.FirstOrDefault( assignment => assignment.SeatIndex == seatIndex );
	}

	private void KeepSeatDisconnected( int seatIndex )
	{
		var savedPlayer = SelectedSaveFile?.Snapshot?.Players?.FirstOrDefault( player => player.SeatIndex == seatIndex );
		if ( savedPlayer is null )
			return;

		SetSeatAssignment( new LoadedSeatAssignment
		{
			SeatIndex = seatIndex,
			AssignedOwnerId = savedPlayer.OwnerId,
			AssignedPlayerName = savedPlayer.PlayerName,
			KeepDisconnected = true
		} );
	}

	private void AssignSeatToPlayer( int seatIndex, LobbyPlayer player )
	{
		if ( player is null )
			return;

		SetSeatAssignment( new LoadedSeatAssignment
		{
			SeatIndex = seatIndex,
			AssignedOwnerId = player.OwnerId,
			AssignedPlayerName = player.Name,
			KeepDisconnected = false
		} );
	}

	private void SetSeatAssignment( LoadedSeatAssignment assignment )
	{
		LoadSeatAssignments.RemoveAll( existing => existing.SeatIndex == assignment.SeatIndex );
		LoadSeatAssignments.Add( assignment );
		LoadSeatAssignments = LoadSeatAssignments.OrderBy( item => item.SeatIndex ).ToList();
		saveRevision++;
	}

