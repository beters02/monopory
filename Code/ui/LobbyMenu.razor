	private void ConfirmDeleteSave( GameSaveSummary save )
	{
		if ( save is null || string.IsNullOrWhiteSpace( save.SaveId ) )
			return;

		if ( PopupGame is null )
		{
			DeleteSave( save.SaveId );
			return;
		}

		PopupGame.ShowLocalConfirmation(
			"Delete save?",
			$"Delete {save.DisplayName}? This cannot be undone.",
			() => DeleteSave( save.SaveId ),
			null,
			"Delete",
			"Cancel",
			false );
	}

	private void DeleteSave( string saveId )
	{
		if ( string.IsNullOrWhiteSpace( saveId ) )
			return;

		if ( GameSaveService.DeleteSave( saveId ) )
		{
			if ( string.Equals( SelectedSaveId, saveId, StringComparison.Ordinal ) )
			{
				SelectedSaveId = "";
				SelectedSaveFile = null;
				LoadSeatAssignments.Clear();
				IsLoadSeatMenuOpen = false;
			}

			RefreshSaves();
			ShowLocalPopup( "Save deleted", "The save file has been deleted.", PopupKind.Success, true, 3f, false );
		}
		else
		{
			ShowLocalPopup( "Could not delete", "That save file could not be deleted.", PopupKind.Warning, true, 4f, false );
		}
	}

