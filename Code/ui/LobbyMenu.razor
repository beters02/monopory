@using Sandbox;
@using Sandbox.UI;
@using Sandbox.ui.components;
@using Sandbox.ui.components.buttons;
@using System;
@inherits PanelComponent

<root class="monopoly-flow-ui">
	<ButtonPopLayer></ButtonPopLayer>
	<PopupStack Popups="@PopupList" OnDismiss="@DismissPopup" OnConfirmDecision="@HandleConfirmationDecision"></PopupStack>
	<div class="flow-screen lobby-screen">
		<OptionsMenu IsOpen="@IsOptionsMenuOpen" OnClose="@CloseOptionsMenu"></OptionsMenu>
		@if ( IsConfigMenuOpen && EditableConfig is not null )
		{
			<div class="match-config-root open">
				<div class="match-config-screen">
					<div class="match-config-panel">
						<div class="match-config-header">
							<div class="match-config-header-text">
								<div class="match-config-kicker">Lobby</div>
								<div class="match-config-title">Game Configuration</div>
							</div>
							<CloseButton Variant="match-config-close-button" Title="Close" OnClick="@CloseConfigMenu"></CloseButton>
						</div>

						<div class="match-config-scroll-shell">
							<div class="match-config-scroll monopory-scroll-y" @ref="MatchConfigScrollPanel">
								<div class="match-config-copy">@ConfigMenuCopy</div>

							@foreach ( var group in ConfigGroups )
							{
								<div class="match-config-section">
									<div class="match-config-section-title">@group</div>
									<div class="match-config-section-options">

								@foreach ( var option in GetConfigOptionsForGroup( group ).Reverse() )
									{
										<div class="match-config-row">
											<div class="match-config-text">
												<div class="match-config-name">@GetConfigOptionTitle( option )</div>
												<div class="match-config-value">@option.Description</div>
											</div>
											<div class="match-config-control">
												@if ( option.Kind == MatchConfigOptionKind.Bool )
												{
													<GameButton Variant="@GetConfigToggleButtonClasses( GetConfigBoolValue( option ) )"
														CanClick="@CanEditConfig"
														BlockedPopupTitle="Host only"
														BlockedPopupMessage="Only the host can change lobby game settings."
														OnClick="@(() => ToggleConfigBoolValue( option ))">
														@(GetConfigBoolValue( option ) ? "On" : "Off")
													</GameButton>
												}
												else if ( option.Kind == MatchConfigOptionKind.Enum )
												{
													@if ( CanEditConfig )
													{
														<DropdownButton Value="@GetConfigEnumValue( option )" Items="@option.EnumNames" ScrollTarget="@MatchConfigScrollPanel" OnSelected="@((string value) => SetConfigEnumValue( option, value ))"></DropdownButton>
													}
													else
													{
														<div class="match-config-readonly-value">@GetConfigFormattedValue( option )</div>
													}
												}
												else if ( option.Kind == MatchConfigOptionKind.Int )
												{
													<div class="match-config-stepper">
														<GameButton Variant="match-config-step-button"
															CanClick="@CanEditConfig"
															BlockedPopupTitle="Host only"
															BlockedPopupMessage="Only the host can change lobby game settings."
															OnClick="@(() => ChangeConfigIntValue( option, -option.Step ))">-</GameButton>
														@if ( CanEditConfig )
														{
															<TextEntry class="match-config-stepper-input"
																Text="@GetConfigIntTextValue( option )"
																Placeholder="0"
																OnTextEdited="@((string value) => SetConfigIntDraftValue( option, value ))"
																onsubmit="@(() => CommitConfigIntDraftValue( option ))" />
														}
														else
														{
															<div class="match-config-stepper-value">@GetConfigIntValue( option )</div>
														}
														<GameButton Variant="match-config-step-button"
															CanClick="@CanEditConfig"
															BlockedPopupTitle="Host only"
															BlockedPopupMessage="Only the host can change lobby game settings."
															OnClick="@(() => ChangeConfigIntValue( option, option.Step ))">+</GameButton>
													</div>
												}
											</div>
										</div>
									}
									</div>
								</div>
							}
							</div>
							<MonoScrollbar Target="@MatchConfigScrollPanel"></MonoScrollbar>
						</div>

						<div class="match-config-footer">
							@if ( CanEditConfig )
							{
								<GameButton Variant="match-config-secondary-button" OnClick="@ResetConfigMenu">Reset to Defaults</GameButton>
								<GameButton Variant="match-config-save-button" OnClick="@SaveConfigMenu">Save</GameButton>
							}
						</div>
					</div>
				</div>
			</div>
		}
		@if ( IsLoadMenuOpen )
		{
			<div class="match-config-root open">
				<div class="match-config-screen">
					@if ( IsLoadSeatMenuOpen )
					{
						<div class="load-seat-popup-panel">
							<div class="match-config-header">
								<div class="match-config-header-text">
									<div class="match-config-kicker">Load Game</div>
									<div class="match-config-title">Saved Seats</div>
								</div>
								<CloseButton Variant="match-config-close-button" Title="Close" OnClick="@CloseLoadSeatMenu"></CloseButton>
							</div>

							<div class="match-config-copy">Choose who should sit in each saved player seat before staging this save in the lobby.</div>

							<div class="load-seat-scroll monopory-scroll-y">
								@if ( SelectedSaveFile?.Snapshot?.Players is null || SelectedSaveFile.Snapshot.Players.Count == 0 )
								{
									<div class="match-config-section">
										<div class="match-config-section-title">No Saved Seats</div>
										<div class="match-config-value">This save has no saved player seats.</div>
									</div>
								}
								else
								{
									@foreach ( var savedPlayer in SelectedSaveFile.Snapshot.Players.Where( player => player.OwnerId != 0 ).OrderBy( player => player.SeatIndex ) )
									{
										<div class="saved-seat-card">
											<div class="saved-seat-main">
												<div class="saved-seat-title">@savedPlayer.PlayerName</div>
												<div class="saved-seat-detail">@GetSeatAssignmentDetail( savedPlayer )</div>
											</div>
											<div class="saved-seat-actions">
												<GameButton Variant="@GetKeepDisconnectedButtonClasses( savedPlayer )" OnClick="@(() => KeepSeatDisconnected( savedPlayer.SeatIndex ))">Keep Disconnected</GameButton>
												@foreach ( var player in GetAssignablePlayersForSeat( savedPlayer.SeatIndex ) )
												{
													<GameButton Variant="@GetAssignPlayerButtonClasses( savedPlayer.SeatIndex, player.OwnerId )" OnClick="@(() => AssignSeatToPlayer( savedPlayer.SeatIndex, player ))">@player.Name</GameButton>
												}
											</div>
										</div>
									}
								}
							</div>

							<div class="match-config-footer">
								<GameButton Variant="match-config-secondary-button" OnClick="@CloseLoadSeatMenu">Cancel</GameButton>
								<GameButton Variant="match-config-save-button" OnClick="@ConfirmLoadSelectedSaveFinal">Continue</GameButton>
							</div>
						</div>
					}
					else
					{
						<div class="match-config-panel">
							<div class="match-config-header">
								<div class="match-config-header-text">
									<div class="match-config-kicker">Lobby</div>
									<div class="match-config-title">Load Game</div>
								</div>
								<CloseButton Variant="match-config-close-button" Title="Close" OnClick="@CloseLoadMenu"></CloseButton>
							</div>

							<div class="match-config-scroll-shell">
								<div class="match-config-scroll monopory-scroll-y" @ref="LoadGameScrollPanel">
									<div class="match-config-copy">Manual saves are stable restore points. Autosaves are stored separately and never overwrite a manual save.</div>
									<div class="match-config-section">
										<div class="match-config-section-title">Save Type</div>
										<div class="match-config-section-options">
											<div class="match-config-row">
												<div class="match-config-text">
													<div class="match-config-name">@ActiveSaveTabTitle</div>
													<div class="match-config-value">@ActiveSaveTabDescription</div>
												</div>
												<div class="match-config-control">
													<GameButton Variant="@GetSaveTabButtonClasses( true )" OnClick="@(() => SetSaveTab( true ))">Manual Saves</GameButton>
													<GameButton Variant="@GetSaveTabButtonClasses( false )" OnClick="@(() => SetSaveTab( false ))">Autosaves</GameButton>
												</div>
											</div>
										</div>
									</div>
									@if ( SaveSummaries.Count == 0 )
									{
										<div class="match-config-section">
											<div class="match-config-section-title">No @ActiveSaveTabTitle Found</div>
											<div class="match-config-value">@EmptySaveTabMessage</div>
										</div>
									}
									else
									{
										@foreach ( var save in SaveSummaries )
										{
											<div class="@GetSaveRowClasses( save )">
												<div class="save-card-main">
													<div class="save-card-header">
														<div class="save-card-title">@save.DisplayName</div>
														@if ( save.IsLastLoadedRestorePoint )
														{
															<div class="save-card-badge">Last Loaded Restore Point</div>
														}
													</div>
													<div class="save-card-grid">
														<div class="save-card-field">
															<div class="save-card-label">Game Identifier</div>
															<div class="save-card-value">@GetSaveGameIdentifier( save )</div>
														</div>
														<div class="save-card-field">
															<div class="save-card-label">Updated</div>
															<div class="save-card-value">@GetSaveUpdatedAt( save )</div>
														</div>
														<div class="save-card-field">
															<div class="save-card-label">Turn</div>
															<div class="save-card-value">@GetSaveTurnSummary( save )</div>
														</div>
														<div class="save-card-field">
															<div class="save-card-label">Players</div>
															<div class="save-card-value">@GetSavePlayers( save )</div>
														</div>
													</div>
												</div>
												<div class="save-card-actions">
													<GameButton Variant="@GetSaveSelectButtonClasses( save )" OnClick="@(() => ToggleSaveSelection( save.SaveId ))">
														@(IsSaveSelected( save ) ? "Selected" : "Select")
													</GameButton>
													<GameButton Variant="match-config-danger-button save-card-delete-button" OnClick="@(() => ConfirmDeleteSave( save ))">Delete</GameButton>
												</div>
											</div>
										}
									}
								</div>
								<MonoScrollbar Target="@LoadGameScrollPanel"></MonoScrollbar>
							</div>

							<div class="match-config-footer">
								@if ( CanEditConfig )
								{
									<GameButton Variant="match-config-secondary-button" OnClick="@RefreshSaves">Refresh</GameButton>
									<GameButton Variant="match-config-save-button" CanClick="@CanLoadSelectedSave" OnClick="@ConfirmLoadSelectedSave" BlockedPopupTitle="No save selected" BlockedPopupMessage="Choose a save before loading.">Load Selected</GameButton>
								}
							</div>
						</div>
					}
				</div>
			</div>
		}
		@if ( IsCustomizeMenuOpen )
		{
			<div class="piece-customize-root open">
				<div class="piece-customize-screen">
					<div class="piece-customize-panel">
						<div class="piece-customize-header">
							<div class="piece-customize-header-text">
								<div class="match-config-kicker">Lobby</div>
								<div class="piece-customize-title">Customize Piece</div>
							</div>
							<CloseButton Variant="match-config-close-button" Title="Close" OnClick="@CloseCustomizeMenu"></CloseButton>
						</div>
						<div class="piece-customize-scroll-shell">
							<div class="piece-customize-grid monopory-scroll-y" @ref="PieceCustomizeScrollPanel">
								@foreach ( var piece in AvailablePieces )
								{
									<div class="@GetPieceCardClasses( piece )">
										<div class="piece-customize-card-title">@piece.Label</div>
										<div class="piece-customize-card-copy">@piece.Description</div>
										<GameButton Variant="@GetPieceSelectButtonClasses( piece )" OnClick="@(() => SelectPiece( piece.Id ))">
											@(IsSelectedPiece( piece ) ? "Selected" : "Select")
										</GameButton>
									</div>
								}
							</div>
							<MonoScrollbar Target="@PieceCustomizeScrollPanel"></MonoScrollbar>
						</div>
						<div class="piece-customize-footer">
							<GameButton Variant="match-config-secondary-button" OnClick="@CloseCustomizeMenu">Done</GameButton>
						</div>
					</div>
				</div>
			</div>
		}
		<GameButton Variant="flow-settings-button" Title="Options" OnClick="@OpenOptionsMenu">
			<ChildContent>
				<div class="flow-settings-icon"></div>
			</ChildContent>
		</GameButton>
		<div class="flow-version-label">Version @GameVersion</div>
		<div class="flow-panel lobby-panel">
			<div class="flow-kicker">Lobby</div>
			<div class="flow-title">Players</div>

			@if ( Lobby is null )
			{
				<div class="flow-copy">Lobby controller missing.</div>
			}
			else
			{
				<div class="lobby-list">
					@foreach ( var player in Players )
					{
						<div class="@GetPlayerClasses( player )">
							<div>
								<div class="lobby-player-name">@player.Name</div>
								<div class="lobby-player-detail">@GetPlayerDetail( player )</div>
							</div>
							<div class="lobby-ready-pill">@GetReadyLabel( player )</div>
						</div>
					}
				</div>

				<div class="flow-copy">@LobbyStatusText</div>
				<div class="flow-actions">
					<div class="lobby-action-row lobby-action-row-top">
						<GameButton Variant="@ReadyButtonClasses" OnClick="@ToggleReady">@ReadyButtonLabel</GameButton>
						<GameButton Variant="@StartButtonClasses" CanClick="@CanClickStartGame" OnClick="@StartGame" BlockedPopupTitle="Cannot start game" BlockedPopupMessage="@StartBlockedMessage">@StartButtonLabel</GameButton>
						<GameButton Variant="flow-secondary-button flow-utility-button" OnClick="@CustomizePiece">Customize</GameButton>
					</div>
					<div class="lobby-action-row lobby-action-row-bottom">
						<GameButton Variant="flow-secondary-button flow-back-button" OnClick="@BackToMenu">@BackButtonLabel</GameButton>
						<GameButton Variant="flow-secondary-button flow-utility-button" OnClick="@InviteFriends">Invite</GameButton>
						<GameButton Variant="flow-secondary-button flow-utility-button" CanClick="@CanEditConfig" OnClick="@OpenLoadMenu" BlockedPopupTitle="Host only" BlockedPopupMessage="Only the host can load saved games.">Load Game</GameButton>
						<GameButton Variant="@ConfigButtonClasses" CanClick="@CanOpenConfig" OnClick="@OpenConfigMenu" BlockedPopupTitle="Host only" BlockedPopupMessage="Only the host can change lobby game settings.">Match Settings</GameButton>
					</div>
				</div>
			}
		</div>
	</div>
</root>

@code
{
	[Property] public LobbyController LobbyRef { get; set; }

	private LobbyController Lobby => LobbyRef;
	private GameController PopupGame => GameController.Instance;
	private List<LobbyPlayer> Players => Lobby?.Players ?? new();
	private List<GamePopup> PopupList => PopupGame?.Popups.ToList() ?? new();
	private LobbyPlayer LocalPlayer => Lobby?.LocalPlayer;
	private bool CanClickStartGame => Lobby?.CanLocalPlayerStartGame == true;
	private bool IsOptionsMenuOpen;
	private bool IsConfigMenuOpen;
	private bool IsCustomizeMenuOpen;
	private bool IsLoadMenuOpen;
	private bool IsLoadSeatMenuOpen;
	private Panel MatchConfigScrollPanel = null!;
	private Panel PieceCustomizeScrollPanel = null!;
	private Panel LoadGameScrollPanel = null!;
	private bool CanOpenConfig => Lobby is not null;
	private string GameVersion => MonopolyApp.GameVersion;
	private bool CanEditConfig => Lobby?.IsLocalEffectiveHost == true;
	private IReadOnlyList<PieceDefinition> AvailablePieces => PieceCatalog.All;
	private MatchConfig EditableConfig;
	private string LoadedConfigSnapshot = "";
	private int configRevision;
	private int saveRevision;
	private string SelectedSaveId = "";
	private List<GameSaveSummary> SaveSummaries = new();
	private GameSaveFile SelectedSaveFile;
	private List<LoadedSeatAssignment> LoadSeatAssignments = new();
	private bool IsManualSaveTab = true;
	private readonly Dictionary<string, string> ConfigIntDrafts = new();
	private IReadOnlyList<string> ConfigGroups => MatchConfigSchema.Options.Where( option => option.IsVisible ).Select( option => option.Group ).Distinct().ToList();

	protected override void OnUpdate()
	{
		base.OnUpdate();
		Mouse.Visibility = MouseVisibility.Visible;

		if ( IsConfigMenuOpen )
			EnsureEditableConfigCurrent();
	}

	private string LobbyStatusText
	{
		get
		{
			if ( Lobby is null )
				return "Lobby controller missing.";

			if ( Lobby.HasStagedLoadedGame )
			{
				var gameId = string.IsNullOrWhiteSpace( Lobby.StagedLoadedGameIdentifier ) ? "" : $" ({Lobby.StagedLoadedGameIdentifier})";
				return $"Loaded save staged: {Lobby.StagedLoadedSaveName}{gameId}. Ready up, then start loaded game.";
			}

			if ( Players.Count < Lobby.MinPlayers )
				return $"Waiting for {Lobby.MinPlayers - Players.Count} more player(s).";

			if ( HasUnreadyPlayers )
				return "Waiting for everyone to ready up.";

			if ( Lobby.OnlyHostStartsGame && !Networking.IsHost )
				return "Waiting for the host to start.";

			return "Ready to start.";
		}
	}

	private string ReadyButtonLabel => LocalPlayer?.IsReady == true ? "Unready" : "Ready";
	private string StartButtonLabel => Lobby?.HasStagedLoadedGame == true ? "Start Loaded Game" : "Start Game";
	private string ReadyButtonClasses => LocalPlayer?.IsReady == true ? "flow-secondary-button ready" : "flow-primary-button";
	private string StartButtonClasses => CanClickStartGame ? "flow-primary-button" : "flow-primary-button blocked-action-button";
	private string ConfigButtonClasses => "flow-secondary-button flow-utility-button flow-config-button";
	private string BackButtonLabel => Lobby?.IsLocalEffectiveHost == true ? "Back" : "Leave";
	private string ConfigMenuCopy => CanEditConfig
		? "Changes stay local to the host until you press Save."
		: "Viewing current host settings. Only the host can change or save configuration.";
	private string StartBlockedMessage => Lobby?.OnlyHostStartsGame == true && Lobby?.IsLocalEffectiveHost != true
		? "Only the host can start this game."
		: LobbyStatusText;
	private bool HasOtherLobbyPlayers => Players.Any( player => !player.IsLocal );
	private bool HasUnsavedConfigChanges =>
		EditableConfig is not null &&
		CanEditConfig &&
		(ConfigIntDrafts.Count > 0 || !string.Equals( MatchConfigSchema.Serialize( EditableConfig ), LoadedConfigSnapshot, StringComparison.Ordinal ));

	private bool HasUnreadyPlayers
	{
		get
		{
			for ( var i = 0; i < Players.Count; i++ )
			{
				if ( !Players[i].IsReady )
					return true;
			}

			return false;
		}
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( Lobby is not null );
		hash.Add( CanClickStartGame );
		hash.Add( LobbyStatusText );
		hash.Add( Lobby?.OnlyHostStartsGame ?? false );
		hash.Add( Lobby?.IsLocalEffectiveHost ?? false );
		hash.Add( IsOptionsMenuOpen );
		hash.Add( IsConfigMenuOpen );
		hash.Add( IsCustomizeMenuOpen );
		hash.Add( IsLoadMenuOpen );
		hash.Add( IsLoadSeatMenuOpen );
		hash.Add( Lobby?.HostedConfigSnapshot ?? "" );
		hash.Add( Lobby?.StagedLoadedSaveName ?? "" );
		hash.Add( Lobby?.StagedLoadedGameIdentifier ?? "" );
		hash.Add( configRevision );
		hash.Add( saveRevision );
		hash.Add( SelectedSaveId ?? "" );
		hash.Add( IsManualSaveTab );
		hash.Add( AppSettings.SettingsAvailable );
		hash.Add( AppSettings.GetFullscreenMode() );
		hash.Add( AppSettings.GetVSyncEnabled() );
		hash.Add( AppSettings.GetMotionBlurEnabled() );
		hash.Add( AppSettings.GetUpscaler() );
		hash.Add( AppSettings.GetFsr3Quality() );
		hash.Add( GetPopupsHash() );

		foreach ( var player in Players )
		{
			hash.Add( player.OwnerId );
			hash.Add( player.Name );
			hash.Add( player.IsReady );
			hash.Add( player.IsConnected );
			hash.Add( player.IsHost );
			hash.Add( player.AbandonEndsAt );
			hash.Add( player.SelectedPieceId ?? "" );
		}

		foreach ( var save in SaveSummaries )
		{
			hash.Add( save.SaveId );
			hash.Add( save.DisplayName );
			hash.Add( save.SaveType );
			hash.Add( save.UpdatedAtUtc );
			hash.Add( save.IsLastLoadedRestorePoint );
		}

		hash.Add( SelectedSaveFile?.Summary?.SaveId ?? "" );
		foreach ( var assignment in LoadSeatAssignments )
		{
			hash.Add( assignment.SeatIndex );
			hash.Add( assignment.AssignedOwnerId );
			hash.Add( assignment.AssignedPlayerName );
			hash.Add( assignment.KeepDisconnected );
		}

		if ( EditableConfig is not null )
		{
			foreach ( var option in MatchConfigSchema.Options )
			{
				hash.Add( MatchConfigSchema.FormatValue( option, MatchConfigSchema.GetOptionValue( option, EditableConfig ) ) );
				hash.Add( ConfigIntDrafts.TryGetValue( option.Key, out var draft ) ? draft : "" );
			}
		}

		return hash.ToHashCode();
	}

	private void ToggleReady()
	{
		if ( Lobby is null || LocalPlayer is null )
			return;

		if ( Networking.IsHost )
			Lobby.TrySetReady( LocalPlayer.OwnerId, !LocalPlayer.IsReady );
		else
			Lobby.RequestSetReady( !LocalPlayer.IsReady );
	}

	private void StartGame()
	{
		if ( Lobby is null )
			return;

		if ( !CanClickStartGame )
		{
			ShowLocalPopup( "Cannot start game", StartBlockedMessage, PopupKind.Warning, true, 3f, false );
			return;
		}

		if ( Networking.IsHost )
			Lobby.TryStartGame();
		else
			Lobby.RequestStartGame();
	}

	private void BackToMenu()
	{
		if ( Lobby is null )
			return;

		if ( Lobby?.IsLocalEffectiveHost == false || Lobby?.IsLocalEffectiveHost == null )
		{
			ConfirmLeaveLobby();
			return;
		}

		if ( HasOtherLobbyPlayers )
		{
			if ( PopupGame is null )
			{
				RequestBackToMenu();
				return;
			}

			PopupGame.ShowLocalConfirmation(
				"Return to menu?",
				"This will send everyone in the lobby back to the main menu.",
				RequestBackToMenu,
				null,
				"Return",
				"Stay",
				false );
			return;
		}

		RequestBackToMenu();
	}

	private void RequestBackToMenu()
	{
		if ( Lobby is null )
			return;

		Lobby.RequestBackToMenu();
	}

	private void ConfirmLeaveLobby()
	{
		if ( PopupGame is null )
		{
			LeaveLobby();
			return;
		}

		PopupGame.ShowLocalConfirmation(
			"Leave lobby?",
			"You will leave this lobby and return to the main menu.",
			LeaveLobby,
			null,
			"Leave",
			"Stay",
			false );
	}

	private void LeaveLobby()
	{
		NetworkSession.ForceDisconnectToMenu( Scene );
	}

	private void InviteFriends()
	{
		Lobby?.TryOpenInviteOverlay();
	}

	private void CustomizePiece()
	{
		IsCustomizeMenuOpen = true;
		IsConfigMenuOpen = false;
		IsOptionsMenuOpen = false;
		IsLoadMenuOpen = false;
		IsLoadSeatMenuOpen = false;
	}

	private void CloseCustomizeMenu()
	{
		IsCustomizeMenuOpen = false;
	}

	private bool IsSelectedPiece( PieceDefinition piece )
	{
		if ( piece is null )
			return false;

		var selectedPieceId = LocalPlayer?.SelectedPieceId ?? PieceCatalog.DefaultPieceId;
		return string.Equals( selectedPieceId, piece.Id, StringComparison.OrdinalIgnoreCase );
	}

	private string GetPieceCardClasses( PieceDefinition piece )
	{
		return IsSelectedPiece( piece ) ? "piece-customize-card selected" : "piece-customize-card";
	}

	private string GetPieceSelectButtonClasses( PieceDefinition piece )
	{
		return IsSelectedPiece( piece ) ? "match-config-save-button" : "match-config-secondary-button";
	}

	private void SelectPiece( string pieceId )
	{
		if ( Lobby is null || LocalPlayer is null )
			return;

		if ( Networking.IsHost )
			Lobby.TrySetSelectedPiece( LocalPlayer.OwnerId, pieceId );
		else
			Lobby.RequestSetSelectedPiece( pieceId );
	}

	private void OpenOptionsMenu()
	{
		IsOptionsMenuOpen = true;
		IsConfigMenuOpen = false;
		IsCustomizeMenuOpen = false;
		IsLoadMenuOpen = false;
		IsLoadSeatMenuOpen = false;
	}

	private void CloseOptionsMenu()
	{
		IsOptionsMenuOpen = false;
	}

	private void OpenConfigMenu()
	{
		if ( !CanOpenConfig )
			return;

		IsConfigMenuOpen = true;
		IsOptionsMenuOpen = false;
		IsCustomizeMenuOpen = false;
		IsLoadMenuOpen = false;
		IsLoadSeatMenuOpen = false;
		EnsureEditableConfigCurrent( true );
	}

	private void OpenLoadMenu()
	{
		if ( Lobby is null || !CanEditConfig )
			return;

		IsLoadMenuOpen = true;
		IsOptionsMenuOpen = false;
		IsConfigMenuOpen = false;
		IsCustomizeMenuOpen = false;
		IsLoadSeatMenuOpen = false;
		SelectedSaveId = "";
		SelectedSaveFile = null;
		LoadSeatAssignments.Clear();
		RefreshSaves();
	}

	private void CloseLoadMenu()
	{
		IsLoadMenuOpen = false;
		IsLoadSeatMenuOpen = false;
		SelectedSaveId = "";
		SelectedSaveFile = null;
		LoadSeatAssignments.Clear();
		saveRevision++;
	}

	private void RefreshSaves()
	{
		SaveSummaries = GameSaveService.ListSaves( ActiveSaveType ).ToList();
		if ( !string.IsNullOrWhiteSpace( SelectedSaveId ) && !SaveSummaries.Any( save => string.Equals( save.SaveId, SelectedSaveId, StringComparison.Ordinal ) ) )
		{
			SelectedSaveId = "";
			IsLoadSeatMenuOpen = false;
		}

		LoadSelectedSaveMetadata();
		saveRevision++;
	}

	private GameSaveType ActiveSaveType => IsManualSaveTab ? GameSaveType.Manual : GameSaveType.Autosave;
	private string ActiveSaveTabTitle => IsManualSaveTab ? "Manual Saves" : "Autosaves";
	private string ActiveSaveTabDescription => IsManualSaveTab
		? "Saved by the host. These are safe restore points until explicitly overwritten."
		: "Automatic recovery saves grouped separately from manual saves.";
	private string EmptySaveTabMessage => IsManualSaveTab
		? "Start a game and use Save Game from the in-game menu."
		: "Autosaves appear after stable game actions when autosave is enabled.";

	private void SetSaveTab( bool manualSaves )
	{
		if ( IsManualSaveTab == manualSaves )
			return;

		IsManualSaveTab = manualSaves;
		SelectedSaveId = "";
		SelectedSaveFile = null;
		LoadSeatAssignments.Clear();
		IsLoadSeatMenuOpen = false;
		RefreshSaves();
	}

	private string GetSaveTabButtonClasses( bool manualSaves )
	{
		return IsManualSaveTab == manualSaves ? "match-config-save-button" : "match-config-secondary-button";
	}

	private bool CanLoadSelectedSave => CanEditConfig && !string.IsNullOrWhiteSpace( SelectedSaveId );

	private void ToggleSaveSelection( string saveId )
	{
		SelectedSaveId = string.Equals( SelectedSaveId, saveId, StringComparison.Ordinal ) ? "" : saveId ?? "";
		IsLoadSeatMenuOpen = false;
		LoadSelectedSaveMetadata();
		saveRevision++;
	}

	private void LoadSelectedSaveMetadata()
	{
		SelectedSaveFile = GameSaveService.ReadSave( SelectedSaveId );
		LoadSeatAssignments = Lobby?.BuildDefaultSeatAssignments( SelectedSaveFile?.Summary ).ToList() ?? new();
	}

	private bool IsSaveSelected( GameSaveSummary save )
	{
		return string.Equals( save?.SaveId, SelectedSaveId, StringComparison.Ordinal );
	}

	private string GetSaveRowClasses( GameSaveSummary save )
	{
		var classes = IsSaveSelected( save ) ? "save-card selected" : "save-card";
		if ( save?.IsLastLoadedRestorePoint == true )
			classes += " last-loaded";
		return classes;
	}

	private string GetSaveSelectButtonClasses( GameSaveSummary save )
	{
		return IsSaveSelected( save ) ? "match-config-save-button save-card-select-button" : "match-config-secondary-button save-card-select-button";
	}

	private void ConfirmDeleteSave( GameSaveSummary save )
	{
		if ( save is null || string.IsNullOrWhiteSpace( save.SaveId ) )
			return;

		if ( PopupGame is null )
		{
			DeleteSave( save.SaveId );
			return;
		}

		PopupGame.ShowLocalConfirmation(
			"Delete save?",
			$"Delete {save.DisplayName}? This cannot be undone.",
			() => DeleteSave( save.SaveId ),
			null,
			"Delete",
			"Cancel",
			false );
	}

	private void DeleteSave( string saveId )
	{
		if ( string.IsNullOrWhiteSpace( saveId ) )
			return;

		if ( GameSaveService.DeleteSave( saveId ) )
		{
			if ( string.Equals( SelectedSaveId, saveId, StringComparison.Ordinal ) )
			{
				SelectedSaveId = "";
				SelectedSaveFile = null;
				LoadSeatAssignments.Clear();
				IsLoadSeatMenuOpen = false;
			}

			RefreshSaves();
			ShowLocalPopup( "Save deleted", "The save file has been deleted.", PopupKind.Success, true, 3f, false );
		}
		else
		{
			ShowLocalPopup( "Could not delete", "That save file could not be deleted.", PopupKind.Warning, true, 4f, false );
		}
	}

	private static string GetSaveGameIdentifier( GameSaveSummary save )
	{
		return string.IsNullOrWhiteSpace( save?.GameIdentifier ) ? "Unknown game" : save.GameIdentifier;
	}

	private static string GetSaveUpdatedAt( GameSaveSummary save )
	{
		return DateTimeOffset.TryParse( save?.UpdatedAtUtc, out var parsed )
			? parsed.ToLocalTime().ToString( "g" )
			: "Unknown time";
	}

	private static string GetSaveTurnSummary( GameSaveSummary save )
	{
		return string.IsNullOrWhiteSpace( save?.TurnSummary ) ? "No turn summary" : save.TurnSummary;
	}

	private static string GetSavePlayers( GameSaveSummary save )
	{
		if ( save?.PlayerNames is null || save.PlayerNames.Count == 0 )
			return "No saved players";

		return string.Join( ", ", save.PlayerNames );
	}

	private string GetSeatAssignmentDetail( GameSavePlayerState savedPlayer )
	{
		var assignment = GetSeatAssignment( savedPlayer.SeatIndex );
		if ( assignment is null )
			return "No assignment";

		if ( assignment.KeepDisconnected )
			return "Missing player will start disconnected.";

		var assignedName = string.IsNullOrWhiteSpace( assignment.AssignedPlayerName ) ? savedPlayer.PlayerName : assignment.AssignedPlayerName;
		if ( assignment.AssignedOwnerId == savedPlayer.OwnerId )
			return $"Matched to {assignedName}.";

		return $"Substituted with {assignedName}.";
	}

	private IEnumerable<LobbyPlayer> GetAssignablePlayersForSeat( int seatIndex )
	{
		var usedOwnerIds = LoadSeatAssignments
			.Where( assignment => assignment.SeatIndex != seatIndex && !assignment.KeepDisconnected )
			.Select( assignment => assignment.AssignedOwnerId )
			.ToHashSet();

		return Players
			.Where( player => player.IsConnected )
			.Where( player => !usedOwnerIds.Contains( player.OwnerId ) )
			.OrderByDescending( player => IsSeatAssignedToPlayer( seatIndex, player.OwnerId ) )
			.ThenBy( player => player.Name );
	}

	private string GetKeepDisconnectedButtonClasses( GameSavePlayerState savedPlayer )
	{
		return GetSeatAssignment( savedPlayer.SeatIndex )?.KeepDisconnected == true
			? "match-config-save-button"
			: "match-config-secondary-button";
	}

	private string GetAssignPlayerButtonClasses( int seatIndex, long ownerId )
	{
		return IsSeatAssignedToPlayer( seatIndex, ownerId )
			? "match-config-save-button"
			: "match-config-secondary-button";
	}

	private bool IsSeatAssignedToPlayer( int seatIndex, long ownerId )
	{
		var assignment = GetSeatAssignment( seatIndex );
		return assignment is not null && !assignment.KeepDisconnected && assignment.AssignedOwnerId == ownerId;
	}

	private LoadedSeatAssignment GetSeatAssignment( int seatIndex )
	{
		return LoadSeatAssignments.FirstOrDefault( assignment => assignment.SeatIndex == seatIndex );
	}

	private void KeepSeatDisconnected( int seatIndex )
	{
		var savedPlayer = SelectedSaveFile?.Snapshot?.Players?.FirstOrDefault( player => player.SeatIndex == seatIndex );
		if ( savedPlayer is null )
			return;

		SetSeatAssignment( new LoadedSeatAssignment
		{
			SeatIndex = seatIndex,
			AssignedOwnerId = savedPlayer.OwnerId,
			AssignedPlayerName = savedPlayer.PlayerName,
			KeepDisconnected = true
		} );
	}

	private void AssignSeatToPlayer( int seatIndex, LobbyPlayer player )
	{
		if ( player is null )
			return;

		SetSeatAssignment( new LoadedSeatAssignment
		{
			SeatIndex = seatIndex,
			AssignedOwnerId = player.OwnerId,
			AssignedPlayerName = player.Name,
			KeepDisconnected = false
		} );
	}

	private void SetSeatAssignment( LoadedSeatAssignment assignment )
	{
		LoadSeatAssignments.RemoveAll( existing => existing.SeatIndex == assignment.SeatIndex );
		LoadSeatAssignments.Add( assignment );
		LoadSeatAssignments = LoadSeatAssignments.OrderBy( item => item.SeatIndex ).ToList();
		saveRevision++;
	}

	private void ConfirmLoadSelectedSave()
	{
		var save = SaveSummaries.FirstOrDefault( save => string.Equals( save.SaveId, SelectedSaveId, StringComparison.Ordinal ) );
		if ( save is null )
		{
			ShowLocalPopup( "Could not load", "Choose a save before loading.", PopupKind.Warning, true, 3f, false );
			return;
		}

		IsLoadSeatMenuOpen = true;
		saveRevision++;
	}

	private void CloseLoadSeatMenu()
	{
		IsLoadSeatMenuOpen = false;
		saveRevision++;
	}

	private void ConfirmLoadSelectedSaveFinal()
	{
		IsLoadSeatMenuOpen = false;

		var save = SaveSummaries.FirstOrDefault( save => string.Equals( save.SaveId, SelectedSaveId, StringComparison.Ordinal ) );
		if ( save is null )
			return;

		if ( PopupGame is null )
		{
			LoadSelectedSave();
			return;
		}

		PopupGame.ShowLocalConfirmation(
			"Load save into lobby?",
			$"This will stage {save.DisplayName} in the lobby. Missing saved players will stay disconnected when the game starts.",
			LoadSelectedSave,
			null,
			"Load",
			"Cancel",
			false );
	}

	private void LoadSelectedSave()
	{
		if ( Lobby is null || !CanEditConfig )
			return;

		var save = SaveSummaries.FirstOrDefault( save => string.Equals( save.SaveId, SelectedSaveId, StringComparison.Ordinal ) );
		var assignments = LoadSeatAssignments.Count > 0 ? LoadSeatAssignments.ToList() : Lobby.BuildDefaultSeatAssignments( save ).ToList();
		if ( Lobby.TryLoadSavedGame( save, assignments, out var message ) )
		{
			CloseLoadMenu();
			ShowLocalPopup( "Save staged", message, PopupKind.Success, true, 4f, false );
		}
		else
		{
			ShowLocalPopup( "Could not load", message, PopupKind.Warning, true, 4f, false );
		}
	}

	private void CloseConfigMenu()
