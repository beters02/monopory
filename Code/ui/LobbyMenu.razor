@using Sandbox;
@using Sandbox.UI;
@using Sandbox.ui.components;
@using Sandbox.ui.components.buttons;
@using System;
@inherits PanelComponent

<root class="monopoly-flow-ui">
	<ButtonPopLayer></ButtonPopLayer>
	<PopupStack Popups="@PopupList" OnDismiss="@DismissPopup" OnConfirmDecision="@HandleConfirmationDecision"></PopupStack>
	<div class="@LobbyScreenClasses">
		<OptionsMenu IsOpen="@IsOptionsMenuOpen" OnClose="@CloseOptionsMenu"></OptionsMenu>
		<OptionsPanel IsOpen="@(IsConfigMenuOpen && EditableConfig is not null)" Kicker="Lobby" Title="Game Configuration" OnClose="@CloseConfigMenu" RootVariant="lobby-options-root">
			<ChildContent>
				<OptionsPanelBody Copy="@ConfigMenuCopy">
					<ChildContent Context="scrollPanel">
						<div class="match-config-tabs">
							<GameButton Variant="@GetConfigPageButtonClasses( MatchConfigPageGameRules )" OnClick="@(() => SetConfigPage( MatchConfigPageGameRules ))">Game Rules</GameButton>
							<GameButton Variant="@GetConfigPageButtonClasses( MatchConfigPageBoardConfiguration )" OnClick="@(() => SetConfigPage( MatchConfigPageBoardConfiguration ))">Board Configuration</GameButton>
						</div>
						@if ( IsGameRulesConfigPage )
						{
							<div class="match-config-presets">
								<div class="match-config-preset-header">
									<div class="options-panel-section-title">Game Rule Presets</div>
									<div class="options-panel-row-value">Apply predefined rule sets or save your current draft as a custom preset.</div>
								</div>
								<div class="match-config-preset-actions">
									<GameButton Variant="@GetCustomGameRulesPresetButtonClasses()" OnClick="@MarkCustomPreset">Custom</GameButton>
									@foreach ( var preset in GameRulePresets )
									{
										<div class="match-config-preset-item">
											<GameButton Variant="@GetGameRulesPresetButtonClasses( preset )" OnClick="@(() => ApplyGameRulesPreset( preset ))">@preset.Name</GameButton>
											@if ( !preset.IsPredefined )
											{
												<GameButton Variant="options-panel-danger-button match-config-preset-delete" OnClick="@(() => DeleteGameRulesPreset( preset ))">Delete</GameButton>
											}
										</div>
									}
									@if ( IsGameRulesCustomSelected )
									{
										<TextEntry class="match-config-preset-name-input"
											Text="@GameRulePresetNameDraft"
											Placeholder="Preset name"
											OnTextEdited="@((string value) => SetGameRulePresetNameDraft( value ))" />
										<GameButton Variant="options-panel-primary-button match-config-preset-button" CanClick="@CanEditConfig" OnClick="@SaveGameRulesPreset" BlockedPopupTitle="Host only" BlockedPopupMessage="Only the host can save match setting presets.">Save Preset</GameButton>
									}
								</div>
							</div>
							<MatchSettingsGameRulesPage Config="@EditableConfig"
								CanEdit="@CanEditCurrentConfigPage"
								ShowHiddenOptions="@ShowHiddenMatchOptions"
								ScrollTarget="@scrollPanel"
								SectionOptionsVariant="reverse"
								ReverseOptionsInGroup="@(true)"
								IntTextValueProvider="@GetConfigIntTextValue"
								OnToggleBool="@ToggleConfigBoolValue"
								OnChangeInt="@ChangeConfigIntValue"
								OnSetIntDraft="@SetConfigIntDraftValue"
								OnCommitIntDraft="@CommitConfigIntDraftValue"
								OnSetEnum="@SetConfigEnumValue"></MatchSettingsGameRulesPage>
						}
						else
						{
							<div class="match-config-presets">
								<div class="match-config-preset-header">
									<div class="options-panel-section-title">Board Presets</div>
									<div class="options-panel-row-value">Apply predefined board names or save your current board name draft.</div>
								</div>
								<div class="match-config-preset-actions">
									<GameButton Variant="@GetCustomBoardConfigPresetButtonClasses()" OnClick="@MarkCustomPreset">Custom</GameButton>
									@foreach ( var preset in BoardConfigPresets )
									{
										<div class="match-config-preset-item">
											<GameButton Variant="@GetBoardConfigPresetButtonClasses( preset )" OnClick="@(() => ApplyBoardConfigPreset( preset ))">@preset.Name</GameButton>
											@if ( !preset.IsPredefined )
											{
												<GameButton Variant="options-panel-danger-button match-config-preset-delete" OnClick="@(() => DeleteBoardConfigPreset( preset ))">Delete</GameButton>
											}
										</div>
									}
									@if ( IsBoardConfigCustomSelected )
									{
										<TextEntry class="match-config-preset-name-input"
											Text="@BoardConfigPresetNameDraft"
											Placeholder="Preset name"
											OnTextEdited="@((string value) => SetBoardConfigPresetNameDraft( value ))" />
										<GameButton Variant="options-panel-primary-button match-config-preset-button" CanClick="@CanEditConfig" OnClick="@SaveBoardConfigPreset" BlockedPopupTitle="Host only" BlockedPopupMessage="Only the host can save board presets.">Save Preset</GameButton>
									}
								</div>
							</div>
							<MatchSettingsBoardConfigurationPage Config="@EditableConfig"
								CanEdit="@CanEditCurrentConfigPage"
								OnSetSpaceName="@SetBoardSpaceName"></MatchSettingsBoardConfigurationPage>
						}
					</ChildContent>
					<Footer>
						@if ( CanEditConfig )
						{
							<GameButton Variant="options-panel-secondary-button" CanClick="@CanEditCurrentConfigPage" ShowBlockedPopup="@(false)" SoundEnabled="@CanEditCurrentConfigPage" OnClick="@ResetConfigMenu">Reset to Defaults</GameButton>
							<GameButton Variant="options-panel-primary-button" OnClick="@SaveConfigMenu">Save</GameButton>
						}
					</Footer>
				</OptionsPanelBody>
			</ChildContent>
		</OptionsPanel>
		<OptionsPanel
			IsOpen="@(IsLoadMenuOpen && IsLoadSeatMenuOpen)"
			Kicker="Load Game"
			Title="Saved Seats"
			OnClose="@CloseLoadSeatMenu"
			RootVariant="lobby-options-root"
			PanelVariant="compact-panel load-seat-popup-panel">
			<ChildContent>
				<OptionsPanelBody Copy="Choose who should sit in each saved player seat before staging this save in the lobby.">
					<ChildContent Context="_">
								@if ( SelectedSaveFile?.Snapshot?.Players is null || SelectedSaveFile.Snapshot.Players.Count == 0 )
								{
									<div class="options-panel-section">
										<div class="options-panel-section-title">No Saved Seats</div>
										<div class="options-panel-row-value">This save has no saved player seats.</div>
									</div>
								}
								else
								{
									@foreach ( var savedPlayer in SelectedSaveFile.Snapshot.Players.Where( player => player.OwnerId != 0 ).OrderBy( player => player.SeatIndex ) )
									{
										<div class="saved-seat-card">
											<div class="saved-seat-main">
												<div class="saved-seat-title">@savedPlayer.PlayerName</div>
												<div class="saved-seat-detail">@GetSeatAssignmentDetail( savedPlayer )</div>
											</div>
											<div class="saved-seat-actions">
												<GameButton Variant="@GetKeepDisconnectedButtonClasses( savedPlayer )" OnClick="@(() => KeepSeatDisconnected( savedPlayer.SeatIndex ))">Keep Disconnected</GameButton>
												@foreach ( var player in GetAssignablePlayersForSeat( savedPlayer.SeatIndex ) )
												{
													<GameButton Variant="@GetAssignPlayerButtonClasses( savedPlayer.SeatIndex, player.OwnerId )" OnClick="@(() => AssignSeatToPlayer( savedPlayer.SeatIndex, player ))">@player.Name</GameButton>
												}
											</div>
										</div>
									}
								}
					</ChildContent>
					<Footer>
						<GameButton Variant="options-panel-secondary-button" OnClick="@CloseLoadSeatMenu">Cancel</GameButton>
						<GameButton Variant="options-panel-primary-button" OnClick="@ConfirmLoadSelectedSaveFinal">Continue</GameButton>
					</Footer>
				</OptionsPanelBody>
			</ChildContent>
		</OptionsPanel>
		<OptionsPanel
			IsOpen="@(IsLoadMenuOpen && !IsLoadSeatMenuOpen)"
			Kicker="Lobby"
			Title="Load Game"
			OnClose="@CloseLoadMenu"
			RootVariant="lobby-options-root">
			<ChildContent>
				<OptionsPanelBody Copy="Manual saves are stable restore points. Autosaves are stored separately and never overwrite a manual save.">
					<ChildContent Context="_">
									<div class="options-panel-section">
										<div class="options-panel-section-title">Save Type</div>
										<div class="options-panel-section-options">
											<OptionsPanelRow Title="@ActiveSaveTabTitle" Value="@ActiveSaveTabDescription">
												<ChildContent>
													<GameButton Variant="@GetSaveTabButtonClasses( true )" OnClick="@(() => SetSaveTab( true ))">Manual Saves</GameButton>
													<GameButton Variant="@GetSaveTabButtonClasses( false )" OnClick="@(() => SetSaveTab( false ))">Autosaves</GameButton>
												</ChildContent>
											</OptionsPanelRow>
										</div>
									</div>
									@if ( SaveSummaries.Count == 0 )
									{
										<div class="options-panel-section">
											<div class="options-panel-section-title">No @ActiveSaveTabTitle Found</div>
											<div class="options-panel-row-value">@EmptySaveTabMessage</div>
										</div>
									}
									else
									{
										@foreach ( var save in SaveSummaries )
										{
											<div class="@GetSaveRowClasses( save )">
												<div class="save-card-main">
													<div class="save-card-header">
														<div class="save-card-title">@save.DisplayName</div>
														@if ( save.IsLastLoadedRestorePoint )
														{
															<div class="save-card-badge">Last Loaded Restore Point</div>
														}
													</div>
													<div class="save-card-grid">
														<div class="save-card-field">
															<div class="save-card-label">Game Identifier</div>
															<div class="save-card-value">@GetSaveGameIdentifier( save )</div>
														</div>
														<div class="save-card-field">
															<div class="save-card-label">Updated</div>
															<div class="save-card-value">@GetSaveUpdatedAt( save )</div>
														</div>
														<div class="save-card-field">
															<div class="save-card-label">Turn</div>
															<div class="save-card-value">@GetSaveTurnSummary( save )</div>
														</div>
														<div class="save-card-field">
															<div class="save-card-label">Players</div>
															<div class="save-card-value">@GetSavePlayers( save )</div>
														</div>
													</div>
												</div>
												<div class="save-card-actions">
													<GameButton Variant="@GetSaveSelectButtonClasses( save )" OnClick="@(() => ToggleSaveSelection( save.SaveId ))">
														@(IsSaveSelected( save ) ? "Selected" : "Select")
													</GameButton>
											<GameButton Variant="options-panel-danger-button save-card-delete-button" OnClick="@(() => ConfirmDeleteSave( save ))">Delete</GameButton>
												</div>
											</div>
										}
									}
					</ChildContent>
					<Footer>
						@if ( CanEditConfig )
						{
							<GameButton Variant="options-panel-secondary-button" OnClick="@RefreshSaves">Refresh</GameButton>
							<GameButton Variant="options-panel-primary-button" CanClick="@CanLoadSelectedSave" OnClick="@ConfirmLoadSelectedSave" BlockedPopupTitle="No save selected" BlockedPopupMessage="Choose a save before loading.">Load Selected</GameButton>
						}
					</Footer>
				</OptionsPanelBody>
			</ChildContent>
		</OptionsPanel>
		<OptionsPanel
			IsOpen="@IsCustomizeMenuOpen"
			Kicker="Lobby"
			Title="Customize Piece"
			OnClose="@CloseCustomizeMenu"
			RootVariant="piece-customize-root"
			ScreenVariant="piece-customize-screen"
			PanelVariant="piece-customize-panel"
			TitleVariant="piece-customize-title">
			<ChildContent>
						<div class="piece-customize-layout">
							<div class="piece-preview-panel">
								<div class="piece-preview-viewport">
									<div class="piece-preview-hint">Live Preview</div>
								</div>
								<div class="piece-preview-details">
									<div class="piece-preview-title">@PreviewedPiece.Label</div>
									<div class="piece-preview-copy">@PreviewedPiece.Description</div>
									<div class="piece-preview-actions">
										<GameButton Variant="@GetPieceSelectButtonClasses( PreviewedPiece )" OnClick="@(() => SelectPiece( PreviewedPiece.Id ))">
											@(IsSelectedPiece( PreviewedPiece ) ? "Selected" : "Select Piece")
										</GameButton>
									</div>
								</div>
							</div>
						<div class="piece-customize-scroll-shell">
							<div class="piece-customize-grid monopory-scroll-y" @ref="PieceCustomizeScrollPanel">
								@foreach ( var piece in AvailablePieces )
								{
									<div class="@GetPieceCardClasses( piece )" onclick="@(() => SetPreviewPiece( piece.Id ))">
										<div class="piece-customize-card-title">@piece.Label</div>
										<div class="piece-customize-card-copy">@piece.Description</div>
										<GameButton Variant="@GetPieceSelectButtonClasses( piece )" OnClick="@(() => SelectPiece( piece.Id ))">
											@(IsSelectedPiece( piece ) ? "Selected" : "Select")
										</GameButton>
									</div>
								}
							</div>
							<MonoScrollbar Target="@PieceCustomizeScrollPanel"></MonoScrollbar>
						</div>
						</div>
						<div class="piece-customize-footer">
							<GameButton Variant="options-panel-secondary-button" OnClick="@CloseCustomizeMenu">Done</GameButton>
						</div>
			</ChildContent>
		</OptionsPanel>
		@if ( !IsCustomizeMenuOpen )
		{
		<GameButton Variant="flow-settings-button" Title="Options" OnClick="@OpenOptionsMenu">
			<ChildContent>
				<div class="flow-settings-icon"></div>
			</ChildContent>
		</GameButton>
		<div class="flow-version-label">Version @GameVersion</div>
		<div class="flow-panel lobby-panel">
			<div class="flow-kicker">Lobby</div>
			<div class="flow-title">Players</div>

			@if ( Lobby is null )
			{
				<div class="flow-copy">Lobby controller missing.</div>
			}
			else
			{
				<div class="lobby-list">
					@foreach ( var player in Players )
					{
						<div class="@GetPlayerClasses( player )">
							<div>
								<div class="lobby-player-name">@player.Name</div>
								<div class="lobby-player-detail">@GetPlayerDetail( player )</div>
							</div>
							<div class="lobby-ready-pill">@GetReadyLabel( player )</div>
						</div>
					}
				</div>

				<div class="flow-copy">@LobbyStatusText</div>
				<div class="flow-actions">
					<div class="lobby-action-row lobby-action-row-top">
						<GameButton Variant="@ReadyButtonClasses" OnClick="@ToggleReady">@ReadyButtonLabel</GameButton>
						<GameButton Variant="@StartButtonClasses" CanClick="@CanClickStartGame" OnClick="@StartGame" BlockedPopupTitle="Cannot start game" BlockedPopupMessage="@StartBlockedMessage">@StartButtonLabel</GameButton>
						<GameButton Variant="flow-secondary-button flow-utility-button" OnClick="@CustomizePiece">Customize</GameButton>
					</div>
					<div class="lobby-action-row lobby-action-row-bottom">
						<GameButton Variant="flow-secondary-button flow-back-button" OnClick="@BackToMenu">@BackButtonLabel</GameButton>
						<GameButton Variant="flow-secondary-button flow-utility-button" OnClick="@InviteFriends">Invite</GameButton>
						<GameButton Variant="flow-secondary-button flow-utility-button" CanClick="@CanEditConfig" OnClick="@OpenLoadMenu" BlockedPopupTitle="Host only" BlockedPopupMessage="Only the host can load saved games.">Load Game</GameButton>
						<GameButton Variant="@ConfigButtonClasses" CanClick="@CanOpenConfig" OnClick="@OpenConfigMenu" BlockedPopupTitle="Host only" BlockedPopupMessage="Only the host can change lobby game settings.">Match Settings</GameButton>
					</div>
				</div>
			}
		</div>
		}
	</div>
	<SteamFriendsPanel></SteamFriendsPanel>
</root>

@code
{
    [Property] public LobbyController LobbyRef { get; set; }

    private LobbyController Lobby => LobbyRef;
    private GameController PopupGame => GameController.Instance;
    private List<LobbyPlayer> Players => Lobby?.Players ?? new();
    private List<GamePopup> PopupList => PopupGame?.Popups.ToList() ?? new();
    private LobbyPlayer LocalPlayer => Lobby?.LocalPlayer;
    private bool CanClickStartGame => Lobby?.CanLocalPlayerStartGame == true;
    private bool IsOptionsMenuOpen;
    private bool IsConfigMenuOpen;
    private bool IsCustomizeMenuOpen;
    private bool IsLoadMenuOpen;
    private bool IsLoadSeatMenuOpen;
    private Panel PieceCustomizeScrollPanel = null!;
    private bool CanOpenConfig => Lobby is not null;
    private string GameVersion => MonopolyApp.GameVersion;
    private bool CanEditConfig => Lobby?.IsLocalEffectiveHost == true;
    private IReadOnlyList<PieceDefinition> AvailablePieces => PieceCatalog.All;
    private string PreviewPieceId = "";
    private PieceDefinition PreviewedPiece => PieceCatalog.GetByIdOrDefault( string.IsNullOrWhiteSpace( PreviewPieceId ) ? LocalPlayer?.SelectedPieceId : PreviewPieceId );
    private MatchConfig EditableConfig;
    private string LoadedConfigSnapshot = "";
    private int configRevision;
    private int saveRevision;
    private string SelectedSaveId = "";
    private List<GameSaveSummary> SaveSummaries = new();
    private GameSaveFile SelectedSaveFile;
    private List<LoadedSeatAssignment> LoadSeatAssignments = new();
    private bool IsManualSaveTab = true;
    private readonly Dictionary<string, string> ConfigIntDrafts = new();
    private IReadOnlyList<string> ConfigGroups;
    private IReadOnlyList<OptionsPanelSection> EditableConfigSections;
	private bool ShowHiddenMatchOptions;
	private string ActiveConfigPage = MatchConfigPageGameRules;
	private string GameRulePresetNameDraft = "";
	private string BoardConfigPresetNameDraft = "";
	private bool IsGameRulesExplicitlyCustom;
	private bool IsBoardConfigExplicitlyCustom;
	private string SelectedGameRulePresetId = CustomPresetId;
	private string SelectedBoardConfigPresetId = CustomPresetId;
	private List<MatchSettingsPreset> CustomGameRulePresets = new();
	private List<MatchSettingsPreset> CustomBoardConfigPresets = new();

	private const string ShowHiddenMatchOptionsCallbackId = "toggleShowHiddenOptionsInMenu";
	private const string MatchConfigPageGameRules = "Game Rules";
	private const string MatchConfigPageBoardConfiguration = "Board Configuration";
	private const string CustomPresetId = "custom";
	private const string GameRulePresetFileName = "match_settings/game_rule_presets.json";
	private const string BoardConfigPresetFileName = "match_settings/board_config_presets.json";

	private void ApplyShowHiddenMatchOptions( bool showHidden )
	{
		ShowHiddenMatchOptions = showHidden;
		RegisterConfigGroupsAndEditableSections();

		configRevision++;
		StateHasChanged();
	}

	private static bool GetShowHiddenMatchOptionsValue()
	{
		try
		{
			var value = ConsoleSystem.GetValue( ShowHiddenMatchOptionsConVar.Name );
			return string.IsNullOrWhiteSpace( value ) ? ShowHiddenMatchOptionsConVar.Value : value.ToBool();
		}
		catch ( KeyNotFoundException )
		{
			return ShowHiddenMatchOptionsConVar.Value;
		}
	}

	private void RegisterConfigGroupsAndEditableSections()
	{
		var options = GetVisibleConfigOptions();
		ConfigGroups = options.Select( option => option.Group ).Distinct().ToList();

		EditableConfigSections = ConfigGroups.Select( group => new OptionsPanelSection
		{
			Key = group,
			Title = group,
			HasItems = GetConfigOptionsForGroup( group ).Any()
		} ).ToList();
	}

	private void LoadMatchSettingPresets()
	{
		CustomGameRulePresets = LoadCustomPresets( GameRulePresetFileName );
		CustomBoardConfigPresets = LoadCustomPresets( BoardConfigPresetFileName );
	}

	private static List<MatchSettingsPreset> LoadCustomPresets( string path )
	{
		if ( !FileSystem.Data.FileExists( path ) )
			return new();

		return FileSystem.Data.ReadJson<List<MatchSettingsPreset>>( path )?
			.Where( preset => preset is not null && !preset.IsPredefined && !string.IsNullOrWhiteSpace( preset.Snapshot ) )
			.ToList() ?? new();
	}

	private static void SaveCustomPresets( string path, List<MatchSettingsPreset> presets )
	{
		FileSystem.Data.CreateDirectory( "match_settings" );
		FileSystem.Data.WriteJson( path, presets ?? new() );
	}

	private IReadOnlyList<MatchSettingsPreset> CreatePredefinedGameRulePresets()
	{
		var defaultConfig = MatchConfigSchema.CreateDefault();
		var quickConfig = MatchConfigSchema.CreateDefault();
		quickConfig.StartingMoney = 1000;
		quickConfig.TurnTimeLimitSeconds = 90;
		quickConfig.VacationCash = false;
		quickConfig.DoublesGoesAgain = true;
		quickConfig.CanSkipUnowned = false;

		var relaxedConfig = MatchConfigSchema.CreateDefault();
		relaxedConfig.MinPlayers = 1;
		relaxedConfig.MaxPlayers = 12;
		relaxedConfig.TurnTimeLimitSeconds = 300;
		relaxedConfig.CanSkipUnowned = true;
		relaxedConfig.DoublesGoAgainOutOfJail = true;

		return new[]
		{
			new MatchSettingsPreset { Id = "rules_default", Name = "Default Rules", Snapshot = MatchConfigSchema.Serialize( defaultConfig ), IsPredefined = true },
			new MatchSettingsPreset { Id = "rules_quick", Name = "Quick Game", Snapshot = MatchConfigSchema.Serialize( quickConfig ), IsPredefined = true },
			new MatchSettingsPreset { Id = "rules_relaxed", Name = "Relaxed Lobby", Snapshot = MatchConfigSchema.Serialize( relaxedConfig ), IsPredefined = true }
		};
	}

	private IReadOnlyList<MatchSettingsPreset> CreatePredefinedBoardConfigPresets()
	{
		return new[]
		{
			new MatchSettingsPreset { Id = "board_default", Name = "Default Board", Snapshot = BoardSpaceNameConfig.CreateDefaultSnapshot(), IsPredefined = true },
			new MatchSettingsPreset { Id = "board_classic", Name = "Classic Names", Snapshot = BoardSpaceNameConfig.SerializeNames( ClassicBoardSpaceNames ), IsPredefined = true }
		};
	}

    protected override void OnAwake()
    {
        base.OnAwake();

		Log.Info("Added");

		ShowHiddenMatchOptions = GetShowHiddenMatchOptionsValue();
		LoadMatchSettingPresets();
		RegisterConfigGroupsAndEditableSections();

		ShowHiddenMatchOptionsConVar.RegisterOnChanged( ShowHiddenMatchOptionsCallbackId, (_, newValue ) => {
			ApplyShowHiddenMatchOptions( newValue );
		});
    }

	protected override void OnDestroy()
	{
		ShowHiddenMatchOptionsConVar.UnregisterOnChanged( ShowHiddenMatchOptionsCallbackId );
		base.OnDestroy();
	}

	protected override void OnUpdate()
	{
		base.OnUpdate();
		Mouse.Visibility = MouseVisibility.Visible;

		if ( IsConfigMenuOpen )
			EnsureEditableConfigCurrent();

		UpdatePiecePreview();
	}

	private string LobbyStatusText
	{
		get
		{
			if ( Lobby is null )
				return "Lobby controller missing.";

			if ( Lobby.HasStagedLoadedGame )
			{
				var gameId = string.IsNullOrWhiteSpace( Lobby.StagedLoadedGameIdentifier ) ? "" : $" ({Lobby.StagedLoadedGameIdentifier})";
				return $"Loaded save staged: {Lobby.StagedLoadedSaveName}{gameId}. Ready up, then start loaded game.";
			}

			if ( Players.Count < Lobby.MinPlayers )
				return $"Waiting for {Lobby.MinPlayers - Players.Count} more player(s).";

			if ( HasUnreadyPlayers )
				return "Waiting for everyone to ready up.";

			if ( Lobby.OnlyHostStartsGame && !Networking.IsHost )
				return "Waiting for the host to start.";

			return "Ready to start.";
		}
	}

	private string ReadyButtonLabel => LocalPlayer?.IsReady == true ? "Unready" : "Ready";
	private string StartButtonLabel => Lobby?.HasStagedLoadedGame == true ? "Start Loaded Game" : "Start Game";
	private string ReadyButtonClasses => LocalPlayer?.IsReady == true ? "flow-secondary-button ready" : "flow-primary-button";
	private string StartButtonClasses => CanClickStartGame ? "flow-primary-button" : "flow-primary-button blocked-action-button";
	private string ConfigButtonClasses => "flow-secondary-button flow-utility-button flow-config-button";
	private string BackButtonLabel => Lobby?.IsLocalEffectiveHost == true ? "Back" : "Leave";
	private string ConfigMenuCopy => CanEditConfig
		? $"Changes to {ActiveConfigPage.ToLower()} stay local to the host until you press Save."
		: $"Viewing current {ActiveConfigPage.ToLower()} settings. Only the host can change or save configuration.";
	private string LobbyScreenClasses => IsCustomizeMenuOpen ? "flow-screen lobby-screen customizing-piece" : "flow-screen lobby-screen";
	private string StartBlockedMessage => Lobby?.OnlyHostStartsGame == true && Lobby?.IsLocalEffectiveHost != true
		? "Only the host can start this game."
		: LobbyStatusText;
	private bool HasOtherLobbyPlayers => Players.Any( player => !player.IsLocal );
	private bool HasUnsavedConfigChanges =>
		EditableConfig is not null &&
		CanEditConfig &&
		(ConfigIntDrafts.Count > 0 || !string.Equals( MatchConfigSchema.Serialize( EditableConfig ), LoadedConfigSnapshot, StringComparison.Ordinal ));
	private bool IsGameRulesConfigPage => string.Equals( ActiveConfigPage, MatchConfigPageGameRules, StringComparison.Ordinal );
	private bool IsGameRulesCustomSelected => string.Equals( SelectedGameRulePresetId, CustomPresetId, StringComparison.Ordinal );
	private bool IsBoardConfigCustomSelected => string.Equals( SelectedBoardConfigPresetId, CustomPresetId, StringComparison.Ordinal );
	private bool CanEditCurrentConfigPage => CanEditConfig && (IsGameRulesConfigPage ? IsGameRulesCustomSelected : IsBoardConfigCustomSelected);
	private IReadOnlyList<MatchSettingsPreset> GameRulePresets => CreatePredefinedGameRulePresets().Concat( CustomGameRulePresets ).ToList();
	private IReadOnlyList<MatchSettingsPreset> BoardConfigPresets => CreatePredefinedBoardConfigPresets().Concat( CustomBoardConfigPresets ).ToList();

	private bool HasUnreadyPlayers
	{
		get
		{
			for ( var i = 0; i < Players.Count; i++ )
			{
				if ( !Players[i].IsReady )
					return true;
			}

			return false;
		}
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( Lobby is not null );
		hash.Add( CanClickStartGame );
		hash.Add( LobbyStatusText );
		hash.Add( Lobby?.OnlyHostStartsGame ?? false );
		hash.Add( Lobby?.IsLocalEffectiveHost ?? false );
		hash.Add( IsOptionsMenuOpen );
		hash.Add( IsConfigMenuOpen );
		hash.Add( IsCustomizeMenuOpen );
		hash.Add( IsLoadMenuOpen );
		hash.Add( IsLoadSeatMenuOpen );
		hash.Add( Lobby?.HostedConfigSnapshot ?? "" );
		hash.Add( Lobby?.StagedLoadedSaveName ?? "" );
		hash.Add( Lobby?.StagedLoadedGameIdentifier ?? "" );
		hash.Add( configRevision );
		hash.Add( saveRevision );
		hash.Add( ActiveConfigPage );
		hash.Add( GameRulePresetNameDraft );
		hash.Add( BoardConfigPresetNameDraft );
		hash.Add( IsGameRulesExplicitlyCustom );
		hash.Add( IsBoardConfigExplicitlyCustom );
		hash.Add( SelectedGameRulePresetId );
		hash.Add( SelectedBoardConfigPresetId );
		hash.Add( PreviewPieceId ?? "" );
		hash.Add( SelectedSaveId ?? "" );
		hash.Add( IsManualSaveTab );
		hash.Add( AppSettings.SettingsAvailable );
		hash.Add( AppSettings.GetFullscreenMode() );
		hash.Add( AppSettings.GetVSyncEnabled() );
		hash.Add( AppSettings.GetMotionBlurEnabled() );
		hash.Add( AppSettings.GetUpscaler() );
		hash.Add( AppSettings.GetFsr3Quality() );
		hash.Add( GetPopupsHash() );

		foreach ( var player in Players )
		{
			hash.Add( player.OwnerId );
			hash.Add( player.Name );
			hash.Add( player.IsReady );
			hash.Add( player.IsConnected );
			hash.Add( player.IsHost );
			hash.Add( player.AbandonEndsAt );
			hash.Add( player.SelectedPieceId ?? "" );
		}

		foreach ( var save in SaveSummaries )
		{
			hash.Add( save.SaveId );
			hash.Add( save.DisplayName );
			hash.Add( save.SaveType );
			hash.Add( save.UpdatedAtUtc );
			hash.Add( save.IsLastLoadedRestorePoint );
		}

		hash.Add( SelectedSaveFile?.Summary?.SaveId ?? "" );
		foreach ( var assignment in LoadSeatAssignments )
		{
			hash.Add( assignment.SeatIndex );
			hash.Add( assignment.AssignedOwnerId );
			hash.Add( assignment.AssignedPlayerName );
			hash.Add( assignment.KeepDisconnected );
		}

		foreach ( var preset in GameRulePresets.Concat( BoardConfigPresets ) )
		{
			hash.Add( preset.Id );
			hash.Add( preset.Name );
			hash.Add( preset.Snapshot );
			hash.Add( preset.IsPredefined );
		}

		if ( EditableConfig is not null )
		{
			foreach ( var option in MatchConfigSchema.Options )
			{
				hash.Add( MatchConfigSchema.FormatValue( option, MatchConfigSchema.GetOptionValue( option, EditableConfig ) ) );
				hash.Add( ConfigIntDrafts.TryGetValue( option.Key, out var draft ) ? draft : "" );
			}
		}

		return hash.ToHashCode();
	}

	private void ToggleReady()
	{
		if ( Lobby is null || LocalPlayer is null )
			return;

		if ( Networking.IsHost )
			Lobby.TrySetReady( LocalPlayer.OwnerId, !LocalPlayer.IsReady );
		else
			Lobby.RequestSetReady( !LocalPlayer.IsReady );
	}

	private void StartGame()
	{
		if ( Lobby is null )
			return;

		if ( !CanClickStartGame )
		{
			ShowLocalPopup( "Cannot start game", StartBlockedMessage, PopupKind.Warning, true, 3f, false );
			return;
		}

		LoadingState.Show( Lobby.HasStagedLoadedGame ? "Loading saved game" : "Starting game", "Setting up the board and player pieces." );
		if ( Networking.IsHost )
			Lobby.TryStartGame();
		else
			Lobby.RequestStartGame();
	}

	private void BackToMenu()
	{
		if ( Lobby is null )
			return;

		if ( Lobby?.IsLocalEffectiveHost == false || Lobby?.IsLocalEffectiveHost == null )
		{
			ConfirmLeaveLobby();
			return;
		}

		if ( HasOtherLobbyPlayers )
		{
			if ( PopupGame is null )
			{
				RequestBackToMenu();
				return;
			}

			PopupGame.ShowLocalConfirmation(
				"Return to menu?",
				"This will send everyone in the lobby back to the main menu.",
				RequestBackToMenu,
				null,
				"Return",
				"Stay",
				false );
			return;
		}

		RequestBackToMenu();
	}

	private void RequestBackToMenu()
	{
		if ( Lobby is null )
			return;

		LoadingState.Show( "Returning to menu", "Closing the lobby view." );
		Lobby.RequestBackToMenu();
	}

	private void ConfirmLeaveLobby()
	{
		if ( PopupGame is null )
		{
			LeaveLobby();
			return;
		}

		PopupGame.ShowLocalConfirmation(
			"Leave lobby?",
			"You will leave this lobby and return to the main menu.",
			LeaveLobby,
			null,
			"Leave",
			"Stay",
			false );
	}

	private void LeaveLobby()
	{
		LoadingState.Show( "Leaving lobby", "Disconnecting and returning to the menu." );
		NetworkSession.ForceDisconnectToMenu( Scene );
	}

