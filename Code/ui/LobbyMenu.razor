		saveRevision++;
	}

	private void ConfirmLoadSelectedSaveFinal()
	{
		IsLoadSeatMenuOpen = false;

		var save = SaveSummaries.FirstOrDefault( save => string.Equals( save.SaveId, SelectedSaveId, StringComparison.Ordinal ) );
		if ( save is null )
			return;

		if ( PopupGame is null )
		{
			LoadSelectedSave();
			return;
		}

		PopupGame.ShowLocalConfirmation(
			"Load save into lobby?",
			$"This will stage {save.DisplayName} in the lobby. Missing saved players will stay disconnected when the game starts.",
			LoadSelectedSave,
			null,
			"Load",
			"Cancel",
			false );
	}

	private void LoadSelectedSave()
	{
		if ( Lobby is null || !CanEditConfig )
			return;

		var save = SaveSummaries.FirstOrDefault( save => string.Equals( save.SaveId, SelectedSaveId, StringComparison.Ordinal ) );
		var assignments = LoadSeatAssignments.Count > 0 ? LoadSeatAssignments.ToList() : Lobby.BuildDefaultSeatAssignments( save ).ToList();
		if ( Lobby.TryLoadSavedGame( save, assignments, out var message ) )
		{
			CloseLoadMenu();
			ShowLocalPopup( "Save staged", message, PopupKind.Success, true, 4f, false );
		}
		else
		{
			ShowLocalPopup( "Could not load", message, PopupKind.Warning, true, 4f, false );
		}
	}

