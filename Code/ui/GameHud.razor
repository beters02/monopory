@using Sandbox;
@using Sandbox.UI;
@using Sandbox.ui.components;
@using Sandbox.ui.components.Test
@using Sandbox.ui.components.buttons;
@using System;
@using System.Threading.Tasks;
@inherits PanelComponent

<root class="monopoly-hud">
	<ButtonPopLayer></ButtonPopLayer>
	@if ( GameRef is not null )
	{
		@if ( NetworkSession.IsEditorSoftLeftLobby )
		{
			<div class="flow-screen lobby-screen">
				<div class="flow-panel lobby-panel">
					<div class="flow-kicker">Lobby</div>
					<div class="flow-title">Editor Leave Mode</div>
					<div class="flow-copy">You left locally without disconnecting. You are still connected to the match host.</div>
					<div class="flow-actions">
						<GameButton Variant="flow-primary-button" OnClick="@RejoinSoftLeftMatch">Rejoin Match</GameButton>
						<GameButton Variant="flow-secondary-button" OnClick="@LeaveForReal">Leave For Real</GameButton>
					</div>
				</div>
			</div>
		}
		else
		{
			<DropdownTestPanel></DropdownTestPanel>
			<SessionOverlay
				GameRef="@GameRef"
				IsEscapeMenuOpen="@IsEscapeMenuOpen"
				IsOptionsMenuOpen="@IsOptionsMenuOpen"
				IsMatchSettingsMenuOpen="@IsMatchSettingsMenuOpen"
				OnResumeGame="@ResumeGame"
				OnOpenOptions="@OpenOptionsMenu"
				OnOpenMatchSettings="@OpenMatchSettingsMenu"
				OnCloseMenu="@CloseEscapeMenu"
				OnCloseOptions="@CloseOptionsMenu"
				OnCloseMatchSettings="@CloseMatchSettingsMenu"
				OnReturnToLobby="@ReturnToLobby"
				OnLeaveLobby="@ConfirmLeaveLobby"
				OnDeclareBankruptcy="@ConfirmDeclareBankruptcy"
				OnExitGame="@ConfirmExitGame"
				OnSaveGame="@SaveGame">
			</SessionOverlay>

			<div class="popup-hud-layer">
				<PopupStack Popups="@Popups" OnDismiss="@DismissPopup" OnConfirmDecision="@HandleConfirmationDecision"></PopupStack>
			</div>

			@if ( IsManualSaveNameMenuOpen )
			{
				<div class="manual-save-name-screen">
					<div class="manual-save-name-panel">
						<div class="manual-save-name-header">
							<div>
								<div class="manual-save-name-kicker">Save Game</div>
								<div class="manual-save-name-title">Name Manual Save</div>
							</div>
							<CloseButton Variant="manual-save-name-close-button" Title="Close" OnClick="@CloseManualSaveNameMenu"></CloseButton>
						</div>
						<div class="manual-save-name-copy">Give this restore point a name that will make sense when you come back later.</div>
						<TextEntry class="manual-save-name-input"
							Text="@ManualSaveNameDraft"
							Placeholder="Manual save name"
							OnTextEdited="@SetManualSaveNameDraft"
							onsubmit="@ConfirmNamedManualSave" />
						<div class="manual-save-name-actions">
							<GameButton Variant="manual-save-name-secondary-button" OnClick="@CloseManualSaveNameMenu">Cancel</GameButton>
							<GameButton Variant="manual-save-name-primary-button"
								CanClick="@CanConfirmManualSaveName"
								BlockedPopupTitle="Name required"
								BlockedPopupMessage="Enter a name before creating this manual save."
								OnClick="@ConfirmNamedManualSave">Save</GameButton>
						</div>
					</div>
				</div>
			}

			@if ( GameRef.IsRecoveringHostState )
			{
				<div class="host-recovery-screen">
					<div class="host-recovery-card">
						<div class="host-recovery-spinner"></div>
						<div class="host-recovery-copy">
							<div class="host-recovery-kicker">Host recovery</div>
							<div class="host-recovery-title">Rebuilding the table state</div>
							<div class="host-recovery-body">Hold tight while the new host finishes the interrupted action.</div>
						</div>
					</div>
				</div>
			}

			@if ( GameRef.MatchState != MatchLifecycleState.GameOver )
			{
				<GambleScreen GameRef="@GameRef" IsMenuOpen="@IsAnyMenuOpen"></GambleScreen>

				<div class="@HudUi.BuildHideableHudClass( GameRef )">
					<GameStatusPanel GameRef="@GameRef"></GameStatusPanel>
					<AuctionModal GameRef="@GameRef"></AuctionModal>
				</div>
				
				<div class="@HudUi.BuildTranslucentHideableHudClass( GameRef )">
					<PropertyOwnershipPanel GameRef="@GameRef"></PropertyOwnershipPanel>
				</div>

				<TradePanel GameRef="@GameRef"></TradePanel>
				
				@if ( !IsAnyMenuOpen || GameRef.ForceHiddenUiVisible )
				{
					<SelectedSpacePanel GameRef="@GameRef"></SelectedSpacePanel>
				}
			}
		}
	}
</root>

@code
{
	[Property] public GameController GameRef { get; set; }

	public static GameHud Instance;

	private bool IsEscapeMenuOpen;
	private bool IsOptionsMenuOpen;
	private bool IsMatchSettingsMenuOpen;
	private bool IsManualSaveNameMenuOpen;
	private string ManualSaveNameDraft = "";
	public static bool IsMenuBlockingHud { get; private set; }

	private bool IsHudVisible() => GameRef?.IsGameHudVisible() == true;

	private List<GamePopup> Popups => GameRef?.Popups.ToList() ?? new();

	public static bool IsAnyMenuOpen =>
		Instance is not null &&
		(Instance.IsEscapeMenuOpen || Instance.IsOptionsMenuOpen || Instance.IsMatchSettingsMenuOpen || Instance.IsManualSaveNameMenuOpen);
	private bool IsGambleScreenActive => GameRef?.IsGambleScreenActive == true;
	private bool CanConfirmManualSaveName => !string.IsNullOrWhiteSpace( ManualSaveNameDraft );

	protected override void OnStart()
	{
		base.OnStart();

		Instance = this;
	}

	protected override void OnUpdate()
	{
		base.OnUpdate();
		Instance = this;
		IsMenuBlockingHud = IsAnyLocalMenuOpen();

		if ( GameRef is null || GameRef.MatchState == MatchLifecycleState.GameOver )
		{
			IsEscapeMenuOpen = false;
			IsOptionsMenuOpen = false;
			IsMatchSettingsMenuOpen = false;
			IsManualSaveNameMenuOpen = false;
			IsMenuBlockingHud = false;
			if ( GameRef is null )
				return;
		}

		if ( NetworkSession.IsEditorSoftLeftLobby )
		{
			IsMenuBlockingHud = false;
			Mouse.Visibility = MouseVisibility.Visible;
			return;
		}

		if ( GameRef.IsRecoveringHostState )
		{
			IsEscapeMenuOpen = false;
			IsOptionsMenuOpen = false;
			IsMatchSettingsMenuOpen = false;
			IsManualSaveNameMenuOpen = false;
			IsMenuBlockingHud = false;
			Mouse.Visibility = MouseVisibility.Visible;
			return;
		}

		if ( IsEscapeMenuOpen || IsOptionsMenuOpen || IsMatchSettingsMenuOpen || IsManualSaveNameMenuOpen )
			Mouse.Visibility = MouseVisibility.Visible;

		if ( StandaloneConsole.IsConsoleOpen )
		{
			Mouse.Visibility = MouseVisibility.Visible;
			IsEscapeMenuOpen = false;
			IsOptionsMenuOpen = false;
			IsMatchSettingsMenuOpen = false;
			IsManualSaveNameMenuOpen = false;
			IsMenuBlockingHud = false;
			return;
		}

		UpdateInputs();
		IsMenuBlockingHud = IsAnyLocalMenuOpen();
	}

	private bool IsAnyLocalMenuOpen()
	{
		return IsEscapeMenuOpen || IsOptionsMenuOpen || IsMatchSettingsMenuOpen || IsManualSaveNameMenuOpen;
	}

	private void UpdateInputs()
	{
		UpdateMenuOpenInput();

		if (Input.Pressed( "ClearAllPopups" ))
		{
			GameRef?.ClearPopups();
		}
			
	}

	private void UpdateMenuOpenInput()
	{	
		if ( MonopolyApp.IsStandalone() )
		{
			if (Input.EscapePressed)
				ToggleEscapeMenu();
			
			return;
		}

		if ( Input.Pressed( "EditorMenu" ) )
		{
			ToggleEscapeMenu();
			return;
		}
	}

	private void ToggleEscapeMenu()
	{
		if ( IsOptionsMenuOpen )
		{
			IsOptionsMenuOpen = false;
			return;
		}

		if ( IsMatchSettingsMenuOpen )
		{
			IsMatchSettingsMenuOpen = false;
			return;
		}

		if ( IsManualSaveNameMenuOpen )
		{
			IsManualSaveNameMenuOpen = false;
			return;
		}

		IsEscapeMenuOpen = !IsEscapeMenuOpen;
	}

	private void OpenOptionsMenu()
	{
		IsOptionsMenuOpen = true;
		IsMatchSettingsMenuOpen = false;
	}

	private void CloseOptionsMenu()
	{
		IsOptionsMenuOpen = false;
	}

	private void OpenMatchSettingsMenu()
	{
		IsMatchSettingsMenuOpen = true;
		IsOptionsMenuOpen = false;
	}

	private void CloseMatchSettingsMenu()
	{
		IsMatchSettingsMenuOpen = false;
	}

	private void CloseEscapeMenu()
	{
		IsEscapeMenuOpen = false;
		IsOptionsMenuOpen = false;
		IsMatchSettingsMenuOpen = false;
		IsManualSaveNameMenuOpen = false;
	}

	private void ResumeGame()
	{
		if ( GameRef is null )
			return;

		if ( Networking.IsHost )
			GameRef.TryResumeGame();
		else
			GameRef.RequestResumeGame();
	}

	private void ReturnToLobby()
	{
		if ( GameRef is null )
			return;
		
		if ( !Networking.IsHost && GameRef.IsLocalEffectiveHost )
		{
			GameRef.RequestReturnToLobby();
			return;
		}

		if (!Networking.IsHost)
			return;

		GameRef.TryReturnToLobby();
	}

	private void ConfirmLeaveLobby()
	{
		GameRef?.ShowLocalConfirmation(
			"Leave lobby?",
			"You will leave the current match lobby.",
			LeaveLobby,
			null,
			"Leave",
			"Cancel"
		);
	}

	private void LeaveLobby()
	{
		IsEscapeMenuOpen = false;
		IsOptionsMenuOpen = false;
		IsMatchSettingsMenuOpen = false;

		if ( !NetworkSession.CanUseEditorSoftLeave )
		{
			if ( ShouldCreateRejoinWindow() )
			{
				var lobbyId = SteamInviteBridge.GetActiveLobbyIdValue();
				var connectTarget = Networking.ServerName ?? "";
				var abandonTimeoutSeconds = Math.Max( GameRef?.Config?.AbandonTimeoutSeconds ?? 180, 1 );
				NetworkSession.LeaveCurrentLobbyWithRejoinWindow( Scene, lobbyId, connectTarget, Time.Now + abandonTimeoutSeconds );
				return;
			}
			else
			{
				NetworkSession.ClearRejoinWindow();
			}
		}

		NetworkSession.LeaveCurrentLobby( Scene );
	}

	private bool ShouldCreateRejoinWindow()
	{
		if ( GameRef is null )
			return false;

		if ( GameRef.MatchState == MatchLifecycleState.GameOver )
			return false;

		if ( Networking.IsHost && GameRef.GetLobbyPlayers().Count <= 1 )
			return false;

		return Networking.IsActive;
	}

	private void RejoinSoftLeftMatch()
	{
		NetworkSession.ReturnFromEditorSoftLeave();
	}

	private void LeaveForReal()
	{
		IsEscapeMenuOpen = false;
		IsOptionsMenuOpen = false;
		IsMatchSettingsMenuOpen = false;
		NetworkSession.ForceDisconnectToMenu( Scene );
	}

	private void ConfirmDeclareBankruptcy()
	{
		GameRef?.ShowLocalConfirmation(
			"Declare bankruptcy?",
			"You will instantly go bankrupt but stay connected to the match.",
			DeclareBankruptcy,
			null,
			"Bankrupt",
			"Cancel"
		);
	}

	private void DeclareBankruptcy()
	{
		IsEscapeMenuOpen = false;
		IsOptionsMenuOpen = false;
		IsMatchSettingsMenuOpen = false;

		if ( GameRef is null )
			return;

		if ( Networking.IsHost )
		{
			GameRef.TryDeclareBankruptcy( GameRef.LocalPlayer );
			return;
		}

		GameRef.RequestDeclareBankruptcy();
	}

	private void ConfirmExitGame()
	{
		GameRef?.ShowLocalConfirmation(
			"Exit game?",
			"The game will close.",
			ExitGame,
			null,
			"Exit",
			"Cancel"
		);
	}

	private void SaveGame()
	{
		if ( GameRef is null || !Networking.IsHost )
			return;

		if ( GameRef.HasCurrentManualSave )
		{
			GameRef.ShowLocalConfirmation(
				"Save game?",
				"Do you want to overwrite your last save or create a new one?",
				OverwriteCurrentManualSave,
				OpenManualSaveNameMenu,
				"Overwrite",
				"Create New"
			);
			return;
		}

		OpenManualSaveNameMenu();
	}

	private void OpenManualSaveNameMenu()
	{
		if ( GameRef is null || !Networking.IsHost )
			return;

		ManualSaveNameDraft = $"Manual Save {DateTime.Now:yyyy-MM-dd HH-mm}";
		IsManualSaveNameMenuOpen = true;
		IsEscapeMenuOpen = false;
		IsOptionsMenuOpen = false;
		IsMatchSettingsMenuOpen = false;
	}

	private void CloseManualSaveNameMenu()
	{
		IsManualSaveNameMenuOpen = false;
		ManualSaveNameDraft = "";
	}

	private void SetManualSaveNameDraft( string value )
	{
		ManualSaveNameDraft = value ?? "";
	}

	private void ConfirmNamedManualSave()
	{
		if ( GameRef is null || !Networking.IsHost || !CanConfirmManualSaveName )
			return;

		var saveName = ManualSaveNameDraft.Trim();
		IsManualSaveNameMenuOpen = false;
		ManualSaveNameDraft = "";

		if ( GameRef.TrySaveGame( saveName, false, out var message ) )
			GameRef.ShowLocalPopup( "Game saved", message, PopupKind.Success, true, 3f, false );
		else
			GameRef.ShowLocalPopup( "Could not save", message, PopupKind.Warning, true, 4f, false );
	}

	private void OverwriteCurrentManualSave()
	{
		if ( GameRef is null || !Networking.IsHost )
			return;

		if ( GameRef.TryOverwriteCurrentManualSave( out var message ) )
			GameRef.ShowLocalPopup( "Save overwritten", message, PopupKind.Success, true, 3f, false );
		else
			GameRef.ShowLocalPopup( "Could not overwrite", message, PopupKind.Warning, true, 4f, false );
	}

	private void ExitGame()
	{
		IsEscapeMenuOpen = false;
		IsOptionsMenuOpen = false;
		IsMatchSettingsMenuOpen = false;
		Game.Close();
	}

	private void DismissPopup( int popupId )
	{
		GameRef?.DismissPopup( popupId );
	}

	private void HandleConfirmationDecision( int popupId, bool confirmed )
	{
		GameRef?.ResolveConfirmationPopup( popupId, confirmed );
	}

	private int GetPopupsHash()
	{
		var hash = new HashCode();

		foreach ( var popup in Popups )
		{
			hash.Add( popup.Id );
			hash.Add( popup.Title );
			hash.Add( popup.Message );
			hash.Add( popup.Kind );
			hash.Add( popup.CanDismiss );
		}

		return hash.ToHashCode();
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( GameRef?.MatchState ?? 0 );
		hash.Add( GameRef?.WinnerPlayerIndex ?? -1 );
		hash.Add( GameRef?.IsRecoveringHostState ?? false );
		hash.Add( IsEscapeMenuOpen );
		hash.Add( IsOptionsMenuOpen );
		hash.Add( IsMatchSettingsMenuOpen );
		hash.Add( IsManualSaveNameMenuOpen );
		hash.Add( ManualSaveNameDraft );
		hash.Add( IsGambleScreenActive );
		hash.Add( IsHudVisible() );
		hash.Add( GameRef?.ForceHiddenUiVisible ?? false );
		hash.Add( AppSettings.SettingsAvailable );
		hash.Add( AppSettings.GetFullscreenMode() );
		hash.Add( AppSettings.GetVSyncEnabled() );
		hash.Add( AppSettings.GetMotionBlurEnabled() );
		hash.Add( AppSettings.GetUpscaler() );
		hash.Add( AppSettings.GetFsr3Quality() );
		hash.Add( GetPopupsHash() );

		if ( GameRef?.Config is not null )
		{
			foreach ( var option in MatchConfigSchema.Options )
				hash.Add( MatchConfigSchema.FormatValue( option, MatchConfigSchema.GetOptionValue( option, GameRef.Config ) ) );
		}

		return hash.ToHashCode();
	}
}
