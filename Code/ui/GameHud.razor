@using Sandbox;
@using Sandbox.UI;
@using Sandbox.ui.components;
@using System;
@inherits PanelComponent

<root class="monopoly-hud">
	@if ( GameRef is not null )
	{
		<PopupStack Popups="@Popups" OnDismiss="@DismissPopup"></PopupStack>

		<SessionOverlay
			GameRef="@GameRef"
			IsEscapeMenuOpen="@IsEscapeMenuOpen"
			OnResumeGame="@ResumeGame"
			OnReturnToLobby="@ReturnToLobby"
			OnLeaveLobby="@LeaveLobby"
			OnExitGame="@ExitGame">
		</SessionOverlay>

		@if ( GameRef.MatchState != MatchLifecycleState.GameOver )
		{
			<GameStatusPanel GameRef="@GameRef"></GameStatusPanel>
			<PropertyOwnershipPanel GameRef="@GameRef"></PropertyOwnershipPanel>
			<TradePanel GameRef="@GameRef"></TradePanel>
			<AuctionModal GameRef="@GameRef"></AuctionModal>
			<SelectedSpacePanel GameRef="@GameRef"></SelectedSpacePanel>
		}
	}
</root>

@code
{
	[Property] public GameController GameRef { get; set; }

	private bool IsEscapeMenuOpen;

	private List<GamePopup> Popups =>
		(GameRef?.Popups ?? Enumerable.Empty<GamePopup>())
			.Concat( LocalPopups.Popups )
			.ToList();

	protected override void OnUpdate()
	{
		base.OnUpdate();

		if ( GameRef is null || GameRef.MatchState == MatchLifecycleState.GameOver )
		{
			IsEscapeMenuOpen = false;
			return;
		}

		HandleMenuOpen();
	}

	private void HandleMenuOpen()
	{
		#if STANDALONE
		if ( Input.EscapePressed )
		{
			IsEscapeMenuOpen = !IsEscapeMenuOpen;
			return;
		}
		#endif

		if ( Input.Pressed( "EditorMenu" ) )
		{
			IsEscapeMenuOpen = !IsEscapeMenuOpen;
		}
	}

	private void ResumeGame()
	{
		if ( GameRef is null )
			return;

		if ( Networking.IsHost )
			GameRef.TryResumeGame();
		else
			GameRef.RequestResumeGame();
	}

	private void ReturnToLobby()
	{
		if ( GameRef is null )
			return;

		if ( Networking.IsHost )
		{
			GameRef.TryReturnToLobby();
			SceneFlow.LoadLobby( Scene );
		}
		else
			GameRef.RequestReturnToLobby();
	}

	private void LeaveLobby()
	{
		IsEscapeMenuOpen = false;
		NetworkSession.LeaveCurrentLobby( Scene );
	}

	private void ExitGame()
	{
		IsEscapeMenuOpen = false;
		Game.Close();
	}

	private void DismissPopup( int popupId )
	{
		LocalPopups.Dismiss( popupId );
		GameRef?.DismissPopup( popupId );
	}

	private int GetPopupsHash()
	{
		var hash = new HashCode();

		foreach ( var popup in Popups )
		{
			hash.Add( popup.Id );
			hash.Add( popup.Title );
			hash.Add( popup.Message );
			hash.Add( popup.Kind );
			hash.Add( popup.CanDismiss );
		}

		return hash.ToHashCode();
	}

	protected override int BuildHash()
	{
		return HashCode.Combine(
			GameRef?.MatchState ?? 0,
			GameRef?.WinnerPlayerIndex ?? -1,
			IsEscapeMenuOpen,
			GetPopupsHash()
		);
	}
}
