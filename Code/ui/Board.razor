@using Sandbox;
@using Sandbox.UI;
@using System.Collections.Generic;
@inherits PanelComponent

<root class="monopoly-root">
	<div class="board-wrap">
		<Image class="board-image" Texture="@GetTextureFromPath("textures/grandcasinopolyboard.png")" />

		@foreach ( var space in Spaces )
		{
			<div class="space-label @space.ClassName"
				 style="@GetSpaceStyle( space )">
				@space.Name
			</div>
		}
	</div>
</root>

@code
{
	public List<BoardSpaceLabel> Spaces { get; set; } = new()
	{
		new()
		{
			Name = "My Property",
			X = 75,
			Y = 92,
			W = 8,
			H = 5,
			Rotation = 180
		},
	};

	private string GetSpaceStyle( BoardSpaceLabel space )
	{
		return
			$"left: {space.X}%; " +
			$"top: {space.Y}%; " +
			$"width: {space.W}%; " +
			$"height: {space.H}%; " +
			$"transform: rotate({space.Rotation}deg);";
	}

	private Texture GetTextureFromPath(string path)
	{
		return Texture.Load(path);
	}

	protected override int BuildHash()
	{
		return System.HashCode.Combine( Spaces.Count );
	}

	public class BoardSpaceLabel
	{
		public string Name { get; set; } = "";
		public float X { get; set; }
		public float Y { get; set; }
		public float W { get; set; }
		public float H { get; set; }
		public float Rotation { get; set; }
		public string ClassName { get; set; } = "";
	}
}