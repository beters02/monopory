@using Sandbox;
@using Sandbox.UI;
@using Sandbox.ui.components;
@using Sandbox.ui.components.buttons
@using System;
@inherits PanelComponent

<root class="monopoly-flow-ui">
	<ButtonPopLayer></ButtonPopLayer>
	<div class="flow-screen menu-screen">
		<OptionsMenu IsOpen="@IsOptionsMenuOpen" OnClose="@CloseOptionsMenu"></OptionsMenu>
		<GameButton Variant="flow-settings-button" Title="Options" OnClick="@OpenOptionsMenu">
			<ChildContent>
				<div class="flow-settings-icon"></div>
			</ChildContent>
		</GameButton>
		<div class="flow-version-label">Version @GameVersion</div>
		<div class="flow-panel menu-panel">
			<div class="flow-kicker">#game.kicker</div>
			<div class="flow-title">#game.name</div>
			<div class="flow-copy">#game.tldr</div>
			<div class="flow-actions">
				<GameButton Variant="flow-primary-button" OnClick="@OpenLobby">Host Lobby</GameButton>
				<GameButton Variant="flow-danger-button" OnClick="@ExitGame">Exit Game</GameButton>
				@if ( NetworkSession.CanRejoinLobby )
				{
					<GameButton Variant="flow-secondary-button" OnClick="@RejoinLobby">Rejoin Lobby (@NetworkSession.RejoinSecondsRemaining s)</GameButton>
				}
			</div>
		</div>
	</div>
	<SteamFriendsPanel></SteamFriendsPanel>
</root>

@code
{
	[Property] public MenuController MenuRef { get; set; }

	private string GameVersion => MonopolyApp.GameVersion;

	private bool IsOptionsMenuOpen;
	private MenuController Menu => MenuRef ?? Scene?.GetAllComponents<MenuController>().FirstOrDefault();

	protected override void OnUpdate()
	{
		base.OnUpdate();
		Mouse.Visibility = MouseVisibility.Visible;
	}

	private void OpenOptionsMenu()
	{
		IsOptionsMenuOpen = true;
	}

	private void CloseOptionsMenu()
	{
		IsOptionsMenuOpen = false;
	}

	private void OpenLobby()
	{
		if ( Menu is null )
		{
			Log.Warning( "Host Lobby clicked, but no MenuController was found in the scene." );
			return;
		}

		LoadingState.Show( "Creating lobby", "Setting up the table for your players." );
		Menu.TryOpenLobby();
	}

	private async void RejoinLobby()
	{
		LoadingState.Show( "Rejoining lobby", "Trying to reconnect to your last match." );
		await NetworkSession.TryRejoinLobby( Scene );
	}

	private void ExitGame()
	{
		Game.Close();
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsOptionsMenuOpen );
		hash.Add( NetworkSession.RejoinLobbyId );
		hash.Add( NetworkSession.RejoinConnectTarget );
		hash.Add( NetworkSession.RejoinSecondsRemaining );
		hash.Add( AppSettings.SettingsAvailable );
		hash.Add( AppSettings.GetFullscreenMode() );
		hash.Add( AppSettings.GetVSyncEnabled() );
		hash.Add( AppSettings.GetMotionBlurEnabled() );
		hash.Add( AppSettings.GetUpscaler() );
		hash.Add( AppSettings.GetFsr3Quality() );
		return hash.ToHashCode();
	}
}
