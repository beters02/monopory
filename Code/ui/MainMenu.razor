@using Sandbox;
@using Sandbox.UI;
@using Sandbox.ui.components;
@using Sandbox.ui.components.buttons
@using System;
@inherits PanelComponent

<root class="monopoly-flow-ui">
	<ButtonPopLayer></ButtonPopLayer>
	<div class="flow-screen menu-screen">
		<OptionsMenu IsOpen="@IsOptionsMenuOpen" OnClose="@CloseOptionsMenu"></OptionsMenu>
		<GameButton Variant="flow-settings-button" Title="Options" OnClick="@OpenOptionsMenu">
			<ChildContent>
				<div class="flow-settings-icon"></div>
			</ChildContent>
		</GameButton>
		<div class="flow-panel menu-panel">
			<div class="flow-kicker">#game.kicker</div>
			<div class="flow-title">#game.name</div>
			<div class="flow-copy">#game.tldr</div>
			<div class="flow-actions">
				<GameButton Variant="flow-primary-button" OnClick="@OpenLobby">Host Lobby</GameButton>
			</div>
		</div>
	</div>
</root>

@code
{
	[Property] public MenuController MenuRef { get; set; }

	private bool IsOptionsMenuOpen;
	private MenuController Menu => MenuRef ?? Scene?.GetAllComponents<MenuController>().FirstOrDefault();

	protected override void OnUpdate()
	{
		base.OnUpdate();
		Mouse.Visibility = MouseVisibility.Visible;
	}

	private void OpenOptionsMenu()
	{
		IsOptionsMenuOpen = true;
	}

	private void CloseOptionsMenu()
	{
		IsOptionsMenuOpen = false;
	}

	private void OpenLobby()
	{
		if ( Menu is null )
		{
			Log.Warning( "Host Lobby clicked, but no MenuController was found in the scene." );
			return;
		}

		if ( Networking.IsHost )
			Menu.TryOpenLobby();
		else
			Menu.RequestOpenLobby();
	}

	protected override int BuildHash()
	{
		return HashCode.Combine(
			IsOptionsMenuOpen,
			AppSettings.SettingsAvailable,
			AppSettings.GetFullscreenMode(),
			AppSettings.GetVSyncEnabled(),
			AppSettings.GetMotionBlurEnabled(),
			AppSettings.GetUpscaler(),
			AppSettings.GetFsr3Quality()
		);
	}
}
