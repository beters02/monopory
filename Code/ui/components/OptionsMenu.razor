@using Sandbox;
@using Sandbox.UI;
@using Sandbox.Engine.Settings;
@using Sandbox.ui.components.buttons
@using System;
@inherits Panel

<root class="@RootClasses">
	@if ( IsOpen )
	{
		<div class="@OptionsScreenClasses">
			<div class="options-panel">
				<div class="options-header">
					<div class="options-header-text">
						<div class="options-kicker">Settings</div>
						<div class="options-title">Options</div>
					</div>
					@if ( ShouldShowSettingsUnavailableWarning )
					{
						<div class="options-header-warning">Video settings are only available when s&box exposes render settings for this session.</div>
					}
					<CloseButton Variant="options-close-button" Title="Close" OnClick="@Close"></CloseButton>
				</div>

				<div class="options-scroll-shell">
					<div class="options-scroll-panel monopory-scroll-y" @ref="OptionsScrollPanel">
						@foreach ( var category in AppSettingsSchema.Categories )
						{
							<div class="options-category-section">
								<div class="options-category-heading">
									<div class="options-category-title">@category.Label</div>
									<div class="options-category-copy">@category.Description</div>
								</div>

								@if ( HasSectionsForCategory( category ) )
								{
									@foreach ( var sectionName in GetSectionsForCategory( category ) )
									{
										<div class="options-section">
											<div class="options-section-title">@sectionName</div>

											@foreach ( var option in GetOptionsForSection( category.Key, sectionName ) )
											{
												<div class="options-row">
													<div class="options-text">
														<div class="options-label">@option.Label</div>
														<div class="options-value">@GetOptionStatusText( option )</div>
													</div>
													<div class="options-control">
														@if ( option.Kind == AppSettingOptionKind.Bool )
														{
															<GameButton Variant="@GetToggleButtonClasses( GetBoolValue( option ) )" CanClick="@IsOptionAvailable( option )" OnClick="@(() => ToggleBoolOption( option ))" BlockedPopupTitle="Unavailable" BlockedPopupMessage="@UnavailableMessage">
																@(GetBoolValue( option ) ? "On" : "Off")
															</GameButton>
														}
														else if ( option.Kind == AppSettingOptionKind.Enum )
														{
															<DropdownButton
																Value="@GetEnumValue( option )"
																Items="@option.EnumNames"
																ScrollTarget="@OptionsScrollPanel"
																CanClick="@IsOptionAvailable( option )"
																OnSelected="@((string value) => SetEnumValue( option, value ))"
																BlockedPopupTitle="Unavailable"
																BlockedPopupMessage="@UnavailableMessage">
															</DropdownButton>
														}
														else if ( option.Kind == AppSettingOptionKind.Int )
														{
															<SliderControl
																class="options-slider"
																Value="@GetIntValue( option )"
																OnValueChanged="@((float value) => SetIntValue( option, value ))"
																Min="@option.IntMin"
																Max="@option.IntMax"
																Step="@option.IntStep"
																ShowTextEntry="@true"
																NumberFormat="0">
															</SliderControl>
														}
													</div>
												</div>
											}
										</div>
									}
								}
								else
								{
									<div class="options-empty-state">
										<div class="options-empty-title">@category.Label</div>
										<div class="options-empty-copy">No settings are wired into this section yet.</div>
									</div>
								}
							</div>
						}
					</div>
					<MonoScrollbar Target="@OptionsScrollPanel"></MonoScrollbar>
				</div>

				<div class="options-footer">
					<GameButton Variant="options-apply-button" OnClick="@ApplyOptions">Apply</GameButton>
				</div>
			</div>
			<ConfirmationDialog
				IsOpen="@IsCloseConfirmationOpen"
				Title="Unsaved settings"
				Message="Are you sure you want to close without saving?"
				ConfirmLabel="Yes"
				CancelLabel="No"
				OnConfirm="@ConfirmCloseWithoutSaving"
				OnCancel="@CancelCloseWithoutSaving">
			</ConfirmationDialog>
		</div>
	}
</root>

@code
{
	[Parameter] public bool IsOpen { get; set; }
	[Parameter] public Action OnClose { get; set; }
	[Parameter] public bool UseBlurBackdrop { get; set; }
	private Panel OptionsScrollPanel = null!;
	private int revision;
	private bool wasOpen;
	private bool isCloseConfirmationOpen;
	private AppSettingsData openingSettingsSnapshot;

	private string RootClasses => IsOpen ? "options-menu-root open" : "options-menu-root";
	private string OptionsScreenClasses => UseBlurBackdrop ? "options-screen blur-backdrop" : "options-screen";
	private bool IsCloseConfirmationOpen => IsOpen && isCloseConfirmationOpen;
	private bool HasUnsavedChanges => openingSettingsSnapshot is not null && !AppSettings.Matches( openingSettingsSnapshot );
	private bool SettingsAvailable => AppSettings.SettingsAvailable;
	private bool ShouldShowSettingsUnavailableWarning => !SettingsAvailable;
	private string UnavailableMessage => "s&box is not exposing render settings here. Try standalone mode if this is the editor.";

	protected override void OnParametersSet()
	{
		base.OnParametersSet();

		if ( IsOpen && !wasOpen )
			CaptureOpeningSettings();
		else if ( !IsOpen && wasOpen )
			isCloseConfirmationOpen = false;

		wasOpen = IsOpen;
	}

	private IEnumerable<string> GetSectionsForCategory( AppSettingCategory category )
	{
		return AppSettingsSchema.GetSectionsForCategory( category?.Key ?? "" );
	}

	private bool HasSectionsForCategory( AppSettingCategory category )
	{
		return GetSectionsForCategory( category ).Any();
	}

	private IEnumerable<AppSettingOption> GetOptionsForSection( string categoryKey, string section )
	{
		return AppSettingsSchema.GetOptionsForSection( categoryKey, section );
	}

	private static bool IsOptionAvailable( AppSettingOption option )
	{
		return option?.IsAvailable?.Invoke() == true;
	}

	private static bool GetBoolValue( AppSettingOption option )
	{
		return option?.GetBoolValue?.Invoke() == true;
	}

	private void ToggleBoolOption( AppSettingOption option )
	{
		ApplySetting( option?.ToggleBoolValue?.Invoke() == true );
	}

	private static string GetEnumValue( AppSettingOption option )
	{
		return option?.GetEnumValue?.Invoke() ?? "";
	}

	private void SetEnumValue( AppSettingOption option, string rawValue )
	{
		ApplySetting( option?.SetEnumValue?.Invoke( rawValue ) == true );
	}

	private static int GetIntValue( AppSettingOption option )
	{
		return option?.GetIntValue?.Invoke() ?? 0;
	}

	private void SetIntValue( AppSettingOption option, float rawValue )
	{
		ApplySetting( option?.SetIntValue?.Invoke( (int)MathF.Round( rawValue ) ) == true );
	}

	private string GetOptionStatusText( AppSettingOption option )
	{
		if ( IsOptionAvailable( option ) )
			return option?.Description ?? "";

		return $"{option?.Description} Unavailable in this session.";
	}

	private void ApplyOptions()
	{
		if ( !AppSettings.TryApply() )
			return;

		openingSettingsSnapshot = AppSettings.Capture();
		isCloseConfirmationOpen = false;
		revision++;
		StateHasChanged();
	}

	private void Close()
	{
		DropdownButton.CloseOpenDropdown();

		if ( HasUnsavedChanges )
		{
			isCloseConfirmationOpen = true;
			revision++;
			StateHasChanged();
			return;
		}

		CloseWithoutRestoring();
	}

	private void ConfirmCloseWithoutSaving()
	{
		if ( openingSettingsSnapshot is not null )
			AppSettings.Restore( openingSettingsSnapshot );

		isCloseConfirmationOpen = false;
		revision++;
		CloseWithoutRestoring();
	}

	private void CancelCloseWithoutSaving()
	{
		isCloseConfirmationOpen = false;
		revision++;
		StateHasChanged();
	}

	private void CloseWithoutRestoring()
	{
		isCloseConfirmationOpen = false;
		OnClose?.Invoke();
	}

	private void ApplySetting( bool applied )
	{
		if ( !applied )
			return;

		AppSettings.Apply();
		revision++;
		StateHasChanged();
	}

	private void CaptureOpeningSettings()
	{
		openingSettingsSnapshot = AppSettings.Capture();
		isCloseConfirmationOpen = false;
	}

	private static string GetToggleButtonClasses( bool enabled )
	{
		return enabled ? "options-toggle-button selected" : "options-toggle-button";
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsOpen );
		hash.Add( revision );
		hash.Add( SettingsAvailable );

		foreach ( var option in AppSettingsSchema.Options )
		{
			hash.Add( option.Key );
			hash.Add( option.IsVisible() );
			hash.Add( option.IsAvailable() );
			hash.Add( option.Kind switch
			{
				AppSettingOptionKind.Bool => GetBoolValue( option ).ToString(),
				AppSettingOptionKind.Int => GetIntValue( option ).ToString(),
				_ => GetEnumValue( option )
			} );
		}

		return hash.ToHashCode();
	}
}
