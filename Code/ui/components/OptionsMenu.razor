@using Sandbox;
@using Sandbox.UI;
@using Sandbox.Engine.Settings;
@using Sandbox.ui.components.buttons
@using System;
@inherits Panel

<root class="@RootClasses">
	@if ( IsOpen )
	{
		<div class="options-screen">
			<div class="options-panel">
				<div class="options-header">
					<div>
						<div class="options-kicker">Settings</div>
						<div class="options-title">Options</div>
					</div>
					<GameButton Variant="options-close-button" Title="Close" OnClick="@Close">X</GameButton>
				</div>

				<div class="options-scroll-shell">
					<div class="options-scroll-panel monopory-scroll-both" @ref="OptionsScrollPanel">
						@if ( !SettingsAvailable )
						{
							<div class="options-unavailable">Video settings are only available when s&box exposes render settings for this session.</div>
						}

						<div class="options-category-strip">
							@foreach ( var category in AppSettingsSchema.Categories )
							{
								<GameButton Variant="@GetCategoryButtonClasses( category )" OnClick="@(() => SelectCategory( category.Key ))">
									@category.Label
								</GameButton>
							}
						</div>

						<div class="options-category-copy">@ActiveCategory?.Description</div>

						@if ( HasActiveSections )
						{
							@foreach ( var sectionName in ActiveSections )
							{
								<div class="options-section">
									<div class="options-section-title">@sectionName</div>

									@foreach ( var option in GetOptionsForSection( sectionName ) )
									{
										<div class="options-row">
											<div class="options-text">
												<div class="options-label">@option.Label</div>
												<div class="options-value">@GetOptionStatusText( option )</div>
											</div>
											<div class="options-control">
												@if ( option.Kind == AppSettingOptionKind.Bool )
												{
													<GameButton Variant="@GetToggleButtonClasses( GetBoolValue( option ) )" CanClick="@IsOptionAvailable( option )" OnClick="@(() => ToggleBoolOption( option ))" BlockedPopupTitle="Unavailable" BlockedPopupMessage="@UnavailableMessage">
														@(GetBoolValue( option ) ? "On" : "Off")
													</GameButton>
												}
												else if ( option.Kind == AppSettingOptionKind.Enum )
												{
													<DropdownButton
														Value="@GetEnumValue( option )"
														Items="@option.EnumNames"
														CanClick="@IsOptionAvailable( option )"
														OnSelected="@((string value) => SetEnumValue( option, value ))"
														BlockedPopupTitle="Unavailable"
														BlockedPopupMessage="@UnavailableMessage">
													</DropdownButton>
												}
											</div>
										</div>
									}
								</div>
							}
						}
						else
						{
							<div class="options-empty-state">
								<div class="options-empty-title">@ActiveCategory?.Label</div>
								<div class="options-empty-copy">No settings are wired into this section yet. Add new keys in `AppSettingsSchema` and they will render here automatically.</div>
							</div>
						}
					</div>
					<MonoScrollbar Target="@OptionsScrollPanel"></MonoScrollbar>
				</div>

				<div class="options-footer">
					<GameButton Variant="options-apply-button" CanClick="@SettingsAvailable" OnClick="@ApplyOptions" BlockedPopupTitle="Unavailable" BlockedPopupMessage="@UnavailableMessage">Apply</GameButton>
				</div>
			</div>
		</div>
	}
</root>

@code
{
	[Parameter] public bool IsOpen { get; set; }
	[Parameter] public Action OnClose { get; set; }
	private Panel OptionsScrollPanel = null!;
	private int revision;
	private string activeCategoryKey = AppSettingsSchema.Categories.FirstOrDefault()?.Key ?? "";

	private string RootClasses => IsOpen ? "options-menu-root open" : "options-menu-root";
	private bool SettingsAvailable => AppSettings.SettingsAvailable;
	private string UnavailableMessage => "s&box is not exposing render settings here. Try standalone mode if this is the editor.";
	private AppSettingCategory ActiveCategory => AppSettingsSchema.Categories.FirstOrDefault(
		category => string.Equals( category.Key, activeCategoryKey, StringComparison.Ordinal )
	) ?? AppSettingsSchema.Categories.FirstOrDefault();
	private IEnumerable<string> ActiveSections => AppSettingsSchema.GetSectionsForCategory( ActiveCategory?.Key ?? "" );
	private bool HasActiveSections => ActiveSections.Any();

	protected override void OnParametersSet()
	{
		base.OnParametersSet();

		if ( string.IsNullOrWhiteSpace( activeCategoryKey ) )
			activeCategoryKey = AppSettingsSchema.Categories.FirstOrDefault()?.Key ?? "";
	}

	private void SelectCategory( string categoryKey )
	{
		if ( string.IsNullOrWhiteSpace( categoryKey ) )
			return;

		activeCategoryKey = categoryKey;
	}

	private IEnumerable<AppSettingOption> GetOptionsForSection( string section )
	{
		return AppSettingsSchema.GetOptionsForSection( ActiveCategory?.Key ?? "", section );
	}

	private bool IsCategorySelected( AppSettingCategory category )
	{
		return string.Equals( activeCategoryKey, category?.Key, StringComparison.Ordinal );
	}

	private string GetCategoryButtonClasses( AppSettingCategory category )
	{
		return IsCategorySelected( category )
			? "options-category-button selected"
			: "options-category-button";
	}

	private static bool IsOptionAvailable( AppSettingOption option )
	{
		return option?.IsAvailable?.Invoke() == true;
	}

	private static bool GetBoolValue( AppSettingOption option )
	{
		return option?.GetBoolValue?.Invoke() == true;
	}

	private void ToggleBoolOption( AppSettingOption option )
	{
		ApplySetting( option?.ToggleBoolValue?.Invoke() == true );
	}

	private static string GetEnumValue( AppSettingOption option )
	{
		return option?.GetEnumValue?.Invoke() ?? "";
	}

	private void SetEnumValue( AppSettingOption option, string rawValue )
	{
		ApplySetting( option?.SetEnumValue?.Invoke( rawValue ) == true );
	}

	private string GetOptionStatusText( AppSettingOption option )
	{
		if ( IsOptionAvailable( option ) )
			return option?.Description ?? "";

		return $"{option?.Description} Unavailable in this session.";
	}

	private void ApplyOptions()
	{
		ApplySetting( AppSettings.TryApply() );
	}

	private void Close()
	{
		OnClose?.Invoke();
	}

	private void ApplySetting( bool applied )
	{
		if ( !applied )
			return;

		revision++;
		StateHasChanged();
	}

	private static string GetToggleButtonClasses( bool enabled )
	{
		return enabled ? "options-toggle-button selected" : "options-toggle-button";
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsOpen );
		hash.Add( revision );
		hash.Add( SettingsAvailable );
		hash.Add( activeCategoryKey ?? "" );

		foreach ( var option in AppSettingsSchema.Options )
		{
			hash.Add( option.Key );
			hash.Add( option.IsVisible() );
			hash.Add( option.IsAvailable() );
			hash.Add( option.Kind == AppSettingOptionKind.Bool ? GetBoolValue( option ).ToString() : GetEnumValue( option ) );
		}

		return hash.ToHashCode();
	}
}
