@using Sandbox;
@using Sandbox.UI;
@using Sandbox.ui.components.buttons
@using System;
@using System.Threading.Tasks;
@inherits Panel

<root class="monopoly-popup-stack-root">
	@if ( StandardPopups.Count > 0 )
	{
		<div class="popup-stack">
			<div class="popup-clear-hint">Press C to clear popups</div>
			@foreach ( var renderedPopup in StandardPopups )
			{
				var popup = renderedPopup.Popup;
				<div class="@GetPopupClasses( renderedPopup )">
					<div class="popup-content">
						@if ( !string.IsNullOrWhiteSpace( popup.Title ) )
						{
							<div class="popup-title">@popup.Title</div>
						}
						<div class="popup-message">@popup.Message</div>
					</div>

					@if ( popup.CanDismiss )
					{
						<div class="popup-dismiss">
							<CloseButton OnClick="@(() => Dismiss( popup.Id ))"></CloseButton>
						</div>
					}
				</div>
			}
		</div>
	}

	@if ( ConfirmationPopups.Count > 0 )
	{
		<div class="popup-confirmation-overlay">
			<div class="popup-confirmation-stack">
				@foreach ( var renderedPopup in ConfirmationPopups )
				{
					var popup = renderedPopup.Popup;
					<div class="@GetPopupClasses( renderedPopup )">
						<div class="popup-content">
							@if ( !string.IsNullOrWhiteSpace( popup.Title ) )
							{
								<div class="popup-title">@popup.Title</div>
							}
							<div class="popup-message">@popup.Message</div>
						</div>
						<div class="popup-confirmation-actions">
							<GameButton Variant="popup-confirm-cancel" OnClick="@(() => Confirm( popup.Id, false ))" SoundEnabled="@false" IgnoreGlobalPopupBlock="@true">@popup.CancelLabel</GameButton>
							<GameButton Variant="popup-confirm-accept" OnClick="@(() => Confirm( popup.Id, true ))" SoundEnabled="@false" IgnoreGlobalPopupBlock="@true">@popup.ConfirmLabel</GameButton>
						</div>
					</div>
				}
			</div>
		</div>
	}
</root>

@code
{
	[Parameter] public List<GamePopup> Popups { get; set; } = new();
	[Parameter] public Action<int> OnDismiss { get; set; }
	[Parameter] public Action<int, bool> OnConfirmDecision { get; set; }

	private const float OutroDuration = 0.13f;
	private readonly List<RenderedPopup> renderedPopups = new();

	private List<RenderedPopup> RenderedPopups
	{
		get
		{
			SyncRenderedPopups();
			return renderedPopups;
		}
	}

	private List<RenderedPopup> StandardPopups =>
		RenderedPopups.Where( popup => popup.Popup.Kind != PopupKind.Confirmation ).ToList();

	private List<RenderedPopup> ConfirmationPopups =>
		RenderedPopups.Where( popup => popup.Popup.Kind == PopupKind.Confirmation ).ToList();

	private static string GetPopupClasses( RenderedPopup renderedPopup )
	{
		var popup = renderedPopup.Popup;
		var closingClass = renderedPopup.IsClosing ? " closing" : "";
		var lineClass = popup.Kind == PopupKind.Confirmation ? $" confirmation-lines-{GetEstimatedConfirmationMessageLines( popup )}" : "";
		return $"game-popup {popup.Kind.ToString().ToLower()}{lineClass}{closingClass}";
	}

	private static int GetEstimatedConfirmationMessageLines( GamePopup popup )
	{
		var message = popup?.Message ?? "";
		var explicitLines = Math.Max( 1, message.Count( character => character == '\n' ) + 1 );
		var longestLine = message.Replace( "\r", "" ).Split( '\n' ).DefaultIfEmpty( "" ).Max( line => line.Length );
		var wrappedLines = Math.Max( 1, (int)MathF.Ceiling( longestLine / 42f ) );
		return Math.Clamp( Math.Max( explicitLines, wrappedLines ), 1, 5 );
	}

	private void Dismiss( int popupId )
	{
		BeginClosing( popupId );
		OnDismiss?.Invoke( popupId );
		Popups.RemoveAll( popup => popup.Id == popupId );
		StateHasChanged();
	}

	private void Confirm( int popupId, bool confirmed )
	{
		BeginClosing( popupId );
		OnConfirmDecision?.Invoke( popupId, confirmed );
		Popups.RemoveAll( popup => popup.Id == popupId );
		StateHasChanged();
	}

	private void SyncRenderedPopups()
	{
		var sourcePopups = Popups ?? new();
		var sourceIds = sourcePopups.Select( popup => popup.Id ).ToHashSet();

		foreach ( var popup in sourcePopups )
		{
			var renderedPopup = renderedPopups.FirstOrDefault( item => item.Popup.Id == popup.Id );
			if ( renderedPopup is null )
			{
				renderedPopups.Add( new RenderedPopup
				{
					Popup = CopyPopup( popup )
				} );
				_ = DismissAfterLifetime( popup.Id, popup.Lifetime );
				continue;
			}

			if ( renderedPopup.IsClosing )
				continue;

			renderedPopup.Popup = CopyPopup( popup );
		}

		foreach ( var renderedPopup in renderedPopups )
		{
			if ( !sourceIds.Contains( renderedPopup.Popup.Id ) )
				BeginClosing( renderedPopup );
		}
	}

	private void BeginClosing( int popupId )
	{
		var renderedPopup = renderedPopups.FirstOrDefault( item => item.Popup.Id == popupId );
		if ( renderedPopup is not null )
			BeginClosing( renderedPopup );
	}

	private void BeginClosing( RenderedPopup renderedPopup )
	{
		if ( renderedPopup.IsClosing )
			return;

		renderedPopup.IsClosing = true;
		_ = RemoveAfterOutro( renderedPopup.Popup.Id );
	}

	private async Task RemoveAfterOutro( int popupId )
	{
		await Task.DelaySeconds( OutroDuration );

		renderedPopups.RemoveAll( popup => popup.Popup.Id == popupId && popup.IsClosing );
		StateHasChanged();
	}

	private async Task DismissAfterLifetime( int popupId, float lifetime )
	{
		if ( lifetime <= 0f )
			return;

		await Task.DelaySeconds( lifetime );

		var renderedPopup = renderedPopups.FirstOrDefault( popup => popup.Popup.Id == popupId );
		if ( renderedPopup is null || renderedPopup.IsClosing )
			return;

		Dismiss( popupId );
	}

	private static GamePopup CopyPopup( GamePopup popup )
	{
		return new GamePopup
		{
			Id = popup.Id,
			Title = popup.Title,
			Message = popup.Message,
			Kind = popup.Kind,
			CanDismiss = popup.CanDismiss,
			Lifetime = popup.Lifetime,
			IsBlocking = popup.IsBlocking,
			ConfirmLabel = popup.ConfirmLabel,
			CancelLabel = popup.CancelLabel
		};
	}

	private sealed class RenderedPopup
	{
		public GamePopup Popup { get; set; }
		public bool IsClosing { get; set; }
	}
}
