@using Sandbox;
@using Sandbox.UI;
@using System;
@inherits Panel

@if ( Space is not null )
{
	<root class="@RootClasses">
		<div class="monopoly-space-card-outline"></div>
		<div class="monopoly-space-card-inner">
			@if ( OverlayContent is not null )
			{
				<div class="monopoly-space-card-overlay">
					@OverlayContent
				</div>
			}

			@if ( IsShowingDrawnCardText )
			{
				<div class="monopoly-drawn-space-card-text">@DrawnCardDisplayText</div>
			}
			else if ( IsDrawnCardSpace )
			{
				<div class="@CardSpaceArtClasses">
					@if ( GetSpaceCardIconType() == SpaceCardIconType.Image )
					{
						<img class="monopoly-card-space-image-icon" src="@GetSpaceCardIconImagePath()" />
					}
					else
					{
						@RenderChestArt()
					}
				</div>
			}
			else if ( HasSpecialTitle )
			{
				<div class="monopoly-special-title">
					@SpecialIcon()
					<div class="monopoly-space-card-name">@Space.DisplayName</div>
				</div>
			}
			else
			{
				<div class="monopoly-space-card-header">
					<div class="monopoly-space-card-type">@Space.Type</div>
					<div class="monopoly-space-card-name">@Space.DisplayName</div>
				</div>
			}

			@if ( !IsShowingDrawnCardText && ShowFreeParkingBank )
			{
				<div class="monopoly-space-card-status">
					<div class="monopoly-space-card-status-title">Free Parking Bank</div>
					<div class="monopoly-space-card-status-value">$@FreeParkingBank</div>
				</div>
			}

			@if ( !IsShowingDrawnCardText && Space.Type == SpaceType.Property )
			{
				<div class="monopoly-space-card-rents property-rents">
					<div><span>with rent</span><span>$@Space.BaseRent</span></div>
					<div><span>with one house</span><span>$@Space.OneHouseRent</span></div>
					<div><span>with two houses</span><span>$@Space.TwoHouseRent</span></div>
					<div><span>with three houses</span><span>$@Space.ThreeHouseRent</span></div>
					<div><span>with four houses</span><span>$@Space.FourHouseRent</span></div>
					<div><span>with a hotel</span><span>$@Space.HotelRent</span></div>
				</div>
			}
			else if ( Space.Type == SpaceType.Railroad )
			{
				<div class="monopoly-special-card railroad-card">
					<div class="monopoly-special-rules">
						<div><span>Rent</span><span>$@RailroadRentOne</span></div>
						<div><span>If 2 railroads are owned</span><span>$@RailroadRentTwo</span></div>
						<div><span>If 3 railroads are owned</span><span>$@RailroadRentThree</span></div>
						<div><span>If 4 railroads are owned</span><span>$@RailroadRentFour</span></div>
					</div>
					<div class="monopoly-special-mortgage">Mortgage value @MortgageValueLabel</div>
				</div>
			}
			else if ( Space.Type == SpaceType.Utility )
			{
				<div class="monopoly-special-card utility-card">
					<div class="monopoly-special-rules utility-rules">
						<div>If one utility is owned, rent is @UtilityRentOneText the amount shown on dice.</div>
						<div>If both utilities are owned, rent is @UtilityRentBothText the amount shown on dice.</div>
					</div>
					<div class="monopoly-special-mortgage">Mortgage value @MortgageValueLabel</div>
				</div>
			}
			else if ( !IsDrawnCardSpace )
			{
				<div class="monopoly-space-card-rents summary-rents">
					<div><span>listed price</span><span>@PriceLabel</span></div>
					<div><span>space type</span><span>@Space.Type</span></div>
				</div>
			}

			@if ( !IsShowingDrawnCardText && ShowImprovementCount )
			{
				<div class="monopoly-space-card-improvements">
					<img class="monopoly-space-card-house-icon" src="ui/house-placeholder.svg" />
					<span>Current houses: @ImprovementLabel</span>
				</div>
			}

			@if ( !IsShowingDrawnCardText && FooterContent is not null )
			{
				<div class="monopoly-space-card-footer">
					@FooterContent
				</div>
			}

			@if ( !IsShowingDrawnCardText && HasActions && ChildContent is not null )
			{
				<div class="monopoly-space-card-actions">
					@ChildContent
				</div>
			}

			@if ( !IsShowingDrawnCardText && IsMortgaged )
			{
				<div class="monopoly-space-card-stamp">Mortgaged</div>
			}
		</div>
	</root>
}

@code
{
	[Parameter] public SpaceDef Space { get; set; }
	[Parameter] public string Variant { get; set; } = "";
	[Parameter] public string ColorClass { get; set; } = "none";
	[Parameter] public bool IsMortgaged { get; set; }
	[Parameter] public bool ShowFreeParkingBank { get; set; }
	[Parameter] public int FreeParkingBank { get; set; }
	[Parameter] public bool ShowImprovementCount { get; set; }
	[Parameter] public bool HasActions { get; set; } = true;
	[Parameter] public string ImprovementLabel { get; set; } = "";
	[Parameter] public string DrawnCardText { get; set; } = "";
	[Parameter] public RenderFragment OverlayContent { get; set; }
	[Parameter] public RenderFragment FooterContent { get; set; }
	[Parameter] public new RenderFragment ChildContent { get; set; }

	private string RootClasses =>
		string.IsNullOrWhiteSpace( Variant )
			? $"monopoly-space-card {StateClasses} {DrawnCardClasses} color-{ColorClass}"
			: $"monopoly-space-card {Variant} {StateClasses} {DrawnCardClasses} color-{ColorClass}";

	private string StateClasses =>
		IsMortgaged ? "is-mortgaged" : "";

	private string DrawnCardClasses =>
		IsShowingDrawnCardText ? "drawn-space-card" : "";

	private bool IsDrawnCardSpace =>
		Space.Type is SpaceType.Chance or SpaceType.CommunityChest;

	private bool IsShowingDrawnCardText =>
		IsDrawnCardSpace && !string.IsNullOrWhiteSpace( DrawnCardText );

	private string DrawnCardDisplayText =>
		DrawnCardText;

	private string CardSpaceArtClasses =>
		Space.Type == SpaceType.Chance
			? "monopoly-card-space-art chance-space-art"
			: "monopoly-card-space-art chest-space-art";

	private enum SpaceCardIconType
	{
		Image,
		Text
	}

	private SpaceCardIconType GetSpaceCardIconType()
	{
		return Space.Type switch
		{
			SpaceType.Chance => SpaceCardIconType.Image,
			SpaceType.CommunityChest => SpaceCardIconType.Text,
			_ => SpaceCardIconType.Text
		};
	}

	private string GetSpaceCardIconText()
	{
		return Space.Type switch
		{
			SpaceType.Chance => "?",
			_ => ""
		};
	}

	private RenderFragment RenderChestArt() => builder =>
	{
		builder.AddMarkupContent(
			0,
			"<div class=\"monopoly-chest-art\">" +
			"<div class=\"monopoly-chest-lid\"></div>" +
			"<div class=\"monopoly-chest-body\"></div>" +
			"<div class=\"monopoly-chest-lock\"></div>" +
			"</div>" );
	};

	private string GetSpaceCardIconImagePath()
	{
		return Space.Type == SpaceType.Chance
			? GameAssets.Images.Chance.Path
			: "";
	}

	private bool HasSpecialTitle =>
		Space.Type is SpaceType.Railroad or SpaceType.Utility;

	private string PriceLabel =>
		Space.Price > 0 ? $"${Space.Price}" : "-";

	private string MortgageValueLabel =>
		Space.Price > 0 ? $"${Space.Price / 2}" : "-";

	private RailroadDef RailroadData =>
		Board.Instance?.RailroadData ?? BoardData.CreateRailroadDefs();

	private UtilityDef UtilityData =>
		Board.Instance?.UtilityData ?? BoardData.CreateUtilityDefs();

	private int RailroadRentOne => Math.Max( RailroadData.OneOwnedRent, 0 );
	private int RailroadRentTwo => RailroadData.TwoOwnedRent;
	private int RailroadRentThree => RailroadData.ThreeOwnedRent;
	private int RailroadRentFour => RailroadData.FourOwnedRent;
	private string UtilityRentOneText => $"{UtilityData.OneOwnedMultiplier}x";
	private string UtilityRentBothText => $"{UtilityData.BothOwnedMultiplier}x";

	private RenderFragment SpecialIcon() => builder =>
	{
		if ( Space.Type == SpaceType.Railroad )
		{
			builder.AddMarkupContent(
				0,
				"<div class=\"monopoly-special-icon railroad-icon\">" +
				"<div class=\"railroad-smoke\"></div>" +
				"<div class=\"railroad-engine\">" +
				"<div class=\"railroad-cab\"></div>" +
				"<div class=\"railroad-body\"></div>" +
				"</div>" +
				"<div class=\"railroad-wheels\">" +
				"<div></div>" +
				"<div></div>" +
				"<div></div>" +
				"</div>" +
				"</div>" );
			return;
		}

		if ( Space.Type == SpaceType.Utility )
		{
			builder.AddMarkupContent(
				1,
				"<div class=\"monopoly-special-icon utility-icon\">" +
				"<div class=\"utility-bolt top\"></div>" +
				"<div class=\"utility-bolt middle\"></div>" +
				"<div class=\"utility-bolt bottom\"></div>" +
				"</div>" );
		}
	};
}
