@using Sandbox
@using Sandbox.UI
@using System
@inherits Panel

<root class="dropdown-overlay-layer">
	@if ( DropdownOverlayState.IsOpen )
	{
		<div class="dropdown-menu dropdown-overlay-menu" style="@MenuStyle" @ref="MenuPanel">
			@foreach ( var item in DropdownOverlayState.Items )
			{
				<GameButton Variant="@GetItemClasses( item )" OnClick="@(() => SelectItem( item ))" SoundEnabled="@DropdownOverlayState.SoundEnabled">
					<ChildContent>
						<span class="dropdown-item-label">@FormatItem( item )</span>
					</ChildContent>
				</GameButton>
			}
		</div>
	}
</root>

@code
{
	private Panel MenuPanel = null!;
	private int SeenVersion;
	private float CloseAfterMouseLeaveAt;
	private int ScrollMeasureFramesRemaining;
	private int SmoothScrollFramesRemaining;
	private float SmoothScrollTargetY;

	private string MenuStyle
	{
		get
		{
			var anchor = DropdownOverlayState.AnchorRect;
			return $"left: {anchor.Left:0.###}px; top: {anchor.Bottom + 8f:0.###}px; width: {anchor.Width:0.###}px;";
		}
	}

	public override void Tick()
	{
		base.Tick();

		if ( SeenVersion != DropdownOverlayState.Version )
		{
			SeenVersion = DropdownOverlayState.Version;
			CloseAfterMouseLeaveAt = 0f;
			ScrollMeasureFramesRemaining = DropdownOverlayState.IsOpen ? 3 : 0;
			SmoothScrollFramesRemaining = 0;
			StateHasChanged();
		}

		if ( !DropdownOverlayState.IsOpen )
			return;

		UpdateHoverClose();

		if ( !DropdownOverlayState.IsOpen )
			return;

		if ( ScrollMeasureFramesRemaining > 0 )
		{
			ScrollMeasureFramesRemaining--;
			MeasureScrollTarget();
		}

		UpdateSmoothScroll();
	}

	private void SelectItem( string item )
	{
		DropdownOverlayState.Select( item );
		StateHasChanged();
	}

	private void UpdateHoverClose()
	{
		if ( IsMouseInsideOpenDropdown() )
		{
			CloseAfterMouseLeaveAt = 0f;
			return;
		}

		if ( CloseAfterMouseLeaveAt <= 0f )
			CloseAfterMouseLeaveAt = Time.Now + 0.35f;

		if ( Time.Now >= CloseAfterMouseLeaveAt )
		{
			DropdownOverlayState.Close();
			StateHasChanged();
		}
	}

	private void MeasureScrollTarget()
	{
		var scrollTarget = DropdownOverlayState.ScrollTarget;
		if ( scrollTarget is null || MenuPanel is null )
			return;

		var viewport = scrollTarget.Box.RectInner;
		var menu = MenuPanel.Box.Rect;
		var overflow = menu.Bottom - viewport.Bottom + 10f;
		if ( overflow <= 0f )
			return;

		var maxOffset = Math.Max( 0f, scrollTarget.ScrollSize.y );
		SmoothScrollTargetY = Math.Clamp( scrollTarget.ScrollOffset.y + overflow, 0f, maxOffset );
		SmoothScrollFramesRemaining = 10;
	}

	private void UpdateSmoothScroll()
	{
		var scrollTarget = DropdownOverlayState.ScrollTarget;
		if ( SmoothScrollFramesRemaining <= 0 || scrollTarget is null )
			return;

		var currentY = scrollTarget.ScrollOffset.y;
		var delta = SmoothScrollTargetY - currentY;
		if ( MathF.Abs( delta ) <= 0.5f || SmoothScrollFramesRemaining == 1 )
		{
			scrollTarget.ScrollOffset = new Vector2( 0f, SmoothScrollTargetY );
			SmoothScrollFramesRemaining = 0;
			return;
		}

		scrollTarget.ScrollOffset = new Vector2( 0f, currentY + delta * 0.28f );
		SmoothScrollFramesRemaining--;
	}

	private bool IsMouseInsideOpenDropdown()
	{
		var position = Mouse.Position;
		return IsPointInside( DropdownOverlayState.AnchorRect, position )
			|| (MenuPanel is not null && IsPointInside( MenuPanel.Box.Rect, position ));
	}

	private static bool IsPointInside( Rect rect, Vector2 point )
	{
		return point.x >= rect.Left
			&& point.x <= rect.Right
			&& point.y >= rect.Top
			&& point.y <= rect.Bottom;
	}

	private static string GetItemClasses( string item )
	{
		return string.Equals( item, DropdownOverlayState.Value, StringComparison.OrdinalIgnoreCase )
			? "dropdown-item selected"
			: "dropdown-item";
	}

	private static string FormatItem( string item )
	{
		if ( string.IsNullOrWhiteSpace( item ) )
			return "";

		var label = item.Replace( "_", " " );
		for ( var i = label.Length - 1; i > 0; i-- )
		{
			if ( char.IsUpper( label[i] ) && !char.IsWhiteSpace( label[i - 1] ) )
				label = label.Insert( i, " " );
		}

		return label;
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( DropdownOverlayState.Version );
		hash.Add( DropdownOverlayState.ActiveId );
		hash.Add( DropdownOverlayState.Value ?? "" );
		hash.Add( MenuStyle );

		foreach ( var item in DropdownOverlayState.Items )
			hash.Add( item ?? "" );

		return hash.ToHashCode();
	}
}
