@using Sandbox;
@using Sandbox.UI;
@using System;
@inherits Button

<root class="@RootClasses" title="@Title" onclick="@HandleClick" onrightclick="@HandleRightClick" onmousedown="@HandlePressStart" onmouseup="@HandlePressEnd" onmouseover="@HandleMouseEnter" onmouseout="@HandleMouseLeave">
	@if ( ShouldShowInputActionIcon )
	{
		<div class="monopoly-button-input-action-icon" style="@InputActionIconStyle"></div>
		<div class="monopoly-button-content">
			@ChildContent
		</div>
	}
	else
	{
		@ChildContent
	}
</root>

@code
{
	[Parameter] public string Variant { get; set; } = "";
	[Parameter] public string Title { get; set; } = "";
	[Parameter] public bool SoundEnabled { get; set; } = true;
	[Parameter] public bool CanClick { get; set; } = true;
	[Parameter] public bool ShowBlockedPopup { get; set; } = true;
	[Parameter] public string BlockedPopupTitle { get; set; } = "Action blocked";
	[Parameter] public string BlockedPopupMessage { get; set; } = "This action is not available right now.";
	[Parameter] public PopupKind BlockedPopupKind { get; set; } = PopupKind.Warning;
	[Parameter] public float BlockedPopupLifetime { get; set; } = 3f;
	[Parameter] public bool IgnoreGlobalPopupBlock { get; set; }
	[Parameter] public GameSound Sound { get; set; } = GameAssets.Sounds.Click;
	[Parameter] public GameSound BlockedSound { get; set; } = GameAssets.Sounds.Error;
	[Parameter] public Action<float> OnHoldComplete { get; set; }
	[Parameter] public float HoldMaxSeconds { get; set; } = 1.25f;
	[Parameter] public new Action OnClick { get; set; }
	[Parameter] public new Action OnRightClick { get; set; }
	[Parameter] public Action OnBlocked { get; set; }
	[Parameter] public new RenderFragment ChildContent { get; set; }
	[Parameter] public InputAction KeyboardInputAction { get; set; }
	[Parameter] public string InputActionIconColor { get; set; } = "";

	private bool isPressing;
	private float pressStartedAt;
	private bool isHovering = false;

	public bool IsHolding => isPressing;

	protected string RootClasses
	{
		get
		{
			var classes = string.IsNullOrWhiteSpace( Variant )
				? "monopoly-button"
				: $"monopoly-button {Variant}";

			if ( isPressing && OnHoldComplete is not null )
				classes += " hold-capture-active";

			if ( ShouldShowInputActionIcon )
				classes += " has-input-action-icon";

			return classes;
		}
	}

	public float HoldProgress
	{
		get
		{
			if ( !isPressing )
				return 0f;

			var heldSeconds = Math.Max( Time.Now - pressStartedAt, 0f );
			return HoldMaxSeconds <= 0f ? 1f : Math.Clamp( heldSeconds / HoldMaxSeconds, 0f, 1f );
		}
	}

	private bool ShouldPlayClickSound =>
		SoundEnabled &&
		!HasVariantClass( "blocked-action-button" ) &&
		!HasVariantClass( "disabled" );
	private bool ShouldShowInputActionIcon => InputActionIcon is not null;
	private bool UseOutlineInputActionIcon => MonopolyApp.InputActionIconType == InputActionIconType.Outline;
	private GameIcon InputActionIcon => GetInputActionIcon();
	private string InputActionIconStyle => GetInputActionIconStyle();

	protected void HandleClick()
	{
		if ( OnHoldComplete is not null )
			return;

		if ( Disabled )
			return;

		if ( GameController.Instance?.HasBlockingPopup == true && !IgnoreGlobalPopupBlock )
			return;

		ButtonPopEffects.Show( Mouse.Position );

		if ( !CanClick )
		{
			PlayBlockedActionSound();
			ShowBlockedActionPopup();
			OnBlocked?.Invoke();
			return;
		}

		if ( ShouldPlayClickSound )
			Sound.Play();

		OnClick?.Invoke();
	}

	protected void HandleRightClick()
	{
		if ( GameController.Instance?.HasBlockingPopup == true && !IgnoreGlobalPopupBlock )
			return;

		ButtonPopEffects.Show( Mouse.Position );

		if ( !CanClick )
		{
			PlayBlockedActionSound();
			ShowBlockedActionPopup();
			OnBlocked?.Invoke();
			return;
		}

		if ( ShouldPlayClickSound )
			Sound.Play();

		OnRightClick?.Invoke();
	}

	private void HandlePressStart()
	{
		if ( OnHoldComplete is null || Disabled )
			return;

		isPressing = true;
		isHovering = true;
		pressStartedAt = Time.Now;
		StateHasChanged();
	}

	private void HandlePressEnd()
	{
		if ( OnHoldComplete is null || !isPressing )
			return;

		StopHolding();

		Log.Info(isHovering);

		if (!isHovering)
			return;

		var heldSeconds = Math.Max( Time.Now - pressStartedAt, 0f );
		var strength = HoldMaxSeconds <= 0f ? 1f : Math.Clamp( heldSeconds / HoldMaxSeconds, 0f, 1f );

		ButtonPopEffects.Show( Mouse.Position );

		if ( GameController.Instance?.HasBlockingPopup == true && !IgnoreGlobalPopupBlock )
			return;

		if ( !CanClick )
		{
			PlayBlockedActionSound();
			ShowBlockedActionPopup();
			OnBlocked?.Invoke();
			return;
		}

		if ( ShouldPlayClickSound )
			Sound.Play();

		OnHoldComplete?.Invoke( strength );
	}

	private void HandleMouseEnter()
	{
		isHovering = true;	
	}

	private void HandleMouseLeave()
	{
		isHovering = false;
		StopHolding();
	}

	private void CancelHold()
	{
		StopHolding();
	}

	private void StopHolding()
	{
		if ( !isPressing )
			return;

		isPressing = false;
		StateHasChanged();
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( Variant );
		hash.Add( Title );
		hash.Add( CanClick );
		hash.Add( Disabled );
		hash.Add( isPressing );
		hash.Add( KeyboardInputAction?.KeyboardCode );
		hash.Add( InputActionIconColor );
		hash.Add( MonopolyApp.InputActionIconType );

		if ( isPressing )
			hash.Add( MathF.Round( Time.Now * 60f ) );

		return hash.ToHashCode();
	}

	private bool HasVariantClass( string className )
	{
		if ( string.IsNullOrWhiteSpace( Variant ) )
			return false;

		return $" {Variant} ".Contains( $" {className} " );
	}

	private GameIcon GetInputActionIcon()
	{
		var keyboardCode = KeyboardInputAction?.KeyboardCode;
		if ( string.IsNullOrWhiteSpace( keyboardCode ) )
			return null;

		return IsMouseKeyboardCode( keyboardCode )
			? GameAssets.MouseIcons.Get( keyboardCode, UseOutlineInputActionIcon )
			: GameAssets.KeyboardIcons.Get( keyboardCode, UseOutlineInputActionIcon );
	}

	private static bool IsMouseKeyboardCode( string keyboardCode )
	{
		var code = (keyboardCode ?? "").Trim();
		return code.StartsWith( "mouse", StringComparison.OrdinalIgnoreCase );
	}

	private string GetInputActionIconStyle()
	{
		var icon = InputActionIcon;
		if ( icon is null )
			return "";

		var style = $"mask-image: url({icon.Path});";
		if ( !string.IsNullOrWhiteSpace( InputActionIconColor ) )
			style += $" background-color: {InputActionIconColor};";

		return style;
	}

	private void ShowBlockedActionPopup()
	{
		if ( !ShowBlockedPopup )
			return;

		GameController.Instance?.ShowLocalPopup(
			BlockedPopupTitle,
			BlockedPopupMessage,
			BlockedPopupKind,
			true,
			BlockedPopupLifetime,
			false
		);
	}

	private void PlayBlockedActionSound()
	{
		if ( !SoundEnabled )
			return;

		BlockedSound.Play();
	}
}
