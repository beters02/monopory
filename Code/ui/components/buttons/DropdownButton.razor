@using Sandbox;
@using Sandbox.UI;
@using Sandbox.ui.components;
@using System;
@inherits Panel

<root class="@RootClasses">
	<GameButton
		Variant="@ButtonClasses"
		Title="@Title"
		CanClick="@CanClick"
		OnClick="@ToggleOpen"
		BlockedPopupTitle="@BlockedPopupTitle"
		BlockedPopupMessage="@BlockedPopupMessage"
		BlockedPopupKind="@BlockedPopupKind"
		BlockedPopupLifetime="@BlockedPopupLifetime"
		SoundEnabled="@SoundEnabled">
		<ChildContent>
			<span class="dropdown-label">@DisplayLabel</span>
			<span class="dropdown-caret">v</span>
		</ChildContent>
	</GameButton>

	@if ( IsOpen )
	{
		<div class="dropdown-dismiss-layer" onclick="@(() => CloseOpenDropdown( InstanceId ))"></div>
		<div class="@MenuClasses" @ref="MenuPanel">
			@foreach ( var item in Items )
			{
				<Tooltip Variant="dropdown-item-tooltip"
					PlacementMode="@TooltipPlacementMode.AroundTarget"
					Enabled="@(!string.IsNullOrWhiteSpace( GetItemTooltip( item ) ))"
					RequestKey="@GetItemTooltipKey( item )"
					Title="@FormatItem( item )"
					Message="@GetItemTooltip( item )">
					<ChildContent>
						<GameButton Variant="@GetItemClasses( item )" OnClick="@(() => SelectItem( item ))" SoundEnabled="@SoundEnabled">
							<ChildContent>
								<span class="dropdown-item-label">@FormatItem( item )</span>
							</ChildContent>
						</GameButton>
					</ChildContent>
				</Tooltip>
			}
		</div>
		@if ( MenuCanScroll )
		{
			<MonoScrollbar Target="@MenuPanel" Variant="dropdown-scrollbar"></MonoScrollbar>
		}
	}
</root>

@code
{
	[Parameter] public string Variant { get; set; } = "";
	[Parameter] public string Title { get; set; } = "";
	[Parameter] public string Placeholder { get; set; } = "Select";
	[Parameter] public string Value { get; set; } = "";
	[Parameter] public IReadOnlyList<string> Items { get; set; } = Array.Empty<string>();
	[Parameter] public Func<string, string> ItemFormatter { get; set; }
	[Parameter] public Func<string, string> ItemTooltipProvider { get; set; }
	[Parameter] public string TooltipRequestKey { get; set; } = "";
	[Parameter] public bool CanClick { get; set; } = true;
	[Parameter] public bool SoundEnabled { get; set; } = true;
	[Parameter] public string BlockedPopupTitle { get; set; } = "Action blocked";
	[Parameter] public string BlockedPopupMessage { get; set; } = "This action is not available right now.";
	[Parameter] public PopupKind BlockedPopupKind { get; set; } = PopupKind.Warning;
	[Parameter] public float BlockedPopupLifetime { get; set; } = 3f;
	[Parameter] public Panel ScrollTarget { get; set; }
	[Parameter] public Action<string> OnSelected { get; set; }

	private static int NextInstanceId;
	private static int ActiveInstanceId;
	private static int OpenVersion;
	private const int MaxVisibleItems = 5;

	private readonly int InstanceId = ++NextInstanceId;
	private Panel MenuPanel = null!;
	private int SeenOpenVersion;
	private float CloseAfterMouseLeaveAt;
	private int ScrollMeasureFramesRemaining;
	private int SmoothScrollFramesRemaining;
	private float SmoothScrollTargetY;

	private bool IsOpen => ActiveInstanceId == InstanceId;
	private string RootClasses => IsOpen ? "dropdown-button open" : "dropdown-button";
	private bool MenuCanScroll => (Items?.Count ?? 0) > MaxVisibleItems;
	private string MenuClasses => MenuCanScroll ? "dropdown-menu scrollable" : "dropdown-menu";
	//private string MenuStyle => $"height: {GetMenuHeight()}px; min-height: {GetMenuHeight()}px;";
	private string ButtonClasses => string.IsNullOrWhiteSpace( Variant )
		? "dropdown-toggle"
		: $"dropdown-toggle {Variant}";

	private string DisplayLabel => string.IsNullOrWhiteSpace( Value )
		? Placeholder
		: FormatItem( Value );

	private void ToggleOpen()
	{
		if ( !CanClick )
			return;

		if ( IsOpen )
		{
			CloseOpenDropdown( InstanceId );
			return;
		}

		ActiveInstanceId = InstanceId;
		OpenVersion++;
		SeenOpenVersion = OpenVersion;
		CloseAfterMouseLeaveAt = 0f;
		ScrollMeasureFramesRemaining = 3;
		SmoothScrollFramesRemaining = 0;
		StateHasChanged();
	}

	public static void CloseOpenDropdown( int id = 0 )
	{
		if ( id != 0 && ActiveInstanceId != id )
			return;

		if ( ActiveInstanceId == 0 )
			return;

		ActiveInstanceId = 0;
		OpenVersion++;
	}

	public override void Tick()
	{
		base.Tick();

		if ( IsOpen )
		{
			UpdateHoverClose();
			ClampMenuScroll();
			MeasureScrollTarget();
			UpdateSmoothScroll();
		}

		if ( SeenOpenVersion != OpenVersion )
		{
			SeenOpenVersion = OpenVersion;
			StateHasChanged();
		}
	}

	private void SelectItem( string item )
	{
		CloseOpenDropdown( InstanceId );
		OnSelected?.Invoke( item );
		StateHasChanged();
	}

	private void ClampMenuScroll()
	{
		if ( MenuPanel is null )
			return;

		var maxOffsetY = MenuCanScroll ? Math.Max( 0f, MenuPanel.ScrollSize.y ) : 0f;
		var currentY = MenuPanel.ScrollOffset.y;
		var nextY = Math.Clamp( currentY, 0f, maxOffsetY );

		if ( MathF.Abs( currentY - nextY ) > 0.1f )
			MenuPanel.ScrollOffset = new Vector2( 0f, nextY );
	}

	private void UpdateHoverClose()
	{
		if ( IsMouseInsideOpenDropdown() )
		{
			CloseAfterMouseLeaveAt = 0f;
			return;
		}

		if ( CloseAfterMouseLeaveAt <= 0f )
			CloseAfterMouseLeaveAt = Time.Now + 0.35f;

		if ( Time.Now >= CloseAfterMouseLeaveAt )
			return;
			//CloseOpenDropdown( InstanceId );
	}

	private void MeasureScrollTarget()
	{
		if ( ScrollMeasureFramesRemaining <= 0 )
			return;

		ScrollMeasureFramesRemaining--;

		if ( ScrollTarget is null || MenuPanel is null )
			return;

		var viewport = ScrollTarget.Box.RectInner;
		var menu = MenuPanel.Box.Rect;
		var overflow = menu.Bottom - viewport.Bottom + 10f;
		if ( overflow <= 0f )
			return;

		var maxOffset = Math.Max( 0f, ScrollTarget.ScrollSize.y );
		SmoothScrollTargetY = Math.Clamp( ScrollTarget.ScrollOffset.y + overflow, 0f, maxOffset );
		SmoothScrollFramesRemaining = 10;
	}

	private void UpdateSmoothScroll()
	{
		if ( SmoothScrollFramesRemaining <= 0 || ScrollTarget is null )
			return;

		var currentY = ScrollTarget.ScrollOffset.y;
		var delta = SmoothScrollTargetY - currentY;
		if ( MathF.Abs( delta ) <= 0.5f || SmoothScrollFramesRemaining == 1 )
		{
			ScrollTarget.ScrollOffset = new Vector2( 0f, SmoothScrollTargetY );
			SmoothScrollFramesRemaining = 0;
			return;
		}

		ScrollTarget.ScrollOffset = new Vector2( 0f, currentY + delta * 0.28f );
		SmoothScrollFramesRemaining--;
	}

	private bool IsMouseInsideOpenDropdown()
	{
		var position = Mouse.Position;
		return IsPointInside( Box.Rect, position )
			|| (MenuPanel is not null && IsPointInside( MenuPanel.Box.Rect, position ));
	}

	private static bool IsPointInside( Rect rect, Vector2 point )
	{
		return point.x >= rect.Left
			&& point.x <= rect.Right
			&& point.y >= rect.Top
			&& point.y <= rect.Bottom;
	}

	private string GetItemClasses( string item )
	{
		return string.Equals( item, Value, StringComparison.OrdinalIgnoreCase )
			? "dropdown-item selected"
			: "dropdown-item";
	}

	private string FormatItem( string item )
	{
		if ( ItemFormatter is not null )
		{
			var formatted = ItemFormatter.Invoke( item );
			if ( !string.IsNullOrWhiteSpace( formatted ) )
				return formatted;
		}

		if ( string.IsNullOrWhiteSpace( item ) )
			return "";

		var label = item.Replace( "_", " " );
		for ( var i = label.Length - 1; i > 0; i-- )
		{
			if ( char.IsUpper( label[i] ) && !char.IsWhiteSpace( label[i - 1] ) )
				label = label.Insert( i, " " );
		}

		return label;
	}

	private string GetItemTooltip( string item )
	{
		return ItemTooltipProvider?.Invoke( item ) ?? "";
	}

	private string GetItemTooltipKey( string item )
	{
		var prefix = string.IsNullOrWhiteSpace( TooltipRequestKey )
			? $"dropdown-{InstanceId}"
			: TooltipRequestKey;
		return $"{prefix}:{item}";
	}

	private int GetMenuHeight()
	{
		var itemCount = Math.Max( Items?.Count ?? 0, 1 );
		var menuGapHeight = Math.Max( itemCount - 1, 0 ) * 4;
		return 12 + menuGapHeight + itemCount * 52;
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsOpen );
		hash.Add( ActiveInstanceId );
		hash.Add( OpenVersion );
		hash.Add( Value ?? "" );
		hash.Add( Placeholder ?? "" );
		hash.Add( CanClick );
		//hash.Add( MenuStyle );

		foreach ( var item in Items )
		{
			hash.Add( item ?? "" );
			hash.Add( GetItemTooltip( item ) );
			hash.Add( FormatItem( item ) );
		}

		return hash.ToHashCode();
	}
}
