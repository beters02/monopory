@using Sandbox;
@using Sandbox.UI;
@using System;
@inherits GameButton

<root class="@CloseRootClasses" title="@Title" onclick="@HandleClick">
	@if ( ChildContent is not null )
	{
		@ChildContent
	}
	else
	{
		<span>@CloseLabel</span>
	}
</root>

@code
{
	[Parameter] public string CloseLabel { get; set; } = "X";

	public CloseButton()
	{
		Sound = GameAssets.Sounds.ClosingClick;
	}

	private string CloseRootClasses => string.IsNullOrWhiteSpace( Variant )
		? "monopoly-button monopoly-close-button"
		: $"monopoly-button monopoly-close-button {Variant}";
}
