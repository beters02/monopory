@using Sandbox;
@using Sandbox.UI;
@using Sandbox.ui.components;
@using Sandbox.ui.components.buttons
@using System;
@inherits Panel

<root>
	@if ( IsOpen )
	{
		<div class="trade-modal-backdrop trade-composer-backdrop">
			<div class="trade-modal trade-composer-modal">
				<CloseButton Variant="trade-modal-close" OnClick="@Close"></CloseButton>
				<div class="trade-modal-title">@Title</div>

				<div class="trade-editor">
					<div class="trade-side">
						<div class="trade-player-name">@GetPlayerName( GameRef.LocalPlayerIndex )</div>
						<div class="trade-money-row">
							<GameButton OnClick="@(() => AdjustSenderMoney( -50 ))">-</GameButton>
							<TextEntry class="trade-money-input"
								Text="@SenderMoneyText"
								Placeholder="0"
								OnTextEdited="@SetSenderMoneyText"
								onsubmit="@CommitSenderMoneyDraft" />
							<GameButton OnClick="@(() => AdjustSenderMoney( 50 ))">+</GameButton>
						</div>
						<div class="trade-property-sections">
							<div class="trade-property-section trade-giving-section">
								<div class="trade-property-section-title">Giving</div>
								<div class="trade-property-picker" @ref="SenderGivingScrollPanel">
									@if ( GetGivingPropertyIndexes( true ).Count == 0 && GetGivingCardIds( true ).Count == 0 )
									{
										<div class="trade-property-empty">No properties selected</div>
									}
									else
									{
										@foreach ( var propertyIndex in GetGivingPropertyIndexes( true ) )
										{
											var property = GameRef.Board.GetSpaceDef( propertyIndex );
											<GameButton Variant="@GetComposerPropertyClasses( propertyIndex, true )" OnClick="@(() => ToggleSenderProperty( propertyIndex ))" OnRightClick="@(() => HandlePropertyRightClick( propertyIndex ))">
												<ChildContent>
												<div class="trade-property-selected-mark">+</div>
												<div class="trade-property-chip-label">@property?.DisplayName</div>
												@if ( IsPropertyMortgaged( propertyIndex ) )
												{
													<div class="trade-property-mortgage-stamp">Mortgaged</div>
												}
												</ChildContent>
											</GameButton>
										}
										@foreach ( var cardId in GetGivingCardIds( true ) )
										{
											<GameButton Variant="@GetComposerCardClasses( cardId, true )" OnClick="@(() => ToggleSenderCard( cardId ))">
												<ChildContent>
													<div class="trade-property-selected-mark">+</div>
													<div class="trade-property-chip-label">@GameRef.GetTradableCardName( cardId )</div>
												</ChildContent>
											</GameButton>
										}
									}
								</div>
								<MonoScrollbar Target="@SenderGivingScrollPanel" Variant="trade-property-scrollbar"></MonoScrollbar>
							</div>
							<div class="trade-property-section trade-has-section">
								<div class="trade-property-section-title">Has</div>
								<div class="trade-property-picker" @ref="SenderHasScrollPanel">
									@if ( GetHasPropertyIndexes( true ).Count == 0 && GetHasCardIds( true ).Count == 0 )
									{
										<div class="trade-property-empty">No properties available</div>
									}
									else
									{
										@foreach ( var propertyIndex in GetHasPropertyIndexes( true ) )
										{
											var property = GameRef.Board.GetSpaceDef( propertyIndex );
											<GameButton Variant="@GetComposerPropertyClasses( propertyIndex, true )" OnClick="@(() => ToggleSenderProperty( propertyIndex ))" OnRightClick="@(() => HandlePropertyRightClick( propertyIndex ))">
												<ChildContent>
												<div class="trade-property-selected-mark">+</div>
												<div class="trade-property-chip-label">@property?.DisplayName</div>
												@if ( IsPropertyMortgaged( propertyIndex ) )
												{
													<div class="trade-property-mortgage-stamp">Mortgaged</div>
												}
												</ChildContent>
											</GameButton>
										}
										@foreach ( var cardId in GetHasCardIds( true ) )
										{
											<GameButton Variant="@GetComposerCardClasses( cardId, true )" OnClick="@(() => ToggleSenderCard( cardId ))">
												<ChildContent>
													<div class="trade-property-selected-mark">+</div>
													<div class="trade-property-chip-label">@GameRef.GetTradableCardName( cardId )</div>
												</ChildContent>
											</GameButton>
										}
									}
								</div>
								<MonoScrollbar Target="@SenderHasScrollPanel" Variant="trade-property-scrollbar"></MonoScrollbar>
							</div>
						</div>
					</div>

					<div class="trade-swap-column">&lt;-&gt;</div>

					<div class="trade-side">
						<div class="@ReceiverHeaderClasses">
							@if ( !CanSelectReceiver )
							{
								<div class="trade-target locked">
									<div class="trade-target-label">@GetPlayerName( EffectiveReceiverPlayerIndex )</div>
								</div>
							}
							else if ( TradeTargetIndexes.Count == 0 )
							{
								<div class="trade-target-empty">No other players</div>
							}
							else
							{
								@foreach ( var playerIndex in TradeTargetIndexes )
								{
								<div class="@GetTradeTargetClasses( playerIndex )" onclick="@(() => SelectTradeTarget( playerIndex ))">
									<div class="trade-target-label">@GetPlayerName( playerIndex )</div>
								</div>
								}
							}
						</div>
						<div class="trade-money-row">
							<GameButton OnClick="@(() => AdjustReceiverMoney( -50 ))">-</GameButton>
							<TextEntry class="trade-money-input"
								Text="@ReceiverMoneyText"
								Placeholder="0"
								OnTextEdited="@SetReceiverMoneyText"
								onsubmit="@CommitReceiverMoneyDraft" />
							<GameButton OnClick="@(() => AdjustReceiverMoney( 50 ))">+</GameButton>
						</div>
						<div class="trade-property-sections">
							<div class="trade-property-section trade-giving-section">
								<div class="trade-property-section-title">Giving</div>
								<div class="trade-property-picker" @ref="ReceiverGivingScrollPanel">
									@if ( GetGivingPropertyIndexes( false ).Count == 0 && GetGivingCardIds( false ).Count == 0 )
									{
										<div class="trade-property-empty">No properties selected</div>
									}
									else
									{
										@foreach ( var propertyIndex in GetGivingPropertyIndexes( false ) )
										{
											var property = GameRef.Board.GetSpaceDef( propertyIndex );
											<GameButton Variant="@GetComposerPropertyClasses( propertyIndex, false )" OnClick="@(() => ToggleReceiverProperty( propertyIndex ))" OnRightClick="@(() => HandlePropertyRightClick( propertyIndex ))">
												<ChildContent>
													<div class="trade-property-selected-mark">+</div>
													<div class="trade-property-chip-label">@property?.DisplayName</div>
													@if ( IsPropertyMortgaged( propertyIndex ) )
													{
														<div class="trade-property-mortgage-stamp">Mortgaged</div>
													}
												</ChildContent>
											</GameButton>
										}
										@foreach ( var cardId in GetGivingCardIds( false ) )
										{
											<GameButton Variant="@GetComposerCardClasses( cardId, false )" OnClick="@(() => ToggleReceiverCard( cardId ))">
												<ChildContent>
													<div class="trade-property-selected-mark">+</div>
													<div class="trade-property-chip-label">@GameRef.GetTradableCardName( cardId )</div>
												</ChildContent>
											</GameButton>
										}
									}
								</div>
								<MonoScrollbar Target="@ReceiverGivingScrollPanel" Variant="trade-property-scrollbar"></MonoScrollbar>
							</div>
							<div class="trade-property-section trade-has-section">
								<div class="trade-property-section-title">Has</div>
								<div class="trade-property-picker" @ref="ReceiverHasScrollPanel">
									@if ( GetHasPropertyIndexes( false ).Count == 0 && GetHasCardIds( false ).Count == 0 )
									{
										<div class="trade-property-empty">No properties available</div>
									}
									else
									{
										@foreach ( var propertyIndex in GetHasPropertyIndexes( false ) )
										{
											var property = GameRef.Board.GetSpaceDef( propertyIndex );
											<GameButton Variant="@GetComposerPropertyClasses( propertyIndex, false )" OnClick="@(() => ToggleReceiverProperty( propertyIndex ))" OnRightClick="@(() => HandlePropertyRightClick( propertyIndex ))">
												<ChildContent>
													<div class="trade-property-selected-mark">+</div>
													<div class="trade-property-chip-label">@property?.DisplayName</div>
													@if ( IsPropertyMortgaged( propertyIndex ) )
													{
														<div class="trade-property-mortgage-stamp">Mortgaged</div>
													}
												</ChildContent>
											</GameButton>
										}
										@foreach ( var cardId in GetHasCardIds( false ) )
										{
											<GameButton Variant="@GetComposerCardClasses( cardId, false )" OnClick="@(() => ToggleReceiverCard( cardId ))">
												<ChildContent>
													<div class="trade-property-selected-mark">+</div>
													<div class="trade-property-chip-label">@GameRef.GetTradableCardName( cardId )</div>
												</ChildContent>
											</GameButton>
										}
									}
								</div>
								<MonoScrollbar Target="@ReceiverHasScrollPanel" Variant="trade-property-scrollbar"></MonoScrollbar>
							</div>
						</div>
					</div>
				</div>

				<GameButton Variant="trade-send-button" OnClick="@Send">@SendLabel</GameButton>
			</div>
		</div>
	}
</root>

@code
{
	[Parameter] public GameController GameRef { get; set; }
	[Parameter] public bool IsOpen { get; set; }
	[Parameter] public int ReceiverPlayerIndex { get; set; } = -1;
	[Parameter] public int SenderMoney { get; set; }
	[Parameter] public int ReceiverMoney { get; set; }
	[Parameter] public HashSet<int> SenderPropertyIndexes { get; set; } = new();
	[Parameter] public HashSet<int> ReceiverPropertyIndexes { get; set; } = new();
	[Parameter] public HashSet<string> SenderCardIds { get; set; } = new();
	[Parameter] public HashSet<string> ReceiverCardIds { get; set; } = new();
	[Parameter] public string Title { get; set; } = "Create a trade";
	[Parameter] public string SendLabel { get; set; } = "Send trade";
	[Parameter] public bool CanSelectReceiver { get; set; } = true;
	[Parameter] public Action OnClose { get; set; }
	[Parameter] public Action<int> OnSelectReceiver { get; set; }
	[Parameter] public Action<int> OnAdjustSenderMoney { get; set; }
	[Parameter] public Action<int> OnAdjustReceiverMoney { get; set; }
	[Parameter] public Action<int> OnSetSenderMoney { get; set; }
	[Parameter] public Action<int> OnSetReceiverMoney { get; set; }
	[Parameter] public Action<int> OnToggleSenderProperty { get; set; }
	[Parameter] public Action<int> OnToggleReceiverProperty { get; set; }
	[Parameter] public Action<string> OnToggleSenderCard { get; set; }
	[Parameter] public Action<string> OnToggleReceiverCard { get; set; }
	[Parameter] public Action OnSend { get; set; }

	private Panel SenderGivingScrollPanel = null!;
	private Panel SenderHasScrollPanel = null!;
	private Panel ReceiverGivingScrollPanel = null!;
	private Panel ReceiverHasScrollPanel = null!;
	private int LocalReceiverPlayerIndex = -1;
	private string SenderMoneyDraft;
	private string ReceiverMoneyDraft;

	private int EffectiveReceiverPlayerIndex =>
		TradeTargetIndexes.Contains( LocalReceiverPlayerIndex ) ? LocalReceiverPlayerIndex : ReceiverPlayerIndex;

	private List<int> TradeTargetIndexes =>
		GameRef?.Players?
			.Select( ( player, index ) => new { player, index } )
			.Where( entry => entry.player is not null && entry.player.IsAssigned && !entry.player.IsBankrupt && entry.index != GameRef.LocalPlayerIndex )
			.Select( entry => entry.index )
			.ToList() ?? new();

	private List<int> LocalOwnedPropertyIndexes =>
		GameRef is null ? new() : GameRef.GetOwnedPropertyIndexes( GameRef.LocalPlayerIndex );

	private List<int> ReceiverOwnedPropertyIndexes =>
		GameRef is null || EffectiveReceiverPlayerIndex < 0 ? new() : GameRef.GetOwnedPropertyIndexes( EffectiveReceiverPlayerIndex );

	private List<string> LocalOwnedCardIds =>
		GameRef is null ? new() : GameRef.GetOwnedTradableCardIds( GameRef.LocalPlayerIndex );

	private List<string> ReceiverOwnedCardIds =>
		GameRef is null || EffectiveReceiverPlayerIndex < 0 ? new() : GameRef.GetOwnedTradableCardIds( EffectiveReceiverPlayerIndex );

	private string ReceiverHeaderClasses =>
		CanSelectReceiver ? "trade-player-select" : "trade-player-select locked";

	private string SenderMoneyText =>
		SenderMoneyDraft ?? SenderMoney.ToString();

	private string ReceiverMoneyText =>
		ReceiverMoneyDraft ?? ReceiverMoney.ToString();

	private void Close()
	{
		LocalReceiverPlayerIndex = -1;
		SenderMoneyDraft = null;
		ReceiverMoneyDraft = null;
		OnClose?.Invoke();
	}
	private void SelectTradeTarget( int playerIndex )
	{
		LocalReceiverPlayerIndex = playerIndex;
		ReceiverMoneyDraft = null;
		OnSelectReceiver?.Invoke( playerIndex );
	}

	private void AdjustSenderMoney( int amount )
	{
		CommitSenderMoneyDraft();
		OnAdjustSenderMoney?.Invoke( amount );
	}

	private void AdjustReceiverMoney( int amount )
	{
		CommitReceiverMoneyDraft();
		OnAdjustReceiverMoney?.Invoke( amount );
	}

	private void SetSenderMoneyText( string value )
	{
		SenderMoneyDraft = value ?? "";
	}

	private void SetReceiverMoneyText( string value )
	{
		ReceiverMoneyDraft = value ?? "";
	}

	private void CommitSenderMoneyDraft()
	{
		if ( SenderMoneyDraft is null )
			return;

		if ( int.TryParse( SenderMoneyDraft, out var amount ) )
			OnSetSenderMoney?.Invoke( amount );

		SenderMoneyDraft = null;
	}

	private void CommitReceiverMoneyDraft()
	{
		if ( ReceiverMoneyDraft is null )
			return;

		if ( int.TryParse( ReceiverMoneyDraft, out var amount ) )
			OnSetReceiverMoney?.Invoke( amount );

		ReceiverMoneyDraft = null;
	}

	private void ToggleSenderProperty( int propertyIndex ) => OnToggleSenderProperty?.Invoke( propertyIndex );
	private void ToggleReceiverProperty( int propertyIndex ) => OnToggleReceiverProperty?.Invoke( propertyIndex );
	private void ToggleSenderCard( string cardId ) => OnToggleSenderCard?.Invoke( cardId );
	private void ToggleReceiverCard( string cardId ) => OnToggleReceiverCard?.Invoke( cardId );
	private void Send()
	{
		CommitSenderMoneyDraft();
		CommitReceiverMoneyDraft();
		OnSend?.Invoke();
	}

	private List<int> GetGivingPropertyIndexes( bool senderSide )
	{
		var ownedIndexes = senderSide ? LocalOwnedPropertyIndexes : ReceiverOwnedPropertyIndexes;
		var selectedIndexes = senderSide ? SenderPropertyIndexes : ReceiverPropertyIndexes;
		return ownedIndexes.Where( selectedIndexes.Contains ).ToList();
	}

	private List<int> GetHasPropertyIndexes( bool senderSide )
	{
		var ownedIndexes = senderSide ? LocalOwnedPropertyIndexes : ReceiverOwnedPropertyIndexes;
		var selectedIndexes = senderSide ? SenderPropertyIndexes : ReceiverPropertyIndexes;
		return ownedIndexes.Where( index => !selectedIndexes.Contains( index ) ).ToList();
	}

	private List<string> GetGivingCardIds( bool senderSide )
	{
		var ownedCardIds = senderSide ? LocalOwnedCardIds : ReceiverOwnedCardIds;
		var selectedCardIds = senderSide ? SenderCardIds : ReceiverCardIds;
		return ownedCardIds.Where( selectedCardIds.Contains ).ToList();
	}

	private List<string> GetHasCardIds( bool senderSide )
	{
		var ownedCardIds = senderSide ? LocalOwnedCardIds : ReceiverOwnedCardIds;
		var selectedCardIds = senderSide ? SenderCardIds : ReceiverCardIds;
		return ownedCardIds.Where( cardId => !selectedCardIds.Contains( cardId ) ).ToList();
	}

	private string GetComposerPropertyClasses( int propertyIndex, bool senderSide )
	{
		var selected = senderSide
			? SenderPropertyIndexes.Contains( propertyIndex )
			: ReceiverPropertyIndexes.Contains( propertyIndex );

		var def = GameRef?.Board?.GetSpaceDef( propertyIndex );
		var colorGroup = HudUi.GetPropertyColorClass( def );
		var classes = $"trade-property-chip color-{colorGroup}";

		if ( selected )
			classes += " selected";

		if ( IsPropertyMortgaged( propertyIndex ) )
			classes += " mortgaged";

		return classes;
	}

	private bool IsPropertyMortgaged( int propertyIndex )
	{
		return GameRef?.IsMortgaged( propertyIndex ) == true;
	}

	private void HandlePropertyRightClick( int propertyIndex )
	{
		GameRef?.SelectSpace( propertyIndex );
	}

	private string GetComposerCardClasses( string cardId, bool senderSide )
	{
		var selected = senderSide
			? SenderCardIds.Contains( cardId )
			: ReceiverCardIds.Contains( cardId );

		var classes = "trade-property-chip color-jail-free";

		if ( selected )
			classes += " selected";

		return classes;
	}

	private string GetTradeTargetClasses( int playerIndex )
	{
		return playerIndex == EffectiveReceiverPlayerIndex ? "trade-target selected" : "trade-target";
	}

	private string GetPlayerName( int playerIndex )
	{
		string def = $"Player {playerIndex + 1}";
		string playerName = def;
		if (GameRef is not null)
		{
			PlayerState player = GameRef.GetPlayerForIndex( playerIndex );
			if (player is not null)
				playerName = player.PlayerName;
		}

		return string.IsNullOrWhiteSpace( playerName ) ? $"Player {playerIndex + 1}" : playerName;
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsOpen );
		hash.Add( ReceiverPlayerIndex );
		hash.Add( LocalReceiverPlayerIndex );
		hash.Add( SenderMoney );
		hash.Add( ReceiverMoney );
		hash.Add( SenderMoneyDraft ?? "" );
		hash.Add( ReceiverMoneyDraft ?? "" );
		hash.Add( Title ?? "" );
		hash.Add( SendLabel ?? "" );
		hash.Add( CanSelectReceiver );
		hash.Add( HudUi.GetPlayersHash( GameRef ) );
		hash.Add( HudUi.GetPropertyOwnersHash( GameRef ) );
		hash.Add( HudUi.GetMortgagedPropertiesHash( GameRef ) );

		foreach ( var index in SenderPropertyIndexes.OrderBy( x => x ) )
			hash.Add( index );

		foreach ( var index in ReceiverPropertyIndexes.OrderBy( x => x ) )
			hash.Add( index );

		foreach ( var cardId in SenderCardIds.OrderBy( x => x ) )
			hash.Add( cardId );

		foreach ( var cardId in ReceiverCardIds.OrderBy( x => x ) )
			hash.Add( cardId );

		return hash.ToHashCode();
	}
}
