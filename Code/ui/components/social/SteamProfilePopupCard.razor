@namespace Sandbox.ui.components
@using Sandbox;
@using Sandbox.UI;
@using System;
@inherits Panel

<root class="@RootClasses" style="@PopupStyle">
	@if ( Entry is not null )
	{
		<div class="steam-profile-popup-top">
			<div class="@AvatarClasses">
				@if ( Entry.AvatarTexture is not null )
				{
					<Image class="steam-avatar-image" Texture="@Entry.AvatarTexture"></Image>
				}
				else
				{
					<div class="steam-avatar-initials">@GetInitials( Entry.Name )</div>
				}
			</div>
			<div class="steam-profile-popup-main">
				<div class="steam-profile-popup-name">@Entry.Name</div>
				<div class="steam-profile-popup-status">@GetFriendStatus( Entry )</div>
			</div>
		</div>
		<div class="steam-profile-popup-actions">
			@if ( ShowJoinAction )
			{
				<button class="steam-profile-popup-action primary" onclick="@HandleJoin">
					<div class="steam-profile-popup-action-icon">J</div>
					<div>Join</div>
				</button>
			}
			@if ( ShowInviteAction )
			{
				<button class="steam-profile-popup-action primary" onclick="@HandleInvite">
					<div class="steam-profile-popup-action-icon">+</div>
					<div>Invite</div>
				</button>
			}
			@if ( CanOpenProfile )
			{
				<button class="steam-profile-popup-action" onclick="@HandleOpenProfile">
					<div class="steam-profile-popup-action-icon">P</div>
					<div>Profile</div>
				</button>
			}
			<button class="steam-profile-popup-action" onclick="@HandleOpenChat">
				<div class="steam-profile-popup-action-icon">C</div>
				<div>Chat</div>
			</button>
			@if ( OnPing is not null )
			{
				<button class="steam-profile-popup-action primary" onclick="@HandlePing">
					<div class="steam-profile-popup-action-icon">!</div>
					<div>Ping</div>
				</button>
			}
			<button class="steam-profile-popup-action" onclick="@HandleClose">
				<div class="steam-profile-popup-action-icon">x</div>
				<div>Close</div>
			</button>
		</div>
	}
</root>

@code
{
	[Parameter] public SteamFriendListEntry Entry { get; set; }
	[Parameter] public string PopupStyle { get; set; } = "";
	[Parameter] public bool IsClosing { get; set; }
	[Parameter] public bool CanInvite { get; set; }
	[Parameter] public bool CanJoin { get; set; }
	[Parameter] public Action OnInvite { get; set; }
	[Parameter] public Action OnJoin { get; set; }
	[Parameter] public Action OnChat { get; set; }
	[Parameter] public Action OnPing { get; set; }
	[Parameter] public Action OnOpenProfile { get; set; }
	[Parameter] public Action OnClose { get; set; }

	private string RootClasses => IsClosing
		? "is-closing"
		: "is-open";

	private string AvatarClasses => $"steam-profile-popup-avatar {GetPresenceClass( Entry )}";
	private bool ShowInviteAction => CanInvite && OnInvite is not null;
	private bool ShowJoinAction => CanJoin && Entry?.CanJoinLobby == true && OnJoin is not null;
	private bool CanOpenProfile => Entry is not null && Entry.SteamId != 0 && OnOpenProfile is not null;

	private void HandleInvite() => OnButtonClicked(OnInvite);
	private void HandleJoin() => OnButtonClicked(OnJoin);
	private void HandleOpenProfile() => OnButtonClicked(OnOpenProfile);
	private void HandleOpenChat() => OnButtonClicked(OnChat);
	private void HandlePing() => OnButtonClicked(OnPing);
	private void HandleClose() => OnButtonClicked(OnClose, GameAssets.Sounds.ClickAndClose);

	private void OnButtonClicked( Action action, GameSound clickSound = null )
	{
		var sound = clickSound ?? GameAssets.Sounds.Click;
		sound.Play();

		action?.Invoke();
	}

	private static string GetFriendStatus( SteamFriendListEntry entry )
	{
		if ( entry is null )
			return "";
		if ( entry.IsPlayingAnyGame )
			return $"In game {GetFriendGameName( entry )}";
		if ( entry.IsAway )
			return string.IsNullOrWhiteSpace( entry.Status ) ? "Away" : entry.Status;
		if ( !string.IsNullOrWhiteSpace( entry.Status ) )
			return entry.Status;
		return entry.IsOnline ? "Online" : "Offline";
	}

	private static string GetFriendGameName( SteamFriendListEntry entry )
	{
		if ( !string.IsNullOrWhiteSpace( entry.GameName ) )
			return entry.GameName;
		return entry.IsPlayingThisGame ? "Rent Rush" : "another game";
	}

	private static string GetPresenceClass( SteamFriendListEntry entry )
	{
		return entry?.PresenceGroup switch
		{
			SteamFriendPresenceGroup.InRentRush => "in-game-rent-rush",
			SteamFriendPresenceGroup.InOtherGame => "in-game-other",
			SteamFriendPresenceGroup.Online => "online",
			SteamFriendPresenceGroup.Away => "away",
			_ => "offline"
		};
	}

	private static string GetInitials( string name )
	{
		if ( string.IsNullOrWhiteSpace( name ) )
			return "?";
		var parts = name.Trim().Split( ' ', StringSplitOptions.RemoveEmptyEntries );
		if ( parts.Length >= 2 )
			return $"{parts[0][0]}{parts[1][0]}".ToUpper();
		return name.Trim()[0].ToString().ToUpper();
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( Entry?.SteamId ?? 0 );
		hash.Add( Entry?.Name ?? "" );
		hash.Add( Entry?.Status ?? "" );
		hash.Add( Entry?.RichPresence ?? "" );
		hash.Add( Entry?.GameName ?? "" );
		hash.Add( Entry?.IsOnline ?? false );
		hash.Add( Entry?.IsAway ?? false );
		hash.Add( Entry?.IsPlayingAnyGame ?? false );
		hash.Add( Entry?.IsPlayingThisGame ?? false );
		hash.Add( Entry?.AvatarTexture is not null );
		hash.Add( PopupStyle );
		hash.Add( IsClosing );
		hash.Add( CanInvite );
		hash.Add( CanJoin );
		hash.Add( Entry?.CanJoinLobby ?? false );
		hash.Add( Entry?.JoinLobbyId ?? 0 );
		hash.Add( Entry?.JoinConnectTarget ?? "" );
		hash.Add( OnInvite is not null );
		hash.Add( OnJoin is not null );
		hash.Add( OnOpenProfile is not null );
		hash.Add( OnPing is not null );
		return hash.ToHashCode();
	}
}
