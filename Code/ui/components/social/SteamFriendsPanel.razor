@namespace Sandbox.ui.components
@using Sandbox;
@using Sandbox.UI;
@using System;
@inherits Panel

<root class="steam-friends-root">
	<div class="@PanelClasses" @ref="FriendsPanel">
		<div class="steam-friends-header">
			<div class="steam-friends-title">Friends</div>
			<div class="@GetStandaloneBadgeClasses()">@GetStandaloneBadgeText()</div>
		</div>
		<div class="steam-friends-list monopory-scroll-y">
			@if ( Friends.Count == 0 )
			{
				<div class="steam-friends-empty">
					<div class="steam-friends-empty-title">@GetEmptyTitle()</div>
					<div class="steam-friends-empty-copy">@GetEmptyCopy()</div>
				</div>
			}
			else
			{
				@foreach ( var friend in Friends )
				{
					<div class="@GetFriendRowClasses( friend )" title="@friend.Name" onclick="@(() => ToggleFriendPopup( friend ))">
						<div class="@GetFriendAvatarClasses( friend )">
							@if ( friend.AvatarTexture is not null )
							{
								<Image class="steam-avatar-image" Texture="@friend.AvatarTexture"></Image>
							}
							else
							{
								<div class="steam-avatar-initials">@GetInitials( friend.Name )</div>
							}
						</div>
						<div class="steam-friend-body">
							<div class="steam-friend-name">@friend.Name</div>
							<div class="steam-friend-status">@GetFriendStatus( friend )</div>
						</div>
					</div>
				}
			}
		</div>
	</div>
	@if ( SelectedFriend is not null )
	{
			<SteamProfilePopupCard
				@ref="PopupPanel"
				Entry="@SelectedFriend"
				PopupStyle="@PopupStyle"
				IsClosing="@IsPopupClosing"
				CanInvite="@CanInviteFriends"
				CanJoin="@CanJoinFriends"
			OnInvite="@InviteSelectedFriend"
			OnJoin="@JoinSelectedFriend"
			OnOpenProfile="@OpenSelectedFriendProfile"
			OnClose="@RequestClosePopup"
			OnChat="@OpenSelectedFriendProfileChat">
		</SteamProfilePopupCard>
	}
</root>

@code
{
	[Parameter] public bool EnableJoin { get; set; } = true;

	private SteamFriendListEntry SelectedFriend;
	private Panel FriendsPanel = null!;
	private SteamProfilePopupCard PopupPanel = null!;
	private float PopupRight;
	private float PopupTop;
	private int actionRevision;
	private bool IsFriendUiHovered;
	private bool IsPopupClosing;
	private float lastHoverTime;
	private float popupCloseStartedAt;
	private const float HoverCloseDelay = 0.12f;
	private const float PopupOutroDuration = 0.14f;
	private const float FriendsHeaderHeight = 46f;
	private const float FriendsListPaddingTop = 8f;
	private const float FriendRowHeight = 58f;
	private const float FriendRowGap = 5f;
	private const float FriendsPanelRight = 12f;
	private const float FriendsPanelWidth = 286f;
	private const float PopupGap = 12f;
	private const float PopupHoverBridgePadding = 12f;

	private IReadOnlyList<SteamFriendListEntry> Friends => SteamFriendsBridge.GetFriends();
	private bool IsStandalone => MonopolyApp.IsStandalone();

	public override void Tick()
	{
		base.Tick();

		var wasHovered = IsFriendUiHovered;
		IsFriendUiHovered = IsMouseInsideFriendUi();

		if ( IsFriendUiHovered )
			lastHoverTime = Time.Now;
		else if ( SelectedFriend is not null && !IsPopupClosing && Time.Now - lastHoverTime > HoverCloseDelay )
			RequestClosePopup();

		if ( IsPopupClosing && Time.Now - popupCloseStartedAt > PopupOutroDuration )
			ClosePopup();

		if ( wasHovered != IsFriendUiHovered )
			actionRevision++;

		StateHasChanged();
	}

	private void ToggleFriendPopup( SteamFriendListEntry friend )
	{
		if ( friend is null )
			return;

		if ( ReferenceEquals( SelectedFriend, friend ) )
		{
			GameAssets.Sounds.ClickAndClose.Play();
			RequestClosePopup();
			return;
		}

		if ( SelectedFriend is null )
			GameAssets.Sounds.ClickAndOpen.Play();

		SelectedFriend = friend;
		IsPopupClosing = false;
		var panelOrigin = FriendsPanel is not null
			? ScreenPositionToPanelPosition( FriendsPanel.PanelPositionToScreenPosition( Vector2.Zero ) )
			: ScreenPositionToPanelPosition( Mouse.Position );
		var clickPosition = ScreenPositionToPanelPosition( Mouse.Position );

		PopupRight = FriendsPanelRight + FriendsPanelWidth + PopupGap;
		
		PopupTop = Mouse.Position.y * (1/this.ScaleToScreen) - (FriendRowHeight/2)/2;
		Mouse.Visibility = MouseVisibility.Visible;
		lastHoverTime = Time.Now;
		actionRevision++;
	}

	private void InviteSelectedFriend()
	{
		if ( SelectedFriend is null )
			return;

		if ( !SteamFriendsBridge.TryInviteFriend( SelectedFriend ) )
			Log.Warning( $"Could not invite Steam friend {SelectedFriend.Name}." );

		RequestClosePopup();
	}

	private async void JoinSelectedFriend()
	{
		if ( SelectedFriend is null )
			return;

		LoadingState.Show( "Joining lobby", $"Connecting to {SelectedFriend.Name}'s lobby." );
		if ( !await SteamFriendsBridge.TryJoinFriend( SelectedFriend, null ) )
		{
			LoadingState.Hide();
			Log.Warning( $"Could not join Steam friend {SelectedFriend.Name}." );
		}

		RequestClosePopup();
	}

	private void TryOpenSteamFriendsProfile( SteamUserOverlayType overlayType = SteamUserOverlayType.steamid )
	{
		if ( SelectedFriend is null )
			return;

		if ( !SteamFriendsBridge.TryOpenProfile( SelectedFriend, overlayType.ToString() ) )
			Log.Warning( $"Could not open Steam profile for {SelectedFriend.Name}." );

		RequestClosePopup();
	}

	private void OpenSelectedFriendProfile() =>
		TryOpenSteamFriendsProfile();

	private void OpenSelectedFriendProfileChat() =>
		TryOpenSteamFriendsProfile( SteamUserOverlayType.chat );

	private void RequestClosePopup()
	{
		if ( SelectedFriend is null || IsPopupClosing )
			return;

		IsPopupClosing = true;
		popupCloseStartedAt = Time.Now;
		actionRevision++;
	}

	private void ClosePopup()
	{
		SelectedFriend = null;
		IsPopupClosing = false;
		PopupPanel = null!;
		actionRevision++;
	}

	private string PanelClasses => IsFriendUiHovered ? "steam-friends-panel is-expanded" : "steam-friends-panel";
	private string PopupStyle => $"right: {PopupRight:0}px; top: {PopupTop:0}px;";
	private bool CanInviteFriends => MonopolyApp.LobbyRef is not null;
	private bool CanJoinFriends => EnableJoin;

	private bool IsMouseInsideFriendUi()
	{
		var position = Mouse.Position;
		return (FriendsPanel is not null && IsPointInside( FriendsPanel.Box.Rect, position ))
			|| (PopupPanel is not null && IsPointInside( PopupPanel.Box.Rect, position ))
			|| IsPointInsidePopupBridge( position );
	}

	private bool IsPointInsidePopupBridge( Vector2 point )
	{
		if ( SelectedFriend is null || FriendsPanel is null || PopupPanel is null )
			return false;

		var panelRect = FriendsPanel.Box.Rect;
		var popupRect = PopupPanel.Box.Rect;
		var left = MathF.Min( panelRect.Left, popupRect.Left ) - PopupHoverBridgePadding;
		var right = MathF.Max( panelRect.Right, popupRect.Right ) + PopupHoverBridgePadding;
		var top = popupRect.Top - PopupHoverBridgePadding;
		var bottom = popupRect.Bottom + PopupHoverBridgePadding;

		return point.x >= left
			&& point.x <= right
			&& point.y >= top
			&& point.y <= bottom;
	}

	private static bool IsPointInside( Rect rect, Vector2 point )
	{
		return point.x >= rect.Left
			&& point.x <= rect.Right
			&& point.y >= rect.Top
			&& point.y <= rect.Bottom;
	}

	private string GetStandaloneBadgeClasses()
	{
		return IsStandalone ? "steam-friends-badge standalone" : "steam-friends-badge editor";
	}

	private string GetStandaloneBadgeText()
	{
		return IsStandalone ? "Steam" : "Editor";
	}

	private string GetEmptyTitle()
	{
		return IsStandalone ? "No friends found" : "Steam unavailable";
	}

	private string GetEmptyCopy()
	{
		return IsStandalone
			? "Friends will appear here when Steam exposes them."
			: "Friend rows only render in standalone builds.";
	}

	private static string GetFriendRowClasses( SteamFriendListEntry friend )
	{
		var classes = "steam-friend-row";

		classes += $" {GetPresenceClass( friend )}";

		return classes;
	}

	private static string GetFriendAvatarClasses( SteamFriendListEntry friend )
	{
		return $"steam-friend-avatar {GetPresenceClass( friend )}";
	}


	private static string GetFriendStatus( SteamFriendListEntry friend )
	{
		if ( friend is null )
			return "";

		if ( friend.IsPlayingAnyGame )
			return $"In game {GetFriendGameName( friend )}";

		if ( friend.IsAway )
			return string.IsNullOrWhiteSpace( friend.Status ) ? "Away" : friend.Status;

		if ( !string.IsNullOrWhiteSpace( friend.Status ) )
			return friend.Status;

		return friend.IsOnline ? "Online" : "Offline";
	}

	private static string GetFriendGameName( SteamFriendListEntry friend )
	{
		if ( !string.IsNullOrWhiteSpace( friend.GameName ) )
			return friend.GameName;

		return friend.IsPlayingThisGame ? "Rent Rush" : "another game";
	}

	private static string GetPresenceClass( SteamFriendListEntry friend )
	{
		return friend?.PresenceGroup switch
		{
			SteamFriendPresenceGroup.InRentRush => "in-game-rent-rush",
			SteamFriendPresenceGroup.InOtherGame => "in-game-other",
			SteamFriendPresenceGroup.Online => "online",
			SteamFriendPresenceGroup.Away => "away",
			_ => "offline"
		};
	}

	private static string GetInitials( string name )
	{
		if ( string.IsNullOrWhiteSpace( name ) )
			return "?";

		var parts = name.Trim().Split( ' ', StringSplitOptions.RemoveEmptyEntries );
		if ( parts.Length >= 2 )
			return $"{parts[0][0]}{parts[1][0]}".ToUpper();

		return name.Trim()[0].ToString().ToUpper();
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsStandalone );
		hash.Add( SelectedFriend?.SteamId ?? 0 );
		hash.Add( PopupRight );
		hash.Add( PopupTop );
		hash.Add( actionRevision );
		hash.Add( IsFriendUiHovered );
		hash.Add( IsPopupClosing );
		hash.Add( CanInviteFriends );
		hash.Add( CanJoinFriends );
		hash.Add( MathF.Floor( Time.Now * 0.5f ) );
		hash.Add( SteamFriendsBridge.AvatarRevision );

		foreach ( var friend in Friends )
		{
			hash.Add( friend.SteamId );
			hash.Add( friend.Name );
			hash.Add( friend.Status );
			hash.Add( friend.RichPresence );
			hash.Add( friend.GameName );
			hash.Add( friend.JoinLobbyId );
			hash.Add( friend.JoinConnectTarget );
			hash.Add( friend.IsOnline );
			hash.Add( friend.IsAway );
			hash.Add( friend.IsPlayingAnyGame );
			hash.Add( friend.IsPlayingThisGame );
			hash.Add( friend.AvatarTexture is not null );
		}

		return hash.ToHashCode();
	}
}
