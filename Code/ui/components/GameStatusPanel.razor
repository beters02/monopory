@using Sandbox;
@using Sandbox.UI;
@using Sandbox.ui.components.HudPanel;
@using Sandbox.ui.components.buttons
@using System;
@inherits Panel

<root>
	<Sandbox.ui.components.HudPanel.HudPanel Variant="hud-card">
		<ChildContent>
			<HudPanelTitle>#game.name</HudPanelTitle>
			<HudPanelSubtitle>Local</HudPanelSubtitle>
			<HudPanelBody>Money: $@LocalPlayerMoney</HudPanelBody>
			<HudPanelEmptyLine></HudPanelEmptyLine>
			<HudPanelEmptyLine></HudPanelEmptyLine>
			<HudPanelSubtitle>Camera</HudPanelSubtitle>
			<div class="camera-mode-buttons">
				<GameButton Variant="@GetCameraModeButtonClasses( BoardCameraMode.Default )" OnClick="@(() => SetCameraMode( BoardCameraMode.Default ))">Default</GameButton>
				<GameButton Variant="@GetCameraModeButtonClasses( BoardCameraMode.Board )" OnClick="@(() => SetCameraMode( BoardCameraMode.Board ))">Board</GameButton>
				<GameButton Variant="@GetCameraModeButtonClasses( BoardCameraMode.FreeCam )" OnClick="@(() => SetCameraMode( BoardCameraMode.FreeCam ))">Free Cam</GameButton>
			</div>
			<HudPanelEmptyLine></HudPanelEmptyLine>
			<HudPanelEmptyLine></HudPanelEmptyLine>
			<HudPanelSubtitle>Game</HudPanelSubtitle>
			<HudPanelBody>Time Left: @CurrentTurnTimeText</HudPanelBody>
			<HudPanelBody>Current Player: @CurrentPlayerName</HudPanelBody>
			<HudPanelBody>Last Roll: @GameRef.LastDieA + @GameRef.LastDieB</HudPanelBody>
			<HudPanelBody>Phase: @GameRef.Phase</HudPanelBody>
			@if ( IsCurrentPlayerInJail )
			{
				<HudPanelBody>Jail Turns: @CurrentPlayer.JailTurnsRemaining</HudPanelBody>
			}

			@if ( CanActOnCurrentTurn && IsCurrentPlayerInJail )
			{
				<div class="jail-action-buttons">
					<GameButton OnClick="@PayToLeaveJail">Pay $50</GameButton>
					<GameButton OnHoldComplete="@RollForJailRelease" HoldMaxSeconds="@RollHoldMaxSeconds">Try Doubles</GameButton>
				</div>
			}
			else if ( CanActOnCurrentTurn )
			{
				<GameButton OnHoldComplete="@RollDice" HoldMaxSeconds="@RollHoldMaxSeconds">Roll Dice</GameButton>
			}
			@if ( GameRef.MatchState == MatchLifecycleState.InGame && CurrentPlayer == LocalPlayer )
			{
				<GameButton Variant="@EndTurnButtonClasses" CanClick="@CanEndTurn" OnClick="@EndTurn" BlockedPopupTitle="Cannot end turn yet" BlockedPopupMessage="@GetEndTurnBlockedMessage()">End Turn</GameButton>
			}
		</ChildContent>
	</Sandbox.ui.components.HudPanel.HudPanel>
</root>

@code
{
	[Parameter] public GameController GameRef { get; set; }

	private PlayerState CurrentPlayer => GameRef?.CurrentPlayer;
	private PlayerState LocalPlayer => GameRef?.LocalPlayer;
	private string CurrentPlayerName => CurrentPlayer?.PlayerName ?? "None";
	private int LocalPlayerMoney => LocalPlayer?.Money ?? 0;
	private SpaceDef PendingDef => GameRef?.Board?.GetSpaceDef( GameRef.PendingPurchaseSpaceIndex );
	private string PendingPropertyName => PendingDef?.DisplayName ?? "Unknown Property";
	private const float RollHoldMaxSeconds = 1.25f;

	private int CurrentTurnRemainingSeconds =>
		GameRef is null || GameRef.CurrentTurnEndsAt <= 0f
			? -1
			: Math.Max( 0, (int)MathF.Ceiling( GameRef.CurrentTurnEndsAt - Time.Now ) );

	private string CurrentTurnTimeText =>
		CurrentTurnRemainingSeconds < 0
			? "Off"
			: $"{CurrentTurnRemainingSeconds / 60:00}:{CurrentTurnRemainingSeconds % 60:00}";

	private string EndTurnButtonClasses =>
		CanEndTurn ? "" : "blocked-action-button";

	private bool CanActOnCurrentTurn =>
		GameRef?.MatchState == MatchLifecycleState.InGame &&
		GameRef.Phase == GamePhase.WaitingToRoll &&
		CurrentPlayer == LocalPlayer;

	private bool IsCurrentPlayerInJail =>
		CurrentPlayer?.IsInJail == true;

	private BoardCameraMode CurrentCameraMode =>
		GameCamera.Instance?.Mode ?? BoardCameraMode.Board;

	private bool CanEndTurn =>
		GameRef?.Phase == GamePhase.TurnEnded &&
		GameRef.HasPendingForcedPayment != true;

	private void SetCameraMode( BoardCameraMode mode )
	{
		GameCamera.Instance?.SetMode( mode );
	}

	private string GetCameraModeButtonClasses( BoardCameraMode mode )
	{
		return CurrentCameraMode == mode
			? "camera-mode-button selected"
			: "camera-mode-button";
	}

	private void RollDice( float throwStrength )
	{
		Log.Info( $"Roll dice button released with throw strength {throwStrength:0.00}." );
		GameRef?.RequestRollDice( -1, throwStrength );
	}

	private void PayToLeaveJail()
	{
		GameRef?.RequestPayToLeaveJail();
	}

	private void RollForJailRelease( float throwStrength )
	{
		GameRef?.RequestRollForJailRelease( throwStrength );
	}

	private void EndTurn()
	{
		if ( CanEndTurn )
			GameRef?.ClearSelectedSpace();

		GameRef?.RequestEndTurn();
	}

	private string GetEndTurnBlockedMessage()
	{
		if ( GameRef?.HasPendingForcedPayment == true )
			return $"Raise ${GameRef.PendingForcedPaymentAmount} before ending your turn.";

		return GameRef?.Phase switch
		{
			GamePhase.WaitingToRoll => "Roll the dice before ending your turn.",
			GamePhase.ResolvingSpace => "Wait for your move to finish resolving.",
			GamePhase.WaitingForBuyDecision => $"{GameRef?.GetPendingPropertyDecisionPrompt() ?? $"Buy or auction {PendingPropertyName}"} before ending your turn.",
			GamePhase.Auctioning => "Wait for the auction to finish before ending your turn.",
			_ => "Finish the current action before ending your turn."
		};
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( GameRef?.MatchState ?? 0 );
		hash.Add( GameRef?.Phase ?? 0 );
		hash.Add( GameRef?.PendingPurchaseSpaceIndex ?? -1 );
		hash.Add( GameRef?.CurrentPlayerIndex ?? -1 );
		hash.Add( GameRef?.LastDieA ?? 0 );
		hash.Add( GameRef?.LastDieB ?? 0 );
		hash.Add( LocalPlayerMoney );
		hash.Add( GameRef?.Config?.CanSkipUnowned ?? false );
		hash.Add( CurrentTurnRemainingSeconds );
		hash.Add( GameRef?.HasPendingForcedPayment ?? false );
		hash.Add( CurrentPlayer?.IsInJail ?? false );
		hash.Add( CurrentPlayer?.JailTurnsRemaining ?? 0 );
		hash.Add( CurrentCameraMode );
		return hash.ToHashCode();
	}
}
