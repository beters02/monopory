@namespace Sandbox.ui.components
@using Sandbox;
@using Sandbox.UI;
@using Sandbox.ui.components.buttons
@using System;
@inherits Panel

<root>
	@if ( IsOpen && GameRef is not null )
	{
		<div class="property-stats-backdrop">
			<div class="property-stats-modal @GetModalClass()">
				@if ( !IsPostMatch )
				{
					<CloseButton Variant="property-stats-close" Title="Close" OnClick="@Close"></CloseButton>
				}

				<div class="property-stats-header">
					<div class="property-stats-heading">
						<div class="property-stats-kicker">@GetKickerText()</div>
						<div class="property-stats-title">@GetTitleText()</div>
					</div>
					<div class="property-stats-subtitle">@GetMatchSummary()</div>
				</div>

				<div class="match-integrity-tabs">
					@foreach ( var tab in Tabs )
					{
						<GameButton Variant="@GetTabButtonClass( tab.Id )" OnClick="@(() => SetActiveTab( tab.Id ))">
							<ChildContent><div class="integrity-tab-label">@tab.Label</div></ChildContent>
						</GameButton>
					}
				</div>

				@if ( ActiveTab == GameTab )
				{
					<div class="game-stats-leaderboard monopory-scroll-y">
						@foreach ( var row in GameLeaderboardRows )
						{
							var avatarTexture = GetGameLeaderboardAvatarTexture( row );
							<div class="@GetGameLeaderboardRowClass( row )">
								<div class="game-stats-card-accent"></div>
								<div class="game-stats-card-header">
									<div class="game-stats-rank-block">
										<div class="game-stats-rank-key">Place</div>
										<div class="game-stats-rank">#@row.Rank</div>
									</div>
									<div class="game-stats-player-avatar">
										@if ( avatarTexture is not null )
										{
											<Image class="game-stats-player-avatar-image" Texture="@avatarTexture"></Image>
										}
										else
										{
											<div class="game-stats-player-avatar-initial">@GetPlayerInitial( row.Name )</div>
										}
									</div>
									<div class="game-stats-player">
										<div class="game-stats-player-name">@row.Name</div>
										<div class="game-stats-player-status">@(row.IsWinner ? "Winner" : row.IsBankrupt ? "Bankrupt" : "In game")</div>
									</div>
									@if ( IsGameOver )
									{
										<div class="game-stats-duration"><div class="game-stats-duration-key">Time lasted</div><div class="game-stats-duration-value">@FormatDuration( row.TimeLastedSeconds )</div></div>
									}
								</div>
								<div class="game-stats-stat-row">
									<div class="game-stats-stat rent-earned-stat"><div class="game-stats-stat-key">Rent accumulated</div><div class="game-stats-stat-value money-value">$@row.RentEarned</div></div>
									<div class="game-stats-stat rent-paid-stat"><div class="game-stats-stat-key">Rent paid</div><div class="game-stats-stat-value money-value">$@row.RentPaid</div></div>
									<div class="@GetGameStatsPropertyStatClass( row.MostProfitableProperty?.SpaceIndex )">
										<div class="game-stats-stat-key">Most profitable property</div>
										<div class="game-stats-stat-value property-value">
											<span class="game-stats-property-name">@GetPropertyProfitName( row.MostProfitableProperty )</span>
											@if ( row.MostProfitableProperty.HasValue )
											{
												<span class="game-stats-property-amount">($@row.MostProfitableProperty.Value.RentEarned)</span>
											}
										</div>
									</div>
									<div class="@GetGameStatsPropertyStatClass( row.CostliestLanding?.SpaceIndex )">
										<div class="game-stats-stat-key">Costliest landing</div>
										<div class="game-stats-stat-value property-value">
											<span class="game-stats-property-name">@GetPropertyRentPaidName( row.CostliestLanding )</span>
											@if ( row.CostliestLanding.HasValue )
											{
												<span class="game-stats-property-amount">($@row.CostliestLanding.Value.RentPaid)</span>
											}
										</div>
									</div>
								</div>
							</div>
						}
						@if ( GameLeaderboardRows.Count == 0 ) { <div class="property-stats-empty">No players are assigned to this match.</div> }
					</div>
				}
				else if ( ActiveTab == PropertyTab )
				{
					<div class="property-stats-summary-grid">
						<div class="property-stats-summary-card"><div class="property-stats-summary-label">Property Landings</div><div class="property-stats-summary-value">@TotalLandings</div></div>
						<div class="property-stats-summary-card"><div class="property-stats-summary-label">Rent Earned</div><div class="property-stats-summary-value">$@TotalRentEarned</div></div>
						<div class="property-stats-summary-card"><div class="property-stats-summary-label">Biggest Loser</div><div class="property-stats-summary-value small">@GetBiggestLoserName()</div></div>
						<div class="property-stats-summary-card"><div class="property-stats-summary-label">Top Earner</div><div class="property-stats-summary-value small">@GetTopRentName()</div></div>
					</div>

					<div class="property-stats-content">
						<div class="property-stats-column">
							<div class="property-stats-section">
								<div class="property-stats-section-title">Most Landed Properties</div>
								@foreach ( var row in TopLandingRows )
								{
									<div class="property-stats-rank-row"><div class="@GetColorSwatchClasses( row.Space )"></div><div class="property-stats-rank-main"><div class="property-stats-rank-name">@row.Name</div><div class="property-stats-rank-meta">@GetOwnerText( row.SpaceIndex )</div></div><div class="property-stats-rank-value">@row.Landings</div></div>
								}
								@if ( TopLandingRows.Count == 0 ) { <div class="property-stats-empty">No property landings recorded yet.</div> }
							</div>
							<div class="property-stats-section">
								<div class="property-stats-section-title">Rent Leaders</div>
								@foreach ( var row in TopRentRows )
								{
									<div class="property-stats-rank-row"><div class="@GetColorSwatchClasses( row.Space )"></div><div class="property-stats-rank-main"><div class="property-stats-rank-name">@row.Name</div><div class="property-stats-rank-meta">@GetOwnerText( row.SpaceIndex )</div></div><div class="property-stats-rank-value">$@row.RentEarned</div></div>
								}
								@if ( TopRentRows.Count == 0 ) { <div class="property-stats-empty">No rent has been collected yet.</div> }
							</div>
						</div>

						<div class="property-stats-column wide">
							<div class="property-stats-section player-totals">
								<div class="property-stats-section-title">Player Totals</div>
								<div class="property-stats-player-shell">
									<div class="property-stats-player-list monopory-scroll-y" @ref="PlayerListPanel">
										@foreach ( var row in PlayerRows )
										{
											<div class="@GetPlayerRowClasses( row )">
												<div class="property-stats-player-name">@row.Name</div>
												<div class="property-stats-player-pill">$@row.Money</div>
												<div class="property-stats-player-metric"><span>@row.PropertyCount</span><label>Props</label></div>
												<div class="property-stats-player-metric"><span>@row.Landings</span><label>Visits</label></div>
												<div class="property-stats-player-metric"><span>$@row.RentEarned</span><label>Rent</label></div>
											</div>
										}
									</div>
									<MonoScrollbar Target="@PlayerListPanel" Variant="property-stats-scrollbar"></MonoScrollbar>
								</div>
							</div>

							<div class="property-stats-section fill">
								<div class="property-stats-section-title">Property Detail</div>
								<div class="property-stats-table-header"><div class="property-stats-table-property">Property</div><div class="property-stats-table-owner">Owner</div><div class="property-stats-table-small">Visits</div><div class="property-stats-table-money">Rent</div></div>
								<div class="property-stats-table-shell">
									<div class="property-stats-table monopory-scroll-y" @ref="PropertyTablePanel">
										@foreach ( var row in PropertyRows )
										{
											<div class="property-stats-table-row" onclick="@(() => SelectProperty( row.SpaceIndex ))">
												<div class="property-stats-property-cell"><div class="@GetColorSwatchClasses( row.Space )"></div><div><div class="property-stats-property-name">@row.Name</div><div class="property-stats-property-meta">@GetPropertyStatusText( row )</div></div></div>
												<div class="property-stats-table-owner">@GetOwnerName( row.SpaceIndex )</div><div class="property-stats-table-small">@row.Landings</div><div class="property-stats-table-money">$@row.RentEarned</div>
											</div>
										}
									</div>
									<MonoScrollbar Target="@PropertyTablePanel" Variant="property-stats-scrollbar"></MonoScrollbar>
								</div>
							</div>
						</div>
					</div>
				}
				else if ( ActiveTab == DiceTab )
				{
					<div class="integrity-list monopory-scroll-y">
						@foreach ( var row in DiceRows ) { <div class="integrity-row"><div class="integrity-row-title">#@row.RollIndex @row.PlayerName</div><div class="integrity-row-meta">Turn @row.TurnNumber - @row.DieA + @row.DieB = @row.Total - @row.Context</div></div> }
						@if ( DiceRows.Count == 0 ) { <div class="property-stats-empty">No dice rolls recorded yet.</div> }
					</div>
				}
				else if ( ActiveTab == MoveTab )
				{
					<div class="move-history-layout">
						<div class="integrity-list move-history-list monopory-scroll-y">
							@foreach ( var turn in MoveRows )
							{
								<div class="move-history-card">
									<div class="integrity-row-title">Turn @turn.TurnNumber - @turn.PlayerName</div>
									<div class="integrity-row-meta">@GetSnapshotSummary( turn.StartPlayers, "Start" )</div>
									@foreach ( var ev in turn.Events ) { <div class="integrity-row nested"><div class="integrity-row-title">@ev.Title</div><div class="integrity-row-meta">@ev.Message</div></div> }
									@foreach ( var delta in turn.MoneyDeltas ) { <div class="integrity-row money"><div class="integrity-row-title">@delta.PlayerName @(delta.Delta >= 0 ? "+" : "")@delta.Delta</div><div class="integrity-row-meta">$@delta.BeforeMoney to $@delta.AfterMoney - @delta.Reason</div></div> }
									<div class="integrity-row-meta">@GetSnapshotSummary( turn.EndPlayers, turn.IsFinalized ? "End" : "Current" )</div>
								</div>
							}
							@if ( MoveRows.Count == 0 ) { <div class="property-stats-empty">No move history recorded yet.</div> }
						</div>
						<div class="move-history-pager">
							<GameButton Variant="@GetMoveHistoryNavigationButtonClass( CanPageMoveHistoryBack )" Disabled="@(!CanPageMoveHistoryBack)" OnClick="@PageMoveHistoryBack">Prev</GameButton>
							@foreach ( var page in MoveHistoryPageButtons )
							{
								@if ( page < 0 )
								{
									<div class="move-history-page-ellipsis">...</div>
								}
								else
								{
									<GameButton Variant="@GetMoveHistoryPageButtonClass( page )" OnClick="@(() => SetMoveHistoryPage( page ))">@(page + 1)</GameButton>
								}
							}
							<GameButton Variant="@GetMoveHistoryNavigationButtonClass( CanPageMoveHistoryForward )" Disabled="@(!CanPageMoveHistoryForward)" OnClick="@PageMoveHistoryForward">Next</GameButton>
						</div>
						<div class="move-history-page-label">@MoveHistoryTotalCount turns</div>
					</div>
				}
				else if ( ActiveTab == GambleTab )
				{
					<div class="integrity-list monopory-scroll-y">
						@foreach ( var entry in GambleRows )
						{
							<div class="move-history-card">
								<div class="integrity-row-title">#@entry.SessionId - @entry.PlayerName</div>
								<div class="integrity-row-meta">Turn @entry.TurnNumber - Station @entry.StationId - @entry.Title</div>
								<div class="integrity-row nested"><div class="integrity-row-title">Gamble started</div><div class="integrity-row-meta">@entry.Description</div></div>
								<div class="integrity-row nested"><div class="integrity-row-title">Pick: @entry.ChosenSide</div><div class="integrity-row-meta">@GetGambleWagerText( entry )</div></div>
								<div class="integrity-row nested"><div class="integrity-row-title">Start balance</div><div class="integrity-row-meta">@entry.PlayerName had $@entry.BeforeMoney before this flip.</div></div>
								@if ( entry.Wager > 0 )
								{
									<div class="integrity-row money"><div class="integrity-row-title">@entry.PlayerName @(entry.Won ? "+" : "-")@entry.Wager</div><div class="integrity-row-meta">$@entry.BeforeMoney to $@entry.AfterMoney - Coin flip @(entry.Won ? "won" : "lost")</div></div>
								}
								<div class="integrity-row nested @GetGambleResultRowClass( entry )"><div class="integrity-row-title">@(entry.Won ? "Won" : "Lost") - @entry.OutcomeSide</div><div class="integrity-row-meta">@entry.ResultMessage</div></div>
								<div class="integrity-row-meta">End: @entry.PlayerName $@entry.AfterMoney</div>
							</div>
						}
						@if ( GambleRows.Count == 0 ) { <div class="property-stats-empty">No gamble station flips recorded yet.</div> }
					</div>
				}
				else if ( ActiveTab == AdminTab )
				{
					<div class="integrity-list monopory-scroll-y">
						@foreach ( var row in CommandRows )
						{
							<div class="integrity-row @GetCommandRowClass( row )">
								<div class="command-history-heading"><div class="integrity-row-title">@row.Command</div><div class="command-type-label">@row.CommandType</div></div>
								<div class="integrity-row-meta">Turn @row.TurnNumber - @row.Message</div>
							</div>
						}
						@if ( CommandRows.Count == 0 ) { <div class="property-stats-empty">No commands recorded yet.</div> }
					</div>
				}
				else
				{
					<div class="integrity-list monopory-scroll-y">
						<div class="integrity-badge @GetIntegrityBadgeClass()">@GetIntegrityBadgeText()</div>
						<div class="integrity-badge cheats @GetCheatsEnabledBadgeClass()">@GetCheatsEnabledText()</div>
						<div class="integrity-row"><div class="integrity-row-title">Commitment Hash</div><div class="integrity-row-meta hash">@GetHashText()</div></div>
						<div class="integrity-row"><div class="integrity-row-title">Revealed Seed</div><div class="integrity-row-meta hash">@GetSeedText()</div></div>
						@foreach ( var reason in GetIntegrityReasons() ) { <div class="integrity-row warning"><div class="integrity-row-title">Integrity Notice</div><div class="integrity-row-meta">@reason</div></div> }
						@foreach ( var row in AdminRows ) { <div class="integrity-row warning"><div class="integrity-row-title">@row.Command</div><div class="integrity-row-meta">Turn @row.TurnNumber - @row.Message</div></div> }
						@if ( AdminRows.Count == 0 ) { <div class="property-stats-empty">No CheatCmd commands recorded.</div> }
					</div>
				}
				@if ( IsPostMatch )
				{
					<div class="post-match-footer">
						@if ( CanUseHostControls )
						{
							<div class="post-match-footer-copy">Return your group to the lobby, or leave the lobby.</div>
							<div class="post-match-footer-actions"><GameButton Variant="post-match-footer-button" OnClick="@ReturnToLobby">Back To Lobby</GameButton><GameButton Variant="post-match-footer-button" OnClick="@LeaveLobby">Leave Lobby</GameButton></div>
						}
						else
						{
							<div class="post-match-footer-copy">Waiting for the host to return the group to the lobby. You can leave the lobby at any time.</div>
							<div class="post-match-footer-actions"><GameButton Variant="post-match-footer-button" OnClick="@LeaveLobby">Leave Lobby</GameButton></div>
						}
					</div>
				}
			</div>
		</div>
	}
</root>

@code
{
	[Parameter] public GameController GameRef { get; set; }
	[Parameter] public bool IsOpen { get; set; }
	[Parameter] public PropertyStatsTab InitialTab { get; set; } = PropertyStatsTab.Game;
	[Parameter] public Action OnClose { get; set; }
	[Parameter] public bool IsPostMatch { get; set; }
	[Parameter] public bool CanUseHostControls { get; set; }
	[Parameter] public Action OnReturnToLobby { get; set; }
	[Parameter] public Action OnLeaveLobby { get; set; }

	private const string GameTab = "game";
	private const string PropertyTab = "property";
	private const string DiceTab = "dice";
	private const string MoveTab = "move";
	private const string GambleTab = "gamble";
	private const string AdminTab = "admin";
	private const string IntegrityTab = "integrity";
	private string ActiveTab = GameTab;
	private bool wasOpen;
	private int MoveHistoryPage;
	private Panel PropertyTablePanel = null!;
	private Panel PlayerListPanel = null!;
	private readonly record struct StatsTab( string Id, string Label );
	private readonly record struct PropertyStatsRow( int SpaceIndex, SpaceDef Space, string Name, int Landings, int RentEarned );
	private readonly record struct PlayerStatsRow( int PlayerIndex, string Name, int Money, int NetLoss, int PropertyCount, int Landings, int RentEarned, bool IsBankrupt, bool IsLocalPlayer );
	private readonly record struct PropertyProfitRow( int SpaceIndex, string Name, int RentEarned );
	private readonly record struct PropertyRentPaidRow( int SpaceIndex, string Name, int RentPaid );
	private readonly record struct GameLeaderboardSeed( int PlayerIndex, string Name, int Money, int RentEarned, int RentPaid, bool IsBankrupt );
	private readonly record struct GameLeaderboardRow( int Rank, int PlayerIndex, string Name, int RentEarned, int RentPaid, bool IsBankrupt, bool IsWinner, int TimeLastedSeconds, PropertyProfitRow? MostProfitableProperty, PropertyRentPaidRow? CostliestLanding );
	private List<StatsTab> Tabs { get; } = new() { new( GameTab, "Game Stats" ), new( PropertyTab, "Property Stats" ), new( DiceTab, "Dice History" ), new( MoveTab, "Move History" ), new( GambleTab, "Gamble History" ), new( AdminTab, "Command History" ), new( IntegrityTab, "Match Integrity" ) };
	private int TotalLandings => PropertyRows.Sum( row => row.Landings );
	private int TotalRentEarned => PropertyRows.Sum( row => row.RentEarned );
	private List<PropertyStatsRow> PropertyRows => BuildPropertyRows();
	private List<PropertyStatsRow> TopLandingRows => PropertyRows.Where( row => row.Landings > 0 ).OrderByDescending( row => row.Landings ).ThenByDescending( row => row.RentEarned ).Take( 5 ).ToList();
	private List<PropertyStatsRow> TopRentRows => PropertyRows.Where( row => row.RentEarned > 0 ).OrderByDescending( row => row.RentEarned ).ThenByDescending( row => row.Landings ).Take( 5 ).ToList();
	private List<PlayerStatsRow> PlayerRows => BuildPlayerRows();
	private List<GameLeaderboardRow> GameLeaderboardRows => BuildGameLeaderboardRows();
	private bool IsGameOver => GameRef?.MatchState == MatchLifecycleState.GameOver;
	private List<DiceHistoryEntry> DiceRows => GameRef?.DiceHistory?.OrderBy( entry => entry.Key ).Select( entry => MatchIntegrityJson.Deserialize<DiceHistoryEntry>( entry.Value ) ).ToList() ?? new();
	private List<AdminHistoryEntry> AdminRows => GameRef?.AdminHistory?.OrderBy( entry => entry.Key ).Select( entry => MatchIntegrityJson.Deserialize<AdminHistoryEntry>( entry.Value ) ).ToList() ?? new();
	private List<CommandHistoryEntry> CommandRows => GameRef?.CommandHistory?.OrderBy( entry => entry.Key ).Select( entry => MatchIntegrityJson.Deserialize<CommandHistoryEntry>( entry.Value ) ).ToList() ?? new();
	private int MoveHistoryPageSize => Math.Clamp( GameRef?.MoveHistoryPageSize ?? 25, 5, 200 );
	private int MoveHistoryTotalCount => GameRef?.MoveHistory?.Count ?? 0;
	private int MoveHistoryPageCount => Math.Max( 1, (int)Math.Ceiling( MoveHistoryTotalCount / (double)MoveHistoryPageSize ) );
	private bool CanPageMoveHistoryBack => MoveHistoryPage > 0;
	private bool CanPageMoveHistoryForward => MoveHistoryPage < MoveHistoryPageCount - 1;
	private List<int> MoveHistoryPageButtons => GetMoveHistoryPageButtons();
	private List<MoveHistoryTurn> MoveRows => GameRef?.MoveHistory?.OrderByDescending( entry => entry.Key ).Skip( MoveHistoryPage * MoveHistoryPageSize ).Take( MoveHistoryPageSize ).Select( entry => MatchIntegrityJson.Deserialize<MoveHistoryTurn>( entry.Value ) ).ToList() ?? new();
	private List<GambleHistoryEntry> GambleRows => GameRef?.GambleHistory?.OrderByDescending( entry => entry.Key ).Select( entry => MatchIntegrityJson.Deserialize<GambleHistoryEntry>( entry.Value ) ).ToList() ?? new();

	protected override void OnParametersSet()
	{
		var isOpening = IsOpen && !wasOpen;
		wasOpen = IsOpen;
		if ( !isOpening )
			return;

		ActiveTab = GetInitialTabId( InitialTab );
		MoveHistoryPage = Math.Min( MoveHistoryPage, MoveHistoryPageCount - 1 );
	}

	private static string GetInitialTabId( PropertyStatsTab tab ) => tab switch
	{
		PropertyStatsTab.Game => GameTab,
		PropertyStatsTab.Property => PropertyTab,
		PropertyStatsTab.Dice => DiceTab,
		PropertyStatsTab.Move => MoveTab,
		PropertyStatsTab.Gamble => GambleTab,
		PropertyStatsTab.Admin => AdminTab,
		PropertyStatsTab.Integrity => IntegrityTab,
		_ => GameTab
	};

	private void Close() => OnClose?.Invoke();
	private void ReturnToLobby() => OnReturnToLobby?.Invoke();
	private void LeaveLobby() => OnLeaveLobby?.Invoke();
	private void SelectProperty( int spaceIndex ) => GameRef?.SelectSpace( spaceIndex );
	private void SetActiveTab( string tab ) { ActiveTab = tab; MoveHistoryPage = Math.Min( MoveHistoryPage, MoveHistoryPageCount - 1 ); StateHasChanged(); }
	private void PageMoveHistoryBack() { SetMoveHistoryPage( MoveHistoryPage - 1 ); }
	private void PageMoveHistoryForward() { SetMoveHistoryPage( MoveHistoryPage + 1 ); }
	private void SetMoveHistoryPage( int page ) { MoveHistoryPage = Math.Clamp( page, 0, MoveHistoryPageCount - 1 ); StateHasChanged(); }
	private string GetMoveHistoryPageButtonClass( int page ) => page == MoveHistoryPage ? "move-history-page-button active-page" : "move-history-page-button";
	private static string GetMoveHistoryNavigationButtonClass( bool canPage ) => canPage
		? "move-history-page-button move-history-nav-button"
		: "move-history-page-button move-history-nav-button disabled";
	private List<int> GetMoveHistoryPageButtons()
	{
		var pages = new List<int>();
		var count = MoveHistoryPageCount;
		if ( count <= 7 )
		{
			for ( var i = 0; i < count; i++ )
				pages.Add( i );
			return pages;
		}

		void AddPage( int page )
		{
			if ( page >= 0 && page < count && !pages.Contains( page ) )
				pages.Add( page );
		}

		AddPage( 0 );
		for ( var page = MoveHistoryPage - 1; page <= MoveHistoryPage + 1; page++ )
			AddPage( page );
		AddPage( count - 1 );
		pages.Sort();

		for ( var i = pages.Count - 1; i > 0; i-- )
		{
			if ( pages[i] - pages[i - 1] > 1 )
				pages.Insert( i, -1 );
		}

		return pages;
	}
	private string GetTabButtonClass( string tab ) => ActiveTab == tab ? "integrity-tab active-tab" : "integrity-tab";
	private string GetKickerText() => IsPostMatch ? "Game Over" : ActiveTab == IntegrityTab ? "Verified Match" : "Board Analytics";
	private string GetTitleText() => Tabs.FirstOrDefault( tab => tab.Id == ActiveTab ).Label ?? "Game Stats";
	private string GetMatchSummary() => $"{GameRef?.Players?.Count( player => player is not null && player.IsAssigned ) ?? 0} players - {GameRef?.PropertyOwners?.Count ?? 0} owned properties";
	private string GetIntegrityBadgeClass() => GameRef?.IsVerifiedMatch == true ? "verified" : "unverified";
	private string GetIntegrityBadgeText() => GameRef?.IsVerifiedMatch == true ? "Verified Match" : "Unverified Match";
	private string GetCheatsEnabledBadgeClass() => MonopolyApp.IsCheatsEnabled() ? "unverified" : "verified";
	private string GetCheatsEnabledText() => MonopolyApp.IsCheatsEnabled() ? "Cheats Enabled" : "Cheats Disabled";
	private string GetHashText() => string.IsNullOrWhiteSpace( GameRef?.DiceCommitmentHash ) ? "Not committed" : GameRef.DiceCommitmentHash;
	private string GetSeedText() => string.IsNullOrWhiteSpace( GameRef?.RevealedSeed ) ? "Hidden until match end" : GameRef.RevealedSeed;
	private IEnumerable<string> GetIntegrityReasons()
	{
		if ( GameRef?.AdminCommandUsedEver == true ) yield return "A CheatCmd command was used during this match.";
		if ( GameRef?.MatchConfigChangedAfterStart == true ) yield return "Match configuration changed after start.";
		if ( GameRef?.DoesDiceHistoryVerify() != true ) yield return "Dice history cannot currently be verified against the commitment.";
	}
	private string GetSnapshotSummary( IReadOnlyList<MoveHistoryPlayerSnapshot> snapshots, string label ) => snapshots is null || snapshots.Count == 0 ? $"{label}: no snapshot" : $"{label}: {string.Join( ", ", snapshots.Select( player => $"{player.PlayerName} ${player.Money}" ) )}";
	private string GetGambleWagerText( GambleHistoryEntry entry ) => entry.Wager > 0 ? $"Wagered ${entry.Wager} on {entry.ChosenSide}." : $"Free-play flip on {entry.ChosenSide}.";
	private string GetGambleResultRowClass( GambleHistoryEntry entry ) => entry.Won ? "" : "warning";
	private string GetCommandRowClass( CommandHistoryEntry entry ) => entry.CommandType switch { "CheatCmd" => "command-cheat", "HostCheatCmd" => "command-host-cheat", "HostCmd" => "command-host", _ => "" };

	private string GetTopRentName() { var row = TopRentRows.FirstOrDefault(); return row.SpaceIndex <= 0 && row.RentEarned <= 0 ? "None yet" : $"{row.Name} (${row.RentEarned})"; }
	private string GetBiggestLoserName() { var row = PlayerRows.Where( row => row.NetLoss > 0 ).OrderByDescending( row => row.NetLoss ).FirstOrDefault(); return row.PlayerIndex < 0 || row.NetLoss <= 0 ? "None yet" : $"{row.Name} (${row.NetLoss})"; }
	private List<PropertyStatsRow> BuildPropertyRows() => GameRef?.Board?.SpaceDefs?.Where( def => def is not null && IsPurchasableSpace( def ) ).Select( def => new PropertyStatsRow( def.Index, def, def.DisplayName ?? $"Space {def.Index}", GetTotalLandingsForSpace( def.Index ), GetTotalRentEarnedForSpace( def.Index ) ) ).OrderByDescending( row => row.Landings > 0 || row.RentEarned > 0 ).ThenByDescending( row => row.RentEarned ).ThenByDescending( row => row.Landings ).ThenBy( row => row.SpaceIndex ).ToList() ?? new();
	private List<PlayerStatsRow> BuildPlayerRows() => GameRef?.Players?.Select( ( player, index ) => new { player, index } ).Where( entry => entry.player is not null && entry.player.IsAssigned ).Select( entry => new PlayerStatsRow( entry.index, entry.player.PlayerName ?? $"Player {entry.index + 1}", entry.player.Money, Math.Max( GetStartingMoney() - entry.player.Money, 0 ), GameRef.GetOwnedPropertyIndexes( entry.index ).Count, GetTotalLandingsForPlayer( entry.index ), GetTotalRentEarnedForPlayer( entry.index ), entry.player.IsBankrupt, entry.index == GameRef.LocalPlayerIndex ) ).OrderByDescending( row => row.RentEarned ).ThenByDescending( row => row.PropertyCount ).ThenByDescending( row => row.Money ).ToList() ?? new();
	private List<GameLeaderboardRow> BuildGameLeaderboardRows()
	{
		var seeds = GameRef?.Players?.Select( ( player, index ) => new { player, index } ).Where( entry => entry.player is not null && entry.player.IsAssigned ).Select( entry => new GameLeaderboardSeed( entry.index, entry.player.PlayerName ?? $"Player {entry.index + 1}", entry.player.Money, GetTotalRentEarnedForPlayer( entry.index ), GetTotalRentPaidForPlayer( entry.index ), entry.player.IsBankrupt ) ).ToList() ?? new();
		IEnumerable<GameLeaderboardSeed> ordered = IsGameOver
			? seeds.OrderBy( row => GetRecordedPlacement( row.PlayerIndex ) ?? int.MaxValue ).ThenBy( row => row.PlayerIndex )
			: seeds.Where( row => !row.IsBankrupt ).OrderByDescending( row => GameRef.GetPlayerLiquidAssetTotal( row.PlayerIndex ) ).ThenByDescending( row => row.RentEarned ).ThenByDescending( row => row.Money ).ThenBy( row => row.PlayerIndex ).Concat( seeds.Where( row => row.IsBankrupt ).OrderBy( row => GetRecordedPlacement( row.PlayerIndex ) ?? int.MaxValue ).ThenBy( row => row.PlayerIndex ) );
		return ordered.Select( ( row, index ) =>
		{
			var placement = GetRecordedPlacement( row.PlayerIndex );
			var candidates = GetPropertyProfitCandidates( row.PlayerIndex );
			var most = candidates.OrderByDescending( candidate => candidate.RentEarned ).ThenBy( candidate => candidate.SpaceIndex ).Cast<PropertyProfitRow?>().FirstOrDefault();
			var costliestLanding = GetPropertyRentPaidCandidates( row.PlayerIndex ).OrderByDescending( candidate => candidate.RentPaid ).ThenBy( candidate => candidate.SpaceIndex ).Cast<PropertyRentPaidRow?>().FirstOrDefault();
			var rank = IsGameOver ? placement ?? index + 1 : row.IsBankrupt && placement.HasValue ? placement.Value : index + 1;
			return new GameLeaderboardRow( rank, row.PlayerIndex, row.Name, row.RentEarned, row.RentPaid, row.IsBankrupt, IsGameOver && row.PlayerIndex == GameRef.WinnerPlayerIndex, GetPlayerTimeLastedSeconds( row.PlayerIndex ), most, costliestLanding );
		} ).ToList();
	}
	private int? GetRecordedPlacement( int playerIndex ) => GameRef?.PlayerFinishPlacements?.TryGetValue( playerIndex, out var placement ) == true && placement > 0 ? placement : null;
	private int GetPlayerTimeLastedSeconds( int playerIndex ) => GameRef?.PlayerTimeLastedSeconds?.TryGetValue( playerIndex, out var seconds ) == true ? Math.Max( seconds, 0 ) : 0;
	private List<PropertyProfitRow> GetPropertyProfitCandidates( int playerIndex )
	{
		IEnumerable<int> indexes = GameRef?.Config?.LeaderboardStatPropertiesProfitType == PropertyProfitStatType.CurrentlyOwned ? GameRef?.GetOwnedPropertyIndexes( playerIndex ) ?? Enumerable.Empty<int>() : GameRef?.PropertyOwnershipHistory?.Where( entry => entry.Value && GetStatPlayerIndex( entry.Key ) == playerIndex ).Select( entry => GetStatSpaceIndex( entry.Key ) ) ?? Enumerable.Empty<int>();
		return indexes.Distinct().Select( index => GameRef?.Board?.GetSpaceDef( index ) ).Where( IsPropertyStatSpace ).Select( def => new PropertyProfitRow( def.Index, def.DisplayName ?? $"Space {def.Index}", GetTotalRentEarnedForPlayerSpace( playerIndex, def.Index ) ) ).ToList();
	}

	private List<PropertyRentPaidRow> GetPropertyRentPaidCandidates( int playerIndex ) => GameRef?.Board?.SpaceDefs?
		.Where( IsPropertyStatSpace )
		.Select( def => new PropertyRentPaidRow( def.Index, def.DisplayName ?? $"Space {def.Index}", GetTotalRentPaidForPlayerSpace( playerIndex, def.Index ) ) )
		.Where( row => row.RentPaid > 0 )
		.ToList() ?? new();
	private string GetPropertyProfitName( PropertyProfitRow? property ) => property.HasValue ? property.Value.Name : "None";
	private string GetPropertyRentPaidName( PropertyRentPaidRow? property ) => property.HasValue ? property.Value.Name : "None";

	private string GetGameStatsPropertyStatClass( int? spaceIndex )
	{
		var def = spaceIndex.HasValue ? GameRef?.Board?.GetSpaceDef( spaceIndex.Value ) : null;
		var colorClass = def?.Type switch
		{
			SpaceType.Chance => "chance",
			SpaceType.CommunityChest => "chest",
			SpaceType.Utility => "utility",
			SpaceType.Railroad => "railroad",
			_ => HudUi.GetPropertyColorClass( def )
		};
		return $"game-stats-stat property-profit-stat color-{colorClass}";
	}
	private static string FormatDuration( int seconds ) => $"{Math.Max( seconds, 0 ) / 3600:00}:{Math.Max( seconds, 0 ) / 60 % 60:00}:{Math.Max( seconds, 0 ) % 60:00}";
	private string GetGameLeaderboardRowClass( GameLeaderboardRow row ) => $"game-stats-card{(row.IsWinner ? " winner" : "")}{(row.IsBankrupt ? " bankrupt" : "")}";
	private static string GetPlayerInitial( string playerName ) => string.IsNullOrWhiteSpace( playerName ) ? "?" : char.ToUpperInvariant( playerName.Trim()[0] ).ToString();

	private Texture GetGameLeaderboardAvatarTexture( GameLeaderboardRow row )
	{
		if ( !MonopolyApp.IsStandalone() )
			return null;

		var player = GameRef?.Players?.ElementAtOrDefault( row.PlayerIndex );
		if ( player is null )
			return null;

		var steamId = player.SteamId != 0 ? player.SteamId : player.OwnerId;
		return SteamFriendsBridge.GetProfileEntry( steamId, row.Name )?.AvatarTexture;
	}
	private string GetModalClass() => IsPostMatch ? "post-match-stats-modal" : "";
	private int GetTotalLandingsForSpace( int spaceIndex ) => SumPropertyStatForSpace( GameRef.PropertyLandingCounts, spaceIndex );
	private int GetTotalRentEarnedForSpace( int spaceIndex ) => SumPropertyStatForSpace( GameRef.PropertyRentEarned, spaceIndex );
	private int GetTotalLandingsForPlayer( int playerIndex ) => SumPropertyStatForPlayer( GameRef.PropertyLandingCounts, playerIndex );
	private int GetTotalRentEarnedForPlayer( int playerIndex ) => SumPropertyStatForPlayer( GameRef.PropertyRentEarned, playerIndex );
	private int GetTotalRentPaidForPlayer( int playerIndex ) => SumPropertyStatForPlayer( GameRef?.PropertyRentPaid, playerIndex );
	private int GetTotalRentEarnedForPlayerSpace( int playerIndex, int spaceIndex ) => GameRef?.PropertyRentEarned?.Where( entry => GetStatPlayerIndex( entry.Key ) == playerIndex && GetStatSpaceIndex( entry.Key ) == spaceIndex ).Sum( entry => Math.Max( entry.Value, 0 ) ) ?? 0;
	private int GetTotalRentPaidForPlayerSpace( int playerIndex, int spaceIndex ) => GameRef?.PropertyRentPaid?.Where( entry => GetStatPlayerIndex( entry.Key ) == playerIndex && GetStatSpaceIndex( entry.Key ) == spaceIndex ).Sum( entry => Math.Max( entry.Value, 0 ) ) ?? 0;
	private int GetStartingMoney() => Math.Max( GameRef?.Config?.StartingMoney ?? 1500, 0 );
	private static int SumPropertyStatForSpace( NetDictionary<int, int> stats, int spaceIndex ) => stats?.Where( entry => GetStatSpaceIndex( entry.Key ) == spaceIndex ).Sum( entry => Math.Max( entry.Value, 0 ) ) ?? 0;
	private static int SumPropertyStatForPlayer( NetDictionary<int, int> stats, int playerIndex ) => stats?.Where( entry => GetStatPlayerIndex( entry.Key ) == playerIndex ).Sum( entry => Math.Max( entry.Value, 0 ) ) ?? 0;
	private static int GetStatPlayerIndex( int key ) => key / 1000;
	private static int GetStatSpaceIndex( int key ) => key % 1000;
	private static bool IsPurchasableSpace( SpaceDef def ) => def is not null && def.Price > 0 && IsPropertyStatSpace( def );
	private static bool IsPropertyStatSpace( SpaceDef def ) => def is not null && (def.Type == SpaceType.Property || def.Type == SpaceType.Railroad || def.Type == SpaceType.Utility);
	private string GetOwnerName( int spaceIndex ) { var ownerIndex = GameRef?.GetOwnerIndexForSpace( spaceIndex ) ?? -1; return ownerIndex < 0 ? "Bank" : GameRef?.Players?.ElementAtOrDefault( ownerIndex )?.PlayerName ?? $"Player {ownerIndex + 1}"; }
	private string GetOwnerText( int spaceIndex ) { var ownerName = GetOwnerName( spaceIndex ); return ownerName == "Bank" ? "Unowned" : $"Owned by {ownerName}"; }
	private string GetPropertyStatusText( PropertyStatsRow row ) { if ( GameRef?.IsMortgaged( row.SpaceIndex ) == true ) return "Mortgaged"; var improvements = GameRef?.GetImprovementCount( row.SpaceIndex ) ?? 0; if ( improvements == 5 ) return "Hotel"; if ( improvements > 0 ) return $"{improvements} house{(improvements == 1 ? "" : "s")}"; return row.Space.Type.ToString(); }
	private string GetColorSwatchClasses( SpaceDef def ) => $"property-stats-color-swatch color-{HudUi.GetPropertyColorClass( def )}";
	private string GetPlayerRowClasses( PlayerStatsRow row ) { var classes = "property-stats-player-row"; if ( row.IsLocalPlayer ) classes += " local-player"; if ( row.IsBankrupt ) classes += " bankrupt"; return classes; }
	protected override int BuildHash()
	{
		var hash = new HashCode(); hash.Add( IsOpen ); hash.Add( IsPostMatch ); hash.Add( CanUseHostControls ); hash.Add( ActiveTab ); hash.Add( GameRef?.MatchState ?? 0 ); hash.Add( GameRef?.WinnerPlayerIndex ?? -1 ); hash.Add( GameRef?.Config?.LeaderboardStatPropertiesProfitType ?? PropertyProfitStatType.EverOwned ); hash.Add( GameRef?.IsVerifiedMatch ?? false ); hash.Add( MonopolyApp.IsCheatsEnabled() ); hash.Add( MonopolyApp.IsStandalone() ); if ( MonopolyApp.IsStandalone() ) hash.Add( SteamFriendsBridge.AvatarRevision ); hash.Add( GameRef?.DiceHistory?.Count ?? 0 ); hash.Add( GameRef?.AdminHistory?.Count ?? 0 ); hash.Add( GameRef?.CommandHistory?.Count ?? 0 ); hash.Add( GameRef?.MoveHistory?.Count ?? 0 ); hash.Add( MoveHistoryPage ); hash.Add( MoveHistoryPageSize ); hash.Add( GameRef?.GambleHistory?.Count ?? 0 ); hash.Add( GameRef?.RevealedSeed ?? "" ); hash.Add( GameRef?.PropertyOwners?.Count ?? 0 );
		if ( GameRef?.Players is not null ) foreach ( var entry in GameRef.Players.Select( ( player, index ) => new { player, index } ).Where( entry => entry.player is not null && entry.player.IsAssigned ) ) { hash.Add( entry.index ); hash.Add( entry.player.SteamId ); hash.Add( entry.player.PlayerName ); hash.Add( entry.player.Money ); hash.Add( entry.player.IsBankrupt ); }
		if ( GameRef?.PropertyOwners is not null ) foreach ( var entry in GameRef.PropertyOwners.OrderBy( entry => entry.Key ) ) { hash.Add( entry.Key ); hash.Add( entry.Value ); }
		if ( GameRef?.PropertyLandingCounts is not null ) foreach ( var entry in GameRef.PropertyLandingCounts.OrderBy( entry => entry.Key ) ) { hash.Add( entry.Key ); hash.Add( entry.Value ); }
		if ( GameRef?.PropertyRentEarned is not null ) foreach ( var entry in GameRef.PropertyRentEarned.OrderBy( entry => entry.Key ) ) { hash.Add( entry.Key ); hash.Add( entry.Value ); }
		if ( GameRef?.PropertyRentPaid is not null ) foreach ( var entry in GameRef.PropertyRentPaid.OrderBy( entry => entry.Key ) ) { hash.Add( entry.Key ); hash.Add( entry.Value ); }
		if ( GameRef?.PropertyOwnershipHistory is not null ) foreach ( var entry in GameRef.PropertyOwnershipHistory.OrderBy( entry => entry.Key ) ) { hash.Add( entry.Key ); hash.Add( entry.Value ); }
		if ( GameRef?.PlayerFinishPlacements is not null ) foreach ( var entry in GameRef.PlayerFinishPlacements.OrderBy( entry => entry.Key ) ) { hash.Add( entry.Key ); hash.Add( entry.Value ); }
		if ( GameRef?.PlayerTimeLastedSeconds is not null ) foreach ( var entry in GameRef.PlayerTimeLastedSeconds.OrderBy( entry => entry.Key ) ) { hash.Add( entry.Key ); hash.Add( entry.Value ); }
		return hash.ToHashCode();
	}
}
