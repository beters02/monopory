@using Sandbox;
@using Sandbox.UI;
@using Sandbox.ui.components.buttons;
@using System;
@using System.Linq;
@inherits Panel

<root class="match-settings-page match-settings-game-rules-page">
	<OptionsPanelSectionList Sections="@ConfigSections" SectionOptionsVariant="@SectionOptionsVariant">
		<ChildContent Context="section">
		@foreach ( var option in GetConfigOptionsForGroupForDisplay( section.Key ) )
			{
				<OptionsPanelRow Title="@option.Label" Value="@option.Description">
					<ChildContent>
						@if ( option.Kind == MatchConfigOptionKind.Bool )
						{
							@if ( CanEdit )
							{
								<GameButton Variant="@GetToggleButtonClasses( GetBoolValue( option ) )"
									OnClick="@(() => ToggleBoolValue( option ))">
									@(GetBoolValue( option ) ? "On" : "Off")
								</GameButton>
							}
							else
							{
								<div class="@GetToggleDisplayClasses( GetBoolValue( option ) )">
									@(GetBoolValue( option ) ? "On" : "Off")
								</div>
							}
						}
						else if ( option.Kind == MatchConfigOptionKind.Enum )
						{
							@if ( CanEdit )
							{
								<DropdownButton Value="@GetEnumValue( option )" Items="@option.EnumNames" ScrollTarget="@ScrollTarget" OnSelected="@((string value) => SetEnumValue( option, value ))"></DropdownButton>
							}
							else
							{
								<div class="options-panel-readonly-value">@GetFormattedValue( option )</div>
							}
						}
						else if ( option.Kind == MatchConfigOptionKind.Int )
						{
							<div class="options-panel-stepper">
								@if ( CanEdit )
								{
									<GameButton Variant="options-panel-step-button"
										OnClick="@(() => ChangeIntValue( option, -option.Step ))">-</GameButton>
									<TextEntry class="options-panel-stepper-input"
										Text="@GetIntTextValue( option )"
										Placeholder="0"
										OnTextEdited="@((string value) => SetIntDraftValue( option, value ))"
										onsubmit="@(() => CommitIntDraftValue( option ))" />
									<GameButton Variant="options-panel-step-button"
										OnClick="@(() => ChangeIntValue( option, option.Step ))">+</GameButton>
								}
								else
								{
									<div class="options-panel-stepper-value readonly">@GetIntValue( option )</div>
								}
							</div>
						}
					</ChildContent>
				</OptionsPanelRow>
			}
		</ChildContent>
	</OptionsPanelSectionList>
</root>

@code
{
	[Parameter] public MatchConfig Config { get; set; }
	[Parameter] public bool CanEdit { get; set; }
	[Parameter] public bool ShowHiddenOptions { get; set; }
	[Parameter] public Panel ScrollTarget { get; set; }
	[Parameter] public string SectionOptionsVariant { get; set; } = "";
	[Parameter] public bool ReverseOptionsInGroup { get; set; }
	[Parameter] public Func<MatchConfigOption, string> IntTextValueProvider { get; set; }
	[Parameter] public Action<MatchConfigOption> OnToggleBool { get; set; }
	[Parameter] public Action<MatchConfigOption, int> OnChangeInt { get; set; }
	[Parameter] public Action<MatchConfigOption, string> OnSetIntDraft { get; set; }
	[Parameter] public Action<MatchConfigOption> OnCommitIntDraft { get; set; }
	[Parameter] public Action<MatchConfigOption, string> OnSetEnum { get; set; }

	private IReadOnlyList<OptionsPanelSection> ConfigSections =>
		ConfigGroups.Select( group => new OptionsPanelSection
		{
			Key = group,
			Title = group,
			HasItems = GetConfigOptionsForGroup( group ).Any()
		} ).ToList();

	private IReadOnlyList<string> ConfigGroups => GetVisibleConfigOptions().Select( option => option.Group ).Distinct().ToList();

	private IEnumerable<MatchConfigOption> GetConfigOptionsForGroup( string group )
	{
		return GetVisibleConfigOptions().Where( option => string.Equals( option.Group, group, StringComparison.Ordinal ) );
	}

	private IEnumerable<MatchConfigOption> GetConfigOptionsForGroupForDisplay( string group )
	{
		var options = GetConfigOptionsForGroup( group );
		return ReverseOptionsInGroup ? options.Reverse() : options;
	}

	private IEnumerable<MatchConfigOption> GetVisibleConfigOptions()
	{
		var options = ShowHiddenOptions
			? MatchConfigSchema.Options
			: MatchConfigSchema.Options.Where( option => option.IsVisible );

		return options.Where( option => option.Kind != MatchConfigOptionKind.String );
	}

	private bool GetBoolValue( MatchConfigOption option )
	{
		return (bool)(MatchConfigSchema.GetOptionValue( option, Config ) ?? false);
	}

	private int GetIntValue( MatchConfigOption option )
	{
		return (int)(MatchConfigSchema.GetOptionValue( option, Config ) ?? 0);
	}

	private string GetIntTextValue( MatchConfigOption option )
	{
		return IntTextValueProvider?.Invoke( option ) ?? GetIntValue( option ).ToString();
	}

	private string GetEnumValue( MatchConfigOption option )
	{
		return MatchConfigSchema.GetOptionValue( option, Config )?.ToString() ?? "";
	}

	private string GetFormattedValue( MatchConfigOption option )
	{
		var value = MatchConfigSchema.GetOptionValue( option, Config );

		if ( option.Kind == MatchConfigOptionKind.Bool )
			return (bool)(value ?? false) ? "On" : "Off";

		if ( option.Kind == MatchConfigOptionKind.Enum )
			return FormatEnumLabel( value?.ToString() ?? "" );

		return MatchConfigSchema.FormatValue( option, value );
	}

	private void ToggleBoolValue( MatchConfigOption option )
	{
		OnToggleBool?.Invoke( option );
	}

	private void ChangeIntValue( MatchConfigOption option, int delta )
	{
		OnChangeInt?.Invoke( option, delta );
	}

	private void SetIntDraftValue( MatchConfigOption option, string value )
	{
		OnSetIntDraft?.Invoke( option, value );
	}

	private void CommitIntDraftValue( MatchConfigOption option )
	{
		OnCommitIntDraft?.Invoke( option );
	}

	private void SetEnumValue( MatchConfigOption option, string value )
	{
		OnSetEnum?.Invoke( option, value );
	}

	private static string GetToggleButtonClasses( bool enabled )
	{
		return enabled ? "options-panel-toggle-button selected" : "options-panel-toggle-button";
	}

	private static string GetToggleDisplayClasses( bool enabled )
	{
		return enabled
			? "options-panel-toggle-display selected readonly"
			: "options-panel-toggle-display readonly";
	}

	private static string FormatEnumLabel( string value )
	{
		if ( string.IsNullOrWhiteSpace( value ) )
			return "";

		var label = value.Replace( "_", " " );
		for ( var i = label.Length - 1; i > 0; i-- )
		{
			if ( char.IsUpper( label[i] ) && !char.IsWhiteSpace( label[i - 1] ) )
				label = label.Insert( i, " " );
		}

		return label;
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( Config is not null );
		hash.Add( CanEdit );
		hash.Add( ShowHiddenOptions );
		hash.Add( SectionOptionsVariant ?? "" );
		hash.Add( ReverseOptionsInGroup );

		if ( Config is not null )
		{
			foreach ( var option in MatchConfigSchema.Options )
				hash.Add( MatchConfigSchema.FormatValue( option, MatchConfigSchema.GetOptionValue( option, Config ) ) );
		}

		return hash.ToHashCode();
	}
}
