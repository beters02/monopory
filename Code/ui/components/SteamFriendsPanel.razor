@using Sandbox;
@using Sandbox.UI;
@using System;
@inherits Panel

<root class="steam-friends-root">
	<div class="@PanelClasses" @ref="FriendsPanel">
		<div class="steam-friends-header">
			<div class="steam-friends-title">Friends</div>
			<div class="@GetStandaloneBadgeClasses()">@GetStandaloneBadgeText()</div>
		</div>
		<div class="steam-friends-list monopory-scroll-y">
			@if ( Friends.Count == 0 )
			{
				<div class="steam-friends-empty">
					<div class="steam-friends-empty-title">@GetEmptyTitle()</div>
					<div class="steam-friends-empty-copy">@GetEmptyCopy()</div>
				</div>
			}
			else
			{
				@foreach ( var friend in Friends )
				{
					<div class="@GetFriendRowClasses( friend )" title="@friend.Name" onclick="@(() => ToggleFriendPopup( friend ))">
						<div class="steam-friend-avatar">
							@if ( friend.AvatarTexture is not null )
							{
								<Image class="steam-avatar-image" Texture="@friend.AvatarTexture"></Image>
							}
							else
							{
								<div class="steam-avatar-initials">@GetInitials( friend.Name )</div>
							}
						</div>
						<div class="steam-friend-body">
							<div class="steam-friend-name">@friend.Name</div>
							<div class="steam-friend-status">@GetFriendStatus( friend )</div>
						</div>
					</div>
				}
			}
		</div>
	</div>
	@if ( SelectedFriend is not null )
	{
		<div class="steam-friend-popup" style="@PopupStyle" @ref="PopupPanel">
			<div class="steam-friend-popup-top">
				<div class="steam-friend-popup-avatar">
					@if ( SelectedFriend.AvatarTexture is not null )
					{
						<Image class="steam-avatar-image" Texture="@SelectedFriend.AvatarTexture"></Image>
					}
					else
					{
						<div class="steam-avatar-initials">@GetInitials( SelectedFriend.Name )</div>
					}
				</div>
				<div class="steam-friend-popup-main">
					<div class="steam-friend-popup-name">@SelectedFriend.Name</div>
					<div class="steam-friend-popup-status">@GetFriendStatus( SelectedFriend )</div>
				</div>
			</div>
			<div class="steam-friend-popup-actions">
				<button class="steam-friend-popup-action primary" onclick="@InviteSelectedFriend">
					<div class="steam-friend-popup-action-icon">+</div>
					<div>Invite</div>
				</button>
				<button class="steam-friend-popup-action" onclick="@OpenSelectedFriendProfile">
					<div class="steam-friend-popup-action-icon">P</div>
					<div>Profile</div>
				</button>
				<button class="steam-friend-popup-action" onclick="@ClosePopup">
					<div class="steam-friend-popup-action-icon">x</div>
					<div>Close</div>
				</button>
			</div>
		</div>
	}
</root>

@code
{
	private SteamFriendListEntry SelectedFriend;
	private Panel FriendsPanel = null!;
	private Panel PopupPanel = null!;
	private float PopupRight;
	private float PopupTop;
	private int actionRevision;
	private bool IsFriendUiHovered;
	private float lastHoverTime;
	private const float HoverCloseDelay = 0.12f;
	private const float FriendsHeaderHeight = 46f;
	private const float FriendsListPaddingTop = 8f;
	private const float FriendRowHeight = 58f;
	private const float FriendRowGap = 5f;
	private const float FriendsPanelRight = 12f;
	private const float FriendsPanelWidth = 286f;
	private const float PopupGap = 12f;

	private IReadOnlyList<SteamFriendListEntry> Friends => SteamFriendsBridge.GetFriends();
	private bool IsStandalone => MonopolyApp.IsStandalone();

	public override void Tick()
	{
		base.Tick();

		var wasHovered = IsFriendUiHovered;
		IsFriendUiHovered = IsMouseInsideFriendUi();

		if ( IsFriendUiHovered )
			lastHoverTime = Time.Now;
		else if ( SelectedFriend is not null && Time.Now - lastHoverTime > HoverCloseDelay )
			ClosePopup();

		if ( wasHovered != IsFriendUiHovered )
			actionRevision++;

		StateHasChanged();
	}

	private void ToggleFriendPopup( SteamFriendListEntry friend )
	{
		if ( friend is null )
			return;

		if ( ReferenceEquals( SelectedFriend, friend ) )
		{
			ClosePopup();
			return;
		}

		SelectedFriend = friend;
		var panelOrigin = FriendsPanel is not null
			? ScreenPositionToPanelPosition( FriendsPanel.PanelPositionToScreenPosition( Vector2.Zero ) )
			: ScreenPositionToPanelPosition( Mouse.Position );
		var clickPosition = ScreenPositionToPanelPosition( Mouse.Position );

		PopupRight = FriendsPanelRight + FriendsPanelWidth + PopupGap;
		
		PopupTop = Mouse.Position.y * (1/this.ScaleToScreen) - (FriendRowHeight/2)/2;
		Mouse.Visibility = MouseVisibility.Visible;
		lastHoverTime = Time.Now;
		actionRevision++;
	}

	private void InviteSelectedFriend()
	{
		if ( SelectedFriend is null )
			return;

		if ( !SteamFriendsBridge.TryInviteFriend( SelectedFriend ) )
			Log.Warning( $"Could not invite Steam friend {SelectedFriend.Name}." );

		ClosePopup();
	}

	private void OpenSelectedFriendProfile()
	{
		if ( SelectedFriend is null )
			return;

		if ( !SteamFriendsBridge.TryOpenProfile( SelectedFriend ) )
			Log.Warning( $"Could not open Steam profile for {SelectedFriend.Name}." );

		ClosePopup();
	}

	private void ClosePopup()
	{
		SelectedFriend = null;
		actionRevision++;
	}

	private string PanelClasses => IsFriendUiHovered ? "steam-friends-panel is-expanded" : "steam-friends-panel";
	private string PopupStyle => $"right: {PopupRight:0}px; top: {PopupTop:0}px;";

	private bool IsMouseInsideFriendUi()
	{
		var position = Mouse.Position;
		return (FriendsPanel is not null && IsPointInside( FriendsPanel.Box.Rect, position ))
			|| (PopupPanel is not null && IsPointInside( PopupPanel.Box.Rect, position ));
	}

	private static bool IsPointInside( Rect rect, Vector2 point )
	{
		return point.x >= rect.Left
			&& point.x <= rect.Right
			&& point.y >= rect.Top
			&& point.y <= rect.Bottom;
	}

	private string GetStandaloneBadgeClasses()
	{
		return IsStandalone ? "steam-friends-badge standalone" : "steam-friends-badge editor";
	}

	private string GetStandaloneBadgeText()
	{
		return IsStandalone ? "Steam" : "Editor";
	}

	private string GetEmptyTitle()
	{
		return IsStandalone ? "No friends found" : "Steam unavailable";
	}

	private string GetEmptyCopy()
	{
		return IsStandalone
			? "Friends will appear here when Steam exposes them."
			: "Friend rows only render in standalone builds.";
	}

	private static string GetFriendRowClasses( SteamFriendListEntry friend )
	{
		var classes = "steam-friend-row";

		if ( friend?.IsPlayingThisGame == true )
			classes += " in-game";
		else if ( friend?.IsOnline == true )
			classes += " online";
		else
			classes += " offline";

		return classes;
	}

	private static string GetFriendStatus( SteamFriendListEntry friend )
	{
		if ( friend is null )
			return "";

		if ( !string.IsNullOrWhiteSpace( friend.RichPresence ) )
			return friend.RichPresence;

		if ( friend.IsPlayingThisGame )
			return "Playing Rent Rush";

		if ( !string.IsNullOrWhiteSpace( friend.Status ) )
			return friend.Status;

		return friend.IsOnline ? "Online" : "Offline";
	}

	private static string GetInitials( string name )
	{
		if ( string.IsNullOrWhiteSpace( name ) )
			return "?";

		var parts = name.Trim().Split( ' ', StringSplitOptions.RemoveEmptyEntries );
		if ( parts.Length >= 2 )
			return $"{parts[0][0]}{parts[1][0]}".ToUpper();

		return name.Trim()[0].ToString().ToUpper();
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsStandalone );
		hash.Add( SelectedFriend?.SteamId ?? 0 );
		hash.Add( PopupRight );
		hash.Add( PopupTop );
		hash.Add( actionRevision );
		hash.Add( IsFriendUiHovered );
		hash.Add( MathF.Floor( Time.Now * 0.5f ) );

		foreach ( var friend in Friends )
		{
			hash.Add( friend.SteamId );
			hash.Add( friend.Name );
			hash.Add( friend.Status );
			hash.Add( friend.RichPresence );
			hash.Add( friend.IsOnline );
			hash.Add( friend.IsPlayingThisGame );
			hash.Add( friend.AvatarTexture is not null );
		}

		return hash.ToHashCode();
	}
}
