@using Sandbox;
@using Sandbox.UI;
@using System;
@inherits Panel

<root class="@RootClasses">
	@if ( !@LoadingState.IsFunctionalityEnabled )
		return;

	@if ( ShouldRenderOverlay )
	{
		<div class="loading-overlay-screen">
			<div class="loading-overlay-card">
				<div class="loading-overlay-spinner">
					<div class="loading-overlay-spinner-dot top-left"></div>
					<div class="loading-overlay-spinner-dot top-right"></div>
					<div class="loading-overlay-spinner-dot center"></div>
					<div class="loading-overlay-spinner-dot bottom-left"></div>
					<div class="loading-overlay-spinner-dot bottom-right"></div>
				</div>
				<div class="loading-overlay-copy">
					<div class="loading-overlay-kicker">Loading</div>
					<div class="loading-overlay-title">@DisplayTitle</div>
					@if ( !string.IsNullOrWhiteSpace( DisplayMessage ) )
					{
						<div class="loading-overlay-body">@DisplayMessage</div>
					}
				</div>
			</div>
		</div>
	}
</root>

@code 
{
	[Parameter] public bool IsServerLoading { get; set; }
	[Parameter] public string ServerLoadingTitle { get; set; } = "";
	[Parameter] public string ServerLoadingMessage { get; set; } = "";
	[Parameter] public float ServerLoadingStartedAt { get; set; }
	[Parameter] public float ServerLoadingClientTimeoutSeconds { get; set; } = 25f;
	[Parameter] public int ServerLoadingRevision { get; set; }

	private bool isOverlayRendered;
	private bool isOverlayExiting;
	private bool wasOverlayTargetVisible;
	private float overlayExitStartedAt;
	private string lastTitle = "Loading";
	private string lastMessage = "";

	private bool IsLocalLoadingVisible =>
		LoadingState.IsVisible && Time.Now - LoadingState.StartedAt <= LoadingState.ClientTimeoutSeconds;

	private bool IsServerLoadingVisible =>
		IsServerLoading && Time.Now - ServerLoadingStartedAt <= ServerLoadingClientTimeoutSeconds;

	private bool IsOverlayTargetVisible => IsLocalLoadingVisible || IsServerLoadingVisible;

	private bool ShouldRenderOverlay
	{
		get
		{
			UpdateOverlayTransitionState();
			return isOverlayRendered;
		}
	}

	private string DisplayTitle => IsOverlayTargetVisible
		? (IsLocalLoadingVisible ? LoadingState.Title : ServerLoadingTitle)
		: lastTitle;

	private string DisplayMessage => IsOverlayTargetVisible
		? (IsLocalLoadingVisible ? LoadingState.Message : ServerLoadingMessage)
		: lastMessage;

	private string RootClasses
	{
		get
		{
			UpdateOverlayTransitionState();

			var classes = "loading-overlay-root";
			if ( IsOverlayTargetVisible )
				classes += " visible";
			else if ( isOverlayExiting )
				classes += " exiting";

			return classes;
		}
	}

	private void UpdateOverlayTransitionState()
	{
		var targetVisible = IsOverlayTargetVisible;
		if ( targetVisible )
		{
			isOverlayRendered = true;
			isOverlayExiting = false;
			wasOverlayTargetVisible = true;
			overlayExitStartedAt = 0f;
			lastTitle = IsLocalLoadingVisible ? LoadingState.Title : ServerLoadingTitle;
			lastMessage = IsLocalLoadingVisible ? LoadingState.Message : ServerLoadingMessage;
			return;
		}

		if ( wasOverlayTargetVisible && isOverlayRendered && !isOverlayExiting )
		{
			isOverlayExiting = true;
			overlayExitStartedAt = Time.Now;
			wasOverlayTargetVisible = false;
		}

		if ( isOverlayExiting && Time.Now - overlayExitStartedAt >= LoadingState.OverlayTransitionSeconds )
		{
			isOverlayRendered = false;
			isOverlayExiting = false;
		}
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( LoadingState.IsVisible );
		hash.Add( LoadingState.Title );
		hash.Add( LoadingState.Message );
		hash.Add( LoadingState.Revision );
		hash.Add( IsServerLoading );
		hash.Add( ServerLoadingTitle );
		hash.Add( ServerLoadingMessage );
		hash.Add( ServerLoadingStartedAt );
		hash.Add( ServerLoadingClientTimeoutSeconds );
		hash.Add( ServerLoadingRevision );
		hash.Add( LoadingState.IsBlockingInteraction );
		hash.Add( isOverlayRendered );
		hash.Add( isOverlayExiting );
		if ( LoadingState.IsBlockingInteraction || IsServerLoading || isOverlayRendered )
			hash.Add( MathF.Round( Time.Now * 2f ) );
		return hash.ToHashCode();
	}
}
	
