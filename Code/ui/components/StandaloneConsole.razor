@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Concurrent;
@using System.IO;
@using System.Reflection;
@using System.Text;
@using System.Linq;
@inherits PanelComponent

<root class="@RootClasses">
	@if ( IsOpen )
	{
		<div class="standalone-console-window">
			<div class="standalone-console-output" @ref="OutputPanel">
				@foreach ( var entry in FilteredEntries )
				{
					<div class="standalone-console-line @entry.Kind">
						<span class="standalone-console-time">@entry.TimeText</span>
						<span class="standalone-console-message">@entry.Message</span>
					</div>
				}
			</div>

			<div class="standalone-console-toolbar">
				<ConsoleCommandTextEntry @ref="CommandInput"
					class="standalone-console-input"
					Placeholder="Enter console command..."
					OnConsoleCloseRequested="@Close"
					onsubmit="@SubmitCommand" />

				<TextEntry class="standalone-console-filter"
					Placeholder="Filter..."
					OnTextEdited="@SetFilter" />

				<button class="standalone-console-type msg @(ShowMessages ? "active" : "")" onclick="@ToggleMessages">@MessageCount</button>
				<button class="standalone-console-type wrn @(ShowWarnings ? "active" : "")" onclick="@ToggleWarnings">@WarningCount</button>
				<button class="standalone-console-type err @(ShowErrors ? "active" : "")" onclick="@ToggleErrors">@ErrorCount</button>
				<button class="standalone-console-clear" onclick="@Clear">clear</button>
			</div>
		</div>
	}
</root>

@code
{
	private readonly record struct ConsoleEntry( string Message, string Kind, DateTime Time )
	{
		public string TimeText => Time.ToString( "HH:mm:ss" );
	}

	private const string LogTargetName = "monopory-standalone-console";
	private const string LogRuleName = "monopory-standalone-console-rule";
	private static readonly ConcurrentQueue<ConsoleEntry> PendingLogEntries = new();
	private static bool LogTargetRegistered;
	private static bool LogTargetRegistrationFailed;
	private static bool StdoutCaptureRegistered;
	private static TextWriter OriginalOut;
	private static TextWriter OriginalError;
	private FileInfo TailedLogFile;
	private long TailedLogPosition;
	private DateTime NextLogPollTime;

	private static readonly string[] KnownCommands =
	{
		"clear",
		"debug",
		"buy_property",
		"buy_property_set",
		"roll_dice",
		"change_money",
		"sv_cheats",
		"quit",
		"disconnect"
	};

	private readonly List<ConsoleEntry> Entries = new();
	private ConsoleCommandTextEntry CommandInput = null!;
	private Panel OutputPanel = null!;
	private bool WantsFocus;
	private string Filter = "";

	public static bool IsConsoleOpen { get; private set; }
	public bool IsOpen { get; private set; }
	private bool ShowMessages { get; set; } = true;
	private bool ShowWarnings { get; set; } = true;
	private bool ShowErrors { get; set; } = true;
	private bool HasShownReadyLine;

	private string RootClasses => IsOpen ? "standalone-console-root open" : "standalone-console-root";
	private int MessageCount => Entries.Count( entry => entry.Kind == "msg" || entry.Kind == "cmd" );
	private int WarningCount => Entries.Count( entry => entry.Kind == "wrn" );
	private int ErrorCount => Entries.Count( entry => entry.Kind == "err" );

	private IEnumerable<ConsoleEntry> FilteredEntries => Entries.Where( ShouldShowEntry );

	protected override void OnUpdate()
	{
		base.OnUpdate();

		ConfigureInput();
		RegisterStdoutCapture();
		RegisterLogTarget();
		PollActiveLogFile();
		DrainLogQueue();

		if ( !HasShownReadyLine )
		{
			HasShownReadyLine = true;
			AddEntry( "Standalone console ready. Press ESC or = to close.", "msg" );
		}

		if ( ShouldToggleConsole() )
		{
			Toggle();
			return;
		}

		if ( IsOpen && Input.EscapePressed )
		{
			Close();
			return;
		}

		if ( WantsFocus && CommandInput is not null )
		{
			CommandInput.Focus();

			if ( CommandInput.HasFocus )
				WantsFocus = false;
		}
	}

	private void ConfigureInput()
	{
		if ( CommandInput is null )
			return;

		CommandInput.HistoryCookie = "monopory-standalone-console-history";
		CommandInput.AutoComplete = GetAutoComplete;
	}

	private static void RegisterStdoutCapture()
	{
		if ( StdoutCaptureRegistered )
			return;

		try
		{
			OriginalOut = System.Console.Out;
			OriginalError = System.Console.Error;

			System.Console.SetOut( new ConsoleMirrorWriter( OriginalOut, "msg" ) );
			System.Console.SetError( new ConsoleMirrorWriter( OriginalError, "err" ) );
			StdoutCaptureRegistered = true;
		}
		catch ( Exception exception )
		{
			StdoutCaptureRegistered = true;
			PendingLogEntries.Enqueue( new ConsoleEntry( $"Could not attach stdout stream: {exception.Message}", "wrn", DateTime.Now ) );
		}
	}

	private static void RegisterLogTarget()
	{
		if ( LogTargetRegistered || LogTargetRegistrationFailed )
			return;

		try
		{
			var nlogAssembly = GetNLogAssembly();
			if ( nlogAssembly is null )
			{
				LogTargetRegistrationFailed = true;
				return;
			}

			var logManagerType = nlogAssembly.GetType( "NLog.LogManager" );
			var loggingConfigurationType = nlogAssembly.GetType( "NLog.Config.LoggingConfiguration" );
			var loggingRuleType = nlogAssembly.GetType( "NLog.Config.LoggingRule" );
			var logLevelType = nlogAssembly.GetType( "NLog.LogLevel" );
			var methodCallTargetType = nlogAssembly.GetType( "NLog.Targets.MethodCallTarget" );
			var methodCallParameterType = nlogAssembly.GetType( "NLog.Targets.MethodCallParameter" );
			var simpleLayoutType = nlogAssembly.GetType( "NLog.Layouts.SimpleLayout" );

			if ( logManagerType is null ||
				loggingConfigurationType is null ||
				loggingRuleType is null ||
				logLevelType is null ||
				methodCallTargetType is null ||
				methodCallParameterType is null ||
				simpleLayoutType is null )
			{
				LogTargetRegistrationFailed = true;
				return;
			}

			var configurationProperty = logManagerType.GetProperty( "Configuration", BindingFlags.Public | BindingFlags.Static );
			var configuration = configurationProperty?.GetValue( null ) ?? Activator.CreateInstance( loggingConfigurationType );
			if ( configuration is null )
			{
				LogTargetRegistrationFailed = true;
				return;
			}

			var findTargetByName = loggingConfigurationType
				.GetMethods( BindingFlags.Public | BindingFlags.Instance )
				.FirstOrDefault( method =>
					method.Name == "FindTargetByName" &&
					!method.IsGenericMethod &&
					method.GetParameters().Length == 1 &&
					method.GetParameters()[0].ParameterType == typeof( string ) );

			var existingTarget = findTargetByName?.Invoke( configuration, new object[] { LogTargetName } );

			if ( existingTarget is null )
			{
				var target = Activator.CreateInstance( methodCallTargetType );
				methodCallTargetType.GetProperty( "Name" )?.SetValue( target, LogTargetName );
				methodCallTargetType.GetProperty( "ClassName" )?.SetValue( target, typeof( StandaloneConsole ).AssemblyQualifiedName );
				methodCallTargetType.GetProperty( "MethodName" )?.SetValue( target, nameof( ReceiveLogLine ) );

				AddLogParameter( target, methodCallTargetType, methodCallParameterType, simpleLayoutType, "${level:uppercase=true}" );
				AddLogParameter( target, methodCallTargetType, methodCallParameterType, simpleLayoutType, "${logger}" );
				AddLogParameter( target, methodCallTargetType, methodCallParameterType, simpleLayoutType, "${message}" );
				AddLogParameter( target, methodCallTargetType, methodCallParameterType, simpleLayoutType, "${date:format=HH\\:mm\\:ss}" );

				var targetBaseType = GetBaseTypeByName( methodCallTargetType, "NLog.Targets.Target" );
				if ( targetBaseType is null )
				{
					LogTargetRegistrationFailed = true;
					return;
				}

				loggingConfigurationType
					.GetMethod( "AddTarget", new[] { targetBaseType } )
					?.Invoke( configuration, new[] { target } );

				var traceLevel = logLevelType.GetField( "Trace", BindingFlags.Public | BindingFlags.Static )?.GetValue( null );
				var fatalLevel = logLevelType.GetField( "Fatal", BindingFlags.Public | BindingFlags.Static )?.GetValue( null );
				var rule = Activator.CreateInstance( loggingRuleType, "*", traceLevel, fatalLevel, target );
				loggingRuleType.GetProperty( "RuleName" )?.SetValue( rule, LogRuleName );

				var rules = loggingConfigurationType.GetProperty( "LoggingRules" )?.GetValue( configuration );
				rules?.GetType().GetMethod( "Insert" )?.Invoke( rules, new object[] { 0, rule } );

				configurationProperty?.SetValue( null, configuration );
				logManagerType.GetMethod( "ReconfigExistingLoggers", Type.EmptyTypes )?.Invoke( null, null );
			}

			LogTargetRegistered = true;
		}
		catch ( Exception exception )
		{
			LogTargetRegistrationFailed = true;
			PendingLogEntries.Enqueue( new ConsoleEntry( $"Could not attach log stream: {exception.Message}", "wrn", DateTime.Now ) );
		}
	}

	private static Assembly GetNLogAssembly()
	{
		return AppDomain.CurrentDomain
			.GetAssemblies()
			.FirstOrDefault( assembly => string.Equals( assembly.GetName().Name, "NLog", StringComparison.OrdinalIgnoreCase ) );
	}

	private static void AddLogParameter( object target, Type targetType, Type parameterType, Type layoutType, string layout )
	{
		var simpleLayout = Activator.CreateInstance( layoutType, layout );
		var parameter = Activator.CreateInstance( parameterType, simpleLayout );
		var parameters = targetType.GetProperty( "Parameters" )?.GetValue( target );
		parameters?.GetType().GetMethod( "Add" )?.Invoke( parameters, new[] { parameter } );
	}

	private static Type GetBaseTypeByName( Type type, string fullName )
	{
		for ( var current = type; current is not null; current = current.BaseType )
		{
			if ( string.Equals( current.FullName, fullName, StringComparison.Ordinal ) )
				return current;
		}

		return null;
	}

	private void DrainLogQueue()
	{
		var didAdd = false;

		while ( PendingLogEntries.TryDequeue( out var entry ) )
		{
			Entries.Add( entry );
			didAdd = true;
		}

		if ( !didAdd )
			return;

		TrimEntries();
		StateHasChanged();
		OutputPanel?.TryScrollToBottom();
	}

	private void PollActiveLogFile()
	{
		if ( DateTime.UtcNow < NextLogPollTime )
			return;

		NextLogPollTime = DateTime.UtcNow.AddMilliseconds( 150 );

		var logFile = FindActiveLogFile();
		if ( logFile is null )
			return;

		if ( TailedLogFile is null ||
			!string.Equals( TailedLogFile.FullName, logFile.FullName, StringComparison.OrdinalIgnoreCase ) )
		{
			TailedLogFile = logFile;
			TailedLogPosition = logFile.Exists ? logFile.Length : 0;
			return;
		}

		logFile.Refresh();
		if ( !logFile.Exists )
			return;

		if ( logFile.Length < TailedLogPosition )
			TailedLogPosition = 0;

		if ( logFile.Length == TailedLogPosition )
			return;

		try
		{
			using var stream = new FileStream( logFile.FullName, FileMode.Open, FileAccess.Read, FileShare.ReadWrite | FileShare.Delete );
			stream.Seek( TailedLogPosition, SeekOrigin.Begin );

			using var reader = new StreamReader( stream, Encoding.UTF8, true );
			var text = reader.ReadToEnd();
			TailedLogPosition = stream.Position;

			foreach ( var line in SplitLogLines( text ) )
				AddLogFileLine( line );
		}
		catch ( Exception exception )
		{
			PendingLogEntries.Enqueue( new ConsoleEntry( $"Could not read active log file: {exception.Message}", "wrn", DateTime.Now ) );
		}
	}

	private static FileInfo FindActiveLogFile()
	{
		try
		{
			var logDirectory = new DirectoryInfo( Path.Combine( Environment.CurrentDirectory, "logs" ) );
			if ( !logDirectory.Exists )
				return null;

			return logDirectory
				.GetFiles( "*.log" )
				.OrderByDescending( file => file.LastWriteTimeUtc )
				.FirstOrDefault();
		}
		catch
		{
			return null;
		}
	}

	private static void AddLogFileLine( string line )
	{
		if ( string.IsNullOrWhiteSpace( line ) )
			return;

		var kind = GetLogFileKind( line );
		var message = StripLogFilePrefix( line );
		PendingLogEntries.Enqueue( new ConsoleEntry( message, kind, DateTime.Now ) );
	}

	private static string GetLogFileKind( string line )
	{
		if ( line.Contains( "Error |", StringComparison.OrdinalIgnoreCase ) ||
			line.Contains( "Exception", StringComparison.OrdinalIgnoreCase ) )
			return "err";

		if ( line.Contains( "Warning |", StringComparison.OrdinalIgnoreCase ) ||
			line.Contains( "Warn |", StringComparison.OrdinalIgnoreCase ) )
			return "wrn";

		return "msg";
	}

	private static string StripLogFilePrefix( string line )
	{
		if ( line.Length > 24 && char.IsDigit( line[0] ) )
		{
			var firstTab = line.IndexOf( '\t' );
			if ( firstTab >= 0 && firstTab + 1 < line.Length )
				return line.Substring( firstTab + 1 );
		}

		return line;
	}

	private static bool ShouldToggleConsole()
	{
		if (MonopolyApp.IsStandalone)
			return Input.Pressed("GameConsole");

		return Input.Pressed( "EditorConsole" );
	}

	private void Toggle()
	{
		if ( IsOpen )
			Close();
		else
			Open();
	}

	private void Open()
	{
		IsOpen = true;
		IsConsoleOpen = true;
		WantsFocus = true;
		Mouse.Visibility = MouseVisibility.Visible;
		StateHasChanged();
	}

	private void Close()
	{
		IsOpen = false;
		IsConsoleOpen = false;
		WantsFocus = false;
		CommandInput?.Blur();
		StateHasChanged();
	}

	private void SubmitCommand()
	{
		if ( CommandInput is null )
			return;

		var command = CommandInput.Text?.Trim() ?? "";
		CommandInput.Text = "";

		if ( string.IsNullOrWhiteSpace( command ) )
		{
			Close();
			return;
		}

		CommandInput.AddToHistory( command );
		CommandInput.DestroyAutoComplete();

		if ( string.Equals( command, "clear", StringComparison.OrdinalIgnoreCase ) )
		{
			Clear();
			FocusInput();
			return;
		}

		foreach ( var line in SplitCommandLines( command ) )
			RunCommandLine( line );

		FocusInput();
	}

	private static IEnumerable<string> SplitCommandLines( string command )
	{
		return command
			.Split( new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries )
			.Select( line => line.Trim() )
			.Where( line => !string.IsNullOrWhiteSpace( line ) );
	}

	private void RunCommandLine( string command )
	{
		AddEntry( $"> {command}", "cmd" );
		Log.Info( $"> {command}" );

		try
		{
			ConsoleSystem.Run( command );
		}
		catch ( Exception exception )
		{
			AddEntry( exception.Message, "err" );
		}
	}

	private void AddEntry( string message, string kind )
	{
		Entries.Add( new ConsoleEntry( message, kind, DateTime.Now ) );
		TrimEntries();

		StateHasChanged();
		OutputPanel?.TryScrollToBottom();
	}

	private void TrimEntries()
	{
		while ( Entries.Count > 500 )
			Entries.RemoveAt( 0 );
	}

	public static void ReceiveLogLine( string level, string loggerName, string message, string timeText )
	{
		if ( string.IsNullOrWhiteSpace( message ) )
			return;

		if ( !string.IsNullOrWhiteSpace( loggerName ) )
			message = $"[{loggerName}] {message}";

		var kind = GetLogKind( level );
		var time = DateTime.Now;
		if ( TimeSpan.TryParse( timeText, out var parsedTime ) )
			time = DateTime.Today + parsedTime;

		foreach ( var line in SplitLogLines( message ) )
			PendingLogEntries.Enqueue( new ConsoleEntry( line, kind, time ) );

		while ( PendingLogEntries.Count > 1000 && PendingLogEntries.TryDequeue( out _ ) )
		{
		}
	}

	private static string GetLogKind( string level )
	{
		if ( string.Equals( level, "ERROR", StringComparison.OrdinalIgnoreCase ) ||
			string.Equals( level, "FATAL", StringComparison.OrdinalIgnoreCase ) )
			return "err";

		if ( string.Equals( level, "WARN", StringComparison.OrdinalIgnoreCase ) ||
			string.Equals( level, "WARNING", StringComparison.OrdinalIgnoreCase ) )
			return "wrn";

		return "msg";
	}

	private static IEnumerable<string> SplitLogLines( string message )
	{
		return message
			.Split( new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries )
			.Select( line => line.TrimEnd() )
			.Where( line => !string.IsNullOrWhiteSpace( line ) );
	}

	private bool ShouldShowEntry( ConsoleEntry entry )
	{
		if ( (entry.Kind == "msg" || entry.Kind == "cmd") && !ShowMessages )
			return false;

		if ( entry.Kind == "wrn" && !ShowWarnings )
			return false;

		if ( entry.Kind == "err" && !ShowErrors )
			return false;

		return string.IsNullOrWhiteSpace( Filter ) ||
			entry.Message.Contains( Filter, StringComparison.OrdinalIgnoreCase );
	}

	private void SetFilter( string value )
	{
		Filter = value ?? "";
		StateHasChanged();
	}

	private void ToggleMessages()
	{
		ShowMessages = !ShowMessages;
		StateHasChanged();
	}

	private void ToggleWarnings()
	{
		ShowWarnings = !ShowWarnings;
		StateHasChanged();
	}

	private void ToggleErrors()
	{
		ShowErrors = !ShowErrors;
		StateHasChanged();
	}

	private void Clear()
	{
		Entries.Clear();
		StateHasChanged();
	}

	private void FocusInput()
	{
		WantsFocus = true;
		CommandInput?.Focus();
		OutputPanel?.TryScrollToBottom();
		StateHasChanged();
	}

	private object[] GetAutoComplete( string value )
	{
		if ( string.IsNullOrWhiteSpace( value ) )
			return Array.Empty<object>();

		return KnownCommands
			.Where( command => command.StartsWith( value, StringComparison.OrdinalIgnoreCase ) )
			.Take( 20 )
			.Select( command => (object)new TextEntry.AutocompleteEntry { Title = command, Value = command } )
			.ToArray();
	}

	private sealed class ConsoleMirrorWriter : TextWriter
	{
		private readonly TextWriter inner;
		private readonly string kind;
		private readonly StringBuilder pendingLine = new();

		public ConsoleMirrorWriter( TextWriter inner, string kind )
		{
			this.inner = inner;
			this.kind = kind;
		}

		public override Encoding Encoding => inner?.Encoding ?? Encoding.UTF8;

		public override void Write( char value )
		{
			inner?.Write( value );
			WriteCapturedCharacter( value );
		}

		public override void Write( string value )
		{
			inner?.Write( value );

			if ( string.IsNullOrEmpty( value ) )
				return;

			foreach ( var character in value )
				WriteCapturedCharacter( character );
		}

		public override void WriteLine( string value )
		{
			inner?.WriteLine( value );

			if ( !string.IsNullOrEmpty( value ) )
			{
				foreach ( var character in value )
					WriteCapturedCharacter( character );
			}

			FlushPendingLine();
		}

		public override void Flush()
		{
			inner?.Flush();
			FlushPendingLine();
		}

		private void WriteCapturedCharacter( char value )
		{
			if ( value == '\r' )
				return;

			if ( value == '\n' )
			{
				FlushPendingLine();
				return;
			}

			pendingLine.Append( value );
		}

		private void FlushPendingLine()
		{
			if ( pendingLine.Length == 0 )
				return;

			var line = pendingLine.ToString();
			pendingLine.Clear();

			if ( !string.IsNullOrWhiteSpace( line ) )
				PendingLogEntries.Enqueue( new ConsoleEntry( line, kind, DateTime.Now ) );
		}
	}

}
