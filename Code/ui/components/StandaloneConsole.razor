@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Collections.Concurrent;
@using System.Linq;
@inherits PanelComponent

<root class="@RootClasses">
	@if ( IsOpen )
	{
		<div class="standalone-console-window">
			<div class="standalone-console-output-shell">
				<div class="standalone-console-output monopory-scroll-both" @ref="OutputPanel">
					@foreach ( var entry in FilteredEntries )
					{
						<div class="standalone-console-line @entry.Kind">
							<span class="standalone-console-time">@entry.TimeText</span>
							<span class="standalone-console-message">@entry.Message</span>
						</div>
					}
				</div>
				<MonoScrollbar Target="@OutputPanel"></MonoScrollbar>
			</div>

			<div class="standalone-console-toolbar">
				<ConsoleCommandTextEntry @ref="CommandInput"
					class="standalone-console-input"
					Placeholder="Enter console command..."
					OnConsoleCloseRequested="@Close"
					onsubmit="@SubmitCommand" />

				<TextEntry class="standalone-console-filter"
					Placeholder="Filter..."
					OnTextEdited="@SetFilter" />

				<button class="standalone-console-type msg @(ShowMessages ? "active" : "")" onclick="@ToggleMessages">@MessageCount</button>
				<button class="standalone-console-type wrn @(ShowWarnings ? "active" : "")" onclick="@ToggleWarnings">@WarningCount</button>
				<button class="standalone-console-type err @(ShowErrors ? "active" : "")" onclick="@ToggleErrors">@ErrorCount</button>
				<button class="standalone-console-clear" onclick="@Clear">clear</button>
			</div>
		</div>
	}
</root>

@code
{
	private readonly record struct ConsoleEntry( string Message, string Kind, DateTime Time )
	{
		public string TimeText => Time.ToString( "HH:mm:ss" );
	}

	private static readonly ConcurrentQueue<ConsoleEntry> PendingLogEntries = new();
	private static string[] KnownCommands =>
		GameCommands.All.Keys
			.Concat( GameConVars.All.Keys )
			.Distinct( StringComparer.OrdinalIgnoreCase )
			.OrderBy( command => command, StringComparer.OrdinalIgnoreCase )
			.ToArray();

	private readonly List<ConsoleEntry> Entries = new();
	private ConsoleCommandTextEntry CommandInput = null!;
	private Panel OutputPanel = null!;
	private bool WantsFocus;
	private string Filter = "";

	public static StandaloneConsole Instance { get; private set; }
	public static bool IsConsoleOpen => Instance?.IsOpen == true;
	public bool IsOpen { get; private set; }
	private bool ShowMessages { get; set; } = true;
	private bool ShowWarnings { get; set; } = true;
	private bool ShowErrors { get; set; } = true;
	private bool HasShownReadyLine;

	private string RootClasses => IsOpen ? "standalone-console-root open" : "standalone-console-root";
	private int MessageCount => Entries.Count( entry => entry.Kind == "msg" || entry.Kind == "cmd" );
	private int WarningCount => Entries.Count( entry => entry.Kind == "wrn" );
	private int ErrorCount => Entries.Count( entry => entry.Kind == "err" );

	private IEnumerable<ConsoleEntry> FilteredEntries => Entries.Where( ShouldShowEntry );

	protected override void OnStart()
	{
		base.OnStart();

		Instance = this;
		Close();
	}

	protected override void OnDestroy()
	{
		if ( Instance == this )
			Instance = null;

		base.OnDestroy();
	}

	protected override void OnUpdate()
	{
		base.OnUpdate();
		Instance = this;

		ConfigureInput();
		PollStandaloneLogFile();
		DrainLogQueue();

		if ( !HasShownReadyLine )
		{
			HasShownReadyLine = true;
			AddEntry( "Standalone console ready. Press ESC or = to close.", "msg" );
		}

		if ( ShouldToggleConsole() )
		{
			Toggle();
			return;
		}

		if ( IsOpen && Input.EscapePressed )
		{
			Close();
			return;
		}

		if ( WantsFocus && CommandInput is not null )
		{
			CommandInput.Focus();

			if ( CommandInput.HasFocus )
				WantsFocus = false;
		}
	}

	private void ConfigureInput()
	{
		if ( CommandInput is null )
			return;

		CommandInput.HistoryCookie = "monopory-standalone-console-history";
		CommandInput.AutoComplete = GetAutoComplete;
	}

	private void DrainLogQueue()
	{
		var didAdd = false;

		while ( PendingLogEntries.TryDequeue( out var entry ) )
		{
			Entries.Add( entry );
			didAdd = true;
		}

		if ( !didAdd )
			return;

		TrimEntries();
		StateHasChanged();
		OutputPanel?.TryScrollToBottom();
	}

	private static bool ShouldToggleConsole()
	{
		if (MonopolyApp.IsStandalone())
			return Input.Pressed("GameConsole");

		return Input.Pressed( "EditorConsole" );
	}

	private void Toggle()
	{
		if ( IsOpen )
			Close();
		else
			Open();
	}

	private void Open()
	{
		IsOpen = true;
		WantsFocus = true;
		Mouse.Visibility = MouseVisibility.Visible;
		StateHasChanged();
	}

	private void Close()
	{
		IsOpen = false;
		WantsFocus = false;
		CommandInput?.Blur();
		StateHasChanged();
	}

	private void SubmitCommand()
	{
		if ( CommandInput is null )
			return;

		var command = CommandInput.Text?.Trim() ?? "";
		CommandInput.Text = "";

		if ( string.IsNullOrWhiteSpace( command ) )
		{
			Close();
			return;
		}

		CommandInput.AddToHistory( command );
		CommandInput.DestroyAutoComplete();

		if ( string.Equals( command, "clear", StringComparison.OrdinalIgnoreCase ) )
		{
			Clear();
			FocusInput();
			return;
		}

		foreach ( var line in SplitCommandLines( command ) )
			RunCommandLine( line );

		FocusInput();
	}

	private static IEnumerable<string> SplitCommandLines( string command )
	{
		return command
			.Split( new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries )
			.Select( line => line.Trim() )
			.Where( line => !string.IsNullOrWhiteSpace( line ) );
	}

	private void RunCommandLine( string command )
	{
		AddEntry( $"> {command}", "cmd" );
		Log.Info( $"> {command}" );

		try
		{
			ConsoleSystem.Run( command );
		}
		catch ( Exception exception )
		{
			AddEntry( exception.Message, "err" );
		}
	}

	private void AddEntry( string message, string kind )
	{
		Entries.Add( new ConsoleEntry( message, kind, DateTime.Now ) );
		TrimEntries();

		StateHasChanged();
		OutputPanel?.TryScrollToBottom();
	}

	private void TrimEntries()
	{
		while ( Entries.Count > 500 )
			Entries.RemoveAt( 0 );
	}

	public static void ReceiveLogLine( string level, string loggerName, string message, string timeText )
	{
		if ( string.IsNullOrWhiteSpace( message ) )
			return;

		if ( !string.IsNullOrWhiteSpace( loggerName ) )
			message = $"[{loggerName}] {message}";

		var kind = GetLogKind( level );
		var time = DateTime.Now;
		if ( TimeSpan.TryParse( timeText, out var parsedTime ) )
			time = DateTime.Today + parsedTime;

		foreach ( var line in SplitLogLines( message ) )
			PendingLogEntries.Enqueue( new ConsoleEntry( line, kind, time ) );

		while ( PendingLogEntries.Count > 1000 && PendingLogEntries.TryDequeue( out _ ) )
		{
		}
	}

	public static void WriteLine( string message, string kind = "msg" )
	{
		if ( string.IsNullOrWhiteSpace( message ) )
			return;

		foreach ( var line in SplitLogLines( message ) )
			PendingLogEntries.Enqueue( new ConsoleEntry( line, kind, DateTime.Now ) );

		while ( PendingLogEntries.Count > 1000 && PendingLogEntries.TryDequeue( out _ ) )
		{
		}
	}

	private static string GetLogKind( string level )
	{
		if ( string.Equals( level, "ERROR", StringComparison.OrdinalIgnoreCase ) ||
			string.Equals( level, "FATAL", StringComparison.OrdinalIgnoreCase ) )
			return "err";

		if ( string.Equals( level, "WARN", StringComparison.OrdinalIgnoreCase ) ||
			string.Equals( level, "WARNING", StringComparison.OrdinalIgnoreCase ) )
			return "wrn";

		return "msg";
	}

	private static IEnumerable<string> SplitLogLines( string message )
	{
		return message
			.Split( new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries )
			.Select( line => line.TrimEnd() )
			.Where( line => !string.IsNullOrWhiteSpace( line ) );
	}

	private bool ShouldShowEntry( ConsoleEntry entry )
	{
		if ( (entry.Kind == "msg" || entry.Kind == "cmd") && !ShowMessages )
			return false;

		if ( entry.Kind == "wrn" && !ShowWarnings )
			return false;

		if ( entry.Kind == "err" && !ShowErrors )
			return false;

		return string.IsNullOrWhiteSpace( Filter ) ||
			entry.Message.Contains( Filter, StringComparison.OrdinalIgnoreCase );
	}

	private void SetFilter( string value )
	{
		Filter = value ?? "";
		StateHasChanged();
	}

	private void ToggleMessages()
	{
		ShowMessages = !ShowMessages;
		StateHasChanged();
	}

	private void ToggleWarnings()
	{
		ShowWarnings = !ShowWarnings;
		StateHasChanged();
	}

	private void ToggleErrors()
	{
		ShowErrors = !ShowErrors;
		StateHasChanged();
	}

	private void Clear()
	{
		Entries.Clear();
		StateHasChanged();
	}

	private void FocusInput()
	{
		WantsFocus = true;
		CommandInput?.Focus();
		OutputPanel?.TryScrollToBottom();
		StateHasChanged();
	}

	private object[] GetAutoComplete( string value )
	{
		if ( string.IsNullOrWhiteSpace( value ) )
			return Array.Empty<object>();

		return KnownCommands
			.Where( command => command.StartsWith( value, StringComparison.OrdinalIgnoreCase ) )
			.Distinct( StringComparer.OrdinalIgnoreCase )
			.Take( 20 )
			.Select( command => (object)new TextEntry.AutocompleteEntry { Title = command, Value = command } )
			.ToArray();
	}

}
