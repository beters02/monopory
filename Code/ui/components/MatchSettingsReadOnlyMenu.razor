@using Sandbox;
@using Sandbox.UI;
@using Sandbox.ui.components;
@using Sandbox.ui.components.buttons;
@using System;
@using System.Linq;
@inherits Panel

<OptionsPanel IsOpen="@(IsOpen && Config is not null)" Kicker="Match" Title="Match Settings" OnClose="@Close" RootVariant="match-config-readonly-root">
	<ChildContent>
		<OptionsPanelBody Copy="Current match settings are read-only during a live game.">
			<ChildContent Context="_">
				<OptionsPanelSectionList TItem="MatchConfigOption" Sections="@ConfigSections">
					<ChildContent Context="option">
						<OptionsPanelRow Title="@option.Label" Value="@option.Description">
							<ChildContent>
								<div class="options-panel-readonly-value">@GetConfigDisplayValue( option )</div>
							</ChildContent>
						</OptionsPanelRow>
					</ChildContent>
				</OptionsPanelSectionList>
			</ChildContent>
		</OptionsPanelBody>
	</ChildContent>
</OptionsPanel>

@code
{
	[Parameter] public bool IsOpen { get; set; }
	[Parameter] public MatchConfig Config { get; set; }
	[Parameter] public Action OnClose { get; set; }

	private IReadOnlyList<OptionsPanelSection<MatchConfigOption>> ConfigSections =>
		ConfigGroups.Select( group => new OptionsPanelSection<MatchConfigOption>
		{
			Title = group,
			Items = GetConfigOptionsForGroup( group ).ToList()
		} ).ToList();

	private IReadOnlyList<string> ConfigGroups => MatchConfigSchema.Options.Where( option => option.IsVisible ).Select( option => option.Group ).Distinct().ToList();

	private void Close()
	{
		OnClose?.Invoke();
	}

	private IEnumerable<MatchConfigOption> GetConfigOptionsForGroup( string group )
	{
		return MatchConfigSchema.Options.Where( option => option.IsVisible && string.Equals( option.Group, group, StringComparison.Ordinal ) );
	}

	private string GetConfigDisplayValue( MatchConfigOption option )
	{
		var value = MatchConfigSchema.GetOptionValue( option, Config );

		if ( option.Kind == MatchConfigOptionKind.Bool )
			return (bool)(value ?? false) ? "On" : "Off";

		if ( option.Kind == MatchConfigOptionKind.Enum )
			return FormatEnumLabel( value?.ToString() ?? "" );

		return MatchConfigSchema.FormatValue( option, value );
	}

	private static string FormatEnumLabel( string value )
	{
		if ( string.IsNullOrWhiteSpace( value ) )
			return "";

		var label = value.Replace( "_", " " );
		for ( var i = label.Length - 1; i > 0; i-- )
		{
			if ( char.IsUpper( label[i] ) && !char.IsWhiteSpace( label[i - 1] ) )
				label = label.Insert( i, " " );
		}

		return label;
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( IsOpen );

		if ( Config is not null )
		{
			foreach ( var option in MatchConfigSchema.Options )
				hash.Add( MatchConfigSchema.FormatValue( option, MatchConfigSchema.GetOptionValue( option, Config ) ) );
		}

		return hash.ToHashCode();
	}
}
