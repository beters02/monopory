@using Sandbox;
@using Sandbox.UI;
@using Sandbox.ui.components.HudPanel;
@using Sandbox.ui.components.buttons
@using System;
@inherits Panel

<root>
	@if ( PropertyHudPlayers.Count > 0 )
	{
		<Sandbox.ui.components.HudPanel.HudPanel Variant="property-hud-card">
			<ChildContent>
				<div class="property-player-list">
				@foreach ( var player in PropertyHudPlayers )
				{
					var playerIndex = GameRef.GetPlayerIndex( player );

					<Sandbox.ui.components.HudPanel.HudPanel Variant="@GetPropertyPanelClasses( playerIndex )">
						<ChildContent>
							<div class="property-player-name">@player.PlayerName</div>
							<div class="property-player-money">$@player.Money</div>
						</ChildContent>
					</Sandbox.ui.components.HudPanel.HudPanel>
				}
				</div>
			</ChildContent>
		</Sandbox.ui.components.HudPanel.HudPanel>

		<Sandbox.ui.components.HudPanel.HudPanel Variant="property-manager-hud">
			<ChildContent>
				<div class="property-manager-title">Property Manager</div>
				<div class="property-manager-content">
					@foreach ( var ownershipGroup in PropertyManagerSections )
					{
						<div class="property-manager-section">
							<div class="property-manager-section-title">@ownershipGroup.Title</div>
							@if ( ownershipGroup.Properties.Count == 0 )
							{
								<div class="property-manager-empty">None</div>
							}
							else
							{
								<div class="property-manager-grid">
									@foreach ( var property in ownershipGroup.Properties )
									{
										<GameButton
											Variant="property-manager-item"
											Title="@property.DisplayName"
											OnClick="@(() => SelectPropertySpace( property.Index ))">
											<ChildContent>
												<div class="@GetPropertySquareClasses( property, ownershipGroup.PlayerIndex )">
													@if ( GameRef.IsMortgaged( property.Index ) )
													{
														<div class="property-mortgage-marker">M</div>
													}
												</div>
												<div class="property-manager-name">@property.DisplayName</div>
											</ChildContent>
										</GameButton>
									}
								</div>
							}
						</div>
					}
				</div>
			</ChildContent>
		</Sandbox.ui.components.HudPanel.HudPanel>
	}
</root>

@code
{
	[Parameter] public GameController GameRef { get; set; }
	private int InitialTurnOrderStartIndex = -1;

	private List<PlayerState> PropertyHudPlayers
	{
		get
		{
			if ( GameRef is null )
				return new();

			var assignedPlayers = GameRef.Players
				.Where( player => player is not null && player.IsAssigned )
				.ToList();

			if ( assignedPlayers.Count == 0 )
				return assignedPlayers;

			var startIndex = GetTurnOrderStartIndex();
			if ( startIndex < 0 )
				return assignedPlayers;

			return assignedPlayers
				.OrderBy( player =>
				{
					var index = GameRef.GetPlayerIndex( player );
					if ( index < 0 )
						return int.MaxValue;

					return index >= startIndex
						? index - startIndex
						: index + GameRef.MaxPlayers - startIndex;
				} )
				.ToList();
		}
	}

	private int GetTurnOrderStartIndex()
	{
		if ( GameRef is null )
			return -1;

		if ( InitialTurnOrderStartIndex < 0 && GameRef.CurrentPlayerIndex >= 0 )
			InitialTurnOrderStartIndex = GameRef.CurrentPlayerIndex;

		return InitialTurnOrderStartIndex;
	}

	private List<SpaceDef> OrderedPropertySpaces =>
		(GameRef?.Board?.SpaceDefs ?? new())
			.Where( HudUi.IsPurchasableSpace )
			.OrderBy( GetPropertyOrderGroup )
			.ThenBy( property => property.Index )
			.ToList();

	private List<PropertyManagerSection> PropertyManagerSections
	{
		get
		{
			var sections = new List<PropertyManagerSection>();
			if ( GameRef is null )
				return sections;

			var localPlayer = GameRef.LocalPlayer;
			if ( localPlayer is not null && localPlayer.IsAssigned )
			{
				sections.Add( CreatePlayerSection( localPlayer, "Owned by you" ) );
			}

			foreach ( var player in PropertyHudPlayers )
			{
				if ( player == localPlayer )
					continue;

				sections.Add( CreatePlayerSection( player, $"Owned by {player.PlayerName}" ) );
			}

			sections.Add( new PropertyManagerSection
			{
				Title = "Unowned",
				PlayerIndex = -1,
				Properties = OrderedPropertySpaces
					.Where( property => (GameRef?.GetOwnerIndexForSpace( property.Index ) ?? -1) < 0 )
					.ToList()
			} );

			return sections;
		}
	}

	private PropertyManagerSection CreatePlayerSection( PlayerState player, string title )
	{
		var playerIndex = GameRef?.GetPlayerIndex( player ) ?? -1;

		return new PropertyManagerSection
		{
			Title = title,
			PlayerIndex = playerIndex,
			Properties = OrderedPropertySpaces
				.Where( property => (GameRef?.GetOwnerIndexForSpace( property.Index ) ?? -1) == playerIndex )
				.ToList()
		};
	}

	private static int GetPropertyOrderGroup( SpaceDef property )
	{
		if ( property.Type == SpaceType.Railroad )
			return 100;

		if ( property.Type == SpaceType.Utility )
			return 200;

		return property.ColorGroup switch
		{
			ColorGroup.Brown => 0,
			ColorGroup.LightBlue => 10,
			ColorGroup.Pink => 20,
			ColorGroup.Orange => 30,
			ColorGroup.Red => 40,
			ColorGroup.Yellow => 50,
			ColorGroup.Green => 60,
			ColorGroup.DarkBlue => 70,
			_ => 90
		};
	}

	private void SelectPropertySpace( int spaceIndex ) => GameRef?.SelectSpace( spaceIndex );

	private string GetPropertyPanelClasses( int playerIndex )
	{
		var classes = $"property-player-panel player-{playerIndex}";

		if ( GameRef?.LocalPlayerIndex == playerIndex )
			classes += " local-player";

		if ( GameRef?.CurrentPlayerIndex == playerIndex )
			classes += " current-player";

		return classes;
	}

	private string GetPropertySquareClasses( SpaceDef property, int playerIndex )
	{
		var ownerIndex = GameRef?.GetOwnerIndexForSpace( property.Index ) ?? -1;
		var colorGroup = HudUi.GetPropertyColorClass( property );
		var classes = $"property-square color-{colorGroup} space-{property.Index}";

		if ( ownerIndex == playerIndex )
			classes += " owned-by-panel-player";
		else if ( ownerIndex >= 0 )
			classes += " owned-by-other-player";
		else
			classes += " unowned";

		if ( GameRef?.PendingPurchaseSpaceIndex == property.Index )
			classes += " pending-purchase";

		if ( GameRef?.IsMortgaged( property.Index ) == true )
			classes += " mortgaged";

		if ( GameRef?.LocalSelectedSpaceIndex == property.Index )
			classes += " selected";

		return classes;
	}

	protected override int BuildHash()
	{
		return HashCode.Combine(
			GameRef?.CurrentPlayerIndex ?? -1,
			GameRef?.PendingPurchaseSpaceIndex ?? -1,
			GameRef?.LocalSelectedSpaceIndex ?? -1,
			HudUi.GetPropertyOwnersHash( GameRef ),
			HudUi.GetMortgagedPropertiesHash( GameRef ),
			HudUi.GetPlayersHash( GameRef )
		);
	}

	private sealed class PropertyManagerSection
	{
		public string Title { get; init; } = "";
		public int PlayerIndex { get; init; } = -1;
		public List<SpaceDef> Properties { get; init; } = new();
	}
}
