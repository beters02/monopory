@using Sandbox;
@using Sandbox.UI;
@using System;
@inherits Panel

<root class="button-pop-layer">
	@foreach ( var effect in ActiveEffects )
	{
		<div @key="effect.Id" class="button-pop" style="@GetEffectStyle( effect )">
			@foreach ( var particle in effect.Particles )
			{
				<div class="button-pop-particle-anchor" style="@GetParticleStyle( effect, particle )">
					<div class="button-pop-particle-line" style="@GetParticleLineStyle( particle )"></div>
				</div>
			}
		</div>
	}
</root>

@code
{
	private IReadOnlyList<ButtonPopEffect> ActiveEffects => ButtonPopEffects.Effects;

	private string GetEffectStyle( ButtonPopEffect effect )
	{
		var position = new Vector2( effect.X, effect.Y ) * ScaleFromScreen;
		return $"left: {position.x}px; top: {position.y}px;";
	}

	private static string GetParticleStyle( ButtonPopEffect effect, ButtonPopParticle particle )
	{
		var progress = Math.Clamp( (Time.Now - effect.StartedAt) / ButtonPopEffects.AnimationDuration, 0f, 1f );
		var eased = 1f - MathF.Pow( 1f - progress, 3f );
		var opacity = progress < 0.22f
			? progress / 0.22f
			: 1f - Math.Clamp( (progress - 0.22f) / 0.78f, 0f, 1f );

		var radius = Lerp( 5f, 30f, eased );
		var angle = particle.Angle.DegreeToRadian();
		var x = MathF.Cos( angle ) * radius;
		var y = MathF.Sin( angle ) * radius;
		var scale = Lerp( 0.55f, 1.2f, eased );

		return $"opacity: {opacity}; transform: translate({x}px, {y}px) scale({scale});";
	}

	private static string GetParticleLineStyle( ButtonPopParticle particle )
	{
		return $"transform: translate(-50%, -50%) rotate({particle.Angle}deg);";
	}

	private static float Lerp( float from, float to, float amount )
	{
		return from + ((to - from) * amount);
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();

		foreach ( var effect in ActiveEffects )
		{
			hash.Add( effect.Id );
			hash.Add( effect.X );
			hash.Add( effect.Y );

			foreach ( var particle in effect.Particles )
				hash.Add( particle.Angle );
		}

		hash.Add( ScaleFromScreen );
		hash.Add( MathF.Round( Time.Now * 120f ) );

		return hash.ToHashCode();
	}
}
