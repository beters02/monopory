@using Sandbox;
@using Sandbox.UI;
@using Sandbox.ui.components.buttons
@using System;
@inherits Panel

<root>
	<OptionsMenu IsOpen="@IsOptionsMenuOpen" OnClose="@CloseOptions" UseBlurBackdrop="@true"></OptionsMenu>
	<MatchSettingsReadOnlyMenu IsOpen="@IsMatchSettingsMenuOpen" Config="@GameRef?.Config" OnClose="@CloseMatchSettings"></MatchSettingsReadOnlyMenu>

	@if ( GameRef?.MatchState == MatchLifecycleState.GameOver )
	{
		<div class="session-screen game-over-screen">
			<div class="session-panel">
				<div class="session-kicker">Game Over</div>
				<div class="session-title">@WinnerName Wins</div>
				@if (CanUseHostControls)
				{
					<div class="session-copy">Return your group back to the lobby, or leave lobby.</div>
					<div class="session-actions">
						<GameButton Variant="session-primary-button" OnClick="@ReturnToLobby">Back To Lobby</GameButton>
						<GameButton Variant="session-primary-button" OnClick="@LeaveLobby">Leave Lobby</GameButton>
					</div>
				} else {
					<div class="session-copy">Wait for the host to return the group to lobby, or leave lobby (you will have to get invited back).</div>
					<div class="session-actions">
						<GameButton Variant="session-primary-button" OnClick="@LeaveLobby">Leave Lobby</GameButton>
					</div>
				}
			</div>
		</div>
	}

	@if ( IsEscapeMenuOpen && !IsOptionsMenuOpen && !IsMatchSettingsMenuOpen )
	{
		<div class="session-screen escape-menu-screen">
			<div class="session-panel escape-menu-panel">
				<div class="session-header">
					<div>
						<div class="session-kicker">Menu</div>
						<div class="session-title">Game Menu</div>
					</div>
					<CloseButton Variant="session-close-button" Title="Close" OnClick="@CloseMenu"></CloseButton>
				</div>
				<div class="session-actions escape-menu-actions">
					<GameButton Variant="session-primary-button" OnClick="@CloseMenu">Return To Game</GameButton>
					<GameButton Variant="session-utility-button" OnClick="@OpenMatchSettings">Match Settings</GameButton>
					@if ( CanUseHostControls )
					{
						<GameButton Variant="session-utility-button" OnClick="@SaveGame">Save Game</GameButton>
						<GameButton Variant="session-utility-button" OnClick="@ReloadLastLoadedSave">Reload Last Loaded Save</GameButton>
					}
					<GameButton Variant="session-utility-button" OnClick="@OpenOptions">Options</GameButton>
					@if ( CanBankruptAndAbandon )
					{
						<GameButton Variant="session-danger-button" OnClick="@BankruptAndAbandon">Bankrupt</GameButton>
					}
					<GameButton Variant="session-danger-button" OnClick="@LeaveLobby">Leave Lobby</GameButton>
					<GameButton Variant="session-danger-button" OnClick="@ExitGame">Exit Game</GameButton>
				</div>
				@if ( !string.IsNullOrWhiteSpace( GameIdentifier ) )
				{
					<div class="session-game-identifier">Game @GameIdentifier</div>
				}
			</div>
		</div>
	}

	@if ( GameRef?.MatchState == MatchLifecycleState.Paused )
	{
		<div class="session-screen pause-screen">
			<div class="session-panel">
				<div class="session-kicker">Paused</div>
				<div class="session-title">Game Paused</div>
				<div class="session-copy">The table is frozen until the host resumes or returns everyone to the lobby.</div>
				<div class="session-actions">
					<GameButton Variant="session-primary-button" OnClick="@ResumeGame">Resume</GameButton>
					@if ( CanUseHostControls )
					{
						<GameButton Variant="session-secondary-button" OnClick="@ReturnToLobby">Back To Lobby</GameButton>
					} else {
						<GameButton Variant="session-secondary-button" OnClick="@LeaveLobby">Leave Lobby</GameButton>
					}
				</div>
			</div>
		</div>
	}
</root>

@code
{
	[Parameter] public GameController GameRef { get; set; }
	[Parameter] public bool IsEscapeMenuOpen { get; set; }
	[Parameter] public bool IsOptionsMenuOpen { get; set; }
	[Parameter] public bool IsMatchSettingsMenuOpen { get; set; }
	[Parameter] public Action OnResumeGame { get; set; }
	[Parameter] public Action OnOpenOptions { get; set; }
	[Parameter] public Action OnOpenMatchSettings { get; set; }
	[Parameter] public Action OnCloseMenu { get; set; }
	[Parameter] public Action OnCloseOptions { get; set; }
	[Parameter] public Action OnCloseMatchSettings { get; set; }
	[Parameter] public Action OnReturnToLobby { get; set; }
	[Parameter] public Action OnLeaveLobby { get; set; }
	[Parameter] public Action OnDeclareBankruptcy { get; set; }
	[Parameter] public Action OnExitGame { get; set; }
	[Parameter] public Action OnSaveGame { get; set; }
	[Parameter] public Action OnReloadLastLoadedSave { get; set; }

	private string WinnerName =>
		GameRef?.Winner?.PlayerName ?? "No One";
	private string GameIdentifier => GameRef?.CurrentGameIdentifier ?? "";
	private bool CanUseHostControls =>
		Networking.IsHost || GameRef?.IsLocalEffectiveHost == true;
	private bool CanBankruptAndAbandon =>
		GameRef?.MatchState == MatchLifecycleState.InGame &&
		GameRef?.LocalPlayer?.IsAssigned == true &&
		GameRef?.LocalPlayer?.IsBankrupt != true;

	private void ResumeGame() => OnResumeGame?.Invoke();
	private void OpenOptions() => OnOpenOptions?.Invoke();
	private void OpenMatchSettings() => OnOpenMatchSettings?.Invoke();
	private void CloseMenu() => OnCloseMenu?.Invoke();
	private void CloseOptions() => OnCloseOptions?.Invoke();
	private void CloseMatchSettings() => OnCloseMatchSettings?.Invoke();
	private void ReturnToLobby() => OnReturnToLobby?.Invoke();
	private void LeaveLobby() => OnLeaveLobby?.Invoke();
	private void BankruptAndAbandon() => OnDeclareBankruptcy?.Invoke();
	private void ExitGame() => OnExitGame?.Invoke();
	private void SaveGame() => OnSaveGame?.Invoke();
	private void ReloadLastLoadedSave() => OnReloadLastLoadedSave?.Invoke();

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( GameRef?.MatchState ?? 0 );
		hash.Add( GameRef?.WinnerPlayerIndex ?? -1 );
		hash.Add( WinnerName );
		hash.Add( CanUseHostControls );
		hash.Add( CanBankruptAndAbandon );
		hash.Add( IsEscapeMenuOpen );
		hash.Add( IsOptionsMenuOpen );
		hash.Add( IsMatchSettingsMenuOpen );
		hash.Add( GameRef?.HasLoadedRestorePoint ?? false );
		hash.Add( GameIdentifier );
		return hash.ToHashCode();
	}
}
