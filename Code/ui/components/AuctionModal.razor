@using Sandbox;
@using Sandbox.UI;
@using Sandbox.ui.components.buttons
@using System;
@inherits Panel

<root>
	@if ( IsAuctionActive )
	{
		<div class="auction-backdrop">
			<div class="auction-modal">
				<div class="auction-kicker">Auction</div>

				<div class="auction-content">
					<div class="auction-bid-panel">
						<div class="auction-label">Current bid</div>
						<div class="auction-current-bid">$@GameRef.AuctionCurrentBid</div>
						<div class="auction-status-row">
							<div>@AuctionLeaderLabel</div>
							<div>@AuctionRemainingLabel</div>
						</div>
						<div class="auction-progress-track">
							<div class="auction-progress-fill" style="@AuctionProgressStyle"></div>
						</div>

						<div class="auction-label bid-label">I'm bidding...</div>
						<div class="auction-actions">
							@foreach ( var increment in AuctionBidIncrements )
							{
								var bid = GameRef.AuctionCurrentBid + increment;
								<GameButton Variant="@GetAuctionBidButtonClasses( bid )" OnClick="@(() => BidAuction( bid ))">
									<ChildContent>
										<span>$@bid</span>
										<span>+$@increment</span>
									</ChildContent>
								</GameButton>
							}
						</div>
					</div>

					<SpaceCard
						Space="@AuctionSpace"
						Variant="selected-space-card"
						ColorClass="@HudUi.GetPropertyColorClass( AuctionSpace )"
						IsMortgaged="@IsAuctionSpaceMortgaged"
						ShowImprovementCount="@IsAuctionProperty"
						HasActions="@false"
						ImprovementLabel="@AuctionImprovementAmountLabel">
						<FooterContent>
							<div>
								<span>Price</span>
								<strong>@AuctionSpacePriceLabel</strong>
							</div>
							<div>
								<span>Rent</span>
								<strong>@AuctionSpaceRentLabel</strong>
							</div>
							@if ( IsAuctionProperty )
							{
								<div>
									<span>House</span>
									<strong>@AuctionHousePriceLabel</strong>
								</div>
							}
						</FooterContent>
					</SpaceCard>
				</div>
			</div>
		</div>
	}
</root>

@code
{
	[Parameter] public GameController GameRef { get; set; }

	private PlayerState LocalPlayer => GameRef?.LocalPlayer;

	private SpaceDef AuctionSpace =>
		GameRef?.Board?.GetSpaceDef( GameRef.AuctionSpaceIndex );

	private int AuctionSpaceIndex =>
		GameRef?.AuctionSpaceIndex ?? -1;

	private bool IsAuctionActive =>
		GameRef?.Phase == GamePhase.Auctioning && AuctionSpace is not null;

	private bool IsAuctionProperty =>
		AuctionSpace is not null &&
		AuctionSpace.HotelRent > 0;

	private bool IsAuctionSpaceMortgaged =>
		AuctionSpaceIndex >= 0 && GameRef?.IsMortgaged( AuctionSpaceIndex ) == true;

	private int AuctionImprovementCount =>
		AuctionSpaceIndex < 0 ? 0 : GameRef?.GetImprovementCount( AuctionSpaceIndex ) ?? 0;

	private int AuctionImprovementCost =>
		AuctionSpaceIndex < 0 ? 0 : GameRef?.GetImprovementCost( AuctionSpaceIndex ) ?? 0;

	private int AuctionSpaceRent =>
		AuctionSpaceIndex < 0 ? 0 : GameRef?.GetRentForSpace( AuctionSpaceIndex ) ?? 0;

	private string AuctionSpacePriceLabel =>
		AuctionSpace?.Price > 0 ? $"${AuctionSpace.Price}" : "-";

	private string AuctionSpaceRentLabel =>
		AuctionSpaceRent > 0 ? $"${AuctionSpaceRent}" : "-";

	private string AuctionHousePriceLabel =>
		AuctionImprovementCost > 0 ? $"${AuctionImprovementCost}" : "-";

	private string AuctionImprovementAmountLabel =>
		AuctionImprovementCount >= 5 ? "Hotel" : AuctionImprovementCount.ToString();

	private int AuctionRemainingSeconds =>
		!IsAuctionActive ? 0 : Math.Max( 0, (int)MathF.Ceiling( GameRef.AuctionEndsAt - Time.Now ) );

	private string AuctionRemainingLabel =>
		$"Ends in {AuctionRemainingSeconds}s";

	private string AuctionLeaderLabel =>
		GameRef?.AuctionHighBidderIndex >= 0
			? $"High bid: {GetPlayerName( GameRef.AuctionHighBidderIndex )}"
			: "No bids yet";

	private int[] AuctionBidIncrements =>
		GameRef?.AuctionCurrentBid < 10 ? new[] { 2, 10, 100 } : new[] { 10, 50, 100 };

	private string AuctionProgressStyle
	{
		get
		{
			var remaining = AuctionRemainingSeconds;
			var percent = Math.Clamp( remaining / 15f * 100f, 0f, 100f );
			return $"width: {percent:0}%;";
		}
	}

	private bool CanLocalPlayerBid( int bidAmount )
	{
		return IsAuctionActive &&
			GameRef?.LocalPlayerIndex >= 0 &&
			GameRef.LocalPlayerIndex != GameRef.AuctionHighBidderIndex &&
			LocalPlayer is not null &&
			bidAmount > GameRef.AuctionCurrentBid &&
			LocalPlayer.Money >= bidAmount;
	}

	private string GetAuctionBidButtonClasses( int bidAmount )
	{
		return CanLocalPlayerBid( bidAmount ) ? "auction-bid-button" : "auction-bid-button disabled";
	}

	private void BidAuction( int bidAmount )
	{
		if ( !CanLocalPlayerBid( bidAmount ) )
			return;

		GameRef?.RequestAuctionBid( bidAmount );
	}

	private string GetPlayerName( int playerIndex )
	{
		return GameRef?.Players?.ElementAtOrDefault( playerIndex )?.PlayerName ?? "Player";
	}

	protected override int BuildHash()
	{
		return HashCode.Combine(
			GameRef?.Phase ?? 0,
			GameRef?.AuctionSpaceIndex ?? -1,
			GameRef?.AuctionCurrentBid ?? 0,
			GameRef?.AuctionHighBidderIndex ?? -1,
			AuctionRemainingSeconds,
			LocalPlayer?.Money ?? 0
		);
	}
}
