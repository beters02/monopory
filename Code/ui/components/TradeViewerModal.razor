@using Sandbox;
@using Sandbox.UI;
@using Sandbox.ui.components.buttons
@using System;
@inherits Panel

<root>
	@if ( Trade is not null )
	{
		<div class="trade-modal-backdrop">
			<div class="trade-modal trade-view-modal">
				<CloseButton Variant="trade-modal-close" OnClick="@Close"></CloseButton>
				<div class="trade-modal-title">@GetPlayerName( Trade.SenderPlayerIndex ) -&gt; @GetPlayerName( Trade.ReceiverPlayerIndex )</div>

				<div class="trade-summary-grid">
					<div class="trade-summary-side">
						<div class="trade-player-name">@GetPlayerName( Trade.SenderPlayerIndex ) gives</div>
						<div class="trade-money-pill">$@Trade.SenderMoney</div>
						@foreach ( var propertyIndex in Trade.SenderPropertyIndexes )
						{
							<div class="@GetPropertyChipClasses( propertyIndex )">@GetPropertyName( propertyIndex )</div>
						}
						@foreach ( var cardId in Trade.SenderCardIds )
						{
							<div class="@GetCardChipClasses( cardId )">@GetCardName( cardId )</div>
						}
					</div>
					<div class="trade-summary-side">
						<div class="trade-player-name">@GetPlayerName( Trade.ReceiverPlayerIndex ) gives</div>
						<div class="trade-money-pill">$@Trade.ReceiverMoney</div>
						@foreach ( var propertyIndex in Trade.ReceiverPropertyIndexes )
						{
							<div class="@GetPropertyChipClasses( propertyIndex )">@GetPropertyName( propertyIndex )</div>
						}
						@foreach ( var cardId in Trade.ReceiverCardIds )
						{
							<div class="@GetCardChipClasses( cardId )">@GetCardName( cardId )</div>
						}
					</div>
				</div>

				@if ( Trade.ReceiverPlayerIndex == GameRef.LocalPlayerIndex )
				{
					<div class="trade-modal-actions">
						<GameButton Variant="trade-send-button" OnClick="@(() => AcceptTrade( Trade.Id ))">Accept</GameButton>
						<GameButton Variant="trade-negotiate-button" OnClick="@(() => NegotiateTrade( Trade.Id ))">Negotiate</GameButton>
						<GameButton Variant="trade-deny-button" OnClick="@(() => DenyTrade( Trade.Id ))">Deny</GameButton>
					</div>
				}
			</div>
		</div>
	}
</root>

@code
{
	[Parameter] public GameController GameRef { get; set; }
	[Parameter] public TradeRequest Trade { get; set; }
	[Parameter] public Action OnClose { get; set; }
	[Parameter] public Action<int> OnAccept { get; set; }
	[Parameter] public Action<int> OnNegotiate { get; set; }
	[Parameter] public Action<int> OnDeny { get; set; }

	private void Close() => OnClose?.Invoke();
	private void AcceptTrade( int tradeId ) => OnAccept?.Invoke( tradeId );
	private void NegotiateTrade( int tradeId ) => OnNegotiate?.Invoke( tradeId );
	private void DenyTrade( int tradeId ) => OnDeny?.Invoke( tradeId );

	private string GetPlayerName( int playerIndex )
	{
		return GameRef?.Players?.ElementAtOrDefault( playerIndex )?.PlayerName ?? "Player";
	}

	private string GetPropertyName( int propertyIndex )
	{
		return GameRef?.Board?.GetSpaceDef( propertyIndex )?.DisplayName ?? $"Space {propertyIndex}";
	}

	private string GetPropertyChipClasses( int propertyIndex )
	{
		var def = GameRef?.Board?.GetSpaceDef( propertyIndex );
		return $"trade-property-chip color-{HudUi.GetPropertyColorClass( def )}";
	}

	private string GetCardName( string cardId )
	{
		return GameRef?.GetTradableCardName( cardId ) ?? "Card";
	}

	private string GetCardChipClasses( string cardId )
	{
		return "trade-property-chip color-jail-free";
	}

	protected override int BuildHash()
	{
		return HashCode.Combine(
			Trade?.Id ?? -1,
			Trade?.Serialize() ?? "",
			GameRef?.LocalPlayerIndex ?? -1,
			HudUi.GetPlayersHash( GameRef )
		);
	}
}
