<Project>
	<PropertyGroup>
		<FacepunchSteamworksDir>$(MSBuildThisFileDirectory)..\Tools\FacepunchSteamworks\</FacepunchSteamworksDir>
	</PropertyGroup>

	<Target Name="CopyFacepunchSteamworksRuntimeFiles" AfterTargets="Build" Condition="'$(MSBuildProjectName)' == 'monopory' and Exists('$(FacepunchSteamworksDir)Facepunch.Steamworks.Win64.dll')">
		<Message Importance="high" Text="Copying optional Facepunch Steamworks runtime files to $(TargetDir)" />
		<Copy SourceFiles="$(FacepunchSteamworksDir)Facepunch.Steamworks.Win64.dll"
			DestinationFiles="$(TargetDir)Facepunch.Steamworks.Win64.dll"
			SkipUnchangedFiles="false" />
		<Copy SourceFiles="$(FacepunchSteamworksDir)Facepunch.Steamworks.Win64.deps.json"
			DestinationFiles="$(TargetDir)Facepunch.Steamworks.Win64.deps.json"
			SkipUnchangedFiles="false" />
		<Copy SourceFiles="$(FacepunchSteamworksDir)steam_api64.dll"
			DestinationFiles="$(TargetDir)steam_api64.dll"
			SkipUnchangedFiles="false" />
	</Target>
</Project>
